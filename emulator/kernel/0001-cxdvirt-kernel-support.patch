+/*
+ * NVMeVirt CXL Type 3 Device - Fix BAR resources for ECAM emulation
+ *
+ * When using ECAM with reserved memory (memmap=), BAR sizing doesn't work
+ * correctly because RAM doesn't implement the BAR sizing protocol (writing
+ * 0xFFFFFFFF should return a size mask, but RAM just stores the value).
+ *
+ * This quirk fixes the BAR resources after enumeration:
+ *   BAR0: Component registers - 64KB at base + 0x100000
+ *   BAR2: Device registers    - 64KB at base + 0x110000
+ *   BAR4: MSI-X table         - 4KB  at base + 0x120000
+ *
+ * The base address is derived from BAR0's start (which the kernel reads
+ * correctly, only the size is wrong).
+ */
+#define NVMEV_CXL_VENDOR_ID	0x0c51
+#define NVMEV_CXL_DEVICE_ID	0x0110
+/* VH mode: BARs after 2MB ECAM region (buses 16-17) */
+#define NVMEV_BAR0_OFFSET	0x200000ULL
+#define NVMEV_BAR2_OFFSET	0x210000ULL
+#define NVMEV_BAR4_OFFSET	0x220000ULL
+
+static void pci_fixup_nvmev_cxl_bars(struct pci_dev *pdev)
+{
+	struct resource *res;
+	u64 base;
+
+	/*
+	 * Derive memmap base from BAR0 start address.
+	 * BAR0 is at base + 0x100000, so base = BAR0_start - 0x100000
+	 */
+	if (!pci_resource_start(pdev, 0)) {
+		pci_warn(pdev, "NVMeVirt CXL: BAR0 not set, cannot fix resources\n");
+		return;
+	}
+
+	base = pci_resource_start(pdev, 0) - NVMEV_BAR0_OFFSET;
+	pci_info(pdev, "NVMeVirt CXL: Fixing BAR resources (base=0x%llx)\n", base);
+
+	/*
+	 * All BARs marked prefetchable to match the bridge's 64-bit
+	 * prefetchable memory window (non-prefetchable only supports 32-bit).
+	 * The actual CPU memory type is controlled by memremap/ioremap.
+	 */
+
+	/* BAR0: Component registers - 64KB, 64-bit, prefetchable */
+	res = &pdev->resource[0];
+	res->start = base + NVMEV_BAR0_OFFSET;
+	res->end = res->start + SZ_64K - 1;
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64 | IORESOURCE_PREFETCH;
+
+	/* BAR1: Upper 32 bits of BAR0 (part of 64-bit BAR) */
+	memset(&pdev->resource[1], 0, sizeof(struct resource));
+
+	/* BAR2: Device registers - 64KB, 64-bit, prefetchable */
+	res = &pdev->resource[2];
+	res->start = base + NVMEV_BAR2_OFFSET;
+	res->end = res->start + SZ_64K - 1;
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64 | IORESOURCE_PREFETCH;
+
+	/* BAR3: Upper 32 bits of BAR2 (part of 64-bit BAR) */
+	memset(&pdev->resource[3], 0, sizeof(struct resource));
+
+	/* BAR4: MSI-X table - 4KB, 64-bit, prefetchable */
+	res = &pdev->resource[4];
+	res->start = base + NVMEV_BAR4_OFFSET;
+	res->end = res->start + SZ_4K - 1;
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64 | IORESOURCE_PREFETCH;
+
+	/* BAR5: Upper 32 bits of BAR4 (part of 64-bit BAR) */
+	memset(&pdev->resource[5], 0, sizeof(struct resource));
+
+	pci_info(pdev, "NVMeVirt CXL: BAR0=0x%llx-0x%llx (64KB)\n",
+		 (u64)pdev->resource[0].start, (u64)pdev->resource[0].end);
+	pci_info(pdev, "NVMeVirt CXL: BAR2=0x%llx-0x%llx (64KB)\n",
+		 (u64)pdev->resource[2].start, (u64)pdev->resource[2].end);
+	pci_info(pdev, "NVMeVirt CXL: BAR4=0x%llx-0x%llx (4KB)\n",
+		 (u64)pdev->resource[4].start, (u64)pdev->resource[4].end);
+}
+DECLARE_PCI_FIXUP_HEADER(NVMEV_CXL_VENDOR_ID, NVMEV_CXL_DEVICE_ID, pci_fixup_nvmev_cxl_bars);
+
+/*
+ * NVMeVirt CXL Root Port BAR fixup
+ *
+ * The root port (Type 1 bridge) has BAR0 pointing to CXL component registers.
+ * Like the endpoint, ECAM-based config access doesn't implement BAR sizing,
+ * so the kernel detects BAR0 as 4GB instead of 64KB.
+ *
+ * Layout (VH mode):
+ *   memmap_start + 0x300000: Root port component registers (64KB) - BAR0
+ *   (Outside the bridge's prefetchable window at 0x200000-0x2FFFFF)
+ */
+#define NVMEV_CXL_RP_DEVICE_ID	0x0001
+#define NVMEV_RP_COMP_OFFSET	0x300000ULL
+
+static void pci_fixup_nvmev_cxl_rp_bar(struct pci_dev *pdev)
+{
+	struct resource *res;
+	u64 base;
+
+	/*
+	 * The root port BAR0 is at base + 0x300000.
+	 * We need to derive the base from the BAR0 address.
+	 * However, the BAR0 value in config space shows 0x3040300000,
+	 * so base = BAR0_start - 0x300000
+	 */
+	if (!pci_resource_start(pdev, 0)) {
+		pci_warn(pdev, "NVMeVirt CXL RP: BAR0 not set, cannot fix resources\n");
+		return;
+	}
+
+	base = pci_resource_start(pdev, 0) - NVMEV_RP_COMP_OFFSET;
+	pci_info(pdev, "NVMeVirt CXL RP: Fixing BAR0 resource (base=0x%llx)\n", base);
+
+	/* BAR0: Component registers - 64KB, 64-bit, prefetchable */
+	res = &pdev->resource[0];
+	res->start = base + NVMEV_RP_COMP_OFFSET;
+	res->end = res->start + SZ_64K - 1;
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64 | IORESOURCE_PREFETCH;
+
+	/* BAR1: Upper 32 bits of BAR0 (part of 64-bit BAR) */
+	memset(&pdev->resource[1], 0, sizeof(struct resource));
+
+	pci_info(pdev, "NVMeVirt CXL RP: BAR0=0x%llx-0x%llx (64KB)\n",
+		 (u64)pdev->resource[0].start, (u64)pdev->resource[0].end);
+}
+DECLARE_PCI_FIXUP_HEADER(NVMEV_CXL_VENDOR_ID, NVMEV_CXL_RP_DEVICE_ID, pci_fixup_nvmev_cxl_rp_bar);
