diff --git a/cxl.h b/cxl.h
new file mode 100644
index 0000000..619d7d1
--- /dev/null
+++ b/cxl.h
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL (Compute Express Link) Support for NVMeVirt
+ *
+ * Based on CXL 2.0 Specification
+ */
+
+#ifndef _NVMEVIRT_CXL_H
+#define _NVMEVIRT_CXL_H
+
+#include <linux/types.h>
+#include <linux/pci.h>
+
+/* CXL Vendor ID */
+#define CXL_VENDOR_ID 0x1e98
+
+/* CXL DVSEC IDs (Designated Vendor Specific Extended Capability) */
+enum cxl_dvsec_type {
+	CXL_DVSEC_DEVICE         = 0,  /* CXL Device */
+	CXL_DVSEC_PORT_EXTENSIONS = 3,  /* Port Extensions */
+	CXL_DVSEC_GPF_DEVICE     = 5,  /* GPF Device */
+	CXL_DVSEC_FLEXBUS_PORT   = 7,  /* Flex Bus Port */
+	CXL_DVSEC_REGISTER_LOCATOR = 8, /* Register Locator */
+	CXL_DVSEC_MLD            = 9,  /* Multi-Logical Device */
+	CXL_MAX_DVSEC            = 10
+};
+
+/* CXL Device Type */
+enum cxl_dev_type {
+	CXL_DEV_TYPE_1 = 1,  /* Type 1 - Cache/Accel */
+	CXL_DEV_TYPE_2 = 2,  /* Type 2 - Accel with memory */
+	CXL_DEV_TYPE_3 = 3,  /* Type 3 - Memory device */
+};
+
+/* Register Block Identifiers (CXL 2.0 Section 8.1.9)
+ * Format of Register Locator Entry:
+ *   Bits 2:0   - BIR (BAR Indicator Register) - which BAR
+ *   Bits 7:3   - Reserved
+ *   Bits 15:8  - Register Block ID
+ *   Bits 31:16 - Register Block Offset Low (bits 31:16 of offset)
+ *   Second DWORD - Register Block Offset High (bits 63:32 of offset)
+ */
+#define CXL_RBI_COMPONENT_REG   0x01  /* Component Register Block ID */
+#define CXL_RBI_CXL_DEVICE_REG  0x03  /* CXL Device Register Block ID */
+
+/* Helper macros to build Register Locator entries */
+#define CXL_REGBLOCK_ENTRY_LO(bir, block_id, offset) \
+	(((bir) & 0x7) | (((block_id) & 0xFF) << 8) | (((((u64)(offset)) >> 16) & 0xFFFF) << 16))
+#define CXL_REGBLOCK_ENTRY_HI(offset) \
+	((((u64)(offset)) >> 32) & 0xFFFFFFFF)
+
+/* Component Register Block Layout */
+#define CXL_COMPONENT_IO_SIZE        0x1000  /* CXL.io registers */
+#define CXL_COMPONENT_CM_SIZE        0x1000  /* CXL.cache/mem registers */
+#define CXL_COMPONENT_BLOCK_SIZE     0x10000 /* Total component block size */
+#define CXL_DEVICE_BLOCK_SIZE        0x10000 /* Total device block size */
+
+/* CXL Capabilities */
+#define CXL_CAP_CAP_ID_RAS           0x2   /* RAS Capability */
+#define CXL_CAP_CAP_ID_LINK          0x4   /* Link Capability */
+#define CXL_CAP_CAP_ID_HDM           0x5   /* HDM Decoder Capability */
+#define CXL_CAP_CAP_ID_EXTSEC        0xE   /* Extended Security Capability */
+#define CXL_CAP_CAP_ID_SNOOP_FILTER  0xF   /* Snoop Filter Capability */
+
+/* CXL Device Capabilities
+ * Layout (offsets from device register base):
+ *   0x00-0x7F:  Capability Array (128 bytes)
+ *   0x80-0x87:  Device Status registers (8 bytes)
+ *   0x88-0x8A7: Mailbox (0x20 header + 0x800 payload = 0x820 bytes)
+ *   0x8A8:      Memory Device registers
+ *
+ * Kernel reads payload at mailbox_base + 0x20 = 0x88 + 0x20 = 0xA8
+ */
+#define CXL_DEV_CAP_ARRAY_SIZE              0x80
+#define CXL_DEV_STATUS_REGISTERS_OFFSET     0x80
+#define CXL_DEV_STATUS_REGISTERS_LENGTH     0x8
+#define CXL_MAILBOX_REGISTERS_OFFSET        0x88
+#define CXL_MAILBOX_REGISTERS_SIZE          0x820  /* 0x20 header + 0x800 payload */
+#define CXL_MAILBOX_PAYLOAD_OFFSET          0xA8   /* mailbox_base(0x88) + 0x20 */
+#define CXL_MAILBOX_MAX_PAYLOAD_SIZE        2048   /* 0x800 bytes */
+#define CXL_MEMORY_DEVICE_REGISTERS_OFFSET  0x8A8  /* After mailbox payload */
+
+/* Component Register Offsets */
+#define CXL_CM_OFFSET           0x1000
+#define CXL_CM_CAP_HDR_OFFSET   0x0
+#define CXL_CM_CAP_PTR_OFFSET   0x4   /* Capability array at offset 0x4 from CM header */
+#define CXL_CM_CAP_SIZE         0x20
+
+/* DVSEC Header Structure (10 bytes, no padding!)
+ * CXL 2.0 Section 8.1.2:
+ *   0x00-0x03: PCI Express Extended Capability Header
+ *   0x04-0x07: DVSEC Header 1 (Vendor ID, Rev, Length)
+ *   0x08-0x09: DVSEC Header 2 (DVSEC ID)
+ * Device-specific data starts immediately at 0x0A
+ */
+struct cxl_dvsec_header {
+	u32 cap_hdr;      /* 0x00: PCI Extended Capability Header */
+	u32 dv_hdr1;      /* 0x04: DVSEC Header 1 (Vendor ID, Rev, Length) */
+	u16 dvsec_id;     /* 0x08: DVSEC ID - NO padding after this! */
+} __packed;
+
+/* CXL Device DVSEC (ID 0) - CXL 2.0 Section 8.1.3
+ * Memory range layout is INTERLEAVED per CXL spec:
+ *   0x18: Range0 Size High
+ *   0x1C: Range0 Size Low (bits 0-1: MEM_INFO_VALID, MEM_ACTIVE)
+ *   0x20: Range0 Base High
+ *   0x24: Range0 Base Low
+ *   0x28: Range1 Size High
+ *   0x2C: Range1 Size Low
+ *   0x30: Range1 Base High
+ *   0x34: Range1 Base Low
+ */
+struct cxl_dvsec_device {
+	struct cxl_dvsec_header header;
+	u16 cap;          /* 0x0A: Capabilities */
+	u16 ctrl;         /* 0x0C: Control */
+	u16 status;       /* 0x0E: Status */
+	u16 ctrl2;        /* 0x10: Control 2 */
+	u16 status2;      /* 0x12: Status 2 */
+	u16 lock;         /* 0x14: Lock */
+	u16 cap2;         /* 0x16: Capabilities 2 */
+	/* Range 0 - interleaved */
+	u32 range0_size_hi;   /* 0x18 */
+	u32 range0_size_lo;   /* 0x1C: bits 0=MEM_INFO_VALID, 1=MEM_ACTIVE, 31:28=size */
+	u32 range0_base_hi;   /* 0x20 */
+	u32 range0_base_lo;   /* 0x24: bits 31:28=base */
+	/* Range 1 - interleaved */
+	u32 range1_size_hi;   /* 0x28 */
+	u32 range1_size_lo;   /* 0x2C */
+	u32 range1_base_hi;   /* 0x30 */
+	u32 range1_base_lo;   /* 0x34 */
+} __packed;
+
+/* Register Locator DVSEC (ID 8) - CXL 2.0 Section 8.1.9 */
+struct cxl_dvsec_register_locator {
+	struct cxl_dvsec_header header;
+	u16 rsvd;
+	/* Register blocks follow, 8 bytes each */
+} __packed;
+
+/* Register Locator Entry */
+struct cxl_dvsec_register_locator_entry {
+	u32 reg_base_lo;  /* Register Base Low */
+	u32 reg_base_hi;  /* Register Base High */
+} __packed;
+
+/* Flex Bus Port DVSEC (ID 7) */
+struct cxl_dvsec_flexbus {
+	struct cxl_dvsec_header header;
+	u16 cap;          /* Port Capability */
+	u16 ctrl;         /* Port Control */
+	u16 status;       /* Port Status */
+} __packed;
+
+/* GPF Device DVSEC (ID 5) */
+struct cxl_dvsec_gpf {
+	struct cxl_dvsec_header header;
+	u16 phase2_duration;
+	u16 phase2_power;
+} __packed;
+
+/* Port Extensions DVSEC (ID 3) */
+struct cxl_dvsec_port_extensions {
+	struct cxl_dvsec_header header;
+	u16 status;
+	u16 control;
+	u32 alt_memory_base;
+	u32 alt_memory_limit;
+	u32 alt_prefetch_base;
+	u32 alt_prefetch_limit;
+	u32 alt_prefetch_base_high;
+	u32 alt_prefetch_limit_high;
+	u32 rcrb_base;
+	u32 rcrb_base_high;
+} __packed;
+
+/* CXL Component Capability Header Register */
+struct cxl_cap_header {
+	u32 cap_id : 16;
+	u32 cap_version : 8;
+	u32 cache_mem_version : 4;
+	u32 array_size : 4;
+} __packed;
+
+/* CXL RAS Capability Structure */
+struct cxl_ras_capability {
+	struct cxl_cap_header header;
+	u32 uncor_err_status;
+	u32 uncor_err_mask;
+	u32 uncor_err_severity;
+	u32 cor_err_status;
+	u32 cor_err_mask;
+	u32 err_cap_ctrl;
+	u32 err_header_log[32];
+} __packed;
+
+/* CXL HDM Decoder Capability */
+struct cxl_hdm_decoder_capability {
+	u32 decoder_cap;
+	u32 decoder_global_control;
+	u32 decoder_target_count;
+	u32 poison_cap;
+	u32 poison_control;
+	u32 poison_status;
+	u32 poison_addr;
+} __packed;
+
+/* CXL HDM Decoder */
+struct cxl_hdm_decoder {
+	u32 base_lo;
+	u32 base_hi;
+	u32 size_lo;
+	u32 size_hi;
+	u32 ctrl;
+	u32 dpa_skip;
+	u32 target_list_lo;
+	u32 target_list_hi;
+} __packed;
+
+/* Device Capability Header Entry (CXL 2.0 Section 8.2.8.2)
+ * Each entry is 16 bytes, starting at offset 0x10
+ * Kernel reads: cap_id at +0x00, offset at +0x04, length at +0x08
+ */
+struct cxl_dev_cap_header {
+	u32 cap_id;     /* Bits 15:0 = Cap ID, Bits 23:16 = Version */
+	u32 offset;     /* Offset of capability registers */
+	u32 length;     /* Length of capability registers */
+	u32 reserved;   /* Reserved (padding to 16 bytes) */
+} __packed;
+
+/* Device Capability Array Register (CXL 2.0 Section 8.2.8.1)
+ * Offset 0x00: Cap Array Header (8 bytes)
+ * Offset 0x08: Reserved (8 bytes) - kernel skips to 0x10
+ * Offset 0x10: First capability header (16 bytes each)
+ */
+struct cxl_dev_cap_array {
+	u64 cap_array_hdr;          /* 0x00: Cap ID=0, Count in bits 47:32 */
+	u64 reserved;               /* 0x08: Reserved (kernel starts at 0x10) */
+	struct cxl_dev_cap_header caps[4];  /* 0x10, 0x20, 0x30, 0x40: Up to 4 caps */
+} __packed;
+
+/* Device Status Registers */
+struct cxl_dev_status {
+	u64 status;
+} __packed;
+
+/* Mailbox Registers */
+struct cxl_mailbox_registers {
+	u32 mailbox_cap;     /* 0x00 */
+	u32 mailbox_ctrl;    /* 0x04 */
+	u64 mailbox_cmd;     /* 0x08 */
+	u64 mailbox_sts;     /* 0x10 */
+	u64 bg_cmd_sts;      /* 0x18 */
+} __packed;
+
+/* Memory Device Status Register */
+struct cxl_mem_device_status {
+	u64 status;
+} __packed;
+
+/* CXL Mailbox Command Return Codes */
+enum cxl_mbox_return_code {
+	CXL_MBOX_SUCCESS = 0x0,
+	CXL_MBOX_BG_STARTED = 0x1,
+	CXL_MBOX_INVALID_INPUT = 0x2,
+	CXL_MBOX_UNSUPPORTED = 0x3,
+	CXL_MBOX_INTERNAL_ERROR = 0x4,
+	CXL_MBOX_RETRY_REQUIRED = 0x5,
+	CXL_MBOX_BUSY = 0x6,
+	CXL_MBOX_MEDIA_DISABLED = 0x7,
+	CXL_MBOX_FW_XFER_IN_PROGRESS = 0x8,
+	CXL_MBOX_FW_XFER_OUT_OF_ORDER = 0x9,
+	CXL_MBOX_FW_AUTH_FAILED = 0xa,
+	CXL_MBOX_FW_INVALID_SLOT = 0xb,
+	CXL_MBOX_FW_ROLLEDBACK = 0xc,
+	CXL_MBOX_FW_REST_REQD = 0xd,
+	CXL_MBOX_INVALID_HANDLE = 0xe,
+	CXL_MBOX_INVALID_PA = 0xf,
+	CXL_MBOX_INJECT_POISON_LIMIT = 0x10,
+	CXL_MBOX_PERMANENT_MEDIA_FAILURE = 0x11,
+	CXL_MBOX_ABORTED = 0x12,
+	CXL_MBOX_INVALID_SECURITY_STATE = 0x13,
+	CXL_MBOX_INCORRECT_PASSPHRASE = 0x14,
+	CXL_MBOX_UNSUPPORTED_MAILBOX = 0x15,
+	CXL_MBOX_INVALID_PAYLOAD_LENGTH = 0x16,
+	CXL_MBOX_MAX = 0x17
+};
+
+/* CXL Mailbox Command Sets, use cxlmem.h
+enum cxl_mailbox_opcode {
+	// Events (0x01)
+	CXL_MBOX_OP_GET_EVENT_RECORD    = 0x0100,
+	CXL_MBOX_OP_CLEAR_EVENT_RECORD  = 0x0101,
+	CXL_MBOX_OP_GET_INTERRUPT_POLICY = 0x0102,
+	CXL_MBOX_OP_SET_INTERRUPT_POLICY = 0x0103,
+
+	// Firmware Update (0x02)
+	CXL_MBOX_OP_GET_FW_INFO          = 0x0200,
+
+	// Timestamp (0x03)
+	CXL_MBOX_OP_GET_TIMESTAMP        = 0x0300,
+	CXL_MBOX_OP_SET_TIMESTAMP        = 0x0301,
+
+	// Logs (0x04)
+	CXL_MBOX_OP_GET_SUPPORTED_LOGS   = 0x0400,
+	CXL_MBOX_OP_GET_LOG              = 0x0401,
+
+	// Identify (0x40)
+	CXL_MBOX_OP_IDENTIFY_DEVICE      = 0x4000,
+
+	// CCLS (0x41)
+	CXL_MBOX_OP_GET_PARTITION_INFO   = 0x4100,
+	CXL_MBOX_OP_GET_LSA              = 0x4102,
+	CXL_MBOX_OP_SET_LSA              = 0x4103,
+
+	// Media and Poison (0x43)
+	CXL_MBOX_OP_GET_POISON_LIST      = 0x4300,
+	CXL_MBOX_OP_INJECT_POISON        = 0x4301,
+	CXL_MBOX_OP_CLEAR_POISON         = 0x4302,
+};
+*/
+
+/* CXL Event Log Types, use use cxlmem.h
+enum cxl_event_log_type {
+	CXL_EVENT_TYPE_INFO = 0,
+	CXL_EVENT_TYPE_WARN = 1,
+	CXL_EVENT_TYPE_FAIL = 2,
+	CXL_EVENT_TYPE_FATAL = 3,
+	CXL_EVENT_TYPE_DYNAMIC_CAP = 4,
+	CXL_EVENT_TYPE_MAX = 5
+};*/
+
+/* Component Register State */
+struct cxl_component_state {
+	void __iomem *base;
+	u32 __iomem *cache_mem_registers;
+
+	/* Capabilities */
+	bool ras_enabled;
+	bool hdm_enabled;
+	u8 hdm_count;
+
+	/* DVSEC tracking */
+	u16 dvsec_offset;
+	u8 dvsec_count;
+};
+
+/* Device Register State */
+struct cxl_device_state {
+	void __iomem *base;
+
+	/* Device capabilities */
+	struct cxl_dev_cap_array __iomem *cap_array;
+	struct cxl_dev_status __iomem *status;
+	struct cxl_mailbox_registers __iomem *mailbox;
+	struct cxl_mem_device_status __iomem *mem_status;
+
+	/* Mailbox state */
+	u8 *mbox_payload;
+	size_t payload_size;
+
+	/* Memory information */
+	u64 total_capacity;
+	u64 volatile_capacity;
+	u64 persistent_capacity;
+
+	/* Event logs */
+	struct list_head event_logs[5];
+	spinlock_t event_log_lock;
+
+	/* Timestamp */
+	u64 timestamp;
+	bool timestamp_set;
+
+	/* Event interrupt policy (stored from SET, returned in GET) */
+	u8 evt_int_policy[4];  /* info, warn, failure, fatal */
+};
+
+/* CXL Type 3 Device State (Memory Device) */
+struct cxl_type3_state {
+	struct cxl_component_state component;
+	struct cxl_device_state device;
+
+	/* Device properties */
+	u64 device_serial_number;
+
+	/* Memory mapping */
+	phys_addr_t mem_base;
+	size_t mem_size;
+
+	/* Poison tracking */
+	struct list_head poison_list;
+	unsigned int poison_count;
+	spinlock_t poison_lock;
+};
+
+/* CXL Command Structure */
+struct cxl_cmd {
+	u16 opcode;
+	u16 effect;
+	ssize_t in;
+	ssize_t out;
+	u8 *payload;
+};
+
+/* CXL Command Handler */
+typedef u32 (*cxl_cmd_handler)(struct cxl_cmd *cmd,
+                               struct cxl_device_state *cxl_dstate,
+                               u16 *len);
+
+/* Function prototypes */
+//int cxl_pci_init(struct pci_dev *pdev, struct cxl_type3_state *ct3);
+//void cxl_pci_exit(struct pci_dev *pdev, struct cxl_type3_state *ct3);
+
+int cxl_component_init(struct cxl_component_state *cxl_comp, void __iomem *base);
+void cxl_component_exit(struct cxl_component_state *cxl_comp);
+int cxl_rp_component_init(void __iomem *base);  /* Root port component registers */
+
+int cxl_device_init(struct cxl_device_state *cxl_dev, void __iomem *base);
+void cxl_device_exit(struct cxl_device_state *cxl_dev);
+
+//int cxl_mailbox_init(struct cxl_device_state *cxl_dev);
+//void cxl_mailbox_exit(struct cxl_device_state *cxl_dev);
+
+u32 cxl_process_mailbox_cmd(struct cxl_device_state *cxl_dev, u64 cmd_reg, u8 *payload);
+
+//int cxl_dvsec_create(struct pci_dev *pdev, enum cxl_dvsec_type type,
+//                     u16 offset, void *body, size_t len);
+
+#endif /* _NVMEVIRT_CXL_H */
