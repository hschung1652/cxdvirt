+#ifdef CONFIG_NVMEV_CXL_SUPPORT
+/**
+ * ROOT_PORT_INIT - Initialize PCIe Root Port config space for VH mode
+ * @nvmev_vdev: NVMeVirt device context
+ * @base_pa: Physical address of memmap_start (ECAM base)
+ *
+ * Creates a Type 1 (PCI-to-PCI bridge) header for the root port at bus 16.
+ * The root port bridges to bus 17 where the CXL endpoint resides.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int ROOT_PORT_INIT(struct nvmev_dev *nvmev_vdev, unsigned long base_pa)
+{
+	void *rp_config;
+	u8 *cfg;
+	u32 *cfg32;
+	u16 *cfg16;
+
+	/* Allocate 4KB for root port config space */
+	rp_config = kzalloc(ECAM_CONFIG_SPACE_SIZE, GFP_KERNEL);
+	if (!rp_config)
+		return -ENOMEM;
+
+	cfg = rp_config;
+	cfg16 = rp_config;
+	cfg32 = rp_config;
+
+	/* === Type 1 Header (PCI-to-PCI Bridge) === */
+
+	/* Vendor/Device ID */
+	cfg16[PCI_VENDOR_ID / 2] = NVMEV_VENDOR_ID;
+	cfg16[PCI_DEVICE_ID / 2] = 0x0001;  /* Root port device ID */
+
+	/* Command: Memory Space Enable, Bus Master Enable */
+	cfg16[PCI_COMMAND / 2] = PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER;
+
+	/* Status: Capabilities List */
+	cfg16[PCI_STATUS / 2] = PCI_STATUS_CAP_LIST;
+
+	/* Revision ID */
+	cfg[PCI_REVISION_ID] = 0x01;
+
+	/* Class Code: PCI-to-PCI Bridge (0x060400) */
+	cfg[PCI_CLASS_PROG] = 0x00;          /* Programming interface */
+	cfg[PCI_CLASS_DEVICE] = 0x04;        /* Subclass: PCI-to-PCI bridge */
+	cfg[PCI_CLASS_DEVICE + 1] = 0x06;    /* Base class: Bridge */
+
+	/* Header Type: Type 1 (Bridge), single function */
+	cfg[PCI_HEADER_TYPE] = PCI_HEADER_TYPE_BRIDGE;
+
+	/* Cache line size, Latency timer */
+	cfg[PCI_CACHE_LINE_SIZE] = 0x10;
+	cfg[PCI_LATENCY_TIMER] = 0x00;
+
+	/* Primary/Secondary/Subordinate bus numbers */
+	cfg[PCI_PRIMARY_BUS] = NVMEV_PCI_BUS_NUM;       /* 0x10 */
+	cfg[PCI_SECONDARY_BUS] = NVMEV_PCI_SEC_BUS_NUM; /* 0x11 */
+	cfg[PCI_SUBORDINATE_BUS] = NVMEV_PCI_SEC_BUS_NUM; /* 0x11 */
+
+	/* Secondary latency timer */
+	cfg[PCI_SEC_LATENCY_TIMER] = 0x00;
+
+	/* I/O Base/Limit: Disabled (0xFF/0x00 pattern) */
+	cfg[PCI_IO_BASE] = 0xF0;
+	cfg[PCI_IO_LIMIT] = 0x00;
+
+	/* Secondary Status */
+	cfg16[PCI_SEC_STATUS / 2] = 0x0000;
+
+	/*
+	 * Memory Base/Limit: Disabled
+	 * Non-prefetchable memory window only supports 32-bit addresses.
+	 * Our BARs are above 4GB, so we must use prefetchable window.
+	 * Set Base > Limit to disable.
+	 */
+	cfg16[PCI_MEMORY_BASE / 2] = 0xFFF0;
+	cfg16[PCI_MEMORY_LIMIT / 2] = 0x0000;
+
+	/*
+	 * Prefetchable Memory: 64-bit window covering all BARs
+	 * Format: bits[15:4] = address[31:20], bits[3:0] = type (0x1 = 64-bit)
+	 * Upper 32 bits of address in PCI_PREF_BASE/LIMIT_UPPER32
+	 */
+	{
+		/*
+		 * Prefetchable window covers ONLY downstream (endpoint) BARs:
+		 * - Endpoint BAR0 (component): 0x200000
+		 * - Endpoint BAR2 (device): 0x210000
+		 * - Endpoint BAR4 (MSI-X): 0x220000
+		 *
+		 * Root port BAR0 is at 0x300000 - OUTSIDE this window (upstream side).
+		 * Bridge window: 0x200000 - 0x2FFFFF (1MB)
+		 */
+		u64 pref_base = base_pa + BAR0_OFFSET;   /* Start: 0x200000 */
+		u64 pref_limit = base_pa + 0x2FFFFF;     /* End: 0x2FFFFF (1MB window) */
+		u32 base_lo = (pref_base >> 16) & 0xFFF0;   /* bits[31:20] shifted to [15:4] */
+		u32 limit_lo = (pref_limit >> 16) & 0xFFF0;
+		u32 base_hi = pref_base >> 32;
+		u32 limit_hi = pref_limit >> 32;
+
+		cfg16[PCI_PREF_MEMORY_BASE / 2] = base_lo | 0x0001;   /* 64-bit type */
+		cfg16[PCI_PREF_MEMORY_LIMIT / 2] = limit_lo | 0x0001;
+		cfg32[PCI_PREF_BASE_UPPER32 / 4] = base_hi;
+		cfg32[PCI_PREF_LIMIT_UPPER32 / 4] = limit_hi;
+	}
+
+	/* I/O Base/Limit Upper 16 bits: Not used */
+	cfg16[PCI_IO_BASE_UPPER16 / 2] = 0x0000;
+	cfg16[PCI_IO_LIMIT_UPPER16 / 2] = 0x0000;
+
+	/* Capabilities Pointer */
+	cfg[PCI_CAPABILITY_LIST] = RP_PM_CAP_OFFSET;
+
+	/* Expansion ROM: Disabled */
+	cfg32[PCI_ROM_ADDRESS1 / 4] = 0x00000000;
+
+	/* Interrupt: Not used for root port */
+	cfg[PCI_INTERRUPT_LINE] = 0x00;
+	cfg[PCI_INTERRUPT_PIN] = 0x00;
+
+	/* Bridge Control */
+	cfg16[PCI_BRIDGE_CONTROL / 2] = 0x0000;
+
+	/* === PM Capability (offset 0x40) === */
+	cfg[RP_PM_CAP_OFFSET + PCI_CAP_LIST_ID] = PCI_CAP_ID_PM;
+	cfg[RP_PM_CAP_OFFSET + PCI_CAP_LIST_NEXT] = RP_PCIE_CAP_OFFSET;
+	cfg16[(RP_PM_CAP_OFFSET + PCI_PM_PMC) / 2] = 0x0003;  /* Version 3, D0/D3 support */
+	cfg16[(RP_PM_CAP_OFFSET + PCI_PM_CTRL) / 2] = 0x0000;
+
+	/* === PCIe Capability (offset 0x50) === */
+	cfg[RP_PCIE_CAP_OFFSET + PCI_CAP_LIST_ID] = PCI_CAP_ID_EXP;
+	cfg[RP_PCIE_CAP_OFFSET + PCI_CAP_LIST_NEXT] = 0x00;  /* End of capability list */
+
+	/* PCIe Capabilities Register */
+	{
+		u16 pcie_caps = 0;
+		pcie_caps |= PCI_EXP_FLAGS;  /* Version */
+		pcie_caps |= (PCI_EXP_TYPE_ROOT_PORT << 4);  /* Device/Port Type: Root Port */
+		cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_FLAGS) / 2] = pcie_caps;
+	}
+
+	/* Device Capabilities */
+	cfg32[(RP_PCIE_CAP_OFFSET + PCI_EXP_DEVCAP) / 4] =
+		(1 << 0) |   /* Max Payload Size supported: 256 bytes */
+		(0 << 3) |   /* Phantom Functions: none */
+		(1 << 4) |   /* Extended Tag Field: 8-bit */
+		(6 << 6) |   /* Acceptable L0s Latency */
+		(2 << 9) |   /* Acceptable L1 Latency */
+		(1 << 15) |  /* Role-Based Error Reporting */
+		(1 << 28);   /* Function Level Reset capability */
+
+	/* Device Control */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_DEVCTL) / 2] = 0x0000;
+
+	/* Device Status */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_DEVSTA) / 2] = 0x0000;
+
+	/* Link Capabilities */
+	cfg32[(RP_PCIE_CAP_OFFSET + PCI_EXP_LNKCAP) / 4] =
+		(4 << 0) |   /* Supported Link Speeds: Gen4 (16 GT/s) */
+		(16 << 4) |  /* Maximum Link Width: x16 */
+		(0 << 10) |  /* ASPM Support: L0s */
+		(6 << 12) |  /* L0s Exit Latency */
+		(2 << 15) |  /* L1 Exit Latency */
+		(1 << 18) |  /* Clock Power Management */
+		(1 << 19) |  /* Surprise Down Error Reporting */
+		(1 << 20) |  /* Data Link Layer Link Active Reporting */
+		(1 << 21) |  /* Link Bandwidth Notification */
+		(1 << 24);   /* Port Number: 1 */
+
+	/* Link Control */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_LNKCTL) / 2] = 0x0000;
+
+	/* Link Status: Link active, Gen4 x16 */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_LNKSTA) / 2] =
+		(4 << 0) |   /* Current Link Speed: Gen4 */
+		(16 << 4) |  /* Negotiated Link Width: x16 */
+		(1 << 12) |  /* Slot Clock Configuration */
+		(1 << 13);   /* Data Link Layer Link Active */
+
+	/* Slot Capabilities: Not a slot, so 0 */
+	cfg32[(RP_PCIE_CAP_OFFSET + PCI_EXP_SLTCAP) / 4] = 0x00000000;
+
+	/* Root Capabilities */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_RTCAP) / 2] = 0x0000;
+
+	/* Root Control */
+	cfg16[(RP_PCIE_CAP_OFFSET + PCI_EXP_RTCTL) / 2] = 0x0000;
+
+	/* Root Status */
+	cfg32[(RP_PCIE_CAP_OFFSET + PCI_EXP_RTSTA) / 4] = 0x00000000;
+
+	/*
+	 * === Root Port BAR0: Component Registers ===
+	 * Type 1 headers have BAR0/BAR1 at 0x10-0x17.
+	 * We use BAR0 for CXL component registers (64KB, 64-bit, prefetchable).
+	 */
+	{
+		u64 rp_bar0_pa = base_pa + RP_COMP_OFFSET;
+		/* BAR0: Lower 32 bits - 64-bit prefetchable, 64KB aligned */
+		cfg32[PCI_BASE_ADDRESS_0 / 4] = (rp_bar0_pa & 0xFFFFFFF0) |
+			PCI_BASE_ADDRESS_MEM_TYPE_64 |
+			PCI_BASE_ADDRESS_MEM_PREFETCH;
+		/* BAR1: Upper 32 bits */
+		cfg32[PCI_BASE_ADDRESS_1 / 4] = rp_bar0_pa >> 32;
+	}
+
+	/* === Extended Capabilities (offset 0x100) === */
+	/* AER Extended Capability - chains to CXL DVSEC */
+	cfg32[RP_EXT_CAP_OFFSET / 4] =
+		(PCI_EXT_CAP_ID_ERR) |  /* AER */
+		(1 << 16) |             /* Version 1 */
+		(RP_CXL_DVSEC_OFFSET << 20);  /* Next: CXL Register Locator */
+
+	/*
+	 * === CXL Register Locator DVSEC (offset 0x110) ===
+	 * This tells the kernel where to find CXL component registers.
+	 * Required for VH mode dport enumeration.
+	 */
+	{
+		u32 *dvsec = (u32 *)(cfg + RP_CXL_DVSEC_OFFSET);
+
+		/* DVSEC Header */
+		dvsec[0] = (PCI_EXT_CAP_ID_DVSEC) |  /* Extended cap ID */
+			   (1 << 16) |                /* Version 1 */
+			   (0 << 20);                 /* No next capability */
+
+		/* DVSEC Header 1: Vendor ID = CXL (0x1E98), Revision = 0 */
+		dvsec[1] = (0x1E98) |              /* CXL Vendor ID */
+			   (0 << 16) |             /* Revision 0 */
+			   (0x1C << 20);           /* Length: 28 bytes (header + 1 entry) */
+
+		/* DVSEC Header 2: DVSEC ID = 8 (Register Locator) */
+		dvsec[2] = 0x0008;  /* Register Locator DVSEC ID */
+
+		/*
+		 * Register Block Entry 1: Component Registers in BAR0
+		 * Format: [31:16] offset_hi, [15:8] block_id, [7:3] rsvd, [2:0] BIR
+		 * Block ID 1 = Component Registers
+		 * BIR 0 = BAR0
+		 * Offset = 0 (registers at start of BAR)
+		 */
+		dvsec[3] = (0 << 16) |    /* Offset[15:0] = 0 */
+			   (1 << 8) |     /* Block ID = 1 (Component Registers) */
+			   (0);           /* BIR = 0 (BAR0) */
+		dvsec[4] = 0;             /* Offset[31:16] = 0 */
+	}
+
+	/* Store the config buffer */
+	nvmev_vdev->root_port_config = rp_config;
+
+	NVMEV_INFO("Root port initialized:\n");
+	NVMEV_INFO("  Primary bus: 0x%02x, Secondary: 0x%02x, Subordinate: 0x%02x\n",
+		   NVMEV_PCI_BUS_NUM, NVMEV_PCI_SEC_BUS_NUM, NVMEV_PCI_SEC_BUS_NUM);
+	NVMEV_INFO("  Prefetchable memory window: 0x%lx - 0x%lx (64-bit)\n",
+		   base_pa + BAR0_OFFSET, base_pa + BAR4_OFFSET + 0x1000 - 1);
+
+	return 0;
+}
+#endif /* CONFIG_NVMEV_CXL_SUPPORT */
