+// SPDX-License-Identifier: GPL-2.0-only
+
+#ifndef _NVMEV_CXLSSD_FTL_H
+#define _NVMEV_CXLSSD_FTL_H
+
+#include <linux/types.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include "ssd.h"
+
+/* Forward declaration */
+struct nvmev_dev;
+
+#define CXL_FTL_MAX_CHANNELS 16
+
+/* CXL-specific SSD structure that reuses conv_ftl's SSD model */
+struct cxl_ssd {
+	struct ssd ssd;                   /* Embedded base SSD structure */
+
+	spinlock_t ch_locks[CXL_FTL_MAX_CHANNELS]; /* Per-channel locks */
+
+	/* Line-level erase geometry (computed in cxl_ftl_init) */
+	unsigned long hugepages_per_line;  /* Hugepages per NAND erase line */
+	unsigned long tt_lines;            /* Total number of lines */
+	unsigned long oneshotpgs_per_line; /* Oneshot pages per erase line */
+
+	/* Statistics (atomic — no lock needed) */
+	atomic64_t total_reads;
+	atomic64_t total_writes;
+	atomic64_t total_erases;
+	atomic64_t total_channel_conflicts;
+	atomic64_t total_die_conflicts;
+};
+
+/* CXL page request structure for batching */
+struct cxl_page_request {
+	unsigned long page_idx;
+	unsigned long long nsecs_start;
+	unsigned long long nsecs_completed;
+};
+
+/* Initialize CXL FTL with SSD model */
+struct cxl_ssd *cxl_ftl_init(unsigned int nr_channels,
+			      unsigned int dies_per_channel,
+			      struct nvmev_dev *nvmev_vdev);
+
+/* Calculate NAND access latency using ssd_advance_nand */
+unsigned long long cxl_ftl_calc_latency(struct cxl_ssd *cxl_ssd,
+					 unsigned long page_idx,
+					 bool is_write,
+					 size_t size,
+					 unsigned long long nsecs_start);
+
+/* Clean up FTL resources */
+void cxl_ftl_cleanup(struct cxl_ssd *cxl_ssd);
+
+/* Erase all NAND blocks in a line (one block per die, parallel erase) */
+unsigned long long cxl_ftl_erase_line(struct cxl_ssd *cxl_ssd,
+				      unsigned long line_id,
+				      unsigned long long nsecs_start);
+
+/* Reset busy times (useful for testing) */
+void cxl_ftl_reset_busy_times(struct cxl_ssd *cxl_ssd);
+
+#endif /* _NVMEV_CXLSSD_FTL_H */
