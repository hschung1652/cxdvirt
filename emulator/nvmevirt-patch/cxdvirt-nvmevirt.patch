diff --git a/cxl_hostbridge.asl b/cxl_hostbridge.asl
new file mode 100644
index 0000000..2d9d47b
--- /dev/null
+++ b/cxl_hostbridge.asl
@@ -0,0 +1,280 @@
+/*
+ * CXL Host Bridge SSDT for NVMeVirt
+ *
+ * This ACPI Source Language (ASL) file defines a CXL host bridge device
+ * that can be discovered by the Linux kernel's cxl_acpi driver.
+ *
+ * Compile with:
+ *   iasl -tc cxl_hostbridge.asl
+ *
+ * This generates cxl_hostbridge.hex with AML bytecode.
+ * Include the hex bytes in cxl_acpi_device.c for runtime injection.
+ *
+ * References:
+ *   - ACPI Specification 6.5
+ *   - CXL Specification 3.0
+ *   - Linux kernel: drivers/cxl/acpi.c
+ */
+
+DefinitionBlock ("cxl_hostbridge.aml", "SSDT", 2, "NVMEV", "CXLHB", 1)
+{
+    /*
+     * Scope: System Bus (_SB)
+     * All platform devices are defined under the system bus
+     *
+     * NOTE: ACPI0017 (CXLR) is defined in a SEPARATE SSDT (cxl_root.asl)
+     * to prevent race condition. See cxl_acpi_device.c for details.
+     */
+    Scope (\_SB)
+    {
+        /*
+         * Device: CXL Host Bridge (CXL0)
+         *
+         * This device represents a virtual CXL host bridge with:
+         *   - Hardware ID: ACPI0016 (CXL Host Bridge)
+         *   - Unique ID: 99 (matches CEDT CHBS entry)
+         *   - Bus range: 0xF0 (virtual PCI bus number)
+         *   - Component registers at base address (from CEDT)
+         */
+        Device (CXL0)
+        {
+            /*
+             * _HID: Hardware ID
+             * ACPI0016 = CXL Host Bridge
+             *
+             * The cxl_acpi driver searches for this HID:
+             * See: linux-6.18.5/drivers/cxl/acpi.c:531
+             *      if (strcmp(acpi_device_hid(adev), "ACPI0016") == 0)
+             */
+            Name (_HID, "ACPI0016")
+
+            /*
+             * _UID: Unique ID
+             * Must match the UID in CEDT CHBS entry (99)
+             *
+             * The cxl_acpi driver uses this to correlate the ACPI device
+             * with the CHBS entry in the CEDT table:
+             * See: linux-6.18.5/drivers/cxl/acpi.c:577
+             *      if (ctx->uid != chbs->uid)
+             */
+            Name (_UID, 99)
+
+            /*
+             * _STA: Device Status
+             * Return value indicates device state:
+             *   Bit 0 (0x01): Device is present
+             *   Bit 1 (0x02): Device is enabled and decoding resources
+             *   Bit 2 (0x04): Device should be shown in UI
+             *   Bit 3 (0x08): Device is functioning properly
+             *
+             * 0x0F = Present, enabled, visible, functioning
+             */
+            Method (_STA, 0, NotSerialized)
+            {
+                Return (0x0F)
+            }
+
+            /*
+             * _CRS: Current Resource Settings
+             *
+             * Defines the MMIO address ranges used by this host bridge.
+             * This includes:
+             *   1. Component register range (from CEDT CHBS base)
+             *   2. PCI configuration space range
+             *   3. Any additional MMIO ranges
+             *
+             * Note: The actual values here are placeholders.
+             * The real SSDT should be generated dynamically with correct
+             * addresses from nvmev_vdev->config.memmap_start
+             */
+            Method (_CRS, 0, Serialized)
+            {
+                Name (RBUF, ResourceTemplate ()
+                {
+                    /*
+                     * WordBusNumber: PCI bus number range
+                     *
+                     * This tells the kernel which bus numbers this host bridge owns.
+                     * Required to avoid "PCI host bridge to bus ... firmware bug: No bus range found" warning.
+                     *
+                     * VH Mode Bus Range:
+                     *   Bus 0x10 (16): PCIe Root Port (Type 1 bridge)
+                     *   Bus 0x11 (17): CXL Endpoint (Type 0)
+                     *
+                     * The root port at bus 16 bridges to bus 17 where the CXL endpoint resides.
+                     */
+                    WordBusNumber (ResourceProducer, MinFixed, MaxFixed, PosDecode,
+                        0x0000,             // Granularity
+                        0x0010,             // Min (bus 16 - root port)
+                        0x0011,             // Max (bus 17 - endpoint)
+                        0x0000,             // Translation
+                        0x0002,             // Length (2 buses)
+                        ,, )
+
+                    /*
+                     * QWordMemory: Component Registers (BAR0)
+                     *
+                     * VH Mode BAR Layout (after 2MB ECAM region):
+                     *   memmap_start + 0x200000: Component registers (64KB) - BAR0
+                     *   memmap_start + 0x210000: Device registers (64KB)    - BAR2
+                     *   memmap_start + 0x220000: MSI-X Table (4KB)          - BAR4
+                     *
+                     * Note: ECAM region is handled by _CBA, not QWordMemory.
+                     *
+                     * PLACEHOLDER: Replace 0x0000003040200000 with actual
+                     *              nvmev_vdev->config.memmap_start + 0x200000
+                     */
+                    /*
+                     * QWordMemory: Single 1MB window for all BARs
+                     *
+                     * PCI prefetchable bridge windows have 1MB MINIMUM granularity.
+                     * Must declare a single contiguous 1MB window - two separate
+                     * QWordMemory entries create separate resources that the kernel
+                     * cannot combine for bridge window allocation.
+                     *
+                     * Layout within this 1MB window:
+                     *   +0x000000: Component registers (64KB) - BAR0
+                     *   +0x010000: Device registers (64KB)    - BAR2
+                     *   +0x020000: MSI-X Table (4KB)          - BAR4
+                     *   +0x021000: Unused padding to 1MB boundary
+                     *
+                     * Use WriteCombining to mark as prefetchable (required for 64-bit).
+                     */
+                    QWordMemory (ResourceProducer, PosDecode, MinFixed, MaxFixed, WriteCombining, ReadWrite,
+                        0x0000000000000000,         // Granularity
+                        0x0000003040200000,         // Min - PLACEHOLDER: memmap_start + 0x200000
+                        0x00000030402FFFFF,         // Max - memmap_start + 0x300000 - 1 (1MB)
+                        0x0000000000000000,         // Translation Offset
+                        0x0000000000100000,         // Length (1MB)
+                        ,, , AddressRangeMemory, TypeStatic)
+                })
+                Return (RBUF)
+            }
+
+            /*
+             * _BBN: Base Bus Number
+             *
+             * Specifies the base PCI bus number for this host bridge.
+             * Our virtual PCI bus is on bus 0x10 (16) (NVMEV_PCI_BUS_NUM)
+             *
+             * See: nvmevirt_fullcxl/pci.h:#define NVMEV_PCI_BUS_NUM 0x10
+             */
+            Name (_BBN, 0x10)
+
+            /*
+             * _SEG: PCI Segment Number
+             *
+             * Specifies the PCI segment group number.
+             * Use segment 1 to avoid conflict with real PCI devices on segment 0
+             */
+            Name (_SEG, 1)
+
+            /*
+             * _CCA: Cache Coherency Attribute
+             *
+             * 1 = Device is cache coherent (required for CXL)
+             * 0 = Device is not cache coherent
+             *
+             * CXL devices are coherent with CPU caches
+             */
+            Name (_CCA, 1)
+
+            /*
+             * _CBA: Configuration Base Address (ECAM base)
+             *
+             * Returns the base address for PCI Enhanced Configuration Access
+             * Mechanism (ECAM). The kernel uses this to memory-map config space.
+             *
+             * ECAM address formula:
+             *   config_addr = ecam_base + (bus << 20) | (dev << 15) | (func << 12) | offset
+             *
+             * For bus 0x10 (16), the offset into ECAM is 16 << 20 = 0x01000000 (16MB)
+             * We set ECAM base so that bus 0x10's config space lands at memmap_start:
+             *   ecam_base = memmap_start - 0x01000000
+             *
+             * PLACEHOLDER: 0x0000002F40000000 will be patched at runtime
+             *              Actual value = nvmev_vdev->config.memmap_start - 0x01000000
+             */
+            Name (_CBA, 0x0000002F40000000)
+
+            /*
+             * _OSC: Operating System Capabilities
+             *
+             * Negotiates control of hardware features between OS and firmware.
+             * For PCI/CXL host bridges, this includes:
+             *   - PCIe native hot plug
+             *   - PCIe native power management
+             *   - PCIe advanced error reporting
+             *   - CXL-specific features
+             *
+             * This is a complex method. For now, we implement a minimal
+             * version that grants control to the OS.
+             */
+            Method (_OSC, 4, NotSerialized)
+            {
+                /*
+                 * Arguments:
+                 *   Arg0: UUID (Buffer) - Identifies capability
+                 *   Arg1: Revision (Integer)
+                 *   Arg2: Count (Integer) - Number of DWORDs in Arg3
+                 *   Arg3: Capabilities (Buffer) - Control bits
+                 *
+                 * Return: Updated capabilities buffer
+                 */
+
+                /* Create DWord fields for Arg3 buffer */
+                CreateDWordField (Arg3, 0, CDW1)
+                CreateDWordField (Arg3, 4, CDW2)
+                CreateDWordField (Arg3, 8, CDW3)
+
+                /*
+                 * CDW1: Status and Error Returns
+                 *   Bit 0: Query Flag (read-only)
+                 *   Bits 1-3: Always zero
+                 *   Bit 4: Capabilities masked (set if features unavailable)
+                 *
+                 * CDW2: Support (read-only)
+                 *   OS indicates which features it supports
+                 *
+                 * CDW3: Control
+                 *   Bits granted to OS:
+                 *   Bit 0: PCIe Native Hot Plug
+                 *   Bit 1: SHPC Native Hot Plug
+                 *   Bit 2: PCIe Native Power Management
+                 *   Bit 3: PCIe Advanced Error Reporting
+                 *   Bit 4: PCIe Capability Structure
+                 */
+
+                /* PCI Host Bridge Device UUID */
+                /* {33DB4D5B-1FF7-401C-9657-7441C03DD766} */
+                If (LEqual (Arg0, ToUUID ("33db4d5b-1ff7-401c-9657-7441c03dd766")))
+                {
+                    /* Grant all requested control bits to OS */
+                    /* For simplicity, just return what was requested */
+                    Return (Arg3)
+                }
+                Else
+                {
+                    /* Unknown UUID - Set "unrecognized UUID" bit */
+                    Or (CDW1, 4, CDW1)
+                    Return (Arg3)
+                }
+            }
+
+            /*
+             * Optional: _DSM (Device Specific Method)
+             *
+             * Could be used for CXL-specific functionality, but not
+             * strictly required for basic host bridge enumeration.
+             */
+
+            /*
+             * Optional: _PRT (PCI Routing Table)
+             *
+             * Defines interrupt routing for devices behind this bridge.
+             * Our virtual device uses MSI-X, so legacy interrupt routing
+             * is not critical. Omitted for simplicity.
+             */
+        }
+    }
+}
