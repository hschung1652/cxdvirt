diff --git a/cxl_acpi_device.c b/cxl_acpi_device.c
new file mode 100644
index 0000000..2dda372
--- /dev/null
+++ b/cxl_acpi_device.c
@@ -0,0 +1,734 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL ACPI Device Registration for NVMeVirt
+ *
+ * Strategy 1: SSDT Table Injection
+ *
+ * Creates an ACPI device by injecting a pre-compiled SSDT table that defines
+ * a CXL host bridge (HID: ACPI0016, UID: 99). The cxl_acpi driver will
+ * discover this device during bus enumeration.
+ */
+
+#include <linux/acpi.h>
+#include <acpi/acpi_bus.h>
+#include <linux/platform_device.h>
+#include <linux/pci.h>
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <linux/ioport.h>
+#include <linux/fs.h>
+
+#include "nvmev.h"
+#include "pci.h"
+#include "cxl.h"
+#include "cxl_hostbridge_aml.h"
+#include "cxl_root_aml.h"
+
+#define CXL_HOST_BRIDGE_UID 99
+
+/*
+ * AML bytecode offsets for runtime address patching
+ * AML size: 276 bytes (CXL0/ACPI0016 only, CXLR in separate SSDT)
+ *
+ * VH Mode Memory Layout:
+ *   memmap_start + 0x000000: Bus 16 ECAM (1MB) - Root Port config
+ *   memmap_start + 0x100000: Bus 17 ECAM (1MB) - CXL Endpoint config
+ *   memmap_start + 0x200000: 1MB BAR window
+ *     +0x000000: Component registers (64KB) - BAR0
+ *     +0x010000: Device registers (64KB)    - BAR2
+ *     +0x020000: MSI-X Table (4KB)          - BAR4
+ *
+ * These offsets are defined in cxl_hostbridge_aml.h and must match the
+ * compiled AML bytecode. Regenerate with: ./scripts/compile_ssdt.sh
+ */
+
+/* ECAM offset for bus 0x10 (16 << 20 = 16MB) */
+#define ECAM_BUS_OFFSET            0x01000000ULL
+
+/* VH Mode BAR offsets - must match pci.c layout (after 2MB ECAM for buses 16-17) */
+#define BAR0_OFFSET                0x200000ULL  /* After 2MB ECAM region */
+#define BAR2_OFFSET                0x210000ULL
+#define BAR4_OFFSET                0x220000ULL
+
+/* 2MB window: 1MB for endpoint BARs + 1MB for root port component registers */
+#define WINDOW_SIZE                0x200000ULL  /* 2MB */
+
+/**
+ * patch_aml_addresses - Patch placeholder addresses in AML bytecode
+ * @aml: Pointer to writable copy of AML bytecode
+ * @memmap_start: Actual base address from config.memmap_start
+ *
+ * Replaces placeholder addresses with actual runtime values.
+ * All addresses are stored in little-endian format in the AML.
+ *
+ * VH Mode Memory Layout (2MB ECAM for buses 16-17):
+ *   memmap_start + 0x000000: Bus 16 ECAM (1MB) - Root Port config
+ *   memmap_start + 0x100000: Bus 17 ECAM (1MB) - CXL Endpoint config
+ *   memmap_start + 0x200000: 1MB window for BARs (bridge granularity)
+ *     +0x000000: Component registers (64KB) - BAR0
+ *     +0x010000: Device registers (64KB)    - BAR2
+ *     +0x020000: MSI-X Table (4KB)          - BAR4
+ *     +0x021000: Padding to 1MB boundary
+ *
+ * ECAM base calculation:
+ *   The kernel reads config space at: ecam_base + (bus << 20) | (dev << 15) | ...
+ *   For bus 0x10: offset = 0x01000000
+ *   We want bus 16 config at memmap_start, so: ecam_base = memmap_start - 0x01000000
+ */
+static void patch_aml_addresses(unsigned char *aml, u64 memmap_start)
+{
+	u64 *cba_value;
+	u64 *window_base, *window_end;
+	u64 ecam_base;
+	u64 bar_window_start, bar_window_end;
+
+	/* Calculate ECAM base so bus 0x10 config space lands at memmap_start */
+	ecam_base = memmap_start - ECAM_BUS_OFFSET;
+
+	/* Calculate 1MB window for BARs (starts at BAR0_OFFSET) */
+	bar_window_start = memmap_start + BAR0_OFFSET;
+	bar_window_end = bar_window_start + WINDOW_SIZE - 1;  /* 1MB window */
+
+	/* Patch _CBA (ECAM base address) */
+	cba_value = (u64 *)(aml + AML_CBA_OFFSET);
+	*cba_value = cpu_to_le64(ecam_base);
+
+	/* Patch single 1MB memory window (covers all BARs) */
+	window_base = (u64 *)(aml + AML_WINDOW_BASE_OFFSET);
+	window_end  = (u64 *)(aml + AML_WINDOW_END_OFFSET);
+	*window_base = cpu_to_le64(bar_window_start);
+	*window_end  = cpu_to_le64(bar_window_end);
+
+	NVMEV_INFO("AML addresses patched for VH mode ECAM:\n");
+	NVMEV_INFO("  ECAM base (_CBA): 0x%016llx\n", ecam_base);
+	NVMEV_INFO("  Bus 16 config:    0x%016llx (root port)\n", memmap_start);
+	NVMEV_INFO("  Bus 17 config:    0x%016llx (endpoint)\n", memmap_start + 0x100000ULL);
+	NVMEV_INFO("  BAR window:       0x%016llx - 0x%016llx (2MB)\n",
+	           bar_window_start, bar_window_end);
+}
+
+/**
+ * recalculate_checksum - Recalculate ACPI table checksum
+ * @table: Pointer to ACPI table header
+ * @length: Length of the table in bytes
+ *
+ * ACPI tables include a checksum byte that ensures table integrity.
+ * After modifying the table (address patching), we must recalculate
+ * and update the checksum.
+ */
+static void recalculate_checksum(struct acpi_table_header *table)
+{
+	u8 checksum = 0;
+	u8 *ptr = (u8 *)table;
+	u32 i;
+
+	/* Zero out existing checksum */
+	table->checksum = 0;
+
+	/* Calculate sum of all bytes */
+	for (i = 0; i < table->length; i++) {
+		checksum += ptr[i];
+	}
+
+	/* Checksum is the value that makes the sum zero (mod 256) */
+	table->checksum = (u8)(256 - checksum);
+
+	NVMEV_DEBUG("ACPI checksum recalculated: 0x%02x\n", table->checksum);
+}
+
+/**
+ * nvmev_create_acpi_ssdt - Create ACPI device via SSDT injection
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * This function:
+ * 1. Copies pre-compiled AML bytecode to writable buffer
+ * 2. Patches placeholder addresses with actual memmap_start
+ * 3. Recalculates ACPI checksum
+ * 4. Loads SSDT into ACPI subsystem
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int nvmev_create_acpi_ssdt(struct nvmev_dev *nvmev_vdev)
+{
+	unsigned char *aml_copy;
+	struct acpi_table_header *table_header;
+	u32 table_index;
+	int rc;
+
+	NVMEV_INFO("Creating CXL host bridge via SSDT injection...\n");
+
+	/* Validate memmap_start is set */
+	if (nvmev_vdev->config.memmap_start == 0) {
+		NVMEV_ERROR("memmap_start is 0, cannot patch AML addresses\n");
+		return -EINVAL;
+	}
+
+	/* Allocate writable copy of AML bytecode */
+	aml_copy = kmalloc(CXL_HOSTBRIDGE_AML_SIZE, GFP_KERNEL);
+	if (!aml_copy) {
+		NVMEV_ERROR("Failed to allocate memory for AML copy\n");
+		return -ENOMEM;
+	}
+
+	/* Copy pre-compiled AML from header */
+	memcpy(aml_copy, cxl_hostbridge_aml, CXL_HOSTBRIDGE_AML_SIZE);
+
+	/* Patch MMIO addresses with actual memmap_start */
+	patch_aml_addresses(aml_copy, nvmev_vdev->config.memmap_start);
+
+	/* Recalculate ACPI checksum after patching */
+	table_header = (struct acpi_table_header *)aml_copy;
+	recalculate_checksum(table_header);
+
+	/* Load SSDT into ACPI subsystem */
+	rc = acpi_load_table(table_header, &table_index);
+	if (rc) {
+		NVMEV_ERROR("Failed to load SSDT table: %d\n", rc);
+		kfree(aml_copy);
+		return rc;
+	}
+
+	/*
+	 * ECAM approach: We WANT the ACPI PCI root driver to bind!
+	 *
+	 * The driver will:
+	 * 1. Parse _CBA to get ECAM base address
+	 * 2. Create a PCI bus with ECAM-based config space ops
+	 * 3. Read config space from: ecam_base + (bus << 20) | ...
+	 *
+	 * Since we set _CBA such that bus 0x10's config space lands at
+	 * memmap_start, and we've copied virtDev there, the kernel will
+	 * read our virtual device's config space!
+	 */
+	NVMEV_INFO("  ECAM approach: letting kernel create PCI bus via ACPI...\n");
+
+	/* Store for cleanup */
+	nvmev_vdev->cxl_ssdt_index = table_index;
+	nvmev_vdev->cxl_ssdt_buffer = aml_copy;
+
+	NVMEV_INFO("✓ SSDT loaded successfully (index %u)\n", table_index);
+	NVMEV_INFO("  CXL host bridge device: \\_SB.CXL0\n");
+	NVMEV_INFO("  HID: ACPI0016, UID: %d\n", CXL_HOST_BRIDGE_UID);
+
+	return 0;
+}
+
+/**
+ * nvmev_trigger_cxl_acpi_rescan - Trigger cxl_acpi driver to rescan devices
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * After loading the SSDT, the cxl_acpi driver needs to rescan the ACPI bus
+ * to discover the new host bridge device. This function triggers a rescan
+ * by unbinding and rebinding the cxl_acpi driver.
+ *
+ * Note: This is only needed if cxl_acpi is already loaded when we inject
+ * the SSDT. If cxl_acpi loads after SSDT injection, it will automatically
+ * discover the device during its initial probe.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_trigger_cxl_acpi_rescan(struct nvmev_dev *nvmev_vdev)
+{
+	struct device *cxl_acpi_dev;
+	int ret;
+
+	NVMEV_INFO("Triggering cxl_acpi rescan...\n");
+
+	/* Find the cxl_acpi platform device (ACPI0017:00) */
+	cxl_acpi_dev = bus_find_device_by_name(&platform_bus_type, NULL, "ACPI0017:00");
+	if (!cxl_acpi_dev) {
+		NVMEV_INFO("cxl_acpi device not found - driver may not be loaded yet\n");
+		NVMEV_INFO("If cxl_acpi is loaded later, it will auto-discover the device\n");
+		return 0;  /* Not an error, just not loaded yet */
+	}
+
+	if (!cxl_acpi_dev->driver) {
+		NVMEV_INFO("cxl_acpi driver not bound to device\n");
+		put_device(cxl_acpi_dev);
+		return 0;  /* Not an error, driver will bind later */
+	}
+
+	NVMEV_INFO("Found cxl_acpi device: %s\n", dev_name(cxl_acpi_dev));
+	NVMEV_INFO("Unbinding cxl_acpi driver to trigger rescan...\n");
+
+	/* Unbind driver */
+	device_release_driver(cxl_acpi_dev);
+
+	/* Wait for cleanup */
+	msleep(100);
+
+	NVMEV_INFO("Rebinding cxl_acpi driver...\n");
+
+	/* Rebind - this triggers probe which does bus_for_each_dev() */
+	ret = device_attach(cxl_acpi_dev);
+	if (ret < 0) {
+		NVMEV_ERROR("Failed to rebind cxl_acpi driver: %d\n", ret);
+		put_device(cxl_acpi_dev);
+		return ret;
+	}
+
+	put_device(cxl_acpi_dev);
+
+	NVMEV_INFO("✓ cxl_acpi driver reprobed successfully\n");
+	NVMEV_INFO("  Check dmesg for \"Found CXL host bridge UID %d\"\n",
+	           CXL_HOST_BRIDGE_UID);
+
+	return 0;
+}
+
+/**
+ * nvmev_scan_cxl_root - Phase 2: Load CXLR SSDT and scan ACPI0017
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * This is Phase 2 of the split-SSDT approach. It must be called AFTER the
+ * PCI bus for ACPI0016 (CXL0) is fully created and verified.
+ *
+ * Why a separate SSDT?
+ *   acpi_load_table() schedules an async acpi_table_events_fn on a kernel
+ *   workqueue that does acpi_bus_scan(ACPI_ROOT_OBJECT), scanning ALL
+ *   namespace objects. If ACPI0017 exists when ACPI0016's SSDT is loaded,
+ *   cxl_acpi probes before the PCI bus is ready → NULL deref crash.
+ *
+ *   By loading ACPI0017 in a separate SSDT here (after PCI bus is ready),
+ *   the async scan from Phase 1 cannot find CXLR (it doesn't exist yet),
+ *   and the async scan from this Phase 2 load finds CXLR but the PCI bus
+ *   is already created.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_scan_cxl_root(struct nvmev_dev *nvmev_vdev)
+{
+	unsigned char *aml_copy;
+	struct acpi_table_header *table_header;
+	u32 table_index;
+	int rc;
+
+	NVMEV_INFO("Phase 2: Loading CXLR (ACPI0017) SSDT...\n");
+
+	/* Allocate writable copy of CXLR AML bytecode */
+	aml_copy = kmalloc(CXL_ROOT_AML_SIZE, GFP_KERNEL);
+	if (!aml_copy) {
+		NVMEV_ERROR("Failed to allocate memory for CXLR AML\n");
+		return -ENOMEM;
+	}
+
+	memcpy(aml_copy, cxl_root_aml, CXL_ROOT_AML_SIZE);
+
+	/* No address patching needed — CXLR has no MMIO resources */
+
+	/* Recalculate checksum (not strictly needed since we didn't patch, but safe) */
+	table_header = (struct acpi_table_header *)aml_copy;
+	recalculate_checksum(table_header);
+
+	/* Load CXLR SSDT into ACPI subsystem */
+	rc = acpi_load_table(table_header, &table_index);
+	if (rc) {
+		NVMEV_ERROR("Failed to load CXLR SSDT: %d\n", rc);
+		kfree(aml_copy);
+		return rc;
+	}
+
+	/* Store for cleanup */
+	nvmev_vdev->cxl_root_ssdt_index = table_index;
+	nvmev_vdev->cxl_root_ssdt_buffer = aml_copy;
+
+	NVMEV_INFO("✓ CXLR SSDT loaded (index %u)\n", table_index);
+
+	/*
+	 * acpi_load_table() schedules acpi_table_events_fn which will
+	 * asynchronously scan and find CXLR, triggering cxl_acpi probe.
+	 * The PCI bus is ready at this point, so the probe will succeed.
+	 */
+	NVMEV_INFO("  Waiting for async CXLR scan and cxl_acpi probe...\n");
+	msleep(500);
+
+	NVMEV_INFO("✓ CXLR scan completed - cxl_acpi can now discover host bridges\n");
+	return 0;
+}
+
+/**
+ * nvmev_register_acpi_pci_root - Register virtual PCI bus as ACPI PCI root
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Creates the critical linkage between ACPI0016 device and our virtual PCI bus.
+ * This enables acpi_pci_find_root() to succeed, which is required for CXL
+ * port enumeration.
+ *
+ * Key linkages established:
+ * 1. ACPI device -> acpi_pci_root (via driver_data)
+ * 2. acpi_pci_root -> virtual PCI bus
+ * 3. PCI bus -> ACPI device (via bus->bridge)
+ *
+ * In ECAM mode, the kernel creates the PCI bus, so we get the bridge device
+ * from pdev->bus->dev.parent instead of virt_bridge.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_register_acpi_pci_root(struct nvmev_dev *nvmev_vdev)
+{
+	struct acpi_device *acpi_dev = NULL;
+	struct acpi_pci_root *root;
+	struct device *bridge_dev;
+	acpi_handle handle;
+	acpi_status status;
+	int ret;
+
+	NVMEV_INFO("Linking virtual PCI bus to kernel-created ACPI PCI root...\n");
+
+	/* Find ACPI0016 device using the device path from SSDT: \_SB.CXL0 */
+	status = acpi_get_handle(NULL, "\\_SB.CXL0", &handle);
+	if (ACPI_FAILURE(status)) {
+		NVMEV_ERROR("Failed to get ACPI handle for \\_SB.CXL0: %d\n", status);
+		return -ENODEV;
+	}
+
+	NVMEV_INFO("  Found ACPI handle for \\_SB.CXL0\n");
+
+	/* Get the acpi_device structure from the handle */
+	acpi_dev = acpi_fetch_acpi_dev(handle);
+	if (!acpi_dev) {
+		NVMEV_ERROR("Failed to get acpi_device for \\_SB.CXL0\n");
+		return -ENODEV;
+	}
+
+	NVMEV_INFO("  Found ACPI device: %s (HID: %s, UID: %s)\n",
+	           acpi_device_bid(acpi_dev),
+	           acpi_device_hid(acpi_dev) ? acpi_device_hid(acpi_dev) : "none",
+	           acpi_device_uid(acpi_dev) ? acpi_device_uid(acpi_dev) : "none");
+
+	/* Check if kernel's ACPI PCI root driver already created a root */
+	root = acpi_pci_find_root(acpi_dev->handle);
+	if (!root) {
+		NVMEV_ERROR("Kernel did not create acpi_pci_root for ACPI0016 device\n");
+		NVMEV_ERROR("This should not happen with the kernel patch applied\n");
+		return -ENODEV;
+	}
+
+	NVMEV_INFO("  ✓ Kernel created acpi_pci_root: segment=%d, bus=0x%02x\n",
+	           root->segment, (unsigned int)root->secondary.start);
+
+	/*
+	 * Get the bridge device - this is "pci0001:10" (the host bridge device).
+	 * This is where the dport will be registered by cxl_acpi.
+	 * In ECAM mode, pdev->dev.parent is the host bridge device.
+	 */
+	if (nvmev_vdev->virt_bridge) {
+		/* Non-ECAM mode: we created the bus */
+		bridge_dev = nvmev_vdev->virt_bridge;
+		NVMEV_INFO("  Using virt_bridge (non-ECAM mode)\n");
+	} else if (nvmev_vdev->pdev && nvmev_vdev->pdev->dev.parent) {
+		/* ECAM mode: kernel created the bus, host bridge is pdev's parent.
+		 * Do NOT set virt_bus here — virt_bus is only for buses NVMeVirt
+		 * created itself. The kernel-owned bus is torn down when the SSDT
+		 * is unloaded in nvmev_destroy_acpi_device(). */
+		bridge_dev = nvmev_vdev->pdev->dev.parent;
+		NVMEV_INFO("  Using pdev->dev.parent (ECAM mode)\n");
+		nvmev_vdev->virt_bridge = bridge_dev;
+	} else {
+		NVMEV_ERROR("No bridge device available (virt_bridge=NULL, pdev=NULL)\n");
+		return -ENODEV;
+	}
+
+	if (!bridge_dev) {
+		NVMEV_ERROR("Bridge device is NULL\n");
+		return -ENODEV;
+	}
+
+	NVMEV_INFO("  Found bridge device: %s (current parent: %s)\n",
+	           dev_name(bridge_dev),
+	           bridge_dev->parent ? dev_name(bridge_dev->parent) : "NULL");
+
+	/*
+	 * Critical: Set up the parent chain for CXL port enumeration.
+	 *
+	 * The CXL port enumeration walk (devm_cxl_enumerate_ports) traverses
+	 * up the device tree using dev->parent to find the CXL root port.
+	 * root0 is registered with ACPI0017's device as key in cxl_port_xarray.
+	 *
+	 * For the walk to succeed:
+	 *   pci0001:10 -> parent -> ... -> ACPI0017 device -> find root0
+	 *
+	 * In our SSDT, ACPI0016 and ACPI0017 are siblings under \_SB, not
+	 * parent-child. So we set pci0001:10->parent directly to ACPI0017
+	 * to create the path the walk needs.
+	 */
+	if (!bridge_dev->parent) {
+		struct acpi_device *acpi0017_dev = NULL;
+		struct device *platform_dev = NULL;
+		acpi_handle acpi0017_handle;
+		acpi_status status;
+
+		/* Find ACPI0017 (CXL root) device - this is where root0 is registered */
+		status = acpi_get_handle(NULL, "\\_SB.CXLR", &acpi0017_handle);
+		if (ACPI_SUCCESS(status)) {
+			acpi0017_dev = acpi_fetch_acpi_dev(acpi0017_handle);
+		}
+
+		if (acpi0017_dev) {
+			/*
+			 * Critical: root0's uport_dev is the PLATFORM device for ACPI0017,
+			 * not the ACPI device itself. cxl_acpi creates root0 with:
+			 *   devm_cxl_add_root(&pdev->dev, ...) where pdev is platform_device
+			 * The xarray lookup needs the exact same device pointer.
+			 * Use acpi_dev_get_first_physical_node() to get the platform device.
+			 */
+			platform_dev = acpi_get_first_physical_node(acpi0017_dev);
+			if (platform_dev) {
+				NVMEV_INFO("  Setting bridge parent to platform device for ACPI0017\n");
+				bridge_dev->parent = platform_dev;
+				NVMEV_INFO("    %s -> %s (platform device)\n",
+				           dev_name(bridge_dev), dev_name(platform_dev));
+			} else {
+				/* Fallback to acpi_device if no platform device */
+				NVMEV_INFO("  No platform device, using ACPI device for ACPI0017\n");
+				bridge_dev->parent = &acpi0017_dev->dev;
+				NVMEV_INFO("    %s -> %s (ACPI device)\n",
+				           dev_name(bridge_dev), dev_name(&acpi0017_dev->dev));
+			}
+		} else {
+			/* Fallback to ACPI0016 */
+			NVMEV_INFO("  Setting bridge parent to ACPI0016 (ACPI0017 not found)\n");
+			bridge_dev->parent = &acpi_dev->dev;
+		}
+	}
+
+	/*
+	 * Critical: Set the ACPI companion for the bridge device.
+	 * This creates the firmware_node symlink (pci0001:10/firmware_node -> ACPI0016:00)
+	 * that the enumeration code needs to connect the device tree to the CXL port tree.
+	 * Real PCI host bridges have this link created during ACPI PCI root driver probe.
+	 */
+	ACPI_COMPANION_SET(bridge_dev, acpi_dev);
+	NVMEV_INFO("  ✓ Set ACPI companion for bridge device\n");
+	NVMEV_INFO("    firmware_node: %s -> %s\n",
+	           dev_name(bridge_dev), dev_name(&acpi_dev->dev));
+
+	/* Store root for cleanup (but don't free it - kernel owns it) */
+	nvmev_vdev->cxl_acpi_pci_root = root;
+
+	/* Verify the linkage */
+	{
+		struct acpi_pci_root *test_root = acpi_pci_find_root(acpi_dev->handle);
+		struct pci_bus *expected_bus = nvmev_vdev->virt_bus ? nvmev_vdev->virt_bus :
+		                               (nvmev_vdev->pdev ? nvmev_vdev->pdev->bus : NULL);
+		if (test_root && expected_bus && test_root->bus == expected_bus) {
+			NVMEV_INFO("✓ Verification: acpi_pci_find_root() returns correct bus!\n");
+			NVMEV_INFO("  Root: segment=%d, bus=%s\n",
+			           test_root->segment, dev_name(&test_root->bus->dev));
+		} else if (test_root) {
+			NVMEV_INFO("  acpi_pci_root bus: %s\n",
+			           test_root->bus ? dev_name(&test_root->bus->dev) : "NULL");
+		} else {
+			NVMEV_ERROR("✗ acpi_pci_find_root() returned NULL\n");
+		}
+	}
+
+	NVMEV_INFO("✓ ACPI-PCI linkage established for CXL port enumeration\n");
+	NVMEV_INFO("  Segment: %d, Bus: 0x%02x\n",
+	           root->segment, (unsigned int)root->secondary.start);
+	NVMEV_INFO("  ACPI device: %s, Bridge device: %s\n",
+	           dev_name(&acpi_dev->dev), dev_name(bridge_dev));
+
+	return 0;
+}
+
+/**
+ * nvmev_verify_acpi_device - Verify SSDT was loaded and device is visible
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Debug function to check if the ACPI device was created correctly.
+ *
+ * Returns: 0 if verification passes, negative error code otherwise
+ */
+static int nvmev_verify_acpi_device(struct nvmev_dev *nvmev_vdev)
+{
+	struct file *fp;
+	char ssdt_path[64];
+	int i;
+
+	NVMEV_INFO("Verifying SSDT injection...\n");
+
+	/* Check if SSDT table is visible in sysfs */
+	for (i = 1; i <= 20; i++) {  /* Check SSDT1 through SSDT20 */
+		snprintf(ssdt_path, sizeof(ssdt_path),
+		         "/sys/firmware/acpi/tables/SSDT%d", i);
+		fp = filp_open(ssdt_path, O_RDONLY, 0);
+		if (!IS_ERR(fp)) {
+			/* Found an SSDT, but can't easily verify it's ours without reading */
+			filp_close(fp, NULL);
+		}
+	}
+
+	/* The main SSDT file should also exist */
+	fp = filp_open("/sys/firmware/acpi/tables/SSDT", O_RDONLY, 0);
+	if (IS_ERR(fp)) {
+		NVMEV_ERROR("SSDT table not found in /sys/firmware/acpi/tables/\n");
+		return -ENOENT;
+	}
+	filp_close(fp, NULL);
+
+	NVMEV_INFO("✓ SSDT table found in sysfs\n");
+
+	/* Additional verification would require parsing ACPI device tree */
+	NVMEV_INFO("Manual verification:\n");
+	NVMEV_INFO("  1. Check: ls -la /sys/firmware/acpi/tables/SSDT*\n");
+	NVMEV_INFO("  2. Check: find /sys/devices/LNXSYSTM:00/ -name '*CXL*'\n");
+	NVMEV_INFO("  3. Check: dmesg | grep -i 'cxl.*uid.*99'\n");
+	NVMEV_INFO("  4. Check: ls /sys/bus/cxl/devices/\n");
+
+	return 0;
+}
+
+/**
+ * nvmev_create_acpi_device - Create ACPI device for virtual CXL host bridge
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Main entry point for ACPI device creation (ECAM mode). This function:
+ * 1. Validates prerequisites (CEDT injected, config space copied to ECAM)
+ * 2. Injects SSDT table with CXL host bridge definition
+ * 3. Triggers ACPI bus scan to enumerate the new device
+ *
+ * With ECAM mode:
+ * - We do NOT create our own PCI bus (virt_bus is NULL)
+ * - The kernel's ACPI PCI root driver creates the bus when it binds to ACPI0016
+ * - The kernel reads config space via ECAM (memory-mapped at our memmap_start)
+ * - After this function, caller should use nvmev_wait_for_kernel_pdev() to
+ *   find the kernel-created pci_dev
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_create_acpi_device(struct nvmev_dev *nvmev_vdev)
+{
+	int ret;
+	acpi_handle cxl0_handle;
+	acpi_status status;
+
+	NVMEV_INFO("=== ACPI Device Registration (ECAM mode) ===\n");
+
+	/* Validation: Ensure CEDT has been injected first */
+	if (nvmev_vdev->cxl_cedt_index <= 0) {
+		NVMEV_ERROR("CEDT table not injected\n");
+		NVMEV_ERROR("Call nvmev_inject_cedt() before creating ACPI device\n");
+		return -EINVAL;
+	}
+
+	/* Validation: Ensure config space has been copied to ECAM region */
+	if (!nvmev_vdev->ecam_config_region) {
+		NVMEV_ERROR("Config space not copied to ECAM region\n");
+		NVMEV_ERROR("Call nvmev_copy_config_to_ecam() before creating ACPI device\n");
+		return -EINVAL;
+	}
+
+	NVMEV_INFO("Prerequisites validated:\n");
+	NVMEV_INFO("  ✓ CEDT table injected (index %d)\n", nvmev_vdev->cxl_cedt_index);
+	NVMEV_INFO("  ✓ Config space at ECAM region: 0x%llx\n",
+	           (u64)nvmev_vdev->config.memmap_start);
+	NVMEV_INFO("  ✓ ECAM base (for bus 0x%x): 0x%llx\n",
+	           NVMEV_PCI_BUS_NUM,
+	           (u64)nvmev_vdev->config.memmap_start - ECAM_BUS_OFFSET);
+
+	/* Step 1: Inject SSDT table */
+	ret = nvmev_create_acpi_ssdt(nvmev_vdev);
+	if (ret) {
+		NVMEV_ERROR("SSDT injection failed: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * Split-SSDT approach to prevent race with cxl_acpi:
+	 *
+	 * acpi_load_table() schedules acpi_table_events_fn on a kernel workqueue
+	 * that calls acpi_bus_scan(ACPI_ROOT_OBJECT), scanning ALL namespace
+	 * objects asynchronously. If ACPI0017 (CXLR) were in the same SSDT as
+	 * ACPI0016 (CXL0), the async scan would find both, and cxl_acpi_probe
+	 * could run before acpi_pci_root_add finishes creating the PCI bus,
+	 * causing a NULL deref in add_host_bridge_dport.
+	 *
+	 * Solution: Two separate SSDTs loaded at different times:
+	 *   Phase 1 (here): Load CXL0-only SSDT. The async scan only finds
+	 *     ACPI0016, triggering acpi_pci_root_add to create the PCI bus.
+	 *     CXLR doesn't exist in ACPI namespace yet.
+	 *   Phase 2 (nvmev_scan_cxl_root, called later): Load CXLR-only SSDT
+	 *     after PCI bus is confirmed ready. The async scan finds CXLR,
+	 *     cxl_acpi probes, and the PCI bus is already there.
+	 */
+	NVMEV_INFO("Phase 1: Loading CXL0 (ACPI0016) host bridge SSDT...\n");
+
+	status = acpi_get_handle(NULL, "\\_SB.CXL0", &cxl0_handle);
+	if (ACPI_FAILURE(status)) {
+		NVMEV_ERROR("Failed to get \\_SB.CXL0 handle: %d\n", status);
+		return -ENODEV;
+	}
+
+	ret = acpi_bus_scan(cxl0_handle);
+	if (ret) {
+		NVMEV_ERROR("acpi_bus_scan(CXL0) failed: %d\n", ret);
+		NVMEV_ERROR("Kernel may not enumerate PCI devices\n");
+	} else {
+		NVMEV_INFO("  ✓ CXL0 scan completed - PCI bus created\n");
+	}
+
+	/* Small delay to let kernel complete async PCI enumeration */
+	NVMEV_INFO("Waiting for kernel PCI enumeration...\n");
+	msleep(200);
+
+	NVMEV_INFO("=== ACPI Device Registration Complete ===\n");
+	NVMEV_INFO("Kernel should now enumerate PCI bus 0x%x via ECAM\n", NVMEV_PCI_BUS_NUM);
+	NVMEV_INFO("Use nvmev_wait_for_kernel_pdev() to find the pci_dev\n");
+
+	return 0;
+}
+
+/**
+ * nvmev_destroy_acpi_device - Clean up ACPI device registration
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Unloads the SSDT table and frees allocated resources.
+ */
+void nvmev_destroy_acpi_device(struct nvmev_dev *nvmev_vdev)
+{
+	if (!nvmev_vdev)
+		return;
+
+	NVMEV_INFO("Cleaning up ACPI device registration...\n");
+
+	/* Clean up ACPI PCI root linkage */
+	if (nvmev_vdev->cxl_acpi_pci_root) {
+		struct acpi_pci_root *root = nvmev_vdev->cxl_acpi_pci_root;
+
+		/* Restore the kernel's original bus pointer if we modified it */
+		/* Note: We don't free the root structure - kernel owns it */
+
+		nvmev_vdev->cxl_acpi_pci_root = NULL;
+		NVMEV_DEBUG("ACPI PCI root linkage cleaned up\n");
+	}
+
+	/* Unload CXLR SSDT first (reverse order of loading) */
+	if (nvmev_vdev->cxl_root_ssdt_index > 0) {
+		acpi_unload_table(nvmev_vdev->cxl_root_ssdt_index);
+		nvmev_vdev->cxl_root_ssdt_index = -1;
+		NVMEV_DEBUG("CXLR SSDT table unloaded\n");
+	}
+
+	if (nvmev_vdev->cxl_root_ssdt_buffer) {
+		kfree(nvmev_vdev->cxl_root_ssdt_buffer);
+		nvmev_vdev->cxl_root_ssdt_buffer = NULL;
+		NVMEV_DEBUG("CXLR AML buffer freed\n");
+	}
+
+	/* Unload CXL0 SSDT */
+	if (nvmev_vdev->cxl_ssdt_index > 0) {
+		acpi_unload_table(nvmev_vdev->cxl_ssdt_index);
+		nvmev_vdev->cxl_ssdt_index = -1;
+		NVMEV_DEBUG("CXL0 SSDT table unloaded\n");
+	}
+
+	if (nvmev_vdev->cxl_ssdt_buffer) {
+		kfree(nvmev_vdev->cxl_ssdt_buffer);
+		nvmev_vdev->cxl_ssdt_buffer = NULL;
+		NVMEV_DEBUG("CXL0 AML buffer freed\n");
+	}
+
+	NVMEV_INFO("ACPI device cleanup complete\n");
+}
diff --git a/cxl_acpi_inject.c b/cxl_acpi_inject.c
new file mode 100644
index 0000000..41e455d
--- /dev/null
+++ b/cxl_acpi_inject.c
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL ACPI Table Injector for NVMeVirt
+ *
+ * Builds and loads CEDT (CXL Early Discovery Table) at runtime to make
+ * the CXL-SSD device discoverable by the OS CXL subsystem.
+ *
+ * Based on:
+ * - CylonFEMU's CEDT generation (hw/acpi/cxl.c)
+ * - Linux kernel test mock (tools/testing/cxl/test/cxl.c)
+ */
+
+#include <linux/acpi.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+
+#include "nvmev.h"
+#include "cxl.h"
+
+#define CXL_HOST_BRIDGE_UID 99  /* Unique ID for virtual CXL host bridge in CEDT */
+
+/**
+ * CEDT Table Structure for NVMeVirt CXL-SSD
+ *
+ * Simplified single-device CEDT with:
+ * - One CHBS (CXL Host Bridge Structure) entry
+ * - One CFMWS (CXL Fixed Memory Window Structure) entry
+ */
+struct nvmev_cedt_table {
+	struct acpi_table_cedt cedt;
+	struct acpi_cedt_chbs chbs;  /* CXL Host Bridge Structure */
+	struct {
+		struct acpi_cedt_cfmws cfmws;
+		u32 target[1];  /* Single target: our host bridge */
+	} cfmws;
+} __packed;
+
+static struct nvmev_cedt_table *cedt_table = NULL;
+
+/**
+ * nvmev_build_cedt - Build CEDT table for NVMeVirt CXL-SSD
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Constructs a complete CEDT table in memory following ACPI CXL 2.0 spec.
+ * The table declares:
+ * - Virtual CXL host bridge (UID 99)
+ * - Fixed memory window covering the CXL-SSD storage area
+ * - Single-way interleave (no interleaving)
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int nvmev_build_cedt(struct nvmev_dev *nvmev_vdev)
+{
+	struct nvmev_cedt_table *tbl;
+	resource_size_t base_hpa = nvmev_vdev->config.storage_start;
+	resource_size_t size = nvmev_vdev->config.storage_size;
+	u8 checksum;
+
+	/* Validate CFMWS requirements */
+	if (base_hpa == 0 || size == 0) {
+		NVMEV_ERROR("CEDT: Invalid storage config - base=0x%llx size=0x%llx\n",
+			    (u64)base_hpa, (u64)size);
+		return -EINVAL;
+	}
+
+	/* CFMWS requires 256MB alignment */
+	if (((u64)base_hpa & (SZ_256M - 1)) != 0) {
+		NVMEV_ERROR("CEDT: base_hpa 0x%llx not 256MB aligned\n", (u64)base_hpa);
+		return -EINVAL;
+	}
+	if (((u64)size & (SZ_256M - 1)) != 0) {
+		NVMEV_ERROR("CEDT: size 0x%llx not 256MB aligned\n", (u64)size);
+		return -EINVAL;
+	}
+
+	NVMEV_INFO("CEDT CFMWS: base_hpa=0x%llx size=%llu MB (%llu GB)\n",
+		   (u64)base_hpa, (u64)size >> 20, (u64)size >> 30);
+
+	tbl = kzalloc(sizeof(*tbl), GFP_KERNEL);
+	if (!tbl)
+		return -ENOMEM;
+
+	/* ===== CEDT Table Header ===== */
+	memcpy(tbl->cedt.header.signature, ACPI_SIG_CEDT, 4);
+	tbl->cedt.header.length = sizeof(*tbl);
+	tbl->cedt.header.revision = 1;
+	memcpy(tbl->cedt.header.oem_id, "NVMEV ", ACPI_OEM_ID_SIZE);
+	memcpy(tbl->cedt.header.oem_table_id, "CXLSSD  ", ACPI_OEM_TABLE_ID_SIZE);
+	tbl->cedt.header.oem_revision = 1;
+	memcpy(tbl->cedt.header.asl_compiler_id, "NVMV", 4);
+	tbl->cedt.header.asl_compiler_revision = 1;
+
+	/* ===== CHBS: CXL Host Bridge Structure ===== */
+	tbl->chbs.header.type = ACPI_CEDT_TYPE_CHBS;
+	tbl->chbs.header.length = sizeof(tbl->chbs);
+	tbl->chbs.uid = CXL_HOST_BRIDGE_UID;  /* Must match platform device registration */
+	tbl->chbs.cxl_version = ACPI_CEDT_CHBS_VERSION_CXL20;
+	/*
+	 * CHBS base points to host bridge's component registers (RCRB).
+	 * In VH mode, this can share the root port's component register space.
+	 * Use 0x300000 offset (RP_COMP_OFFSET) where root port registers are.
+	 * Previously pointed to 0x200000 (endpoint's BAR0) which caused conflicts.
+	 */
+	tbl->chbs.base = nvmev_vdev->config.memmap_start + 0x300000;  /* Root port component regs */
+	tbl->chbs.length = ACPI_CEDT_CHBS_LENGTH_CXL20;	
+
+	/* ===== CFMWS: CXL Fixed Memory Window Structure ===== */
+	tbl->cfmws.cfmws.header.type = ACPI_CEDT_TYPE_CFMWS;
+	tbl->cfmws.cfmws.header.length = sizeof(tbl->cfmws);
+
+	/* Memory window configuration */
+	tbl->cfmws.cfmws.base_hpa = base_hpa;  /* Base host physical address */
+	tbl->cfmws.cfmws.window_size = size;
+
+	/* Interleave configuration: 1-way (no interleaving) */
+	tbl->cfmws.cfmws.interleave_ways = 0;  /* Encoded: 2^0 = 1 way */
+	tbl->cfmws.cfmws.granularity = 0;  /* 256 bytes (minimum) */
+	tbl->cfmws.cfmws.interleave_arithmetic = ACPI_CEDT_CFMWS_ARITHMETIC_MODULO;
+
+	/* Memory type restrictions - Type 2/3 volatile memory */
+	tbl->cfmws.cfmws.restrictions = ACPI_CEDT_CFMWS_RESTRICT_DEVMEM |       /* Type 2 */
+	                                 ACPI_CEDT_CFMWS_RESTRICT_HOSTONLYMEM |  /* Type 3 */
+	                                 ACPI_CEDT_CFMWS_RESTRICT_VOLATILE;      /* Volatile/RAM */
+
+	/* QoS Throttling Group ID */
+	tbl->cfmws.cfmws.qtg_id = 0;
+
+	/* Target list: single entry pointing to our CHBS */
+	tbl->cfmws.target[0] = CXL_HOST_BRIDGE_UID;
+
+	/* ===== Calculate ACPI Checksum ===== */
+	tbl->cedt.header.checksum = 0;
+	checksum = 0;
+	size_t i;
+	for (i = 0; i < sizeof(*tbl); i++) {
+		checksum += ((u8 *)tbl)[i];
+	}
+	tbl->cedt.header.checksum = (u8)(256 - checksum);
+
+	cedt_table = tbl;
+
+	NVMEV_INFO("Built CEDT table: base=0x%llx size=%llu MB uid=%d\n",
+	           (u64)base_hpa, (u64)size >> 20, CXL_HOST_BRIDGE_UID);
+
+	return 0;
+}
+
+/**
+ * nvmev_inject_cedt - Inject CEDT table into ACPI subsystem
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Loads the constructed CEDT table using acpi_load_table().
+ * Requires Patch 1.1 to accept CEDT signatures in configfs.
+ *
+ * Must be called BEFORE cxl_acpi driver probes to ensure the table
+ * is available during CXL topology enumeration.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_inject_cedt(struct nvmev_dev *nvmev_vdev)
+{
+	u32 table_index;
+	int rc;
+
+	/* Initialize ACPI table indices */
+	nvmev_vdev->cxl_cedt_index = -1;
+	nvmev_vdev->cxl_ssdt_index = -1;
+	nvmev_vdev->cxl_ssdt_buffer = NULL;
+	nvmev_vdev->cxl_root_ssdt_index = -1;
+	nvmev_vdev->cxl_root_ssdt_buffer = NULL;
+	nvmev_vdev->cxl_acpi_pci_root = NULL;
+	//nvmev_vdev->virt_bridge = NULL;
+
+	/* Build CEDT table in memory */
+	rc = nvmev_build_cedt(nvmev_vdev);
+	if (rc)
+		return rc;
+
+	/* Load table into ACPI subsystem */
+	rc = acpi_load_table(&cedt_table->cedt.header, &table_index);
+	if (rc) {
+		NVMEV_ERROR("Failed to load CEDT table: %d\n", rc);
+		NVMEV_ERROR("Ensure Patch 1.1 is applied to allow CEDT loading\n");
+		return rc;
+	}
+
+	nvmev_vdev->cxl_cedt_index = table_index;
+
+	NVMEV_INFO("CEDT table loaded successfully (ACPI index %u)\n", table_index);
+	NVMEV_INFO("Table should be visible at /sys/firmware/acpi/tables/CEDT\n");
+
+	/* ===== Verify CEDT is accessible via acpi_get_table ===== */
+	{
+		struct acpi_table_header *verify_hdr = NULL;
+		acpi_status status;
+		u8 *raw;
+		unsigned long offset, tbl_end;
+
+		NVMEV_INFO("CEDT verify: cedt_table=%px sizeof=%zu\n",
+			   cedt_table, sizeof(*cedt_table));
+
+		/* Dump CHBS fields as written */
+		NVMEV_INFO("CEDT verify: CHBS fields in memory:\n");
+		NVMEV_INFO("  header.type=%u header.reserved=%u header.length=%u\n",
+			   cedt_table->chbs.header.type,
+			   cedt_table->chbs.header.reserved,
+			   cedt_table->chbs.header.length);
+		NVMEV_INFO("  uid=%u cxl_version=%u reserved=%u\n",
+			   cedt_table->chbs.uid,
+			   cedt_table->chbs.cxl_version,
+			   cedt_table->chbs.reserved);
+		NVMEV_INFO("  base=0x%llx length=0x%llx\n",
+			   cedt_table->chbs.base,
+			   cedt_table->chbs.length);
+
+		/* Dump raw bytes of CHBS entry (offset 36, length 32) */
+		raw = (u8 *)cedt_table;
+		NVMEV_INFO("CEDT verify: raw bytes [36..67] (CHBS):\n");
+		NVMEV_INFO("  %02x %02x %02x %02x %02x %02x %02x %02x"
+			   " %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			   raw[36], raw[37], raw[38], raw[39],
+			   raw[40], raw[41], raw[42], raw[43],
+			   raw[44], raw[45], raw[46], raw[47],
+			   raw[48], raw[49], raw[50], raw[51]);
+		NVMEV_INFO("  %02x %02x %02x %02x %02x %02x %02x %02x"
+			   " %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			   raw[52], raw[53], raw[54], raw[55],
+			   raw[56], raw[57], raw[58], raw[59],
+			   raw[60], raw[61], raw[62], raw[63],
+			   raw[64], raw[65], raw[66], raw[67]);
+
+		/* Try acpi_get_table to see what cxl_acpi will see */
+		status = acpi_get_table(ACPI_SIG_CEDT, 0, &verify_hdr);
+		if (ACPI_FAILURE(status) || !verify_hdr) {
+			NVMEV_ERROR("CEDT verify: acpi_get_table FAILED! status=0x%x\n",
+				    status);
+		} else {
+			NVMEV_INFO("CEDT verify: acpi_get_table returned %px length=%u\n",
+				   verify_hdr, verify_hdr->length);
+			NVMEV_INFO("CEDT verify: same as cedt_table? %s\n",
+				   (verify_hdr == &cedt_table->cedt.header) ? "YES" : "NO");
+
+			/* Walk subtables manually */
+			offset = sizeof(struct acpi_table_cedt);
+			tbl_end = verify_hdr->length;
+			while (offset + sizeof(struct acpi_cedt_header) < tbl_end) {
+				struct acpi_cedt_header *sub =
+					(struct acpi_cedt_header *)((u8 *)verify_hdr + offset);
+				NVMEV_INFO("CEDT verify: subtable at offset %lu: type=%u length=%u\n",
+					   offset, sub->type, sub->length);
+				if (sub->type == ACPI_CEDT_TYPE_CHBS) {
+					struct acpi_cedt_chbs *chbs =
+						(struct acpi_cedt_chbs *)sub;
+					NVMEV_INFO("  CHBS: uid=%u ver=%u base=0x%llx len=0x%llx\n",
+						   chbs->uid, chbs->cxl_version,
+						   chbs->base, chbs->length);
+				}
+				if (sub->length == 0)
+					break;
+				offset += sub->length;
+			}
+
+			acpi_put_table(verify_hdr);
+		}
+	}
+
+	NVMEV_INFO("✓ CEDT table injected - ready for cxl_acpi discovery\n");
+
+	return 0;
+}
+
+/**
+ * nvmev_cleanup_cedt - Remove CEDT table from ACPI subsystem
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Called during module unload to clean up the injected CEDT table.
+ */
+void nvmev_cleanup_cedt(struct nvmev_dev *nvmev_vdev)
+{
+	if (nvmev_vdev->cxl_cedt_index > 0) {
+		acpi_unload_table(nvmev_vdev->cxl_cedt_index);
+		NVMEV_INFO("CEDT table unloaded (index %d)\n", nvmev_vdev->cxl_cedt_index);
+		nvmev_vdev->cxl_cedt_index = -1;
+	}
+
+	/*
+	 * Do NOT kfree(cedt_table) here. acpi_unload_table() marks the entry
+	 * as "unloaded" but does NOT remove it from the ACPI root table list.
+	 * acpi_get_table("CEDT", 0) still returns the FIRST matching entry
+	 * (our old pointer). If we kfree it, the next module load sees a
+	 * use-after-free: corrupted CHBS data → "No CHBS found for Host Bridge".
+	 *
+	 * Leaking ~108 bytes per module reload is acceptable.
+	 */
+	cedt_table = NULL;
+}
\ No newline at end of file
diff --git a/cxl_async_io.c b/cxl_async_io.c
new file mode 100644
index 0000000..bbb34f0
--- /dev/null
+++ b/cxl_async_io.c
@@ -0,0 +1,2878 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL Asynchronous I/O Operations for DRAM/NAND Cache Management (2MB Only)
+ *
+ * All async operations work at 2MB huge page granularity:
+ * - Background eviction evicts entire 2MB regions
+ * - Async prefetch loads 2MB regions from NAND
+ * - PMD invalidation/installation handled by fault handler (lazy)
+ *
+ * Architecture:
+ * - Uses existing I/O worker threads (no dedicated eviction threads)
+ * - Eviction triggered by: cache pressure, dispatcher thread, explicit requests
+ * - Page state machine: NOT_IN_DRAM -> LOADING -> IN_DRAM -> EVICTING -> NOT_IN_DRAM
+ * - All NAND I/O goes through schedule_cxl_nand_operation() in io.c
+ */
+
+#include <linux/completion.h>
+#include <linux/mm.h>
+#include <linux/sched/clock.h>
+#include <linux/delay.h>
+
+#include "nvmev.h"
+#include "cxlssd_ftl.h"
+#include <linux/pgtable.h>
+#include <asm/pgtable.h>
+
+/* Completion structure for async operations */
+struct cxl_async_completion {
+	struct nvmev_dev *nvmev_vdev;
+	unsigned long hpage_idx;
+	bool is_write;  /* true = eviction, false = load/prefetch */
+	bool credit_released;  /* 4K eviction only: nr_cached_4k already
+	                        * decremented at zap time (paired-replacement
+	                        * prefetch admission); the completion must not
+	                        * decrement again.  kzalloc zeroes it, so every
+	                        * legacy path keeps release-at-completion. */
+	struct completion *done;  /* Optional: for synchronous waiting */
+};
+
+/* Context for chained evict-then-load: async eviction frees a DRAM slot,
+ * then the completion callback reuses that slot to schedule an async load.
+ * This avoids blocking the dispatcher on synchronous eviction delays. */
+struct cxl_chained_evict_load {
+	struct nvmev_dev *nvmev_vdev;
+	unsigned long victim_hpage_idx;  /* page being evicted */
+	unsigned long load_hpage_idx;    /* page to load after eviction completes */
+	unsigned long dram_slot;         /* DRAM slot: freed by evict, reused by load */
+	struct completion *done;         /* signaled after load completes (not eviction) */
+};
+
+/* Statistics */
+static atomic64_t async_loads = ATOMIC64_INIT(0);
+static atomic64_t async_evictions = ATOMIC64_INIT(0);
+static atomic64_t async_prefetches = ATOMIC64_INIT(0);
+
+
+/**
+ * cxl_async_load_completion() - Completion callback for async NAND load (2MB)
+ * @completion_data: Pointer to cxl_async_completion
+ *
+ * Called by I/O worker thread when NAND load completes.
+ * Copies 2MB from NAND to DRAM, updates hpage_table entry, and installs
+ * a read-only PMD so that subsequent reads do not trigger a page fault.
+ */
+static void cxl_async_load_completion(void *completion_data)
+{
+	struct cxl_async_completion *comp = completion_data;
+	struct nvmev_dev *nvmev_vdev = comp->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *entry;
+	unsigned long hpage_idx = comp->hpage_idx;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("Invalid nvmev_vdev in load completion\n");
+		goto out;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	if (hpage_idx >= cxl_mb->nr_hpages) {
+		NVMEV_ERROR("Invalid hpage_idx in load completion: %lu >= %lu\n",
+			    hpage_idx, cxl_mb->nr_hpages);
+		goto out;
+	}
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/* No memcpy needed — data lives at NAND PFN.
+	 * Install read-only PMD so subsequent reads avoid a page fault. */
+	cxl_install_hpage_pmd(cxl_mb, hpage_idx, entry->dram_slot);
+
+	/* Commit: store data, then publish state */
+	WRITE_ONCE(entry->dirty, false);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	atomic_set(&entry->accessed, 1);
+	wake_up(&entry->wait);
+
+	NVMEV_DEBUG("I/O worker: LOAD complete hpage=%lu slot=%lu\n",
+		   hpage_idx, entry->dram_slot);
+	atomic64_inc(&async_loads);
+
+	/* Decrement prefetch in-flight counter */
+	atomic_dec_if_positive(&cxl_mb->prefetch_inflight);
+
+out:
+	if (comp->done)
+		complete(comp->done);
+
+	kfree(comp);
+}
+
+/**
+ * cxl_async_evict_completion() - Completion callback for async NAND write (2MB)
+ * @completion_data: Pointer to cxl_async_completion
+ *
+ * Called by I/O worker thread when NAND write (eviction) completes.
+ * Updates hpage_table entry, frees DRAM slot, and invalidates PMDs.
+ */
+static void cxl_async_evict_completion(void *completion_data)
+{
+	struct cxl_async_completion *comp = completion_data;
+	struct nvmev_dev *nvmev_vdev = comp->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *entry;
+	unsigned long hpage_idx = comp->hpage_idx;
+	unsigned long dram_hpage_slot;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("Invalid nvmev_vdev in evict completion\n");
+		goto out;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	if (hpage_idx >= cxl_mb->nr_hpages) {
+		NVMEV_ERROR("Invalid hpage_idx in evict completion: %lu >= %lu\n",
+			    hpage_idx, cxl_mb->nr_hpages);
+		goto out;
+	}
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+	dram_hpage_slot = entry->dram_slot;
+
+	/* Zap PMD entries FIRST — while state is still EVICTING, userspace
+	 * faults will see EVICTING and wait.  This prevents stale PMD mappings
+	 * from accessing the DRAM slot after it is recycled. */
+	cxl_zap_hpage_ptes(cxl_mb, hpage_idx);
+
+	/* Commit: clear dirty, then publish NOT_CACHED */
+	WRITE_ONCE(entry->dirty, false);
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], INVALID_PAGE_IDX);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+	wake_up(&entry->wait);
+
+	/* Push freed slot back to correct pool */
+	spin_lock(&cxl_mb->cache_lock);
+	cxl_mb->free_slots[cxl_mb->nr_free++] = dram_hpage_slot;
+	spin_unlock(&cxl_mb->cache_lock);
+
+	NVMEV_DEBUG("I/O worker: EVICT complete hpage=%lu freed_slot=%lu\n",
+		   hpage_idx, dram_hpage_slot);
+	atomic64_inc(&async_evictions);
+
+out:
+	if (comp->done)
+		complete(comp->done);
+
+	kfree(comp);
+}
+
+/**
+ * cxl_chained_evict_completion() - Completion callback for chained evict→load
+ * @completion_data: Pointer to cxl_chained_evict_load
+ *
+ * Called by I/O worker when the eviction NAND write timing completes.
+ * Finishes victim cleanup (zap PMDs, state transition), then reuses the
+ * freed DRAM slot to schedule an async NAND read for the pending load target.
+ */
+static void cxl_chained_evict_completion(void *completion_data)
+{
+	struct cxl_chained_evict_load *chain = completion_data;
+	struct nvmev_dev *nvmev_vdev = chain->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *victim, *load_entry;
+	struct cxl_async_completion *load_comp;
+	unsigned long long nsecs_start, nsecs_target;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("Invalid nvmev_vdev in chained evict completion\n");
+		goto err_out;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+	victim = &cxl_mb->hpage_table[chain->victim_hpage_idx];
+	load_entry = &cxl_mb->hpage_table[chain->load_hpage_idx];
+
+	/* Complete victim eviction: zap PMDs, update state */
+	cxl_zap_hpage_ptes(cxl_mb, chain->victim_hpage_idx);
+	WRITE_ONCE(victim->dirty, false);
+	smp_wmb();
+	atomic_set(&victim->state, CXL_HPAGE_NOT_CACHED);
+	wake_up(&victim->wait);
+
+	atomic64_inc(&async_evictions);
+
+	/* Reuse DRAM slot for pending load (no free list round-trip) */
+	load_entry->dram_slot = chain->dram_slot;
+	WRITE_ONCE(cxl_mb->slot_to_hpage[chain->dram_slot], chain->load_hpage_idx);
+
+	/* Allocate load completion context */
+	load_comp = kzalloc(sizeof(*load_comp), GFP_ATOMIC);
+	if (!load_comp) {
+		NVMEV_ERROR("Failed to allocate load completion in chain\n");
+		WRITE_ONCE(cxl_mb->slot_to_hpage[chain->dram_slot], INVALID_PAGE_IDX);
+		spin_lock(&cxl_mb->cache_lock);
+		cxl_mb->free_slots[cxl_mb->nr_free++] = chain->dram_slot;
+		spin_unlock(&cxl_mb->cache_lock);
+		atomic_set(&load_entry->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&load_entry->wait);
+		goto err_out;
+	}
+
+	load_comp->nvmev_vdev = nvmev_vdev;
+	load_comp->hpage_idx = chain->load_hpage_idx;
+	load_comp->is_write = false;
+	load_comp->done = chain->done;  /* Pass through wait completion */
+
+	/* Schedule NAND read for the load target */
+	nsecs_start = local_clock();
+	if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+		nsecs_target = cxl_ftl_calc_latency(
+			nvmev_vdev->cxl_ftl,
+			CXL_HPAGE_TO_PAGE(chain->load_hpage_idx),
+			false, CXL_HPAGE_SIZE, nsecs_start);
+	} else {
+		nsecs_target = nsecs_start; /* No latency */
+	}
+
+	NVMEV_DEBUG("Chained load: hpage=%lu after evicting victim=%lu\n",
+		    chain->load_hpage_idx, chain->victim_hpage_idx);
+
+	schedule_cxl_nand_operation(CXL_HPAGE_TO_PAGE(chain->load_hpage_idx),
+				    false, nsecs_target,
+				    cxl_async_load_completion, load_comp);
+
+	kfree(chain);
+	return;
+
+err_out:
+	if (chain->done)
+		complete(chain->done);
+	kfree(chain);
+}
+
+/**
+ * cxl_async_load_hpage() - Asynchronously load a 2MB huge page from NAND to DRAM
+ * @nvmev_vdev: NVMeVirt device
+ * @hpage_idx: Huge page index to load
+ * @wait: Whether to wait for completion
+ *
+ * Schedules a NAND read operation via I/O workers for a 2MB region.
+ *
+ * Returns: 0 on success, negative error code otherwise
+ */
+int cxl_async_load_hpage(struct nvmev_dev *nvmev_vdev, unsigned long hpage_idx, bool wait)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_hpage_entry *entry;
+	struct cxl_async_completion *comp;
+	struct completion done_comp;
+	unsigned long long nsecs_start, nsecs_target;
+	unsigned long dram_hpage_slot;
+
+	if (!cxl_mb || hpage_idx >= cxl_mb->nr_hpages)
+		return -EINVAL;
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/* Atomically transition NOT_CACHED → LOADING */
+	{
+		int old = atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED,
+					 CXL_HPAGE_LOADING);
+		if (old != CXL_HPAGE_NOT_CACHED) {
+			if ((old == CXL_HPAGE_LOADING || old == CXL_HPAGE_EVICTING) && wait)
+				wait_event(entry->wait, !cxl_hpage_is_busy(entry));
+			return 0;
+		}
+	}
+
+	atomic64_inc(&cxl_mb->cache_misses);
+
+	/* Allocate a DRAM slot from staging pool */
+	spin_lock(&cxl_mb->cache_lock);
+	if (cxl_mb->nr_free > 0) {
+		dram_hpage_slot = cxl_mb->free_slots[--cxl_mb->nr_free];
+	} else {
+		dram_hpage_slot = INVALID_PAGE_IDX;
+	}
+	spin_unlock(&cxl_mb->cache_lock);
+
+	if (dram_hpage_slot == INVALID_PAGE_IDX) {
+		long victim_idx = cxl_clock_victim(cxl_mb,
+							cxl_mb->nr_dram_hpages * 2);
+		struct cxl_hpage_entry *victim;
+
+		if (victim_idx < 0) {
+			NVMEV_ERROR("Async load: no evictable pages for hpage %lu\n",
+				    hpage_idx);
+			atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+			wake_up(&entry->wait);
+			return -ENOMEM;
+		}
+
+		victim = &cxl_mb->hpage_table[victim_idx];
+		dram_hpage_slot = victim->dram_slot;
+
+		if (READ_ONCE(victim->dirty)) {
+			/* Dirty victim: chain async eviction → async load.
+			 * No memcpy needed — data is already at NAND PFN.
+			 * Eviction completion reuses this DRAM slot for the
+			 * pending load — dispatcher never blocks. */
+			struct cxl_chained_evict_load *chain;
+			unsigned long long nsecs_start, nsecs_target;
+
+			set_bit(victim_idx, cxl_mb->nand_valid);
+
+			chain = kzalloc(sizeof(*chain), GFP_ATOMIC);
+			if (!chain) {
+				atomic_set(&victim->state, CXL_HPAGE_CACHED);
+				wake_up(&victim->wait);
+				atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+				wake_up(&entry->wait);
+				return -ENOMEM;
+			}
+
+			chain->nvmev_vdev = nvmev_vdev;
+			chain->victim_hpage_idx = victim_idx;
+			chain->load_hpage_idx = hpage_idx;
+			chain->dram_slot = dram_hpage_slot;
+
+			if (wait) {
+				init_completion(&done_comp);
+				chain->done = &done_comp;
+			} else {
+				chain->done = NULL;
+			}
+
+			/* Schedule eviction timing — callback chains load */
+			nsecs_start = local_clock();
+			if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+				nsecs_target = cxl_ftl_calc_latency(
+					nvmev_vdev->cxl_ftl,
+					CXL_HPAGE_TO_PAGE(victim_idx),
+					true, CXL_HPAGE_SIZE, nsecs_start);
+			} else {
+				nsecs_target = nsecs_start; /* No latency */
+			}
+
+			schedule_cxl_nand_operation(
+				CXL_HPAGE_TO_PAGE(victim_idx), true,
+				nsecs_target,
+				cxl_chained_evict_completion, chain);
+
+			if (wait)
+				wait_for_completion(&done_comp);
+
+			return 0;
+		}
+
+		/* Clean victim: inline eviction (no NAND I/O needed) */
+		cxl_zap_hpage_ptes(cxl_mb, victim_idx);
+		WRITE_ONCE(victim->dirty, false);
+		smp_wmb();
+		atomic_set(&victim->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&victim->wait);
+		/* Slot reused directly — not pushed to free list */
+	}
+
+	/* Assign DRAM slot before scheduling async I/O */
+	entry->dram_slot = dram_hpage_slot;
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], hpage_idx);
+
+	/* Allocate completion structure */
+	comp = kzalloc(sizeof(*comp), GFP_ATOMIC);
+	if (!comp) {
+		WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], INVALID_PAGE_IDX);
+		spin_lock(&cxl_mb->cache_lock);
+		cxl_mb->free_slots[cxl_mb->nr_free++] = dram_hpage_slot;
+		spin_unlock(&cxl_mb->cache_lock);
+		atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&entry->wait);
+		return -ENOMEM;
+	}
+
+	comp->nvmev_vdev = nvmev_vdev;
+	comp->hpage_idx = hpage_idx;
+	comp->is_write = false;
+
+	if (wait) {
+		init_completion(&done_comp);
+		comp->done = &done_comp;
+	} else {
+		comp->done = NULL;
+	}
+
+	/* Calculate NAND read latency using FTL for 2MB */
+	nsecs_start = local_clock();
+	if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+		nsecs_target = cxl_ftl_calc_latency(
+			nvmev_vdev->cxl_ftl,
+			CXL_HPAGE_TO_PAGE(hpage_idx),
+			false,
+			CXL_HPAGE_SIZE,
+			nsecs_start);
+	} else {
+		nsecs_target = nsecs_start; /* No latency */
+	}
+
+	NVMEV_DEBUG("I/O worker: LOAD dispatch hpage=%lu slot=%lu latency=%llu ns (%llu us)\n",
+		   hpage_idx, dram_hpage_slot,
+		   nsecs_target - nsecs_start,
+		   (nsecs_target - nsecs_start) / 1000);
+
+	/* Record latency for adaptive prefetch throttle */
+	WRITE_ONCE(cxl_mb->last_prefetch_latency_ns, nsecs_target - nsecs_start);
+
+	schedule_cxl_nand_operation(CXL_HPAGE_TO_PAGE(hpage_idx), false, nsecs_target,
+				    cxl_async_load_completion, comp);
+
+	if (wait)
+		wait_for_completion(&done_comp);
+
+	return 0;
+}
+
+/**
+ * __dispatch_async_eviction() - Dispatch eviction for a victim already in EVICTING state
+ * @nvmev_vdev: NVMeVirt device
+ * @hpage_idx: Victim huge page index (state must already be EVICTING)
+ *
+ * Clean pages are freed immediately.  Dirty pages schedule an async NAND
+ * write with FTL latency simulation — cxl_async_evict_completion() frees
+ * the DRAM slot once the simulated write completes.
+ */
+static void __dispatch_async_eviction(struct nvmev_dev *nvmev_vdev, unsigned long hpage_idx)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_hpage_entry *entry = &cxl_mb->hpage_table[hpage_idx];
+	unsigned long dram_hpage_slot = entry->dram_slot;
+
+	if (READ_ONCE(entry->dirty)) {
+		struct cxl_async_completion *comp;
+		unsigned long long nsecs_start, nsecs_target;
+
+		set_bit(hpage_idx, cxl_mb->nand_valid);
+
+		comp = kzalloc(sizeof(*comp), GFP_ATOMIC);
+		if (!comp) {
+			NVMEV_ERROR("EVICT alloc failed for hpage %lu, "
+				    "sync fallback\n", hpage_idx);
+			goto sync_fallback;
+		}
+
+		comp->nvmev_vdev = nvmev_vdev;
+		comp->hpage_idx = hpage_idx;
+		comp->is_write = true;
+		comp->done = NULL;
+
+		nsecs_start = local_clock();
+		if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+			nsecs_target = cxl_ftl_calc_latency(
+				nvmev_vdev->cxl_ftl,
+				CXL_HPAGE_TO_PAGE(hpage_idx),
+				true, CXL_HPAGE_SIZE, nsecs_start);
+		} else {
+			nsecs_target = nsecs_start; /* No latency */
+		}
+
+		NVMEV_DEBUG("I/O worker: EVICT dispatch hpage=%lu slot=%lu "
+			    "dirty=1 latency=%llu ns (%llu us)\n",
+			    hpage_idx, dram_hpage_slot,
+			    nsecs_target - nsecs_start,
+			    (nsecs_target - nsecs_start) / 1000);
+
+		schedule_cxl_nand_operation(
+			CXL_HPAGE_TO_PAGE(hpage_idx), true,
+			nsecs_target,
+			cxl_async_evict_completion, comp);
+		return;
+	}
+
+sync_fallback:
+	/* Clean page (or dirty fallback on alloc failure): free immediately */
+	NVMEV_DEBUG("I/O worker: EVICT dispatch hpage=%lu slot=%lu dirty=0\n",
+		    hpage_idx, dram_hpage_slot);
+
+	cxl_zap_hpage_ptes(cxl_mb, hpage_idx);
+
+	WRITE_ONCE(entry->dirty, false);
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], INVALID_PAGE_IDX);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+	wake_up(&entry->wait);
+
+	spin_lock(&cxl_mb->cache_lock);
+	cxl_mb->free_slots[cxl_mb->nr_free++] = dram_hpage_slot;
+	spin_unlock(&cxl_mb->cache_lock);
+
+	atomic64_inc(&async_evictions);
+}
+
+/*
+ * ============================================================================
+ * Background Maintenance: Discard, Prefetch Queue, Eviction Check
+ * ============================================================================
+ */
+
+/**
+ * cxl_discard_freed_hpages() - Erase NAND lines freed by userspace
+ * @nvmev_vdev: NVMeVirt device
+ * @max_discard: Maximum lines to process per invocation
+ *
+ * Pops line_id values from the shared SPSC free queue. For each line:
+ *   1. Invalidates all hugepages in [line_id * HPL, (line_id+1) * HPL)
+ *      - CACHED pages: reclaim DRAM slot, zap PMDs, transition to NOT_CACHED
+ *      - NOT_CACHED pages: nothing to do on DRAM side
+ *      - LOADING/EVICTING pages: skip entire line (retry next cycle)
+ *   2. Clears nand_valid bits for the line's hugepage range
+ *   3. Issues parallel NAND_ERASE across all dies via cxl_ftl_erase_line()
+ *      (fire-and-forget: advances LUN busy times, future I/O sees contention)
+ *
+ * Returns: number of hugepages discarded (across all erased lines)
+ */
+unsigned long cxl_discard_freed_hpages(struct nvmev_dev *nvmev_vdev,
+				       unsigned long max_discard)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_ssd *cxl_ftl = nvmev_vdev->cxl_ftl;
+	struct cxl_free_queue *fq;
+	unsigned long nr_discarded = 0;
+	unsigned long head, tail;
+	unsigned long hugepages_per_line;
+	unsigned long tt_lines;
+
+	if (!cxl_mb || !cxl_ftl)
+		return 0;
+
+	fq = cxl_mb->free_queue;
+	if (!fq)
+		return 0;
+
+	hugepages_per_line = cxl_ftl->hugepages_per_line;
+	tt_lines = cxl_ftl->tt_lines;
+
+	head = READ_ONCE(fq->head);
+	tail = READ_ONCE(fq->tail);
+
+	if (head != tail)
+		NVMEV_INFO("FREE_Q: head=%lu tail=%lu (entries pending)\n",
+			   head, tail);
+
+	while (head != tail) {
+		__u64 line_id_val;
+		unsigned long line_id;
+		unsigned long first_hpage, last_hpage;
+		unsigned long i;
+		bool has_busy = false;
+
+		if (max_discard && nr_discarded >= max_discard)
+			break;
+
+		line_id_val = READ_ONCE(fq->entries[head & fq->mask]);
+
+		/* MPSC sentinel: slot claimed by CAS but entry not yet written.
+		 * Stop processing — the entry will be ready next poll cycle. */
+		if (line_id_val == (__u64)(~0ULL))
+			break;
+
+		line_id = (unsigned long)line_id_val;
+
+		/* Validate line_id */
+		if (line_id >= tt_lines) {
+			NVMEV_DEBUG("Free queue: invalid line_id %lu >= %lu\n",
+				    line_id, tt_lines);
+			goto advance;
+		}
+
+		first_hpage = line_id * hugepages_per_line;
+		last_hpage = min(first_hpage + hugepages_per_line,
+				 cxl_mb->nr_hpages);
+
+		/* Phase 1: Check for busy hpages — skip line if any in-flight */
+		for (i = first_hpage; i < last_hpage; i++) {
+			struct cxl_hpage_entry *entry =
+				&cxl_mb->hpage_table[i];
+			if (cxl_hpage_is_busy(entry)) {
+				has_busy = true;
+				break;
+			}
+		}
+		if (has_busy) {
+			NVMEV_DEBUG("Free queue: line %lu has busy hpage, skipping\n",
+				    line_id);
+			goto advance;
+		}
+
+		/* Phase 2: Invalidate all hpages in the line */
+		for (i = first_hpage; i < last_hpage; i++) {
+			struct cxl_hpage_entry *entry =
+				&cxl_mb->hpage_table[i];
+			int state = atomic_read(&entry->state);
+
+			if (state == CXL_HPAGE_CACHED) {
+				unsigned long dram_hpage_slot;
+
+				/* Skip pinned pages */
+				if (READ_ONCE(cxl_mb->pin_flags[i]))
+					continue;
+
+				/* Claim: CACHED → EVICTING */
+				if (atomic_cmpxchg(&entry->state,
+						   CXL_HPAGE_CACHED,
+						   CXL_HPAGE_EVICTING) !=
+				    CXL_HPAGE_CACHED)
+					continue;
+
+				dram_hpage_slot = entry->dram_slot;
+
+				/* Zap PMD entries */
+				cxl_zap_hpage_ptes(cxl_mb, i);
+
+				WRITE_ONCE(entry->dirty, false);
+				WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot],
+					   INVALID_PAGE_IDX);
+
+				smp_wmb();
+				atomic_set(&entry->state,
+					   CXL_HPAGE_NOT_CACHED);
+				wake_up(&entry->wait);
+
+				/* Return DRAM slot to correct pool */
+				spin_lock(&cxl_mb->cache_lock);
+				cxl_mb->free_slots[cxl_mb->nr_free++] = dram_hpage_slot;
+				spin_unlock(&cxl_mb->cache_lock);
+			}
+			/* NOT_CACHED: nothing to do on DRAM side */
+		}
+
+		/* Phase 3: Clear NAND validity for entire line */
+		bitmap_clear(cxl_mb->nand_valid, first_hpage,
+			     last_hpage - first_hpage);
+
+		/* Phase 4: Issue parallel NAND_ERASE across all dies
+		 * (fire-and-forget: advances LUN busy times, returns immediately) */
+		cxl_ftl_erase_line(cxl_ftl, line_id, local_clock());
+
+		nr_discarded += last_hpage - first_hpage;
+
+advance:
+		head = head + 1;
+		WRITE_ONCE(fq->head, head);
+		tail = READ_ONCE(fq->tail);
+	}
+
+	if (nr_discarded > 0) {
+		NVMEV_INFO("Discarded %lu hugepages via line erase\n",
+			   nr_discarded);
+	}
+
+	return nr_discarded;
+}
+
+/*
+ * ============================================================================
+ * Layer-by-Layer Prefetch: loads hugepages in layer_size increments
+ * ============================================================================
+ */
+
+/* Context for layer-by-layer prefetch of a chunk's hugepages */
+struct cxl_layered_prefetch_ctx {
+	struct nvmev_dev *nvmev_vdev;
+	unsigned long hpage_idx;       /* Current hugepage being loaded */
+	unsigned long dram_slot;       /* DRAM slot for current hugepage */
+	unsigned int current_layer;    /* Next layer (0-based, global across chunk) */
+	unsigned int total_layers;     /* Total layers across all hugepages */
+	size_t layer_size;             /* Bytes per layer */
+
+	struct cxl_chunk_entry *chunk_entry; /* Shared DRAM chunk table entry */
+	unsigned long base_hpage_idx;  /* First hpage_idx of chunk */
+	unsigned int current_hpage;    /* Which hugepage (0-based) */
+	unsigned int total_hpages;     /* nr_hpages from chunk entry */
+	unsigned int layers_per_hpage; /* DIV_ROUND_UP(CXL_HPAGE_SIZE, layer_size) */
+};
+
+/* Chain context for dirty victim eviction before starting layer reads */
+struct cxl_layered_evict_chain {
+	struct nvmev_dev *nvmev_vdev;
+	unsigned long victim_hpage_idx;
+	unsigned long dram_slot;
+	struct cxl_layered_prefetch_ctx *ctx;
+};
+
+/* Forward declarations */
+static void cxl_layer_read_completion(void *completion_data);
+static void cxl_layered_evict_completion(void *completion_data);
+
+/**
+ * cxl_chunk_lookup() - Look up a chunk entry by hash in the shared hash table
+ * @cxl_mb: Memory backend with chunk table
+ * @chunk_hash: Hash key to search for
+ *
+ * Open-addressing linear probe lookup. O(1) amortized at ~50% load factor.
+ * Returns: pointer to matching entry, or NULL if not found.
+ */
+static struct cxl_chunk_entry *cxl_chunk_lookup(struct cxl_memory_backend *cxl_mb,
+						__u64 chunk_hash)
+{
+	unsigned long idx = chunk_hash & cxl_mb->chunk_table->mask;
+	unsigned long start = idx;
+
+	do {
+		struct cxl_chunk_entry *e = &cxl_mb->chunk_entries[idx];
+		__u64 h = READ_ONCE(e->chunk_hash);
+
+		if (h == chunk_hash)
+			return e;
+		if (h == CXL_CHUNK_EMPTY)
+			return NULL;
+		idx = (idx + 1) & cxl_mb->chunk_table->mask;
+	} while (idx != start);
+
+	return NULL;
+}
+
+/**
+ * __schedule_layer_read() - Schedule one layer-sized NAND read
+ * @ctx: Layered prefetch context (current_layer indicates which layer)
+ *
+ * Computes the NAND page range for the current layer within the hugepage,
+ * calculates NAND latency, and dispatches to an I/O worker thread.
+ */
+static void __schedule_layer_read(struct cxl_layered_prefetch_ctx *ctx)
+{
+	struct nvmev_dev *nvmev_vdev = ctx->nvmev_vdev;
+	unsigned int local_layer;
+	unsigned long byte_off, start_page, end_page, page_idx;
+	size_t read_size, nand_size;
+	unsigned long long nsecs_start, nsecs_target;
+
+	local_layer = ctx->current_layer -
+		      (ctx->current_hpage * ctx->layers_per_hpage);
+	byte_off = (unsigned long)local_layer * ctx->layer_size;
+	read_size = min_t(size_t, ctx->layer_size, CXL_HPAGE_SIZE - byte_off);
+
+	start_page = byte_off >> PAGE_SHIFT;
+	end_page = DIV_ROUND_UP(byte_off + read_size, PAGE_SIZE);
+	page_idx = CXL_HPAGE_TO_PAGE(ctx->hpage_idx) + start_page;
+	nand_size = (end_page - start_page) << PAGE_SHIFT;
+
+	nsecs_start = local_clock();
+	if (nvmev_vdev->cxl_ftl && READ_ONCE(nvmev_vdev->cxl_mb->latency_enabled)) {
+		nsecs_target = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+						    page_idx, false,
+						    nand_size, nsecs_start);
+	} else {
+		nsecs_target = nsecs_start; /* No latency */
+	}
+
+	NVMEV_DEBUG("Layered I/O: LOAD layer hpage=%lu layer=%u/%u "
+		   "size=%zu latency=%llu ns (%llu us)\n",
+		   ctx->hpage_idx, ctx->current_layer,
+		   ctx->total_layers, read_size,
+		   nsecs_target - nsecs_start,
+		   (nsecs_target - nsecs_start) / 1000);
+
+	schedule_cxl_nand_operation(page_idx, false, nsecs_target,
+				    cxl_layer_read_completion, ctx);
+}
+
+/**
+ * __layered_setup_hpage() - Set up a hugepage for layer reads
+ * @ctx: Layered prefetch context
+ * @hpage_idx: Hugepage index to set up
+ * @dram_slot: Allocated DRAM slot for this hugepage
+ *
+ * Assigns the slot, zeros the DRAM page, installs a read-only PMD so
+ * userspace can access the page immediately, then starts the first layer read.
+ */
+static void __layered_setup_hpage(struct cxl_layered_prefetch_ctx *ctx,
+				  unsigned long hpage_idx,
+				  unsigned long dram_slot)
+{
+	struct cxl_memory_backend *cxl_mb = ctx->nvmev_vdev->cxl_mb;
+	struct cxl_hpage_entry *entry = &cxl_mb->hpage_table[hpage_idx];
+
+	ctx->hpage_idx = hpage_idx;
+	ctx->dram_slot = dram_slot;
+
+	entry->dram_slot = dram_slot;
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_slot], hpage_idx);
+
+	/* No DRAM zero-fill needed — data lives at NAND PFN.
+	 * Install read-only PMD immediately — userspace can access now. */
+	cxl_install_hpage_pmd(cxl_mb, hpage_idx, dram_slot);
+
+	__schedule_layer_read(ctx);
+}
+
+/**
+ * cxl_layered_evict_completion() - Eviction done, resume layer reads
+ * @completion_data: Pointer to cxl_layered_evict_chain
+ *
+ * Called by I/O worker when dirty victim eviction timing completes.
+ * Finalizes victim cleanup and reuses the freed DRAM slot for the pending
+ * hugepage load.
+ */
+static void cxl_layered_evict_completion(void *completion_data)
+{
+	struct cxl_layered_evict_chain *chain = completion_data;
+	struct nvmev_dev *nvmev_vdev = chain->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *victim;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("Invalid nvmev_vdev in layered evict completion\n");
+		kfree(chain->ctx);
+		kfree(chain);
+		return;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+	victim = &cxl_mb->hpage_table[chain->victim_hpage_idx];
+
+	/* Finalize victim eviction */
+	cxl_zap_hpage_ptes(cxl_mb, chain->victim_hpage_idx);
+	WRITE_ONCE(victim->dirty, false);
+	smp_wmb();
+	atomic_set(&victim->state, CXL_HPAGE_NOT_CACHED);
+	wake_up(&victim->wait);
+	atomic64_inc(&async_evictions);
+
+	NVMEV_DEBUG("Layered I/O: EVICT complete victim_hpage=%lu "
+		   "freed_slot=%lu\n",
+		   chain->victim_hpage_idx, chain->dram_slot);
+
+	/* Set up the new hugepage with the freed slot and start layer reads */
+	__layered_setup_hpage(chain->ctx,
+			      chain->ctx->base_hpage_idx +
+				      chain->ctx->current_hpage,
+			      chain->dram_slot);
+
+	kfree(chain);
+}
+
+/**
+ * __layered_alloc_and_start() - Allocate DRAM slot and start layer reads
+ * @ctx: Layered prefetch context (freed on error)
+ * @hpage_idx: Hugepage index (must already be in LOADING state)
+ *
+ * Allocates a DRAM slot (evicting if needed), zeros the page, installs PMD,
+ * and starts the first layer read.  For dirty victims, chains eviction →
+ * layer reads asynchronously.
+ *
+ * Returns: 0 on success (or pending eviction chain), negative on error.
+ *          On error, ctx is freed and hpage state is reset to NOT_CACHED.
+ */
+static int __layered_alloc_and_start(struct cxl_layered_prefetch_ctx *ctx,
+				     unsigned long hpage_idx)
+{
+	struct nvmev_dev *nvmev_vdev = ctx->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_hpage_entry *entry = &cxl_mb->hpage_table[hpage_idx];
+	unsigned long dram_slot;
+
+	/* Try staging free stack first */
+	spin_lock(&cxl_mb->cache_lock);
+	if (cxl_mb->nr_free > 0)
+		dram_slot = cxl_mb->free_slots[--cxl_mb->nr_free];
+	else
+		dram_slot = INVALID_PAGE_IDX;
+	spin_unlock(&cxl_mb->cache_lock);
+
+	if (dram_slot == INVALID_PAGE_IDX) {
+		/* Need eviction from staging pool */
+		long victim_idx = cxl_clock_victim(
+			cxl_mb, cxl_mb->nr_dram_hpages * 2);
+		struct cxl_hpage_entry *victim;
+
+		if (victim_idx < 0) {
+			NVMEV_ERROR("Layered prefetch: no evictable pages "
+				    "for hpage %lu\n", hpage_idx);
+			atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+			wake_up(&entry->wait);
+			kfree(ctx);
+			return -ENOMEM;
+		}
+
+		victim = &cxl_mb->hpage_table[victim_idx];
+		dram_slot = victim->dram_slot;
+
+		if (READ_ONCE(victim->dirty)) {
+			/* Dirty victim: chain eviction → layer reads.
+			 * No memcpy — data is already at NAND PFN. */
+			struct cxl_layered_evict_chain *chain;
+			unsigned long long nsecs_start, nsecs_target;
+
+			set_bit(victim_idx, cxl_mb->nand_valid);
+
+			chain = kzalloc(sizeof(*chain), GFP_ATOMIC);
+			if (!chain) {
+				atomic_set(&victim->state, CXL_HPAGE_CACHED);
+				wake_up(&victim->wait);
+				atomic_set(&entry->state,
+					   CXL_HPAGE_NOT_CACHED);
+				wake_up(&entry->wait);
+				kfree(ctx);
+				return -ENOMEM;
+			}
+
+			chain->nvmev_vdev = nvmev_vdev;
+			chain->victim_hpage_idx = victim_idx;
+			chain->dram_slot = dram_slot;
+			chain->ctx = ctx;
+
+			nsecs_start = local_clock();
+			if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+				nsecs_target = cxl_ftl_calc_latency(
+					nvmev_vdev->cxl_ftl,
+					CXL_HPAGE_TO_PAGE(victim_idx),
+					true, CXL_HPAGE_SIZE, nsecs_start);
+			} else {
+				nsecs_target = nsecs_start; /* No latency */
+			}
+
+			NVMEV_DEBUG("Layered I/O: EVICT dispatch "
+				   "victim_hpage=%lu slot=%lu dirty=1 "
+				   "latency=%llu ns (%llu us)\n",
+				   victim_idx, dram_slot,
+				   nsecs_target - nsecs_start,
+				   (nsecs_target - nsecs_start) / 1000);
+
+			schedule_cxl_nand_operation(
+				CXL_HPAGE_TO_PAGE(victim_idx), true,
+				nsecs_target,
+				cxl_layered_evict_completion, chain);
+
+			return 0; /* Eviction completion will continue */
+		}
+
+		/* Clean victim: inline eviction */
+		cxl_zap_hpage_ptes(cxl_mb, victim_idx);
+		WRITE_ONCE(victim->dirty, false);
+		smp_wmb();
+		atomic_set(&victim->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&victim->wait);
+	}
+
+	/* Got a DRAM slot — set up hugepage and start layer reads */
+	__layered_setup_hpage(ctx, hpage_idx, dram_slot);
+	return 0;
+}
+
+/**
+ * cxl_layer_read_completion() - Completion callback for one layer read
+ * @completion_data: Pointer to cxl_layered_prefetch_ctx
+ *
+ * Called by I/O worker when one layer's NAND read timing completes.
+ * Copies layer data from NAND to DRAM, increments prefetch_layer, and
+ * either chains the next layer or finalizes the hugepage.
+ */
+static void cxl_layer_read_completion(void *completion_data)
+{
+	struct cxl_layered_prefetch_ctx *ctx = completion_data;
+	struct nvmev_dev *nvmev_vdev = ctx->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *entry;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("Invalid nvmev_vdev in layer read completion\n");
+		kfree(ctx);
+		return;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+	entry = &cxl_mb->hpage_table[ctx->hpage_idx];
+
+	/* No memcpy needed — data lives at NAND PFN directly.
+	 * Publish progress to userspace. */
+	WRITE_ONCE(ctx->chunk_entry->prefetch_layer,
+		   (__u64)(ctx->current_layer + 1));
+	ctx->current_layer++;
+
+	/* More layers in current hugepage? */
+	if (ctx->current_layer <
+		    (ctx->current_hpage + 1) * ctx->layers_per_hpage &&
+	    ctx->current_layer < ctx->total_layers) {
+		__schedule_layer_read(ctx);
+		return;
+	}
+
+	/* Current hugepage complete: mark CACHED */
+	WRITE_ONCE(entry->dirty, false);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	atomic_set(&entry->accessed, 1);
+	wake_up(&entry->wait);
+	atomic64_inc(&async_loads);
+
+	NVMEV_INFO("Layered I/O: LOAD complete hpage=%lu slot=%lu "
+		   "layers=%u\n",
+		   ctx->hpage_idx, entry->dram_slot,
+		   ctx->layers_per_hpage);
+
+	ctx->current_hpage++;
+
+	/* More hugepages in chunk? */
+	while (ctx->current_hpage < ctx->total_hpages) {
+		unsigned long next_idx =
+			ctx->base_hpage_idx + ctx->current_hpage;
+		struct cxl_hpage_entry *next_entry;
+		int old;
+
+		if (next_idx >= cxl_mb->nr_hpages) {
+			kfree(ctx);
+			return;
+		}
+
+		next_entry = &cxl_mb->hpage_table[next_idx];
+
+		/* Try to claim next hugepage */
+		old = atomic_cmpxchg(&next_entry->state,
+				     CXL_HPAGE_NOT_CACHED,
+				     CXL_HPAGE_LOADING);
+		if (old != CXL_HPAGE_NOT_CACHED) {
+			/* Already cached or loading — count its layers
+			 * and skip to the next hugepage */
+			ctx->current_layer = (ctx->current_hpage + 1) *
+					     ctx->layers_per_hpage;
+			WRITE_ONCE(ctx->chunk_entry->prefetch_layer,
+				   (__u64)min(ctx->current_layer,
+					     ctx->total_layers));
+			ctx->current_hpage++;
+			continue;
+		}
+
+		atomic64_inc(&cxl_mb->cache_misses);
+
+		/* Allocate DRAM slot and start layers for next hugepage */
+		if (__layered_alloc_and_start(ctx, next_idx) < 0)
+			return; /* ctx freed by __layered_alloc_and_start */
+
+		return;
+	}
+
+	/* All hugepages done */
+	NVMEV_INFO("Layered I/O: chunk complete base_hpage=%lu "
+		   "hpages=%u total_layers=%u\n",
+		   ctx->base_hpage_idx, ctx->total_hpages,
+		   ctx->total_layers);
+	kfree(ctx);
+}
+
+/**
+ * cxl_layered_prefetch_chunk() - Start layer-by-layer prefetch for a chunk
+ * @nvmev_vdev: NVMeVirt device
+ * @chunk_entry: Shared chunk table entry (for prefetch_layer updates)
+ * @base_hpage_idx: First hugepage index of the chunk
+ * @nr_hpages: Number of hugepages in the chunk
+ *
+ * Begins prefetching the first hugepage layer-by-layer. Subsequent layers
+ * and hugepages are chained via I/O worker completion callbacks.
+ *
+ * Returns: 0 on success, negative error code otherwise
+ */
+static int cxl_layered_prefetch_chunk(struct nvmev_dev *nvmev_vdev,
+				      struct cxl_chunk_entry *chunk_entry,
+				      unsigned long base_hpage_idx,
+				      unsigned int nr_hpages)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_layered_prefetch_ctx *ctx;
+	unsigned int layers_per_hpage;
+	unsigned int start_hpage = 0;
+	int old;
+
+	if (base_hpage_idx >= cxl_mb->nr_hpages)
+		return -EINVAL;
+
+	layers_per_hpage = DIV_ROUND_UP(CXL_HPAGE_SIZE, cxl_mb->layer_size);
+
+	/* Scan forward past already-cached/loading hugepages, counting
+	 * their layers in prefetch_layer so userspace sees progress. */
+	while (start_hpage < nr_hpages) {
+		unsigned long idx = base_hpage_idx + start_hpage;
+		struct cxl_hpage_entry *entry;
+
+		if (idx >= cxl_mb->nr_hpages)
+			break;
+
+		entry = &cxl_mb->hpage_table[idx];
+		old = atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED,
+				     CXL_HPAGE_LOADING);
+		if (old == CXL_HPAGE_NOT_CACHED)
+			break; /* Claimed — start loading from here */
+
+		/* Already cached or loading — skip, count its layers */
+		WRITE_ONCE(chunk_entry->prefetch_layer,
+			   (__u64)min((start_hpage + 1) * layers_per_hpage,
+				      layers_per_hpage * nr_hpages));
+		start_hpage++;
+	}
+
+	/* All hugepages already cached/loading */
+	if (start_hpage >= nr_hpages) {
+		WRITE_ONCE(chunk_entry->prefetch_layer,
+			   (__u64)(layers_per_hpage * nr_hpages));
+		return 0;
+	}
+
+	atomic64_inc(&cxl_mb->cache_misses);
+
+	/* prefetch_layer already updated for skipped hugepages above */
+
+	/* Allocate context */
+	ctx = kzalloc(sizeof(*ctx), GFP_ATOMIC);
+	if (!ctx) {
+		struct cxl_hpage_entry *entry =
+			&cxl_mb->hpage_table[base_hpage_idx + start_hpage];
+		atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&entry->wait);
+		return -ENOMEM;
+	}
+
+	ctx->nvmev_vdev = nvmev_vdev;
+	ctx->chunk_entry = chunk_entry;
+	ctx->base_hpage_idx = base_hpage_idx;
+	ctx->current_hpage = start_hpage;
+	ctx->total_hpages = nr_hpages;
+	ctx->layer_size = cxl_mb->layer_size;
+	ctx->layers_per_hpage = layers_per_hpage;
+	ctx->total_layers = layers_per_hpage * nr_hpages;
+	ctx->current_layer = start_hpage * layers_per_hpage;
+
+	NVMEV_INFO("Layered I/O: prefetch start base_hpage=%lu+%u "
+		   "hpages=%u layers=%u layer_size=%zu\n",
+		   base_hpage_idx, start_hpage, nr_hpages,
+		   ctx->total_layers, ctx->layer_size);
+
+	/* Allocate DRAM slot, setup page, and start first layer read */
+	return __layered_alloc_and_start(ctx,
+					 base_hpage_idx + start_hpage);
+}
+
+/**
+ * cxl_process_prefetch_queue() - Process pending prefetch requests from userspace
+ * @nvmev_vdev: NVMeVirt device
+ * @max_prefetch: Maximum number of entries to process (0 = unlimited)
+ *
+ * When layer_size > 0: pops chunk_hash values from the SPSC prefetch queue,
+ * looks up the chunk entry, and starts layer-by-layer prefetch.
+ * When layer_size == 0: legacy path — pops vaddr values and loads full 2MB.
+ *
+ * Returns: Number of chunks/pages successfully dispatched for prefetch
+ */
+unsigned long cxl_process_prefetch_queue(struct nvmev_dev *nvmev_vdev,
+					 unsigned long max_prefetch)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_prefetch_queue *pq;
+	unsigned long nr_prefetched = 0;
+	unsigned long nr_dram_hits = 0;
+	unsigned long head, tail;
+	int ret;
+
+	if (!cxl_mb)
+		return 0;
+
+	pq = cxl_mb->prefetch_queue;
+	if (!pq)
+		return 0;
+
+	if (cxl_mb->nr_mmap_entries == 0)
+		return 0;
+
+	/* Minimal reserve: only stop prefetch when pool is nearly empty.
+	 * 64 slots (~128 MB) reserved for demand faults. */
+	if (cxl_mb->nr_free < 64)
+		return 0;
+
+	head = READ_ONCE(pq->head);
+	tail = READ_ONCE(pq->tail);
+
+	while (head != tail) {
+		if (max_prefetch && nr_prefetched >= max_prefetch)
+			break;
+
+		/* MISS_NEXTN mode: entries are encoded hugepage indices */
+		if (cxl_mb->prefetch_mode == CXL_PREFETCH_MODE_MISS_NEXTN) {
+			__u64 encoded = READ_ONCE(pq->entries[head & pq->mask]);
+			unsigned long hpage_idx;
+			unsigned long long last_lat;
+
+			if (encoded == CXL_CHUNK_EMPTY)
+				break;
+
+			hpage_idx = (unsigned long)(encoded - 1);
+
+			/* Prefetch throttles removed for testing:
+			 * - MAX_PREFETCH_INFLIGHT cap
+			 * - Adaptive channel-aware latency threshold
+			 * Rely on I/O worker queue capacity (enlarged via kvzalloc)
+			 * and CLOCK with max_scan = nr_dram_hpages * 2. */
+
+			if (hpage_idx < cxl_mb->nr_hpages &&
+			    atomic_read(&cxl_mb->hpage_table[hpage_idx].state)
+			    != CXL_HPAGE_CACHED) {
+				if (cxl_async_load_hpage(nvmev_vdev, hpage_idx,
+							 false) == 0) {
+					nr_prefetched++;
+					atomic_inc(&cxl_mb->prefetch_inflight);
+				}
+			} else {
+				nr_dram_hits++;
+			}
+
+			goto advance;
+		}
+
+		{
+			/*
+			 * Entries are chunk_hash values.  Look up the chunk,
+			 * extract vaddr/nr_hpages, then either do layer-by-
+			 * layer prefetch or full 2MB loads depending on
+			 * layer_size.
+			 */
+			__u64 chunk_hash;
+			struct cxl_chunk_entry *chunk_entry;
+			__u64 vaddr, offset;
+			unsigned long hpage_idx;
+			unsigned int nr_hpages;
+
+			chunk_hash = READ_ONCE(pq->entries[head & pq->mask]);
+
+			/* MPSC: 0 may be an unwritten CAS-claimed slot.
+			 * Break to defer until the entry is written. */
+			if (chunk_hash == CXL_CHUNK_EMPTY)
+				break;
+			if (chunk_hash == CXL_CHUNK_TOMBSTONE)
+				goto advance;
+
+			chunk_entry = cxl_chunk_lookup(cxl_mb, chunk_hash);
+			if (!chunk_entry) {
+				NVMEV_DEBUG("Prefetch: chunk_hash %llx "
+					    "not found\n", chunk_hash);
+				goto advance;
+			}
+
+			vaddr = CXL_CHUNK_VADDR(chunk_entry);
+			nr_hpages = CXL_CHUNK_NR_HPAGES(chunk_entry);
+
+			if (!vaddr)
+				goto advance;
+
+			/* Find which mmap entry this vaddr belongs to */
+			{
+				int mi;
+				unsigned long base = 0;
+
+				for (mi = 0; mi < cxl_mb->nr_mmap_entries; mi++) {
+					unsigned long b = cxl_mb->mmap_entries[mi].base;
+					if (b && vaddr >= b) {
+						base = b;
+						break;
+					}
+				}
+				if (!base)
+					goto advance;
+				offset = vaddr - base;
+			}
+			if (offset < cxl_mb->metadata_size)
+				goto advance;
+
+			hpage_idx = (offset - cxl_mb->metadata_size) >>
+				    CXL_HPAGE_SHIFT;
+			if (hpage_idx >= cxl_mb->nr_hpages)
+				goto advance;
+
+			/* Skip if ALL hugepages already cached */
+			{
+				unsigned int h;
+				bool all_cached = true;
+
+				for (h = 0; h < nr_hpages; h++) {
+					unsigned long idx = hpage_idx + h;
+
+					if (idx >= cxl_mb->nr_hpages)
+						break;
+					if (atomic_read(&cxl_mb->hpage_table[idx].state)
+					    != CXL_HPAGE_CACHED) {
+						all_cached = false;
+						break;
+					}
+				}
+				if (all_cached) {
+					nr_dram_hits++;
+					goto advance;
+				}
+			}
+
+			if (cxl_mb->layer_size > 0) {
+				/* Reset layer progress before starting */
+				WRITE_ONCE(chunk_entry->prefetch_layer, 0);
+				ret = cxl_layered_prefetch_chunk(
+					nvmev_vdev, chunk_entry,
+					hpage_idx, nr_hpages);
+			} else {
+				unsigned int h;
+
+				ret = 0;
+				for (h = 0; h < nr_hpages && ret == 0; h++) {
+					unsigned long idx = hpage_idx + h;
+
+					if (idx >= cxl_mb->nr_hpages)
+						break;
+					if (atomic_read(&cxl_mb->hpage_table[idx].state)
+					    == CXL_HPAGE_CACHED)
+						continue;
+					ret = cxl_async_load_hpage(
+						nvmev_vdev, idx, false);
+				}
+			}
+
+			if (ret == 0) {
+				nr_prefetched++;
+			} else {
+				NVMEV_DEBUG("Prefetch: chunk hpage %lu failed: %d\n",
+					    hpage_idx, ret);
+			}
+		}
+
+advance:
+		head = head + 1;
+		WRITE_ONCE(pq->head, head);
+		tail = READ_ONCE(pq->tail);
+	}
+
+	if (nr_prefetched > 0 || nr_dram_hits > 0)
+		NVMEV_DEBUG("Prefetch queue: %lu dispatched for NAND load, %lu already in DRAM\n",
+			   nr_prefetched, nr_dram_hits);
+
+	return nr_prefetched;
+}
+
+/**
+ * cxl_prefetch_queue_push_hpage() - Push a hugepage index onto the prefetch queue
+ * @cxl_mb: CXL memory backend
+ * @hpage_idx: Hugepage index to enqueue
+ *
+ * MPSC-safe: uses prefetch_push_lock for concurrent fault handler producers.
+ * Encodes as hpage_idx + 1 so that 0 remains the CXL_CHUNK_EMPTY sentinel.
+ *
+ * Returns: 0 on success, -ENOSPC if queue is full
+ */
+static int cxl_prefetch_queue_push_hpage(struct cxl_memory_backend *cxl_mb,
+					 unsigned long hpage_idx)
+{
+	struct cxl_prefetch_queue *pq = cxl_mb->prefetch_queue;
+	unsigned long tail, head;
+
+	spin_lock(&cxl_mb->prefetch_push_lock);
+	tail = READ_ONCE(pq->tail);
+	head = READ_ONCE(pq->head);
+
+	if ((tail - head) >= pq->capacity) {
+		spin_unlock(&cxl_mb->prefetch_push_lock);
+		return -ENOSPC;
+	}
+
+	/* Encode as hpage_idx + 1; consumer subtracts 1 */
+	WRITE_ONCE(pq->entries[tail & pq->mask], (__u64)(hpage_idx + 1));
+	smp_wmb();
+	WRITE_ONCE(pq->tail, tail + 1);
+	spin_unlock(&cxl_mb->prefetch_push_lock);
+
+	return 0;
+}
+
+void cxl_prefetch_nextn_on_miss(struct nvmev_dev *nvmev_vdev,
+				 unsigned long miss_hpage_idx,
+				 bool is_write_fault)
+{
+	struct cxl_memory_backend *cxl_mb;
+	unsigned long nr_enqueued = 0;
+	unsigned long nr_candidates = 0;
+	unsigned long nr_cached = 0;
+	unsigned long nr_qfull = 0;
+	u32 degree;
+	u32 i;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->prefetch_mode != CXL_PREFETCH_MODE_MISS_NEXTN)
+		return;
+
+	/* Skip during GUP (cudaHostRegister) — latency is disabled */
+	if (!READ_ONCE(cxl_mb->latency_enabled))
+		return;
+
+	degree = cxl_mb->prefetch_degree;
+	if (degree == 0)
+		return;
+
+	/* Only prefetch on read misses — write-allocate faults have no
+	 * useful NAND data to prefetch from adjacent pages. */
+	if (is_write_fault)
+		return;
+
+	for (i = 1; i <= degree; i++) {
+		unsigned long next_hpage_idx;
+
+		if (miss_hpage_idx < i)
+			break;
+
+		next_hpage_idx = miss_hpage_idx - i;
+		nr_candidates++;
+
+		if (atomic_read(&cxl_mb->hpage_table[next_hpage_idx].state) ==
+		    CXL_HPAGE_CACHED) {
+			nr_cached++;
+			continue;
+		}
+
+		{
+			int ret = cxl_prefetch_queue_push_hpage(cxl_mb,
+							next_hpage_idx);
+			if (ret == 0)
+				nr_enqueued++;
+			else
+				nr_qfull++;
+		}
+	}
+
+	NVMEV_DEBUG("MISS_NEXTN: miss_hpage=%lu degree=%u candidates=%lu "
+		   "enqueued=%lu cached=%lu qfull=%lu\n",
+		   miss_hpage_idx, degree, nr_candidates,
+		   nr_enqueued, nr_cached, nr_qfull);
+}
+
+/**
+ * cxl_drain_nand_retry_list() - Re-submit deferred NAND operations
+ * @cxl_mb: CXL memory backend
+ *
+ * Called from the dispatcher thread before processing new prefetches.
+ * Drains up to 64 entries per iteration to avoid monopolizing the dispatcher.
+ * Entries that still can't be queued are put back at the head of the list.
+ */
+static void cxl_drain_nand_retry_list(struct cxl_memory_backend *cxl_mb)
+{
+	struct cxl_nand_retry_entry *re, *tmp;
+	int drained = 0;
+	const int max_drain = 64;
+	LIST_HEAD(local);
+
+	if (list_empty(&cxl_mb->nand_retry_list))
+		return;
+
+	spin_lock(&cxl_mb->retry_lock);
+	list_splice_init(&cxl_mb->nand_retry_list, &local);
+	spin_unlock(&cxl_mb->retry_lock);
+
+	list_for_each_entry_safe(re, tmp, &local, node) {
+		unsigned long long now = local_clock();
+		if (drained >= max_drain)
+			break;
+		/* Check if nsecs_target is already in the past (latency lost) */
+		if (re->nsecs_target <= now) {
+			NVMEV_DEBUG("Retry stale: page=%lu %s nsecs_target=%llu now=%llu late_by=%llu us\n",
+				   re->page_idx, re->is_write ? "write" : "read",
+				   re->nsecs_target, now,
+				   (now - re->nsecs_target) / 1000);
+		}
+		if (__try_schedule_cxl_nand(re->page_idx, re->is_write,
+					    re->nsecs_target,
+					    re->completion_fn,
+					    re->completion_data)) {
+			list_del(&re->node);
+			kfree(re);
+			drained++;
+		} else {
+			break;  /* queue still full, stop trying */
+		}
+	}
+
+	/* Put undrained entries back at the head */
+	if (!list_empty(&local)) {
+		spin_lock(&cxl_mb->retry_lock);
+		list_splice(&local, &cxl_mb->nand_retry_list);
+		spin_unlock(&cxl_mb->retry_lock);
+	}
+}
+
+/**
+ * cxl_process_queues() - Process prefetch and discard queues
+ * @nvmev_vdev: NVMeVirt device
+ *
+ * Called from the dispatcher thread on every iteration (no rate limit).
+ * Drains the retry list first (stalled NAND ops), then processes new work.
+ */
+void cxl_process_queues(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	/* Drain deferred NAND operations before submitting new ones */
+	cxl_drain_nand_retry_list(cxl_mb);
+
+	cxl_discard_freed_hpages(nvmev_vdev, 16);
+	cxl_process_prefetch_queue(nvmev_vdev, 8);
+}
+
+/**
+ * cxl_check_eviction() - Watermark-based background eviction
+ * @nvmev_vdev: NVMeVirt device
+ *
+ * Called from the dispatcher thread every iteration.  Uses a dual-watermark
+ * scheme to maintain a healthy free DRAM slot pool:
+ *
+ *   nr_free >= high_watermark (15%)  → do nothing
+ *   low_watermark <= nr_free < high  → evict up to 8 pages (steady)
+ *   nr_free < low_watermark (5%)     → evict up to 16 pages (burst)
+ *
+ * This prevents demand faults from needing synchronous eviction in most cases.
+ */
+void cxl_check_eviction(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb;
+	int max_evict, i;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	/* Skip during GUP (cudaHostRegister) — cxl_clear_gup_state will
+	 * reset all pages after GUP completes, no point evicting now. */
+	if (!READ_ONCE(cxl_mb->latency_enabled))
+		return;
+
+	if (cxl_mb->nr_free < cxl_mb->high_wm) {
+		max_evict = (cxl_mb->nr_free < cxl_mb->low_wm) ? 16 : 8;
+		for (i = 0; i < max_evict; i++) {
+			long victim = cxl_clock_victim(cxl_mb, cxl_mb->nr_dram_hpages * 2);
+			if (victim < 0)
+				break;
+			__dispatch_async_eviction(nvmev_vdev, victim);
+		}
+		if (i > 0)
+			NVMEV_DEBUG("Background eviction: %d pages (free %lu, low_wm %lu, high_wm %lu)\n",
+				    i, cxl_mb->nr_free, cxl_mb->low_wm, cxl_mb->high_wm);
+	}
+}
+
+/*
+ * cxl_prefetch_sequential() is superseded by cxl_process_prefetch_queue(),
+ * which uses explicit userspace hints via the SPSC prefetch ring instead of
+ * blind sequential guessing.  Kept commented out for reference.
+ */
