+	const int poll_interval = 50;  /* 50ms between polls */
+
+	NVMEV_INFO("VH mode: Waiting for kernel PCI enumeration (timeout %dms)...\n", timeout_ms);
+	NVMEV_INFO("  Looking for root port at segment %d, bus 0x%02x\n",
+		   NVMEV_PCI_DOMAIN_NUM, NVMEV_PCI_BUS_NUM);
+	NVMEV_INFO("  Looking for endpoint at segment %d, bus 0x%02x\n",
+		   NVMEV_PCI_DOMAIN_NUM, NVMEV_PCI_SEC_BUS_NUM);
+
+	while (waited < timeout_ms) {
+		/*
+		 * Look for root port at segment 1, bus 0x10, devfn 0
+		 * This appears first as the kernel scans from the primary bus
+		 */
+		if (!rp_pdev) {
+			rp_pdev = pci_get_domain_bus_and_slot(NVMEV_PCI_DOMAIN_NUM,
+							      NVMEV_PCI_BUS_NUM,
+							      PCI_DEVFN(0, 0));
+			if (rp_pdev) {
+				NVMEV_INFO("Found root port after %dms: %s\n",
+					   waited, pci_name(rp_pdev));
+				NVMEV_INFO("  Vendor: 0x%04x, Device: 0x%04x, Class: 0x%06x\n",
+					   rp_pdev->vendor, rp_pdev->device, rp_pdev->class);
+				/* We don't need to hold reference to root port */
+				pci_dev_put(rp_pdev);
+			}
+		}
+
+		/*
+		 * Look for CXL endpoint at segment 1, bus 0x11, devfn 0
+		 * This is the device we actually need for CXL operations
+		 */
+		ep_pdev = pci_get_domain_bus_and_slot(NVMEV_PCI_DOMAIN_NUM,
+						      NVMEV_PCI_SEC_BUS_NUM,
+						      PCI_DEVFN(0, 0));
+		if (ep_pdev) {
+			NVMEV_INFO("Found CXL endpoint after %dms: %s\n",
+				   waited, pci_name(ep_pdev));
+			NVMEV_INFO("  Vendor: 0x%04x, Device: 0x%04x\n",
+				   ep_pdev->vendor, ep_pdev->device);
+			NVMEV_INFO("  Class: 0x%06x\n", ep_pdev->class);
+			return ep_pdev;
+		}
+
+		msleep(poll_interval);
+		waited += poll_interval;
+	}
+
+	NVMEV_ERROR("Timeout waiting for kernel PCI enumeration after %dms\n", timeout_ms);
+	NVMEV_ERROR("VH mode topology:\n");
+	NVMEV_ERROR("  Root port (bus 0x%02x): %s\n", NVMEV_PCI_BUS_NUM,
+		    rp_pdev ? "found" : "NOT FOUND");
+	NVMEV_ERROR("  Endpoint (bus 0x%02x): NOT FOUND\n", NVMEV_PCI_SEC_BUS_NUM);
+	NVMEV_ERROR("Check that:\n");
+	NVMEV_ERROR("  - SSDT was loaded correctly\n");
+	NVMEV_ERROR("  - ECAM config space contains valid data for both buses\n");
+	NVMEV_ERROR("  - Root port bridges bus 0x%02x -> 0x%02x\n",
+		    NVMEV_PCI_BUS_NUM, NVMEV_PCI_SEC_BUS_NUM);
+	return NULL;
+}
