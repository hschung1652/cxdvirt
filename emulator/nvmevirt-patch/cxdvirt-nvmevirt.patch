 static void NVMeV_exit(void)
 {
 	int i;
 
+	/*
+	 * Shutdown sequence:
+	 *   1. Stop dispatcher — no new work submitted (evictions, prefetch)
+	 *   2. Drain inflight I/O — workers continue processing queued ops
+	 *   3. Signal shutdown + stop workers
+	 *
+	 * If we set shutting_down before draining, workers exit immediately
+	 * and 30K+ inflight CXL NAND ops are abandoned — their completion
+	 * callbacks never fire, hpage states get stuck, and the subsequent
+	 * cleanup frees structures still referenced by the orphaned ops.
+	 */
+
+	/* Step 1: Stop dispatcher (no new submissions) */
+	NVMEV_DISPATCHER_FINAL(nvmev_vdev);
+
+	/* Step 2: Wait for inflight I/O to drain (workers still running) */
+	{
+		int inflight;
+		int retries = 0;
+		const int max_retries = 100;  /* 100 * 100ms = 10 seconds */
+
+		inflight = nvmev_total_inflight(nvmev_vdev);
+		if (inflight > 0)
+			NVMEV_INFO("Draining %d inflight I/O operations...\n",
+				   inflight);
+
+		while (inflight > 0 && retries < max_retries) {
+			msleep(100);
+			retries++;
+			inflight = nvmev_total_inflight(nvmev_vdev);
+			if (retries % 10 == 0)
+				NVMEV_INFO("  still draining: %d inflight (%d.%ds)\n",
+					   inflight, retries / 10, retries % 10);
+		}
+
+		if (inflight > 0)
+			NVMEV_ERROR("Timeout: %d inflight ops remaining after "
+				    "%d.%ds — proceeding with shutdown\n",
+				    inflight, retries / 10, retries % 10);
+		else if (retries > 0)
+			NVMEV_INFO("All inflight I/O drained after %d.%ds\n",
+				   retries / 10, retries % 10);
+	}
+
+	/* Step 3: Now signal shutdown and stop workers */
+	WRITE_ONCE(nvmev_vdev->shutting_down, true);
+	smp_wmb();
+	NVMEV_IO_WORKER_FINAL(nvmev_vdev);
+
 	if (nvmev_vdev->virt_bus != NULL) {
 		pci_stop_root_bus(nvmev_vdev->virt_bus);
 		pci_remove_root_bus(nvmev_vdev->virt_bus);
 	}
 
-	NVMEV_DISPATCHER_FINAL(nvmev_vdev);
-	NVMEV_IO_WORKER_FINAL(nvmev_vdev);
+#ifdef CONFIG_NVMEV_CXL_SUPPORT
