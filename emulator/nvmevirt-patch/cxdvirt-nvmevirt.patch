diff --git a/cxl_root.asl b/cxl_root.asl
new file mode 100644
index 0000000..2312dac
--- /dev/null
+++ b/cxl_root.asl
@@ -0,0 +1,47 @@
+/*
+ * CXL Root Device SSDT for NVMeVirt
+ *
+ * This ACPI Source Language (ASL) file defines the ACPI0017 CXL root device
+ * in a SEPARATE table from the ACPI0016 host bridge (cxl_hostbridge.asl).
+ *
+ * Why separate tables?
+ *   acpi_load_table() schedules an async acpi_table_events_fn on a kernel
+ *   workqueue that does acpi_bus_scan(ACPI_ROOT_OBJECT), scanning ALL
+ *   namespace objects. If ACPI0017 exists when ACPI0016's table is loaded,
+ *   cxl_acpi probes before the PCI bus is ready, causing a NULL dereference
+ *   in add_host_bridge_dport.
+ *
+ *   By loading this table AFTER the PCI bus for ACPI0016 is confirmed ready,
+ *   the race is eliminated.
+ *
+ * Compile with:
+ *   iasl -tc cxl_root.asl
+ *
+ * References:
+ *   - CXL Specification 3.0
+ *   - Linux kernel: drivers/cxl/acpi.c
+ */
+
+DefinitionBlock ("cxl_root.aml", "SSDT", 2, "NVMEV", "CXLRT", 1)
+{
+    Scope (\_SB)
+    {
+        /*
+         * Device: CXL Platform Device / Root (CXLR)
+         *
+         * This is the root CXL device that the cxl_acpi driver binds to.
+         *   - Hardware ID: ACPI0017 (CXL Platform Device)
+         *   - The cxl_acpi driver binds to this and enumerates child ACPI0016 devices
+         */
+        Device (CXLR)
+        {
+            Name (_HID, "ACPI0017")  /* CXL Platform Device */
+            Name (_UID, 0)            /* Root device UID */
+
+            Method (_STA, 0, NotSerialized)
+            {
+                Return (0x0F)  /* Present, enabled, functioning */
+            }
+        }
+    }
+}
