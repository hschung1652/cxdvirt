+#ifdef CONFIG_NVMEV_CXL_SUPPORT
+/**
+ * nvmev_copy_config_to_ecam - Copy config space to physical memory for VH mode
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * VH (Virtual Hierarchy) Mode ECAM Layout:
+ *   memmap_start + 0x000000: Bus 16 ECAM (1MB) - Root Port (Type 1 bridge)
+ *   memmap_start + 0x100000: Bus 17 ECAM (1MB) - CXL Endpoint (Type 0)
+ *   memmap_start + 0x200000: Component registers (64KB) - BAR0
+ *   memmap_start + 0x210000: Device registers (64KB)    - BAR2
+ *   memmap_start + 0x220000: MSI-X Table (4KB)          - BAR4
+ *
+ * For ECAM-based config space access, the kernel reads config space from
+ * physical memory at: ecam_base + (bus << 20) | (dev << 15) | (func << 12)
+ *
+ * This creates a proper PCIe hierarchy where the root port at bus 16 bridges
+ * to bus 17 where the CXL endpoint resides. This topology matches what
+ * the Linux CXL driver expects for VH (CXL 2.0) mode.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_copy_config_to_ecam(struct nvmev_dev *nvmev_vdev)
+{
+	void __iomem *rp_ecam_region;    /* Root port config at bus 16 */
+	void __iomem *ep_ecam_region;    /* Endpoint config at bus 17 */
+	u64 base_pa = nvmev_vdev->config.memmap_start;
+	int rc;
+
+	if (!nvmev_vdev->virtDev) {
+		NVMEV_ERROR("virtDev not initialized\n");
+		return -EINVAL;
+	}
+
+	if (!base_pa) {
+		NVMEV_ERROR("memmap_start not set\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * Step 1: Initialize root port config space
+	 * This creates a Type 1 (PCI-to-PCI bridge) header that bridges
+	 * from bus 16 to bus 17.
+	 */
+	rc = ROOT_PORT_INIT(nvmev_vdev, base_pa);
+	if (rc) {
+		NVMEV_ERROR("Failed to initialize root port config: %d\n", rc);
+		return rc;
+	}
+
+	/*
+	 * Step 2: Map and zero the ENTIRE ECAM region for both buses.
+	 *
+	 * Each bus has 1MB of ECAM space (32 devices × 8 functions × 4KB).
+	 * The kernel scans ALL devfn slots during enumeration. Any slot
+	 * whose Vendor ID is not 0xFFFF is treated as a real device.
+	 * Since this is reserved memory (memmap=), it contains garbage
+	 * from previous boot cycles — the kernel sees dozens of ghost
+	 * devices with random header types, causing "not ready" polling
+	 * loops that block enumeration for minutes.
+	 *
+	 * Fix: map the full 2MB (buses 16-17), fill with 0xFF (so every
+	 * devfn reads Vendor ID = 0xFFFF = "no device"), then write the
+	 * real config at devfn 0 for each bus.
+	 */
+	{
+		void __iomem *full_ecam;
+
+		full_ecam = ioremap(base_pa, VH_ECAM_REGION_SIZE);
+		if (!full_ecam) {
+			NVMEV_ERROR("Failed to map full ECAM region at 0x%llx\n",
+				    base_pa);
+			kfree(nvmev_vdev->root_port_config);
+			nvmev_vdev->root_port_config = NULL;
+			return -ENOMEM;
+		}
+		memset_io(full_ecam, 0xFF, VH_ECAM_REGION_SIZE);
+		wmb();
+		iounmap(full_ecam);
+
+		NVMEV_INFO("ECAM region zeroed (0xFF) for buses 16-17 "
+			   "(2MB at 0x%llx)\n", base_pa);
+	}
+
+	/*
+	 * Step 3: Map individual devfn 0 regions for root port and endpoint.
+	 */
+	rp_ecam_region = ioremap(base_pa, ECAM_CONFIG_SPACE_SIZE);
+	if (!rp_ecam_region) {
+		NVMEV_ERROR("Failed to map root port ECAM region at 0x%llx\n", base_pa);
+		kfree(nvmev_vdev->root_port_config);
+		nvmev_vdev->root_port_config = NULL;
+		return -ENOMEM;
+	}
+
+	ep_ecam_region = ioremap(base_pa + BUS17_ECAM_OFFSET, ECAM_CONFIG_SPACE_SIZE);
+	if (!ep_ecam_region) {
+		NVMEV_ERROR("Failed to map endpoint ECAM region at 0x%llx\n",
+			    base_pa + BUS17_ECAM_OFFSET);
+		iounmap(rp_ecam_region);
+		kfree(nvmev_vdev->root_port_config);
+		nvmev_vdev->root_port_config = NULL;
+		return -ENOMEM;
+	}
+
+	/*
+	 * Step 4: Copy root port config space to bus 16 ECAM
+	 */
+	memcpy_toio(rp_ecam_region, nvmev_vdev->root_port_config, ECAM_CONFIG_SPACE_SIZE);
+	wmb();
+
+	NVMEV_INFO("Root port config copied to ECAM bus 16 at 0x%llx\n", base_pa);
+
+	/* Verify root port */
+	{
+		u32 val;
+		val = readl(rp_ecam_region + 0x00);  /* Vendor/Device */
+		NVMEV_INFO("Root Port ECAM verify: VID/DID = 0x%08x\n", val);
+
+		val = readl(rp_ecam_region + 0x08);  /* Rev/Class */
+		NVMEV_INFO("Root Port ECAM verify: Class = 0x%08x (expect 0x0604xx)\n", val);
+
+		val = readl(rp_ecam_region + 0x18);  /* Primary/Secondary/Subordinate bus */
+		NVMEV_INFO("Root Port ECAM verify: Bus = 0x%08x (pri=0x%02x sec=0x%02x sub=0x%02x)\n",
+			   val, val & 0xFF, (val >> 8) & 0xFF, (val >> 16) & 0xFF);
+	}
+
+	/*
+	 * Step 5: Copy endpoint config space to bus 17 ECAM
+	 */
+	memcpy_toio(ep_ecam_region, nvmev_vdev->virtDev, ECAM_CONFIG_SPACE_SIZE);
+	wmb();
+
+	NVMEV_INFO("Endpoint config copied to ECAM bus 17 at 0x%llx\n",
+		   base_pa + BUS17_ECAM_OFFSET);
+
+	/* Verify endpoint */
+	{
+		u32 val, val2, next;
+		u64 bar_addr;
+
+		val = readl(ep_ecam_region + 0x00);  /* Vendor/Device */
+		NVMEV_INFO("Endpoint ECAM verify: VID/DID = 0x%08x (expect 0x01100c51)\n", val);
+
+		/* Verify BAR0 */
+		val = readl(ep_ecam_region + 0x10);
+		val2 = readl(ep_ecam_region + 0x14);
+		bar_addr = ((u64)val2 << 32) | (val & PCI_BASE_ADDRESS_MEM_MASK);
+		NVMEV_INFO("Endpoint BAR0: 0x%llx (expect 0x%llx)\n",
+			   bar_addr, (u64)(base_pa + BAR0_OFFSET));
+
+		/* Verify BAR2 */
+		val = readl(ep_ecam_region + 0x18);
+		val2 = readl(ep_ecam_region + 0x1C);
+		bar_addr = ((u64)val2 << 32) | (val & PCI_BASE_ADDRESS_MEM_MASK);
+		NVMEV_INFO("Endpoint BAR2: 0x%llx (expect 0x%llx)\n",
+			   bar_addr, (u64)(base_pa + BAR2_OFFSET));
+
+		/* Trace extended capability chain */
+		NVMEV_INFO("Endpoint ext cap chain:\n");
+		next = 0x100;
+		while (next && next < 0x1000) {
+			val = readl(ep_ecam_region + next);
+			NVMEV_INFO("  0x%03x: cap=0x%04x ver=%d next=0x%03x\n",
+				   next, val & 0xFFFF, (val >> 16) & 0xF, val >> 20);
+			next = val >> 20;
+		}
+
+		/* Find and dump Register Locator DVSEC (ID 8) */
+		NVMEV_INFO("Looking for Register Locator DVSEC (ID 8):\n");
+		next = 0x100;
+		while (next && next < 0x1000) {
+			u32 dvsec_hdr, dvsec_id_val;
+			val = readl(ep_ecam_region + next);
+			if ((val & 0xFFFF) == 0x0023) {  /* DVSEC cap */
+				dvsec_hdr = readl(ep_ecam_region + next + 4);
+				dvsec_id_val = readl(ep_ecam_region + next + 8);
+				if ((dvsec_id_val & 0xFFFF) == 8) {  /* Register Locator */
+					u32 entry_lo, entry_hi;
+					NVMEV_INFO("  Found Register Locator at 0x%x\n", next);
+					entry_lo = readl(ep_ecam_region + next + 12);
+					entry_hi = readl(ep_ecam_region + next + 16);
+					NVMEV_INFO("    Entry 1 (Component): BIR=%d, BlockID=%d, Offset=0x%llx\n",
+						   entry_lo & 0x7, (entry_lo >> 8) & 0xFF,
+						   (((u64)(entry_lo >> 16) << 16) | ((u64)entry_hi << 32)));
+					entry_lo = readl(ep_ecam_region + next + 20);
+					entry_hi = readl(ep_ecam_region + next + 24);
+					NVMEV_INFO("    Entry 2 (Device): BIR=%d, BlockID=%d, Offset=0x%llx\n",
+						   entry_lo & 0x7, (entry_lo >> 8) & 0xFF,
+						   (((u64)(entry_lo >> 16) << 16) | ((u64)entry_hi << 32)));
+					break;
+				}
+			}
+			next = val >> 20;
+		}
+	}
+
+	/* Store mappings for later sync operations */
+	nvmev_vdev->root_port_ecam = rp_ecam_region;
+	nvmev_vdev->endpoint_ecam = ep_ecam_region;
+	nvmev_vdev->ecam_config_region = ep_ecam_region;  /* Keep for backward compat */
+
+	NVMEV_INFO("VH mode ECAM setup complete:\n");
+	NVMEV_INFO("  Root port at bus 16 (0x%llx)\n", base_pa);
+	NVMEV_INFO("  Endpoint at bus 17 (0x%llx)\n", base_pa + BUS17_ECAM_OFFSET);
+
+	return 0;
+}
+
+/**
+ * nvmev_sync_config_to_ecam - Sync config space changes to ECAM region
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Call this after modifying virtDev or root_port_config to keep ECAM in sync.
+ * In VH mode, syncs both root port (bus 16) and endpoint (bus 17) config spaces.
+ */
+void nvmev_sync_config_to_ecam(struct nvmev_dev *nvmev_vdev)
+{
+	/* Sync root port config to bus 16 */
+	if (nvmev_vdev->root_port_ecam && nvmev_vdev->root_port_config) {
+		memcpy_toio(nvmev_vdev->root_port_ecam,
+			    nvmev_vdev->root_port_config, ECAM_CONFIG_SPACE_SIZE);
+		wmb();
+	}
+
+	/* Sync endpoint config to bus 17 */
+	if (nvmev_vdev->endpoint_ecam && nvmev_vdev->virtDev) {
+		memcpy_toio(nvmev_vdev->endpoint_ecam,
+			    nvmev_vdev->virtDev, ECAM_CONFIG_SPACE_SIZE);
+		wmb();
+	}
+}
+
+/**
+ * nvmev_cleanup_ecam - Clean up ECAM mappings for VH mode
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * Unmaps ECAM regions and frees root port config buffer.
+ */
+void nvmev_cleanup_ecam(struct nvmev_dev *nvmev_vdev)
+{
+	if (nvmev_vdev->root_port_ecam) {
+		iounmap(nvmev_vdev->root_port_ecam);
+		nvmev_vdev->root_port_ecam = NULL;
+	}
+
+	if (nvmev_vdev->endpoint_ecam) {
+		iounmap(nvmev_vdev->endpoint_ecam);
+		nvmev_vdev->endpoint_ecam = NULL;
+	}
+
+	nvmev_vdev->ecam_config_region = NULL;
+
+	if (nvmev_vdev->root_port_config) {
+		kfree(nvmev_vdev->root_port_config);
+		nvmev_vdev->root_port_config = NULL;
+	}
+}
+#endif /* CONFIG_NVMEV_CXL_SUPPORT */
+
 bool NVMEV_PCI_INIT(struct nvmev_dev *nvmev_vdev)
