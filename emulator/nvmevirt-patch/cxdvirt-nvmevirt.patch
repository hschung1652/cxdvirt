+static int nvmev_total_inflight(struct nvmev_dev *dev)
+{
+	int total = 0;
+	unsigned int i;
+
+	for (i = 0; i < dev->config.nr_io_workers; i++)
+		total += atomic_read(&dev->io_workers[i].nr_inflight);
+	return total;
+}
