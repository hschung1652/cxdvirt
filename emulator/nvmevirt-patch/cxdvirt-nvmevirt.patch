diff --git a/cxl_page_fault.c b/cxl_page_fault.c
new file mode 100644
index 0000000..bb59a9f
--- /dev/null
+++ b/cxl_page_fault.c
@@ -0,0 +1,1900 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL-SSD Page Fault Handler with NAND Latency Simulation (2MB Huge Pages Only)
+ *
+ * All DRAM cache management operates exclusively at 2MB huge page granularity.
+ * The 4KB .fault handler is a stub returning VM_FAULT_SIGBUS.
+ *
+ * - DRAM cache metadata starts pre-populated (first N huge pages in DRAM)
+ * - PMD entries are installed lazily on first access via .huge_fault
+ * - Page faults for NAND-only pages trigger 2MB NAND read with latency simulation
+ * - Eviction removes PMD entries and writes back dirty 2MB regions
+ */
+
+#include <linux/mm.h>
+#include <linux/huge_mm.h>
+#include <linux/sched/clock.h>
+#include <asm/msr.h>          /* rdtsc_ordered(): shared timebase with userspace */
+#include <linux/delay.h>
+#include <linux/vmalloc.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <asm/tlbflush.h>
+#include <asm/pgtable.h>
+
+#include "nvmev.h"
+#include "cxlssd_ftl.h"
+
+/*
+ * ============================================================================
+ * Option-B: per-miss in-context stage decomposition (4K mode)
+ * ============================================================================
+ * nvmevirt services a miss entirely in-context (no cross-thread handoff), so
+ * the analog of Cylon's {inbound, service, outbound} is:
+ *   dispatch = handler logic before the modeled latency (lookup, state CAS,
+ *              credit reserve+enforce)
+ *   modeled  = the in-context udelay (the device latency itself; ~0 at NOLAT)
+ *   install  = pin re-check + vmf_insert_pfn (PTE install)
+ *   total    = dispatch + install  (pure emulation overhead, EXCLUDES modeled)
+ * One record per real miss (NOT_CACHED->LOADING path); CACHED fast-path re-faults
+ * are not recorded.  Dumped as CSV via /proc/nvmev/optb4k; any write resets it.
+ */
+/*
+ * Per-miss stage decomposition.  `evict` is broken out of `dispatch` so that
+ * `total` is emulation overhead ONLY at any NAND latency - matching the
+ * contract the analysis tooling assumes.  Without the split, the in-context
+ * victim write-back (cxl_enforce_4k_budget -> cxl_evict_4k_page_sync, one
+ * tPROG per dirty victim) is buried inside `dispatch`, which makes `total`
+ * device-latency-bearing and not comparable against emulators that keep
+ * write-back off the critical path.
+ *
+ *   dispatch : lookup, bounds check, state CAS, credit reserve   (overhead)
+ *   evict    : in-context victim write-back stall                (device)
+ *   modeled  : this miss's own NAND read udelay                  (device)
+ *   install  : pin re-check + vmf_insert_pfn                     (overhead)
+ *   total    : dispatch + install                                (overhead)
+ */
+/*
+ * Extra fields let a userspace harness reconstruct the guest-FELT latency the
+ * way Cylon's refault breakdown does, but without Cylon's guest/host TSC join:
+ * both sides read the same invariant TSC, so records match directly.
+ *
+ *   page_idx : join key (which page this fault was for)
+ *   tsc_in   : rdtsc at handler entry;  tsc_dur = cycles to handler exit
+ *   wait     : blocked on ANOTHER thread's in-flight fill/evict
+ *              (analogue of Cylon's "primary-fill stall")
+ *   outcome  : 0 filled, 1 VM_FAULT_RETRY, 2 CACHED re-fault.  Several records
+ *              sharing a key inside one userspace TSC window = a multi-fault
+ *              access (analogue of "multi-exit refault").
+ *   tid      : the faulting thread (current->pid, i.e. what gettid() returns).
+ *              page_idx alone is NOT a sufficient join key: when two threads
+ *              fault the same page their windows overlap and one record would
+ *              be attributed to every one of them.  Joining on (tid, page_idx)
+ *              makes each record belong to exactly one access.
+ *
+ * felt - SUM(tsc_dur of matched records) = entry/exit, TLB and resume cost
+ * outside the handler (analogue of Cylon's "re-entry gap").
+ */
+struct optb4k_rec {
+	u64 tsc_in;
+	u32 tsc_dur;
+	u32 page_idx;
+	u32 dispatch, wait, evict, modeled, install, total;
+	u32 outcome;
+	u32 tid;          /* fits free: 44B was already padded to 48 */
+};
+/*
+ * Record-buffer capacity, in records of 48 B, allocated on the first miss.
+ * 0444: fixed for the life of the module, so the recording cap and the dump's
+ * clamp cannot disagree.  The 2M default (96 MB) holds a 410 MB felt capture;
+ * the 4.8 GiB Fig. 6 capture records 7400 MB x 3 passes = 5.7M misses and is
+ * loaded with optb4k_max=8388608 (384 MB).  Past the cap recording stops, it
+ * does not wrap.  0 disables recording.
+ */
+static unsigned int optb4k_max = 2u << 20;
+module_param(optb4k_max, uint, 0444);
+MODULE_PARM_DESC(optb4k_max,
+		 "/proc/nvmev/optb4k capacity in per-miss records, 48 B each (default 2097152)");
+#define OPTB4K_MAX ((u64)optb4k_max)
+static struct optb4k_rec *g_optb4k;
+static atomic64_t g_optb4k_idx = ATOMIC64_INIT(0);
+static int g_optb4k_on = 1;
+
+/*
+ * The join needs two serialising TSC stamps per miss, on top of the six
+ * local_clock() stamps the stage decomposition already takes.  Keep them
+ * switchable: a figure whose subject IS the fault-path overhead should be
+ * captured with optb_tsc=0 so the measurement does not carry its own cost.
+ * Toggle between captures - /proc/nvmev/optb4k is reset by writing to it.
+ */
+static bool optb_tsc = true;
+module_param(optb_tsc, bool, 0644);
+MODULE_PARM_DESC(optb_tsc,
+		 "stamp rdtsc at 4K fault entry/exit for the userspace felt-latency join (default 1)");
+
+static inline u64 optb4k_tsc(void)
+{
+	return optb_tsc ? rdtsc_ordered() : 0;
+}
+
+static void optb4k_record(u32 pidx, u64 tsc_in, u32 tsc_dur, u32 outcome,
+			  u32 disp, u32 wait, u32 evct, u32 modl, u32 inst)
+{
+	u64 i;
+	if (!g_optb4k_on || !OPTB4K_MAX)
+		return;
+	if (!READ_ONCE(g_optb4k)) {
+		struct optb4k_rec *p = vzalloc((size_t)OPTB4K_MAX * sizeof(*p));
+		if (!p) {
+			g_optb4k_on = 0;
+			return;
+		}
+		if (cmpxchg(&g_optb4k, NULL, p) != NULL)
+			vfree(p);  /* lost the race: another CPU allocated first */
+	}
+	i = atomic64_fetch_add(1, &g_optb4k_idx);
+	if (i >= OPTB4K_MAX)
+		return;  /* cap reached: stop recording */
+	g_optb4k[i].tsc_in = tsc_in;
+	g_optb4k[i].tsc_dur = tsc_dur;
+	g_optb4k[i].page_idx = pidx;
+	g_optb4k[i].dispatch = disp;
+	g_optb4k[i].wait = wait;
+	g_optb4k[i].evict = evct;
+	g_optb4k[i].modeled = modl;
+	g_optb4k[i].install = inst;
+	g_optb4k[i].outcome = outcome;
+	g_optb4k[i].tid = (u32)current->pid;   /* always the faulting thread */
+	g_optb4k[i].total = disp + inst;   /* overhead only: excludes evict+modeled */
+}
+
+void cxl_optb4k_free(void)
+{
+	struct optb4k_rec *p = xchg(&g_optb4k, NULL);
+	if (p)
+		vfree(p);
+}
+
+static void *optb4k_seq_start(struct seq_file *s, loff_t *pos)
+{
+	u64 cnt = atomic64_read(&g_optb4k_idx);
+	if (cnt > OPTB4K_MAX)
+		cnt = OPTB4K_MAX;
+	if (!g_optb4k || *pos >= cnt)
+		return NULL;
+	return &g_optb4k[*pos];
+}
+
+static void *optb4k_seq_next(struct seq_file *s, void *v, loff_t *pos)
+{
+	u64 cnt = atomic64_read(&g_optb4k_idx);
+	if (cnt > OPTB4K_MAX)
+		cnt = OPTB4K_MAX;
+	(*pos)++;
+	if (*pos >= cnt)
+		return NULL;
+	return &g_optb4k[*pos];
+}
+
+static void optb4k_seq_stop(struct seq_file *s, void *v) {}
+
+static int optb4k_seq_show(struct seq_file *s, void *v)
+{
+	struct optb4k_rec *r = v;
+	/* tid,page_idx,outcome,tsc_in,tsc_dur,dispatch,wait,evict,modeled,install,total
+	 * `total` stays LAST: the analysis tooling asserts that. */
+	seq_printf(s, "%u,%u,%u,%llu,%u,%u,%u,%u,%u,%u,%u\n",
+		   r->tid, r->page_idx, r->outcome, r->tsc_in, r->tsc_dur,
+		   r->dispatch, r->wait, r->evict, r->modeled, r->install,
+		   r->total);
+	return 0;
+}
+
+static const struct seq_operations optb4k_seq_ops = {
+	.start = optb4k_seq_start,
+	.next = optb4k_seq_next,
+	.stop = optb4k_seq_stop,
+	.show = optb4k_seq_show,
+};
+
+static int optb4k_proc_open(struct inode *ino, struct file *f)
+{
+	return seq_open(f, &optb4k_seq_ops);
+}
+
+static ssize_t optb4k_proc_write(struct file *f, const char __user *buf,
+				 size_t n, loff_t *off)
+{
+	atomic64_set(&g_optb4k_idx, 0);  /* any write resets for the next run */
+	return n;
+}
+
+const struct proc_ops cxl_optb4k_fops = {
+	.proc_open = optb4k_proc_open,
+	.proc_read = seq_read,
+	.proc_write = optb4k_proc_write,
+	.proc_lseek = seq_lseek,
+	.proc_release = seq_release,
+};
+
+/*
+ * ============================================================================
+ * Section 1: VMA and PMD Invalidation Helpers
+ * ============================================================================
+ */
+
+/* Walk the page table for @vaddr in @mm and report whether the PMD is
+ * present.  Caller must hold mmap_read_lock(mm).  A concurrent fault on
+ * another CPU may race, so a lone observation can be inaccurate at the
+ * margins — aggregate counts over many calls are what matter. */
+static bool __cxl_pmd_present_at(struct mm_struct *mm, unsigned long vaddr)
+{
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd, pmd_val;
+
+	pgd = pgd_offset(mm, vaddr);
+	if (pgd_none(*pgd) || pgd_bad(*pgd))
+		return false;
+	p4d = p4d_offset(pgd, vaddr);
+	if (p4d_none(*p4d) || p4d_bad(*p4d))
+		return false;
+	pud = pud_offset(p4d, vaddr);
+	if (pud_none(*pud) || pud_bad(*pud))
+		return false;
+	pmd = pmd_offset(pud, vaddr);
+	pmd_val = READ_ONCE(*pmd);
+	return pmd_present(pmd_val);
+}
+
+/**
+ * cxl_zap_hpage_ptes - Invalidate PMD entries for a huge page using saved mmap state
+ * @cxl_mb: CXL memory backend (contains saved mm and mmap_base)
+ * @hpage_idx: Huge page index to invalidate
+ *
+ * Uses the mm_struct and mmap_base captured at mmap time to look up the VMA
+ * and zap page table entries, avoiding expensive for_each_process iteration.
+ */
+void cxl_zap_hpage_ptes(struct cxl_memory_backend *cxl_mb, unsigned long hpage_idx)
+{
+	struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+	int n, i;
+
+	if (cxl_mb->nr_mmap_entries == 0)
+		atomic64_inc(&cxl_mb->zap_no_mmap_entries);
+
+	/* Bug 1: snapshot under spinlock + mmgrab to prevent UAF on mm. */
+	n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+
+	for (i = 0; i < n; i++) {
+		struct mm_struct *mm = snap[i].mm;
+		struct vm_area_struct *vma;
+		unsigned long vaddr;
+
+		if (!mm)
+			continue;
+
+		/*
+		 * Temporarily elevate mm_users so the mm is fully usable
+		 * for page table walks.  If mm_users is already 0 (process
+		 * exited, exit_mmap ran), VMAs are gone — skip this mm.
+		 */
+		if (!mmget_not_zero(mm))
+			continue;
+
+		vaddr = snap[i].base + cxl_mb->metadata_size +
+			(hpage_idx << CXL_HPAGE_SHIFT);
+
+		mmap_read_lock(mm);
+		vma = vma_lookup(mm, vaddr);
+		if (vma) {
+			bool before = __cxl_pmd_present_at(mm, vaddr);
+
+			zap_page_range_single(vma, vaddr, CXL_HPAGE_SIZE, NULL);
+
+			if (before) {
+				bool after = __cxl_pmd_present_at(mm, vaddr);
+				if (!after)
+					atomic64_inc(&cxl_mb->zap_effective);
+				else
+					atomic64_inc(&cxl_mb->zap_ineffective);
+			} else {
+				atomic64_inc(&cxl_mb->zap_already_clear);
+			}
+		}
+		mmap_read_unlock(mm);
+		mmput(mm);
+	}
+
+	cxl_mmap_snap_release(snap, n);
+}
+EXPORT_SYMBOL_GPL(cxl_zap_hpage_ptes);
+
+/**
+ * cxl_install_hpage_pmd - Install PMD entry for an async-loaded huge page
+ * @cxl_mb: CXL memory backend (contains saved mm and mmap_base)
+ * @hpage_idx: Huge page index
+ * @dram_slot: DRAM slot (unused for PFN — kept for API compatibility)
+ *
+ * Installs a read-only PMD from outside fault context (e.g. async load
+ * completion callback) so that subsequent reads hit the TLB directly
+ * without triggering a page fault.  The PMD maps to the fixed NAND PFN
+ * for this hpage_idx, so GUP pins remain valid across zap/re-install.
+ *
+ * Requires that intermediate page table levels (PGD/P4D/PUD) already
+ * exist for the target virtual address range — this is the common case
+ * because nearby pages will have faulted earlier, allocating those levels.
+ * If they are missing (no prior fault in the same 1GB PUD range), the
+ * function returns silently and the next fault installs the PMD instead.
+ *
+ * A subsequent write fault will upgrade the read-only PMD to writable
+ * and set entry->dirty = true.
+ */
+void cxl_install_hpage_pmd(struct cxl_memory_backend *cxl_mb,
+			   unsigned long hpage_idx, unsigned long dram_slot)
+{
+	unsigned long pfn = cxl_hpage_nand_pfn(cxl_mb, hpage_idx);
+	struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+	int n, i;
+
+	/* Bug 1: snapshot under spinlock + mmgrab to prevent UAF on mm. */
+	n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+
+	for (i = 0; i < n; i++) {
+		struct mm_struct *mm = snap[i].mm;
+		struct vm_area_struct *vma;
+		unsigned long vaddr;
+		pgd_t *pgd;
+		p4d_t *p4d;
+		pud_t *pud;
+		pmd_t *pmd;
+		struct folio *folio;
+
+		if (!mm)
+			continue;
+
+		/* Skip if process already exited (mm_users == 0) */
+		if (!mmget_not_zero(mm))
+			continue;
+
+		vaddr = snap[i].base + cxl_mb->metadata_size +
+			(hpage_idx << CXL_HPAGE_SHIFT);
+
+		mmap_read_lock(mm);
+		vma = vma_lookup(mm, vaddr);
+		if (!vma)
+			goto unlock;
+
+		/* Walk page table — bail if any intermediate level is missing */
+		pgd = pgd_offset(mm, vaddr);
+		if (pgd_none(*pgd))
+			goto unlock;
+		p4d = p4d_offset(pgd, vaddr);
+		if (p4d_none(*p4d))
+			goto unlock;
+		pud = pud_offset(p4d, vaddr);
+		if (pud_none(*pud))
+			goto unlock;
+		pmd = pmd_offset(pud, vaddr);
+
+		folio = pfn_folio(pfn);
+		folio->mapping = vma->vm_file->f_mapping;
+		{
+			struct vm_fault vmf = {
+				.vma = vma,
+				.address = vaddr,
+				.pmd = pmd,
+			};
+			vmf_insert_folio_pmd(&vmf, folio, true);
+		}
+
+unlock:
+		mmap_read_unlock(mm);
+		mmput(mm);
+	}
+
+	cxl_mmap_snap_release(snap, n);
+}
+EXPORT_SYMBOL_GPL(cxl_install_hpage_pmd);
+
+/*
+ * ============================================================================
+ * Section 2: 4KB Page Fault Handler (Stub)
+ * ============================================================================
+ */
+
+/**
+ * cxl_page_fault_handler - 4 KiB page fault handler (4K mode only)
+ * @vmf: VM fault information
+ *
+ * Direct-PFN model: PTE maps straight at the NAND PFN for this page_idx.
+ * On NOT_CACHED pages we pay simulated NAND read latency synchronously,
+ * transition to CACHED, then install the PTE.  Concurrent faults on the
+ * same page coalesce via state-machine cmpxchg + waitqueue, so only one
+ * thread pays the latency.
+ *
+ * In 2M mode this returns VM_FAULT_SIGBUS — the .huge_fault path handles
+ * everything and 4 KiB faults should not occur (VM_HUGEPAGE is set).
+ */
+vm_fault_t cxl_page_fault_handler(struct vm_fault *vmf)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct nvmev_dev *nvmev_vdev = vma->vm_private_data;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_page_entry *entry;
+	unsigned long page_idx;
+	unsigned long pfn;
+	unsigned long long nsecs_start, nsecs_target;
+	int state;
+	vm_fault_t ret;
+	/* Option-B stage stamps (in-context, local_clock ns) */
+	u64 t_enter, t_premodel = 0, t_postmodel = 0;
+	/* zero-init: the eviction block is skipped on the CACHED fast path,
+	 * where these must contribute 0 to the decomposition */
+	u64 t_evict0 = 0, t_evict1 = 0;
+	/* TSC bracket for joining against a userspace harness, and the time
+	 * blocked on another thread's in-flight fill (Cylon: primary-fill stall).
+	 * `waited` accumulates because the retry loop may block more than once. */
+	u64 tsc_enter = optb4k_tsc();
+	u64 t_wait0, waited = 0;
+	u32 optb_outcome = 0;   /* 0 filled | 1 retry | 2 CACHED re-fault */
+	bool optb_miss = false;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("CXL device not initialized\n");
+		return VM_FAULT_SIGBUS;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+	t_enter = local_clock();
+
+	if (cxl_mb->pg_mode != CXL_PG_4K) {
+		NVMEV_ERROR("4KB page fault in 2M mode (unexpected). addr=0x%lx\n",
+			    vmf->address);
+		return VM_FAULT_SIGBUS;
+	}
+
+	/* DEVICE page index, not VMA-relative.  A caller may map a window of the
+	 * device (mmap offset != 0): MIO's multi-threaded pointer chase gives each
+	 * thread its own mmap at offset thread_idx * size.  Without vm_pgoff every
+	 * such window aliases onto device pages 0..npages, the threads overwrite
+	 * each other's data, and the device sees one window's worth of faults. */
+	page_idx = ((vmf->address - vma->vm_start) >> PAGE_SHIFT) + vma->vm_pgoff;
+	if (page_idx >= cxl_mb->nr_pages) {
+		NVMEV_ERROR("4K page fault beyond range: idx=%lu max=%lu\n",
+			    page_idx, cxl_mb->nr_pages);
+		return VM_FAULT_SIGBUS;
+	}
+
+	entry = &cxl_mb->page_table[page_idx];
+
+retry:
+	state = atomic_read(&entry->state);
+
+	/* Fast path: page is already CACHED.  Re-fault on a CACHED entry
+	 * happens after a recent eviction zap or because PTEs are not yet
+	 * propagated.  Just (re)install the PTE — no NAND latency. */
+	if (state == CXL_HPAGE_CACHED) {
+		optb_outcome = 2;      /* re-fault on an already-cached page */
+		/* This path has no dispatch/modeled phase — all it does is the
+		 * PTE install.  Anchor both stamps at t_enter so the whole
+		 * handler is charged to `install`.  Leaving them 0 would make
+		 * `install` come out as t_done - 0, i.e. a raw local_clock()
+		 * truncated into u32: pure garbage, and large enough to wreck
+		 * any band mean it lands in. */
+		t_premodel = t_postmodel = t_enter;
+		goto install_pte;
+	}
+
+	/* Another fault is loading or evicting this page — wait.  Charge the
+	 * block to `wait`, not `dispatch`: it is somebody else's fill, the
+	 * direct analogue of Cylon's primary-fill stall. */
+	if (state == CXL_HPAGE_LOADING || state == CXL_HPAGE_EVICTING) {
+		/* Waiting on a page a prefetch is still fetching = the right
+		 * guess arriving too late.  Counted before the wait so it is
+		 * recorded even if the state changes under us. */
+		if (state == CXL_HPAGE_LOADING && cxl_mb->prefetched_bm &&
+		    test_bit(page_idx, cxl_mb->prefetched_bm))
+			atomic64_inc(&cxl_mb->pf4k_late);
+		t_wait0 = local_clock();
+		wait_event(entry->wait,
+			   atomic_read(&entry->state) != CXL_HPAGE_LOADING &&
+			   atomic_read(&entry->state) != CXL_HPAGE_EVICTING);
+		waited += local_clock() - t_wait0;
+		goto retry;
+	}
+
+	/* state == NOT_CACHED — try to claim LOADING via cmpxchg */
+	if (atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED,
+			   CXL_HPAGE_LOADING) != CXL_HPAGE_NOT_CACHED) {
+		/* Lost the race — another thread is loading.  Retry from top. */
+		goto retry;
+	}
+
+	/* This admission is demand-driven, so the page is not a prefetch's any
+	 * more.  Clearing here is what keeps accuracy honest: a page prefetched,
+	 * evicted unused, then later demand-faulted must not be credited to the
+	 * prefetcher on its second life. */
+	if (cxl_mb->prefetched_bm) {
+		clear_bit(page_idx, cxl_mb->prefetched_bm);
+		clear_bit(page_idx, cxl_mb->pfused_bm);
+	}
+
+	atomic64_inc(&cxl_mb->cache_misses);
+	optb_miss = true;  /* Option-B: this is a real miss, record it at install */
+
+	/* Reserve a DRAM-cache credit and enforce the hard bound (mirror of the
+	 * 2M slot acquire in cxl_load_hpage_from_nand).  Our page is LOADING so
+	 * the CLOCK victim finder skips it; we only evict OTHER cached pages,
+	 * paying their NAND write-back latency in-context (the backpressure). */
+	atomic_long_inc(&cxl_mb->nr_cached_4k);
+	t_evict0 = local_clock();      /* Option-B: victim write-back stall starts */
+	cxl_enforce_4k_budget(nvmev_vdev);
+	t_evict1 = local_clock();      /* ...ends; charged to `evict`, not dispatch */
+
+	/* Read miss pays NAND read latency.  What a WRITE miss pays is the
+	 * cxl_wr_alloc policy (see nvmev.h): NONE and DEFER fetch nothing here --
+	 * DEFER charges the merge read later, at write-back -- while READ fetches
+	 * on the miss like a non-sectored page-granular cache must.  The
+	 * nand_valid gate below applies either way, so a virgin page is free
+	 * under every policy. */
+	t_premodel = local_clock();  /* Option-B: end of dispatch, start of modeled */
+	if (!(vmf->flags & FAULT_FLAG_WRITE) ||
+	    READ_ONCE(cxl_wr_alloc) == CXL_WR_ALLOC_READ) {
+		/* Gate the NAND read latency (mirror the 2M read path): charge it only
+		 * when NAND actually holds real data for this page.  A never-written
+		 * page (nand_valid unset) is a zero-fill — no physical NAND read occurs,
+		 * so no latency is modeled.  This is what makes first-touch / cold I/O
+		 * free while re-reads of previously-written-back data pay tR. */
+		if (!nvmev_vdev->cxl_ftl) {
+			atomic64_inc(&cxl_mb->nand_lat_skip_noftl);
+		} else if (!READ_ONCE(cxl_mb->latency_enabled)) {
+			atomic64_inc(&cxl_mb->nand_lat_skip_disabled);
+		} else if (!test_bit(page_idx, cxl_mb->nand_valid)) {
+			atomic64_inc(&cxl_mb->nand_lat_skip_invalid);
+		} else {
+			nsecs_start = local_clock();
+			nsecs_target = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+							     page_idx,
+							     false /* read */,
+							     PAGE_SIZE,
+							     nsecs_start);
+			if (nsecs_target > nsecs_start) {
+				unsigned long long delay_ns = nsecs_target - nsecs_start;
+				unsigned long delay_us = delay_ns / 1000;
+				if (delay_us > 0) {
+					if (delay_us < 10000)
+						udelay(delay_us);
+					else
+						msleep(delay_us / 1000);
+				}
+				atomic64_inc(&cxl_mb->nand_lat_applied);
+				atomic64_add(delay_ns, &cxl_mb->nand_lat_applied_ns);
+			}
+		}
+	}
+
+	t_postmodel = local_clock();  /* Option-B: end of modeled, start of install */
+
+	/* Transition to CACHED, wake waiters.  Credit already reserved above. */
+	atomic_set(&entry->accessed, 1);
+	/* Publish policy metadata before CACHED so every visible resident is
+	 * reachable by the selected CLOCK/FIFO/LIFO victim finder. */
+	cxl_policy_insert_4k(cxl_mb, page_idx);
+	set_bit(page_idx, cxl_mb->cached_bm);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	wake_up(&entry->wait);
+
+	/* Optional: queue miss-triggered next-N prefetch.  O(1) push only —
+	 * admission (including paired eviction at a full cache) runs on the
+	 * dispatcher via cxl_process_4k_queues(), so the demand miss is not
+	 * charged the victim-scan/zap work of its own speculation. */
+	if (cxl_mb->prefetch_mode == CXL_PREFETCH_MODE_MISS_NEXTN &&
+	    cxl_mb->prefetch_degree > 0)
+		cxl_prefetch_push_4k(cxl_mb, page_idx);
+
+install_pte:
+	/* A fault reaching install on a prefetched page IS a use of it (either
+	 * it was found CACHED, or we just waited out its load).  Most uses of a
+	 * prefetched page never get here -- the completion pre-installs the PTE,
+	 * so they never fault -- and those are picked up from the hardware A-bit
+	 * in cxl_pte_young_4k instead. */
+	if (cxl_mb->prefetched_bm && test_bit(page_idx, cxl_mb->prefetched_bm))
+		set_bit(page_idx, cxl_mb->pfused_bm);
+
+	/*
+	 * Bug 3: pin to block eviction while we're calling vmf_insert_pfn.
+	 * Eviction's CLOCK finder skips entries with pin_count > 0, AND
+	 * re-checks pin after its CACHED->EVICTING CAS (with smp_mb).
+	 * Our smp_mb here pairs with eviction's re-check; ordering ensures
+	 * that if we see state==CACHED below, eviction sees our pin > 0
+	 * and reverts.
+	 */
+	atomic_inc(&entry->pin_count);
+	smp_mb();
+
+	if (atomic_read(&entry->state) != CXL_HPAGE_CACHED) {
+		/* Eviction claimed this page between LOADING->CACHED transition
+		 * (or our pre-install check) and our pin.  Drop the pin, wake
+		 * any eviction waiters, and ask the kernel to re-dispatch. */
+		atomic_dec(&entry->pin_count);
+		wake_up(&entry->wait);
+		/* Record the aborted attempt too: one logical access can need
+		 * several handler entries, and counting only the last one hides
+		 * exactly what Cylon's multi-exit refault measures. */
+		if (optb_miss || optb_outcome == 2) {
+			u64 t_r = local_clock();
+			u32 d = (t_premodel > t_enter) ? (u32)(t_premodel - t_enter) : 0;
+			u32 e = (t_evict1 > t_evict0) ? (u32)(t_evict1 - t_evict0) : 0;
+			u32 m = (t_postmodel > t_premodel) ? (u32)(t_postmodel - t_premodel) : 0;
+
+			d = (d > e) ? d - e : 0;
+			d = (d > (u32)waited) ? d - (u32)waited : 0;
+			optb4k_record(page_idx, tsc_enter,
+				      (u32)(optb4k_tsc() - tsc_enter), 1,
+				      d, (u32)waited, e, m,
+				      (t_r > t_postmodel) ? (u32)(t_r - t_postmodel) : 0);
+		}
+		return VM_FAULT_RETRY;
+	}
+
+	atomic_set(&entry->accessed, 1);
+	if (vmf->flags & FAULT_FLAG_WRITE)
+		atomic64_inc(&cxl_mb->fault_write_enter);
+	else
+		atomic64_inc(&cxl_mb->fault_read_enter);
+
+	/* Direct-PFN: data lives at NAND PFN.  No memcpy.
+	 * Install read-only for reads so the first write traps via .pfn_mkwrite
+	 * (dirty tracking — mirror of 2M's RO-then-RW PMD).  Write faults install
+	 * writable directly and mark the page dirty. */
+	pfn = cxl_mb->nand_pfn_base + page_idx;
+	if (vmf->flags & FAULT_FLAG_WRITE) {
+		atomic_set(&entry->dirty, 1);
+		/* CXL_WR_ALLOC_DEFER: nothing was fetched, so the cache holds only
+		 * the cachelines this store touches and the write-back owes a merge
+		 * read.  Tested BEFORE the set_bit below on purpose: nand_valid here
+		 * still reports whether NAND held content BEFORE this fault.  A
+		 * virgin page has nothing to merge and must stay unmarked, which is
+		 * what keeps first-touch writes (a load phase, a fresh allocation)
+		 * free.  Not marked on the .pfn_mkwrite path: that page is already
+		 * resident and complete, by a read fill or by being virgin. */
+		if (READ_ONCE(cxl_wr_alloc) == CXL_WR_ALLOC_DEFER &&
+		    cxl_mb->wralloc_bm &&
+		    test_bit(page_idx, cxl_mb->nand_valid))
+			set_bit(page_idx, cxl_mb->wralloc_bm);
+		/* Direct-PFN: the write lands at the NAND PFN, so NAND now holds real
+		 * data for this page — a later re-read (after eviction) must pay tR. */
+		set_bit(page_idx, cxl_mb->nand_valid);
+		ret = vmf_insert_pfn(vma, vmf->address, pfn);
+	} else {
+		pgprot_t ro = __pgprot(pgprot_val(vma->vm_page_prot) & ~_PAGE_RW);
+		ret = vmf_insert_pfn_prot(vma, vmf->address, pfn, ro);
+	}
+
+	atomic_dec(&entry->pin_count);
+	wake_up(&entry->wait);  /* unblock eviction that may be waiting */
+
+	/* Option-B: record stage decomposition for real misses only (not CACHED
+	 * fast-path re-faults).  install span = since t_postmodel, includes the
+	 * pin re-check + vmf_insert_pfn.  Skipped on the VM_FAULT_RETRY early-out. */
+	if (optb_miss || optb_outcome == 2) {
+		u64 t_done = local_clock();
+		u32 disp = (t_premodel  > t_enter)     ? (u32)(t_premodel  - t_enter)     : 0;
+		u32 evct = (t_evict1    > t_evict0)    ? (u32)(t_evict1    - t_evict0)    : 0;
+		u32 modl = (t_postmodel > t_premodel)  ? (u32)(t_postmodel - t_premodel)  : 0;
+		u32 inst = (t_done      > t_postmodel) ? (u32)(t_done      - t_postmodel) : 0;
+
+		/* dispatch spans the eviction stall AND any wait on another
+		 * thread; remove both so dispatch (and total) is this fault's
+		 * own overhead. */
+		disp = (disp > evct) ? disp - evct : 0;
+		disp = (disp > (u32)waited) ? disp - (u32)waited : 0;
+		optb4k_record(page_idx, tsc_enter,
+			      (u32)(optb4k_tsc() - tsc_enter), optb_outcome,
+			      disp, (u32)waited, evct, modl, inst);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cxl_page_fault_handler);
+
+/*
+ * cxl_page_pfn_mkwrite - write-protect-fault handler for 4K CXL pages.
+ *
+ * 4K read faults install RO PTEs (above) so the first write to a CACHED page
+ * traps here (VM_PFNMAP/VM_SHARED -> wp_pfn_shared -> .pfn_mkwrite).  We mark
+ * the page dirty (so eviction charges NAND program latency) and let the kernel
+ * upgrade the PTE to writable.  This is the 4K twin of 2M's CACHED+FAULT_FLAG_WRITE
+ * path (cxl_huge_page_fault_handler), adapted to the pfn_mkwrite hook.
+ */
+vm_fault_t cxl_page_pfn_mkwrite(struct vm_fault *vmf)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct nvmev_dev *nvmev_vdev = vma->vm_private_data;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_page_entry *entry;
+	unsigned long page_idx;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return VM_FAULT_SIGBUS;
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->pg_mode != CXL_PG_4K)
+		return VM_FAULT_SIGBUS;
+
+	page_idx = ((vmf->address - vma->vm_start) >> PAGE_SHIFT) + vma->vm_pgoff;
+	if (page_idx >= cxl_mb->nr_pages)
+		return VM_FAULT_SIGBUS;
+
+	entry = &cxl_mb->page_table[page_idx];
+
+	/* Pin + re-check CACHED so we don't race an in-flight eviction.  If the
+	 * page is being evicted (or got evicted), back off and re-fault: the next
+	 * access reloads it and re-installs the PTE. */
+	atomic_inc(&entry->pin_count);
+	smp_mb();
+	if (atomic_read(&entry->state) != CXL_HPAGE_CACHED) {
+		atomic_dec(&entry->pin_count);
+		wake_up(&entry->wait);
+		return VM_FAULT_RETRY;
+	}
+
+	atomic_set(&entry->dirty, 1);
+	/* First write to a read-only (clean) page: data now lands at the NAND PFN,
+	 * so mark NAND as holding real data (gates re-read latency after eviction). */
+	set_bit(page_idx, cxl_mb->nand_valid);
+	atomic_set(&entry->accessed, 1);
+	atomic64_inc(&cxl_mb->write_protect_faults);
+
+	atomic_dec(&entry->pin_count);
+	wake_up(&entry->wait);
+
+	/* Return 0: the kernel completes the write-protect upgrade and makes the
+	 * PTE writable+dirty.  Subsequent writes to this page won't fault. */
+	return 0;
+}
+EXPORT_SYMBOL_GPL(cxl_page_pfn_mkwrite);
+
+/*
+ * ============================================================================
+ * Section 3: Huge Page (2MB) Cache Management
+ * ============================================================================
+ */
+
+/**
+ * cxl_load_hpage_from_nand - Load a 2MB huge page from NAND to DRAM
+ * @nvmev_vdev: NVMeVirt device
+ * @hpage_idx: Huge page index to load
+ *
+ * Loads a 2MB region from NAND to DRAM with latency simulation.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int cxl_load_hpage_from_nand(struct nvmev_dev *nvmev_vdev, unsigned long hpage_idx)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	unsigned long dram_hpage_slot;
+	unsigned long long nsecs_start = 0, nsecs_completed = 0;
+	struct cxl_hpage_entry *entry;
+	int old;
+
+	if (!cxl_mb)
+		return -EINVAL;
+
+	if (hpage_idx >= cxl_mb->nr_hpages)
+		return -EINVAL;
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/* Atomically transition NOT_CACHED → LOADING */
+	old = atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED, CXL_HPAGE_LOADING);
+	if (old != CXL_HPAGE_NOT_CACHED) {
+		if (old == CXL_HPAGE_LOADING || old == CXL_HPAGE_EVICTING)
+			wait_event(entry->wait, !cxl_hpage_is_busy(entry));
+		return 0;  /* Already cached or another thread is handling it */
+	}
+
+	atomic64_inc(&cxl_mb->cache_misses);
+
+	/* Try to pop a free DRAM slot */
+	spin_lock(&cxl_mb->cache_lock);
+	if (cxl_mb->nr_free > 0) {
+		dram_hpage_slot = cxl_mb->free_slots[--cxl_mb->nr_free];
+	} else {
+		dram_hpage_slot = INVALID_PAGE_IDX;
+	}
+	spin_unlock(&cxl_mb->cache_lock);
+
+	if (dram_hpage_slot == INVALID_PAGE_IDX) {
+		/* No free slots — use CLOCK to find and claim a victim */
+		long victim_idx = cxl_clock_victim(cxl_mb,
+						   cxl_mb->nr_dram_hpages * 2);
+
+		if (victim_idx >= 0) {
+			/* Victim is already in EVICTING state; take its slot directly */
+			struct cxl_hpage_entry *victim = &cxl_mb->hpage_table[victim_idx];
+			dram_hpage_slot = victim->dram_slot;
+
+			/* Evict the victim (new contract: caller manages slot) */
+			cxl_evict_hpage_to_nand(nvmev_vdev, victim_idx);
+		} else {
+			NVMEV_ERROR("No evictable pages for hpage %lu\n", hpage_idx);
+			atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+			wake_up(&entry->wait);
+			return -ENOMEM;
+		}
+	}
+
+	NVMEV_DEBUG("Loading huge page %lu (DRAM slot %lu as logical tracker)\n",
+		    hpage_idx, dram_hpage_slot);
+
+	/* Simulate NAND read latency for 2MB transfer (data lives at NAND PFN) */
+	nsecs_start = local_clock();
+	if (!nvmev_vdev->cxl_ftl) {
+		atomic64_inc(&cxl_mb->nand_lat_skip_noftl);
+	} else if (!READ_ONCE(cxl_mb->latency_enabled)) {
+		atomic64_inc(&cxl_mb->nand_lat_skip_disabled);
+	} else if (!test_bit(hpage_idx, cxl_mb->nand_valid)) {
+		atomic64_inc(&cxl_mb->nand_lat_skip_invalid);
+	} else {
+		nsecs_completed = cxl_ftl_calc_latency(
+			nvmev_vdev->cxl_ftl,
+			CXL_HPAGE_TO_PAGE(hpage_idx),
+			false,  /* is_write = false for read */
+			CXL_HPAGE_SIZE,
+			nsecs_start);
+
+		if (nsecs_completed > nsecs_start) {
+			unsigned long long delay_ns = nsecs_completed - nsecs_start;
+			unsigned long delay_us = delay_ns / 1000;
+
+			/* Update adaptive prefetch throttle with current
+			 * channel state so it can recover when load drops */
+			WRITE_ONCE(cxl_mb->last_prefetch_latency_ns, delay_ns);
+
+			if (delay_us > 0) {
+				if (delay_us < 10000)
+					udelay(delay_us);
+				else
+					msleep(delay_us / 1000);
+				atomic64_inc(&cxl_mb->nand_lat_applied);
+				atomic64_add((s64)delay_ns,
+					     &cxl_mb->nand_lat_applied_ns);
+			}
+		}
+
+		NVMEV_DEBUG("Demand fault MISS: hpage=%lu latency=%llu us\n",
+			   hpage_idx, (nsecs_completed - nsecs_start) / 1000);
+	}
+
+	/* No memcpy needed — data lives at NAND PFN, PMD maps there directly */
+
+	/* Commit: store data fields, then publish state */
+	entry->dram_slot = dram_hpage_slot;
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], hpage_idx);
+	WRITE_ONCE(entry->dirty, false);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	atomic_set(&entry->accessed, 1);
+	wake_up(&entry->wait);
+
+	NVMEV_DEBUG("Huge page %lu loaded from NAND (latency: %llu ns)\n",
+		   hpage_idx,
+		   nvmev_vdev->cxl_ftl ? (nsecs_completed - nsecs_start) : 0);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(cxl_load_hpage_from_nand);
+
+/**
+ * cxl_evict_hpage_to_nand - Evict a 2MB huge page from DRAM to NAND
+ * @nvmev_vdev: NVMeVirt device
+ * @hpage_idx: Huge page index to evict
+ *
+ * Contract: caller must have already transitioned state to EVICTING
+ * (via cmpxchg or cxl_clock_find_victim). Caller manages the freed
+ * DRAM slot (this function does NOT push it to free_slots).
+ *
+ * Writes back dirty data to NAND, transitions state to NOT_CACHED,
+ * and invalidates PMD entries.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int cxl_evict_hpage_to_nand(struct nvmev_dev *nvmev_vdev, unsigned long hpage_idx)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_hpage_entry *entry;
+
+	if (!cxl_mb)
+		return -EINVAL;
+
+	if (hpage_idx >= cxl_mb->nr_hpages)
+		return -EINVAL;
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/*
+	 * Data already lives at the NAND PFN (PMD maps there directly),
+	 * so no memcpy is needed.  However we must simulate the NAND
+	 * program latency for dirty pages — without this, sync eviction
+	 * would not advance LUN busy times, causing subsequent reads on
+	 * the same die to underestimate contention.
+	 */
+	if (READ_ONCE(entry->dirty)) {
+		set_bit(hpage_idx, cxl_mb->nand_valid);
+
+		if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+			unsigned long long nsecs_start = local_clock();
+			unsigned long long nsecs_completed;
+
+			nsecs_completed = cxl_ftl_calc_latency(
+				nvmev_vdev->cxl_ftl,
+				CXL_HPAGE_TO_PAGE(hpage_idx),
+				true,  /* is_write */
+				CXL_HPAGE_SIZE,
+				nsecs_start);
+
+			if (nsecs_completed > nsecs_start) {
+				unsigned long delay_us =
+					(nsecs_completed - nsecs_start) / 1000;
+
+				if (delay_us > 0) {
+					if (delay_us < 10000)
+						udelay(delay_us);
+					else
+						msleep(delay_us / 1000);
+				}
+			}
+		}
+	}
+
+	NVMEV_DEBUG("Sync evict: hpage=%lu dirty=%d slot=%lu\n",
+		   hpage_idx, READ_ONCE(entry->dirty), entry->dram_slot);
+
+	/* Zap PMD entries — while state is still EVICTING, userspace
+	 * faults will see EVICTING and wait.  Next access re-faults and
+	 * simulates NAND read latency before re-installing the PMD. */
+	cxl_zap_hpage_ptes(cxl_mb, hpage_idx);
+
+	/* Commit: clear dirty, then publish NOT_CACHED */
+	WRITE_ONCE(entry->dirty, false);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+	wake_up(&entry->wait);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(cxl_evict_hpage_to_nand);
+
+/**
+ * cxl_clear_gup_state - Reset DRAM cache state dirtied by cudaHostRegister GUP
+ * @nvmev_vdev: NVMeVirt device
+ *
+ * cudaHostRegister triggers GUP with FOLL_WRITE, which faults in every
+ * hugepage via the write-allocate path: allocating a DRAM slot, marking
+ * dirty, and installing a writable PMD.  These are false positives — no
+ * real data was written.
+ *
+ * Expects latency to have been disabled before cudaHostRegister via
+ * "disable_latency" so all faults/evictions completed instantly
+ * (no inflight async I/O to drain).
+ *
+ * This function:
+ *   1. Clears all CACHED pages (zap PMD, free DRAM slot, reset state)
+ *   2. Resets all statistics
+ *   3. Re-enables NAND latency simulation for real benchmarks
+ *
+ * GUP refcount pins on the NAND PFNs remain valid — GPU DMA is unaffected.
+ * Must be called after cudaHostRegister completes and before any real I/O.
+ */
+void cxl_clear_gup_state(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb;
+	unsigned long i, cleared = 0;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	if (cxl_mb->pg_mode == CXL_PG_4K) {
+		/* 4K mode: zap PTEs and reset state for any CACHED page.
+		 * If zap can't complete (trylock failure on some mm), revert
+		 * state — same protocol as the dispatcher's __evict_4k_page. */
+		for (i = 0; i < cxl_mb->nr_pages; i++) {
+			struct cxl_page_entry *entry = &cxl_mb->page_table[i];
+			int old;
+
+			old = atomic_cmpxchg(&entry->state,
+					     CXL_HPAGE_CACHED, CXL_HPAGE_EVICTING);
+			if (old != CXL_HPAGE_CACHED)
+				continue;
+
+			if (!cxl_zap_4k_pte(cxl_mb, i)) {
+				/* Revert; user can re-issue clear_gup later */
+				atomic_set(&entry->state, CXL_HPAGE_CACHED);
+				wake_up(&entry->wait);
+				continue;
+			}
+
+			clear_bit(i, cxl_mb->cached_bm);
+			cxl_policy_remove_4k(cxl_mb, i);
+			smp_wmb();
+			atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+			atomic_long_dec(&cxl_mb->nr_cached_4k);
+			wake_up(&entry->wait);
+			cleared++;
+		}
+		/* GUP wrote no real data to NAND — reset validity so post-clear reads
+		 * are treated as zero-fill (fresh), mirroring the 2M clear_gup. */
+		if (cxl_mb->nand_valid)
+			bitmap_clear(cxl_mb->nand_valid, 0, cxl_mb->nr_pages);
+		goto reset_stats;
+	}
+
+	for (i = 0; i < cxl_mb->nr_hpages; i++) {
+		struct cxl_hpage_entry *entry = &cxl_mb->hpage_table[i];
+		int old;
+
+		/* Only touch pages that GUP faulted in (state == CACHED) */
+		old = atomic_cmpxchg(&entry->state,
+				     CXL_HPAGE_CACHED, CXL_HPAGE_EVICTING);
+		if (old != CXL_HPAGE_CACHED)
+			continue;
+
+		/* Zap PMD so next CPU access re-faults properly */
+		cxl_zap_hpage_ptes(cxl_mb, i);
+
+		/* Clear false dirty from GUP FOLL_WRITE */
+		WRITE_ONCE(entry->dirty, false);
+
+		/* Clear nand_valid — GUP wrote no real data to NAND PFN */
+		clear_bit(i, cxl_mb->nand_valid);
+
+		/* Return DRAM slot to free list */
+		spin_lock(&cxl_mb->cache_lock);
+		WRITE_ONCE(cxl_mb->slot_to_hpage[entry->dram_slot],
+			   INVALID_PAGE_IDX);
+		cxl_mb->free_slots[cxl_mb->nr_free++] = entry->dram_slot;
+		spin_unlock(&cxl_mb->cache_lock);
+
+		/* Publish NOT_CACHED */
+		smp_wmb();
+		atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&entry->wait);
+		cleared++;
+	}
+
+reset_stats:
+
+	/* Reset all statistics so benchmarks start from a clean slate */
+	atomic64_set(&cxl_mb->cache_hits, 0);
+	atomic64_set(&cxl_mb->cache_misses, 0);
+	atomic64_set(&cxl_mb->huge_faults, 0);
+	atomic64_set(&cxl_mb->zap_no_mmap_entries, 0);
+	atomic64_set(&cxl_mb->zap_effective, 0);
+	atomic64_set(&cxl_mb->zap_ineffective, 0);
+	atomic64_set(&cxl_mb->zap_already_clear, 0);
+	atomic64_set(&cxl_mb->nand_lat_applied, 0);
+	atomic64_set(&cxl_mb->nand_lat_applied_ns, 0);
+	atomic64_set(&cxl_mb->nand_lat_skip_disabled, 0);
+	atomic64_set(&cxl_mb->nand_lat_skip_noftl, 0);
+	atomic64_set(&cxl_mb->nand_lat_skip_invalid, 0);
+	atomic64_set(&cxl_mb->fault_read_enter, 0);
+	atomic64_set(&cxl_mb->fault_write_enter, 0);
+	atomic64_set(&cxl_mb->fault_read_cached, 0);
+	atomic64_set(&cxl_mb->fault_write_cached, 0);
+	atomic64_set(&cxl_mb->victim_probes_4k, 0);
+	atomic64_set(&cxl_mb->clock_victims_4k, 0);
+	atomic64_set(&cxl_mb->fifo_victims_4k, 0);
+	atomic64_set(&cxl_mb->lifo_victims_4k, 0);
+	atomic64_set(&cxl_mb->zap_failures_4k, 0);
+	cxl_reset_async_stats();
+	if (nvmev_vdev->cxl_ftl) {
+		atomic64_set(&nvmev_vdev->cxl_ftl->total_reads, 0);
+		atomic64_set(&nvmev_vdev->cxl_ftl->total_writes, 0);
+		atomic64_set(&nvmev_vdev->cxl_ftl->total_erases, 0);
+		atomic64_set(&nvmev_vdev->cxl_ftl->total_channel_conflicts, 0);
+		atomic64_set(&nvmev_vdev->cxl_ftl->total_die_conflicts, 0);
+	}
+
+	/* Re-enable NAND latency simulation for real workloads */
+	WRITE_ONCE(cxl_mb->latency_enabled, true);
+
+	if (cxl_mb->pg_mode == CXL_PG_4K)
+		NVMEV_INFO("Cleared GUP state: %lu 4K pages reset, cached=%ld/%lu (stats reset, latency re-enabled)\n",
+			   cleared, atomic_long_read(&cxl_mb->nr_cached_4k),
+			   cxl_mb->nr_dram_pages);
+	else
+		NVMEV_INFO("Cleared GUP state: %lu hugepages reset, %lu/%lu free (stats reset, latency re-enabled)\n",
+			   cleared, cxl_mb->nr_free, cxl_mb->nr_dram_hpages);
+}
+EXPORT_SYMBOL_GPL(cxl_clear_gup_state);
+
+/**
+ * cxl_allocate_hpage - Allocate a 2MB DRAM slot for write-allocate (no NAND read)
+ * @nvmev_vdev: NVMeVirt device
+ * @hpage_idx: Huge page index to allocate
+ *
+ * Write-allocate optimization: when a write fault occurs for a 2MB region
+ * not in DRAM, allocate a DRAM slot without reading from NAND.
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int cxl_allocate_hpage(struct nvmev_dev *nvmev_vdev, unsigned long hpage_idx)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	unsigned long dram_hpage_slot;
+	struct cxl_hpage_entry *entry;
+	int old;
+
+	if (!cxl_mb)
+		return -EINVAL;
+
+	if (hpage_idx >= cxl_mb->nr_hpages)
+		return -EINVAL;
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/* Atomically transition NOT_CACHED → LOADING */
+	old = atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED, CXL_HPAGE_LOADING);
+	if (old != CXL_HPAGE_NOT_CACHED) {
+		if (old == CXL_HPAGE_LOADING || old == CXL_HPAGE_EVICTING)
+			wait_event(entry->wait, !cxl_hpage_is_busy(entry));
+		return 0;  /* Already cached or another thread is handling it */
+	}
+
+	atomic64_inc(&cxl_mb->cache_misses);
+
+	/* Try to pop a free DRAM slot */
+	spin_lock(&cxl_mb->cache_lock);
+	if (cxl_mb->nr_free > 0) {
+		dram_hpage_slot = cxl_mb->free_slots[--cxl_mb->nr_free];
+	} else {
+		dram_hpage_slot = INVALID_PAGE_IDX;
+	}
+	spin_unlock(&cxl_mb->cache_lock);
+
+	if (dram_hpage_slot == INVALID_PAGE_IDX) {
+		/* No free slots — use CLOCK to find and claim a victim */
+		long victim_idx = cxl_clock_victim(cxl_mb,
+						   cxl_mb->nr_dram_hpages * 2);
+
+		if (victim_idx >= 0) {
+			struct cxl_hpage_entry *victim = &cxl_mb->hpage_table[victim_idx];
+			dram_hpage_slot = victim->dram_slot;
+
+			cxl_evict_hpage_to_nand(nvmev_vdev, victim_idx);
+		} else {
+			NVMEV_ERROR("No evictable pages for write-allocate hpage %lu\n",
+				    hpage_idx);
+			atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+			wake_up(&entry->wait);
+			return -ENOMEM;
+		}
+	}
+
+	NVMEV_DEBUG("Write-allocate: huge page %lu assigned DRAM slot %lu\n",
+		   hpage_idx, dram_hpage_slot);
+
+	/* Commit: store data fields, then publish state.
+	 * Writes go directly to the NAND PFN via PMD — mark nand_valid. */
+	entry->dram_slot = dram_hpage_slot;
+	WRITE_ONCE(cxl_mb->slot_to_hpage[dram_hpage_slot], hpage_idx);
+	WRITE_ONCE(entry->dirty, true);
+	set_bit(hpage_idx, cxl_mb->nand_valid);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	atomic_set(&entry->accessed, 1);
+	wake_up(&entry->wait);
+
+	NVMEV_DEBUG("Huge page %lu write-allocated (no NAND latency)\n", hpage_idx);
+
+	return 0;
+}
+
+/*
+ * ============================================================================
+ * Section 4: Huge Page Fault Handler
+ * ============================================================================
+ */
+
+/**
+ * cxl_huge_page_fault_handler - Handle 2MB huge page faults for CXL memory
+ * @vmf: VM fault information
+ * @order: Page order (9 for 2MB PMD, 18 for 1GB PUD)
+ *
+ * This handler is called for PMD-level (2MB) page faults. It loads the
+ * entire 2MB region from NAND to DRAM and installs a PMD entry.
+ *
+ * Returns: VM_FAULT_NOPAGE on success, VM_FAULT_SIGBUS on failure
+ */
+vm_fault_t cxl_huge_page_fault_handler(struct vm_fault *vmf, unsigned int order)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct nvmev_dev *nvmev_vdev = vma->vm_private_data;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_hpage_entry *entry;
+	unsigned long address = vmf->address;
+	unsigned long hpage_idx;
+	unsigned long pfn;
+	struct folio *folio;
+	int ret;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb) {
+		NVMEV_ERROR("CXL device not initialized\n");
+		return VM_FAULT_SIGBUS;
+	}
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	/* In 4K mode, hpage_table is NULL — fall back to .fault handler.
+	 * The kernel can call .huge_fault even when VM_HUGEPAGE is unset
+	 * (e.g., transparent hugepage decisions, alignment-based prefaulting),
+	 * so we must explicitly opt out here. */
+	if (cxl_mb->pg_mode == CXL_PG_4K)
+		return VM_FAULT_FALLBACK;
+
+	NVMEV_DEBUG("[DIAG] huge_fault: addr=0x%lx order=%u\n", address, order);
+
+	/*
+	 * Only handle PMD-level (2MB) faults.
+	 * Order 9 = 2^9 * 4KB = 2MB (PMD)
+	 * Order 18 = 2^18 * 4KB = 1GB (PUD) - not supported
+	 */
+	if (order != PMD_ORDER) {
+		NVMEV_DEBUG("[DIAG] Unsupported order %u, falling back\n", order);
+		return VM_FAULT_FALLBACK;
+	}
+
+	/* Align address to 2MB boundary */
+	address = CXL_HPAGE_ALIGN_DOWN(address);
+
+	{
+		/* Calculate virtual huge page index (includes metadata region) */
+		unsigned long virt_hpage_idx;
+		/* Only the 4 KiB paths honour vm_pgoff.  2 MiB mode still assumes
+		 * the whole device is mapped from offset 0; say so rather than
+		 * aliasing a windowed mapping onto the wrong huge pages. */
+		WARN_ON_ONCE(vma->vm_pgoff != 0);
+		virt_hpage_idx = (address - vma->vm_start) >> CXL_HPAGE_SHIFT;
+
+		/* Check alignment */
+		if (!CXL_IS_HPAGE_ALIGNED(address - vma->vm_start)) {
+			NVMEV_ERROR("[DIAG] Address not 2MB aligned\n");
+			return VM_FAULT_SIGBUS;
+		}
+
+		/* Ensure VMA range covers the full 2MB */
+		if (address + CXL_HPAGE_SIZE > vma->vm_end) {
+			NVMEV_ERROR("[DIAG] VMA too small for 2MB page\n");
+			return VM_FAULT_SIGBUS;
+		}
+
+		NVMEV_DEBUG("[DIAG] virt_hpage_idx=%lu metadata_hpages=%lu\n",
+			   virt_hpage_idx, (unsigned long)cxl_mb->metadata_hpages);
+
+		/* Metadata region: direct PFN map, always DRAM-resident, no cache management */
+		if (virt_hpage_idx < cxl_mb->metadata_hpages) {
+			pfn = cxl_mb->dram_pfn_base +
+			      (virt_hpage_idx << (CXL_HPAGE_SHIFT - PAGE_SHIFT));
+			atomic64_inc(&cxl_mb->huge_faults);
+			NVMEV_DEBUG("[DIAG] metadata path: pfn=0x%lx dram_pfn_base=0x%lx\n",
+				   pfn, (unsigned long)cxl_mb->dram_pfn_base);
+			folio = pfn_folio(pfn);
+			if (!folio->mapping)
+				folio->mapping = vmf->vma->vm_file->f_mapping;
+			ret = vmf_insert_folio_pmd(vmf, folio,
+						    (vmf->flags & FAULT_FLAG_WRITE));
+			NVMEV_DEBUG("[DIAG] vmf_insert_folio_pmd returned %d\n", ret);
+			return ret;
+		}
+
+		/* Data region: subtract metadata offset to get data hpage_idx */
+		hpage_idx = virt_hpage_idx - cxl_mb->metadata_hpages;
+	}
+
+	if (hpage_idx >= cxl_mb->nr_hpages) {
+		NVMEV_ERROR("Huge page fault beyond CXL memory range: idx=%lu\n", hpage_idx);
+		return VM_FAULT_SIGBUS;
+	}
+
+	NVMEV_DEBUG("CXL huge page fault at 0x%lx (hpage %lu, %s)\n",
+		    address, hpage_idx,
+		    (vmf->flags & FAULT_FLAG_WRITE) ? "write" : "read");
+
+	atomic64_inc(&cxl_mb->huge_faults);
+
+	/* Split by read vs write for diagnostics: writes go to
+	 * cxl_allocate_hpage (no NAND read, no nand_lat_applied), reads
+	 * go to cxl_load_hpage_from_nand.  Comparing read_enter against
+	 * nand_lat_applied + skip_* tells us whether most reads are
+	 * hitting the CACHED fast-path (i.e., retrieves find data in
+	 * DRAM cache already) or the miss path. */
+	if (vmf->flags & FAULT_FLAG_WRITE)
+		atomic64_inc(&cxl_mb->fault_write_enter);
+	else
+		atomic64_inc(&cxl_mb->fault_read_enter);
+
+	entry = &cxl_mb->hpage_table[hpage_idx];
+
+	/* Check if already in DRAM (cache hit — just needs PMD install) */
+	if (atomic_read(&entry->state) == CXL_HPAGE_CACHED) {
+		atomic64_inc(&cxl_mb->cache_hits);
+		if (vmf->flags & FAULT_FLAG_WRITE)
+			atomic64_inc(&cxl_mb->fault_write_cached);
+		else
+			atomic64_inc(&cxl_mb->fault_read_cached);
+
+		NVMEV_DEBUG("Demand fault HIT: hpage=%lu\n", hpage_idx);
+
+		/*
+		 * Pin the page to prevent eviction before touching metadata.
+		 * After smp_mb(), cxl_clock_find_victim sees the nonzero
+		 * pin_flags and skips this page.  Any in-flight eviction that
+		 * already passed the pin check must have completed its
+		 * cmpxchg(CACHED, EVICTING) — caught by the re-check below.
+		 */
+		atomic_inc((atomic_t *)&cxl_mb->pin_flags[hpage_idx]);
+		smp_mb();
+
+		if (atomic_read(&entry->state) != CXL_HPAGE_CACHED) {
+			/* Eviction claimed the entry before our pin took effect */
+			atomic_dec((atomic_t *)&cxl_mb->pin_flags[hpage_idx]);
+			return VM_FAULT_RETRY;
+		}
+
+		/* Pinned + CACHED: safe to update metadata */
+		if (vmf->flags & FAULT_FLAG_WRITE)
+			WRITE_ONCE(entry->dirty, true);
+
+		/* Mark as recently accessed (CLOCK second-chance bit) */
+		atomic_set(&entry->accessed, 1);
+
+	} else {
+		/* Cache miss — load or allocate the huge page in DRAM */
+		if (vmf->flags & FAULT_FLAG_WRITE) {
+			NVMEV_DEBUG("Write-allocate huge page %lu (skipping NAND read)\n",
+				    hpage_idx);
+			ret = cxl_allocate_hpage(nvmev_vdev, hpage_idx);
+		} else {
+			ret = cxl_load_hpage_from_nand(nvmev_vdev, hpage_idx);
+		}
+		if (ret < 0) {
+			NVMEV_ERROR("Failed to %s huge page %lu: %d\n",
+				    (vmf->flags & FAULT_FLAG_WRITE) ? "allocate" : "load",
+				    hpage_idx, ret);
+			return VM_FAULT_SIGBUS;
+		}
+		cxl_prefetch_nextn_on_miss(nvmev_vdev, hpage_idx,
+					    (vmf->flags & FAULT_FLAG_WRITE));
+
+		/*
+		 * The load/allocate path set state to CACHED with accessed=1.
+		 * Pin before reading dram_slot to prevent eviction from
+		 * stealing the slot before we install the PMD.
+		 */
+		atomic_inc((atomic_t *)&cxl_mb->pin_flags[hpage_idx]);
+		smp_mb();
+
+		if (atomic_read(&entry->state) != CXL_HPAGE_CACHED) {
+			atomic_dec((atomic_t *)&cxl_mb->pin_flags[hpage_idx]);
+			return VM_FAULT_RETRY;
+		}
+	}
+
+	/* Pinned + CACHED: safe to install PMD with stable NAND PFN */
+	pfn = cxl_hpage_nand_pfn(cxl_mb, hpage_idx);
+
+	/*
+	 * Install PMD entry for 2MB mapping using folio-backed API.
+	 * vmf_insert_folio_pmd() handles refcount, rmap, and memory accounting.
+	 * The PFN is the fixed NAND region address for this hpage_idx —
+	 * it never changes, so GUP pins (cudaHostRegister) remain valid
+	 * even after PMD zap/re-install cycles.
+	 */
+	folio = pfn_folio(pfn);
+	folio->mapping = vmf->vma->vm_file->f_mapping;
+	ret = vmf_insert_folio_pmd(vmf, folio, (vmf->flags & FAULT_FLAG_WRITE));
+
+	/* Unpin — eviction can now target this page via CLOCK */
+	atomic_dec((atomic_t *)&cxl_mb->pin_flags[hpage_idx]);
+
+	if (ret == VM_FAULT_NOPAGE) {
+		NVMEV_DEBUG("Huge page fault resolved for hpage %lu\n", hpage_idx);
+		return VM_FAULT_NOPAGE;
+	}
+
+	NVMEV_ERROR("PMD insert failed for hpage %lu: %d\n", hpage_idx, ret);
+	return VM_FAULT_SIGBUS;
+}
+EXPORT_SYMBOL_GPL(cxl_huge_page_fault_handler);
+
+/*
+ * ============================================================================
+ * Section 5: Memory Backend Initialization and Cleanup
+ * ============================================================================
+ */
+
+/**
+ * cxl_memory_backend_init - Initialize CXL memory backend with DRAM cache + NAND
+ * @storage_start: Physical address of reserved memory
+ * @storage_size: Total size of reserved memory
+ * @dram_cache_size: Size of DRAM cache (rest becomes NAND)
+ * @cache_policy: Victim policy for 4 KiB mode
+ *
+ * Memory layout:
+ *   [DRAM Cache (fast)] [NAND Storage (slow, simulated)]
+ *   |<- dram_cache_size ->|<- remaining space ->|
+ *
+ * All tracking is at 2MB huge page granularity. The first N huge pages
+ * start in DRAM with metadata pre-populated. PMD entries are installed
+ * lazily on first access via the .huge_fault handler.
+ *
+ * Returns: Pointer to cxl_memory_backend, or NULL on failure
+ */
+struct cxl_memory_backend *cxl_memory_backend_init(
+    unsigned long storage_start,
+    unsigned long storage_size,
+    size_t dram_cache_size,
+    bool zero_on_init,
+    enum cxl_pg_mode pg_mode,
+    enum cxl_cache_policy cache_policy)
+{
+    struct cxl_memory_backend *cxl_mb;
+    unsigned long i;
+
+    /* Validate parameters */
+    if (dram_cache_size >= storage_size) {
+        NVMEV_ERROR("DRAM cache size must be less than total storage\n");
+        return NULL;
+    }
+
+    if (dram_cache_size < CXL_HPAGE_SIZE) {
+        NVMEV_ERROR("DRAM cache size must be at least one huge page (2MB)\n");
+        return NULL;
+    }
+
+    /* Require 2MB alignment for hpage-only operation */
+    if (!CXL_IS_HPAGE_ALIGNED(storage_start) ||
+        !CXL_IS_HPAGE_ALIGNED(dram_cache_size)) {
+        NVMEV_ERROR("Storage start and DRAM cache size must be 2MB-aligned\n");
+        return NULL;
+    }
+
+    /* Allocate the backend structure */
+    cxl_mb = kzalloc(sizeof(*cxl_mb), GFP_KERNEL);
+    if (!cxl_mb) {
+        NVMEV_ERROR("Failed to allocate CXL memory backend\n");
+        return NULL;
+    }
+
+    cxl_mb->pg_mode = pg_mode;
+    cxl_mb->cache_policy = cache_policy;
+
+    /* Calculate sizes */
+    cxl_mb->dram_size = dram_cache_size;
+    cxl_mb->nand_size = storage_size - dram_cache_size;
+
+    /*
+     * Compute shared metadata region size (2M mode only).
+     * Layout: [header] [chunk_entries] [pin_flags] [free_queue] [prefetch_queue] [2MB alignment pad]
+     * Capacity = 2 * nr_hpages_raw, rounded up to power of 2 (~50% load factor).
+     */
+    if (pg_mode == CXL_PG_2M) {
+        unsigned long nr_hpages_raw = storage_size >> CXL_HPAGE_SHIFT;
+        unsigned long pin_flags_offset;
+        unsigned long free_queue_offset;
+        unsigned long free_queue_size;
+        unsigned long prefetch_queue_offset;
+        unsigned long prefetch_queue_size;
+        cxl_mb->chunk_capacity = roundup_pow_of_two(nr_hpages_raw * 2);
+        pin_flags_offset = sizeof(struct cxl_chunk_table_header) +
+            cxl_mb->chunk_capacity * sizeof(struct cxl_chunk_entry);
+        free_queue_offset = pin_flags_offset + nr_hpages_raw * sizeof(__u32);
+        free_queue_size = sizeof(struct cxl_free_queue) +
+            CXL_FREE_QUEUE_CAPACITY * sizeof(__u64);
+        prefetch_queue_offset = free_queue_offset + free_queue_size;
+        prefetch_queue_size = sizeof(struct cxl_prefetch_queue) +
+            CXL_PREFETCH_QUEUE_CAPACITY * sizeof(__u64);
+        cxl_mb->metadata_size = CXL_HPAGE_ALIGN(
+            prefetch_queue_offset + prefetch_queue_size);
+        cxl_mb->metadata_hpages = cxl_mb->metadata_size >> CXL_HPAGE_SHIFT;
+    } else {
+        /* 4K mode has no shared metadata in the DRAM region — page_table
+         * lives in vmalloc.  Userspace mmaps the data region directly. */
+        cxl_mb->chunk_capacity = 0;
+        cxl_mb->metadata_size = 0;
+        cxl_mb->metadata_hpages = 0;
+    }
+
+    /* Virtual data pages = NAND capacity (DRAM is a transparent cache).
+     * Each virtual page must have a unique NAND backing slot for eviction. */
+    cxl_mb->nr_hpages = cxl_mb->nand_size >> CXL_HPAGE_SHIFT;
+    cxl_mb->nr_dram_hpages = (dram_cache_size - cxl_mb->metadata_size) >> CXL_HPAGE_SHIFT;
+
+    /* 4 KiB tracking sizes (used only in 4K mode) */
+    cxl_mb->nr_pages = cxl_mb->nand_size >> PAGE_SHIFT;
+    cxl_mb->nr_dram_pages = dram_cache_size >> PAGE_SHIFT;
+
+    /* FIFO/LIFO list links use u32 page indices to add only 8 bytes of
+     * metadata per 4K page.  U32_MAX is reserved as the list sentinel. */
+    if (pg_mode == CXL_PG_4K && cache_policy != CXL_CACHE_POLICY_CLOCK &&
+        cxl_mb->nr_pages > U32_MAX) {
+        NVMEV_ERROR("FIFO/LIFO supports at most %u 4K pages\n", U32_MAX);
+        goto err_free_backend;
+    }
+
+    BUILD_BUG_ON(sizeof(struct cxl_chunk_entry) != 32);
+    BUILD_BUG_ON(sizeof(struct cxl_chunk_table_header) != 224);
+
+    if (pg_mode == CXL_PG_2M) {
+        NVMEV_INFO("Initializing CXL memory backend (2MB huge pages only):\n");
+        NVMEV_INFO("  Total storage: %lu MB\n", BYTE_TO_MB(storage_size));
+        NVMEV_INFO("  Metadata:      %lu MB (%lu huge pages, chunk table capacity %lu)\n",
+                   BYTE_TO_MB(cxl_mb->metadata_size), cxl_mb->metadata_hpages,
+                   cxl_mb->chunk_capacity);
+        NVMEV_INFO("  DRAM cache:    %lu MB (%lu huge pages)\n",
+                   BYTE_TO_MB(dram_cache_size - cxl_mb->metadata_size),
+                   cxl_mb->nr_dram_hpages);
+        NVMEV_INFO("  NAND storage:  %lu MB (%lu huge pages)\n",
+                   BYTE_TO_MB(cxl_mb->nand_size), cxl_mb->nr_hpages);
+        NVMEV_INFO("  Virtual data:  %lu huge pages (= NAND capacity)\n",
+                   cxl_mb->nr_hpages);
+    } else {
+        NVMEV_INFO("Initializing CXL memory backend (4 KiB normal-page mode):\n");
+        NVMEV_INFO("  Total storage: %lu MB\n", BYTE_TO_MB(storage_size));
+        NVMEV_INFO("  DRAM region:   %lu MB (unused as backing — budget only)\n",
+                   BYTE_TO_MB(dram_cache_size));
+        NVMEV_INFO("  NAND storage:  %lu MB (%lu pages of 4 KiB)\n",
+                   BYTE_TO_MB(cxl_mb->nand_size), cxl_mb->nr_pages);
+        NVMEV_INFO("  DRAM budget:   %lu pages of 4 KiB (cached-set cap)\n",
+                   cxl_mb->nr_dram_pages);
+        NVMEV_INFO("  page_table:    %lu MB (sizeof(cxl_page_entry)=%zu × %lu)\n",
+                   (sizeof(struct cxl_page_entry) * cxl_mb->nr_pages) >> 20,
+                   sizeof(struct cxl_page_entry), cxl_mb->nr_pages);
+    }
+
+    /* Map DRAM cache region (first part of storage) */
+    cxl_mb->dram_buffer = memremap(storage_start, dram_cache_size, MEMREMAP_WB);
+    if (!cxl_mb->dram_buffer) {
+        NVMEV_ERROR("Failed to map DRAM cache region\n");
+        goto err_free_backend;
+    }
+
+    /* Map NAND storage region (rest of storage) */
+    cxl_mb->nand_storage = memremap(storage_start + dram_cache_size,
+                                     cxl_mb->nand_size, MEMREMAP_WB);
+    if (!cxl_mb->nand_storage) {
+        NVMEV_ERROR("Failed to map NAND storage region\n");
+        goto err_unmap_dram;
+    }
+
+    /* Optionally zero the entire reserved region so module state is
+     * independent of whatever bytes previous runs left behind in the
+     * memmap= reservation.  The metadata header and chunk_entries /
+     * pin_flags at the start of dram_buffer are (re)written below, so
+     * they're safe to zero here.  memset_io is not needed — memremap
+     * with MEMREMAP_WB gives a plain kernel virtual mapping. */
+    if (zero_on_init) {
+        NVMEV_INFO("zero_on_init=true: zeroing %lu MB DRAM + %lu MB NAND "
+                   "(this can take a while)\n",
+                   BYTE_TO_MB(dram_cache_size),
+                   BYTE_TO_MB(cxl_mb->nand_size));
+        memset(cxl_mb->dram_buffer, 0, dram_cache_size);
+        memset(cxl_mb->nand_storage, 0, cxl_mb->nand_size);
+        NVMEV_INFO("zero_on_init: done\n");
+    }
+
+    /* Calculate base PFNs for DRAM (metadata only) and NAND (data pages) */
+    cxl_mb->dram_pfn_base = storage_start >> PAGE_SHIFT;
+    cxl_mb->nand_pfn_base = (storage_start + dram_cache_size) >> PAGE_SHIFT;
+
+    if (pg_mode == CXL_PG_2M) {
+        /* Point chunk table header, entries, pin_flags, and free_flags to DRAM buffer */
+        cxl_mb->chunk_table = (struct cxl_chunk_table_header *)cxl_mb->dram_buffer;
+        cxl_mb->chunk_entries = (struct cxl_chunk_entry *)(cxl_mb->chunk_table + 1);
+        cxl_mb->pin_flags = (__u32 *)(cxl_mb->dram_buffer +
+            sizeof(struct cxl_chunk_table_header) +
+            cxl_mb->chunk_capacity * sizeof(struct cxl_chunk_entry));
+        cxl_mb->free_queue = (struct cxl_free_queue *)(cxl_mb->pin_flags +
+            (storage_size >> CXL_HPAGE_SHIFT));  /* nr_hpages_raw */
+        cxl_mb->prefetch_queue = (struct cxl_prefetch_queue *)(
+            (__u8 *)cxl_mb->free_queue + sizeof(struct cxl_free_queue) +
+            CXL_FREE_QUEUE_CAPACITY * sizeof(__u64));
+
+        /* Allocate hpage table (per-2MB entries) */
+        cxl_mb->hpage_table = vzalloc(sizeof(*cxl_mb->hpage_table) * cxl_mb->nr_hpages);
+        if (!cxl_mb->hpage_table) {
+            NVMEV_ERROR("Failed to allocate hpage table\n");
+            goto err_unmap_nand;
+        }
+
+        /* Allocate unified free slot stack */
+        cxl_mb->free_slots = vzalloc(sizeof(unsigned long) * cxl_mb->nr_dram_hpages);
+        if (!cxl_mb->free_slots) {
+            NVMEV_ERROR("Failed to allocate free slot stack\n");
+            goto err_free_hpage_table;
+        }
+
+        /* Allocate reverse mapping: DRAM slot → hpage_idx (for CLOCK eviction) */
+        cxl_mb->slot_to_hpage = vzalloc(sizeof(*cxl_mb->slot_to_hpage) * cxl_mb->nr_dram_hpages);
+        if (!cxl_mb->slot_to_hpage) {
+            NVMEV_ERROR("Failed to allocate slot_to_hpage\n");
+            goto err_free_slots;
+        }
+
+        /* Allocate NAND validity bitmap (1 bit per hpage, all start invalid) */
+        cxl_mb->nand_valid = vzalloc(BITS_TO_LONGS(cxl_mb->nr_hpages) * sizeof(unsigned long));
+        if (!cxl_mb->nand_valid) {
+            NVMEV_ERROR("Failed to allocate nand_valid bitmap\n");
+            goto err_free_slot_to_hpage;
+        }
+    } else {
+        /* 4K mode: page_table + cached_bm + nand_valid.  No chunk table,
+         * no DRAM-slot pool. */
+        cxl_mb->chunk_table = NULL;
+        cxl_mb->chunk_entries = NULL;
+        cxl_mb->pin_flags = NULL;
+        cxl_mb->free_queue = NULL;
+        cxl_mb->prefetch_queue = NULL;
+        cxl_mb->hpage_table = NULL;
+        cxl_mb->free_slots = NULL;
+        cxl_mb->slot_to_hpage = NULL;
+        cxl_mb->nand_valid = NULL;
+
+        cxl_mb->page_table = vzalloc(sizeof(*cxl_mb->page_table) * cxl_mb->nr_pages);
+        if (!cxl_mb->page_table) {
+            NVMEV_ERROR("Failed to allocate 4K page table (%lu MB needed)\n",
+                        (sizeof(struct cxl_page_entry) * cxl_mb->nr_pages) >> 20);
+            goto err_unmap_nand;
+        }
+
+        /* Resident-set index for the CLOCK victim scan (Fix 1): 1 bit/page,
+         * ~256 KB for 8 GB.  Starts all-zero (every page NOT_CACHED). */
+        cxl_mb->cached_bm = vzalloc(BITS_TO_LONGS(cxl_mb->nr_pages) *
+                                    sizeof(unsigned long));
+        if (!cxl_mb->cached_bm) {
+            NVMEV_ERROR("Failed to allocate 4K cached bitmap (%lu KB needed)\n",
+                        (BITS_TO_LONGS(cxl_mb->nr_pages) * sizeof(unsigned long)) >> 10);
+            vfree(cxl_mb->page_table);
+            cxl_mb->page_table = NULL;
+            goto err_unmap_nand;
+        }
+
+        /* NAND-validity bitmap (1 bit/page, all-zero = fresh/erased).  Gates the
+         * read-miss NAND latency: a page that has never been written holds no
+         * real NAND data, so re-reading it after eviction is free (zero-fill).
+         * Mirror of the 2M nand_valid; set when a page is dirtied. */
+        cxl_mb->nand_valid = vzalloc(BITS_TO_LONGS(cxl_mb->nr_pages) *
+                                     sizeof(unsigned long));
+        if (!cxl_mb->nand_valid) {
+            NVMEV_ERROR("Failed to allocate 4K nand_valid bitmap\n");
+            vfree(cxl_mb->cached_bm);   cxl_mb->cached_bm = NULL;
+            vfree(cxl_mb->page_table);  cxl_mb->page_table = NULL;
+            goto err_unmap_nand;
+        }
+
+        /* Prefetch provenance + use bitmaps (same 1 bit/page sizing as
+         * cached_bm).  Allocated unconditionally so the counters stay valid
+         * if prefetch is enabled on a later reload without a rebuild. */
+        cxl_mb->prefetched_bm = vzalloc(BITS_TO_LONGS(cxl_mb->nr_pages) *
+                                        sizeof(unsigned long));
+        cxl_mb->pfused_bm = vzalloc(BITS_TO_LONGS(cxl_mb->nr_pages) *
+                                    sizeof(unsigned long));
+        /* Allocated unconditionally, like the pair above: cxl_wr_alloc is
+         * runtime-writable, so the bitmap has to exist even when the module
+         * loads in policy 0. */
+        cxl_mb->wralloc_bm = vzalloc(BITS_TO_LONGS(cxl_mb->nr_pages) *
+                                     sizeof(unsigned long));
+        if (!cxl_mb->prefetched_bm || !cxl_mb->pfused_bm || !cxl_mb->wralloc_bm) {
+            NVMEV_ERROR("Failed to allocate 4K prefetch-provenance bitmaps\n");
+            vfree(cxl_mb->wralloc_bm);    cxl_mb->wralloc_bm = NULL;
+            vfree(cxl_mb->pfused_bm);     cxl_mb->pfused_bm = NULL;
+            vfree(cxl_mb->prefetched_bm); cxl_mb->prefetched_bm = NULL;
+            vfree(cxl_mb->nand_valid);    cxl_mb->nand_valid = NULL;
+            vfree(cxl_mb->cached_bm);     cxl_mb->cached_bm = NULL;
+            vfree(cxl_mb->page_table);    cxl_mb->page_table = NULL;
+            goto err_unmap_nand;
+        }
+    }
+
+    /* Initialize victim-policy state, cache_lock, and mmap_lock */
+    atomic_long_set(&cxl_mb->clock_hand, 0);
+    atomic_long_set(&cxl_mb->clock_hand_4k, 0);
+    atomic64_set(&cxl_mb->vskip_second_chance_4k, 0);
+    atomic64_set(&cxl_mb->vforced_4k, 0);
+    atomic_long_set(&cxl_mb->nr_cached_4k, 0);
+    spin_lock_init(&cxl_mb->cache_lock);
+    spin_lock_init(&cxl_mb->policy_lock_4k);
+    cxl_mb->policy_head_4k = CXL_POLICY_IDX_NONE;
+    cxl_mb->policy_tail_4k = CXL_POLICY_IDX_NONE;
+    spin_lock_init(&cxl_mb->mmap_lock);
+    cxl_mb->nr_mmap_entries = 0;
+
+    /* Initialize NAND retry list for deferred I/O operations */
+    INIT_LIST_HEAD(&cxl_mb->nand_retry_list);
+    spin_lock_init(&cxl_mb->retry_lock);
+
+    if (pg_mode == CXL_PG_2M) {
+        /* Initialize shared metadata: write header, zero entries and flags */
+        cxl_mb->chunk_table->capacity = cxl_mb->chunk_capacity;
+        cxl_mb->chunk_table->mask = cxl_mb->chunk_capacity - 1;
+        cxl_mb->chunk_table->metadata_size = cxl_mb->metadata_size;
+        cxl_mb->chunk_table->nr_hpages = cxl_mb->nr_hpages;
+        cxl_mb->chunk_table->pin_flags_offset =
+            (__u8 *)cxl_mb->pin_flags - (__u8 *)cxl_mb->dram_buffer;
+        cxl_mb->chunk_table->free_queue_offset =
+            (__u8 *)cxl_mb->free_queue - (__u8 *)cxl_mb->dram_buffer;
+        cxl_mb->chunk_table->prefetch_queue_offset =
+            (__u8 *)cxl_mb->prefetch_queue - (__u8 *)cxl_mb->dram_buffer;
+        memset(cxl_mb->chunk_entries, 0,
+               cxl_mb->chunk_capacity * sizeof(struct cxl_chunk_entry));
+        memset(cxl_mb->pin_flags, 0, cxl_mb->nr_hpages * sizeof(__u32));
+        /* Initialize free queue */
+        cxl_mb->free_queue->capacity = CXL_FREE_QUEUE_CAPACITY;
+        cxl_mb->free_queue->mask = CXL_FREE_QUEUE_CAPACITY - 1;
+        cxl_mb->free_queue->head = 0;
+        cxl_mb->free_queue->tail = 0;
+
+        /* Initialize prefetch queue */
+        cxl_mb->prefetch_queue->capacity = CXL_PREFETCH_QUEUE_CAPACITY;
+        cxl_mb->prefetch_queue->mask = CXL_PREFETCH_QUEUE_CAPACITY - 1;
+        cxl_mb->prefetch_queue->head = 0;
+        cxl_mb->prefetch_queue->tail = 0;
+    }
+    spin_lock_init(&cxl_mb->prefetch_push_lock);
+    cxl_mb->prefetch_mode = CXL_PREFETCH_MODE_USER_HINT;
+    cxl_mb->prefetch_degree = 0;
+    cxl_mb->prefetch_random = 0;
+    cxl_mb->prefetch_gate = true;   /* armed unless a harness closes it */
+
+    if (pg_mode == CXL_PG_2M) {
+        /*
+         * All data pages start NOT_CACHED (data lives at NAND PFNs).
+         * PMDs are installed lazily on first access via the fault handler.
+         * DRAM slots are logical warm-page budget trackers for CLOCK.
+         */
+        for (i = 0; i < cxl_mb->nr_hpages; i++) {
+            struct cxl_hpage_entry *entry = &cxl_mb->hpage_table[i];
+            atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+            atomic_set(&entry->accessed, 0);
+            entry->dram_slot = 0;
+            entry->dirty = false;
+            init_waitqueue_head(&entry->wait);
+        }
+
+        /* All slots: indices [0, nr_dram_hpages) */
+        for (i = 0; i < cxl_mb->nr_dram_hpages; i++) {
+            cxl_mb->free_slots[i] = i;
+            cxl_mb->slot_to_hpage[i] = INVALID_PAGE_IDX;
+        }
+        cxl_mb->nr_free = cxl_mb->nr_dram_hpages;
+
+        /* Watermarks (in slots) */
+        cxl_mb->high_wm = cxl_mb->nr_dram_hpages * 15 / 100;
+        cxl_mb->low_wm  = cxl_mb->nr_dram_hpages * 5 / 100;
+    } else {
+        /* 4K mode: initialize the per-page state machine.  All entries
+         * start NOT_CACHED — the first access faults and pays NAND latency.
+         * The "DRAM cache" is purely a budget — no slot pool. */
+        for (i = 0; i < cxl_mb->nr_pages; i++) {
+            struct cxl_page_entry *entry = &cxl_mb->page_table[i];
+            atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+            atomic_set(&entry->accessed, 0);
+            atomic_set(&entry->pin_count, 0);  /* Bug 3: pin counter */
+            atomic_set(&entry->dirty, 0);
+            entry->policy_prev = CXL_POLICY_IDX_NONE;
+            entry->policy_next = CXL_POLICY_IDX_NONE;
+            init_waitqueue_head(&entry->wait);
+        }
+        cxl_mb->nr_free = 0;  /* unused in 4K mode */
+
+        /* Watermarks (in pages) — eviction triggers when cached set
+         * exceeds high_wm of the budget. */
+        cxl_mb->high_wm = cxl_mb->nr_dram_pages * 95 / 100;
+        cxl_mb->low_wm  = cxl_mb->nr_dram_pages * 85 / 100;
+    }
+
+    /* Initialize statistics */
+    atomic64_set(&cxl_mb->cache_hits, 0);
+    atomic64_set(&cxl_mb->cache_misses, 0);
+    atomic64_set(&cxl_mb->huge_faults, 0);
+    atomic64_set(&cxl_mb->victim_probes_4k, 0);
+    atomic64_set(&cxl_mb->clock_victims_4k, 0);
+    atomic64_set(&cxl_mb->fifo_victims_4k, 0);
+    atomic64_set(&cxl_mb->lifo_victims_4k, 0);
+    atomic64_set(&cxl_mb->zap_failures_4k, 0);
+
+    /* NAND latency enabled by default */
+    cxl_mb->latency_enabled = true;
+
+    /* Prefetch in-flight counter */
+    atomic_set(&cxl_mb->prefetch_inflight, 0);
+
+    /* Set NUMA node */
+    cxl_mb->numa_node = -1;
+
+    NVMEV_INFO("CXL memory backend initialized successfully\n");
+    NVMEV_INFO("  4K cache policy: %s\n",
+               cxl_cache_policy_name(cxl_mb->cache_policy));
+    NVMEV_INFO("  NAND PFN base: 0x%lx, data pages: %lu, DRAM warm-page budget: %lu\n",
+               cxl_mb->nand_pfn_base, cxl_mb->nr_hpages, cxl_mb->nr_dram_hpages);
+    NVMEV_INFO("  Unified pool: %lu hpages (wm: %lu/%lu)\n",
+               cxl_mb->nr_dram_hpages, cxl_mb->low_wm, cxl_mb->high_wm);
+
+    return cxl_mb;
+
+err_free_slot_to_hpage:
+    vfree(cxl_mb->slot_to_hpage);
+err_free_slots:
+    vfree(cxl_mb->free_slots);
+err_free_hpage_table:
+    vfree(cxl_mb->hpage_table);
+err_unmap_nand:
+    memunmap(cxl_mb->nand_storage);
+err_unmap_dram:
+    memunmap(cxl_mb->dram_buffer);
+err_free_backend:
+    kfree(cxl_mb);
+    return NULL;
+}
+EXPORT_SYMBOL_GPL(cxl_memory_backend_init);
+
+/**
+ * cxl_memory_backend_cleanup - Clean up CXL memory backend
+ * @cxl_mb: Memory backend to clean up
+ */
+void cxl_memory_backend_cleanup(struct cxl_memory_backend *cxl_mb)
+{
+    if (!cxl_mb)
+        return;
+
+    NVMEV_INFO("Cleaning up CXL memory backend\n");
+    NVMEV_INFO("  Cache hits:       %llu\n", atomic64_read(&cxl_mb->cache_hits));
+    NVMEV_INFO("  Cache misses:     %llu\n", atomic64_read(&cxl_mb->cache_misses));
+    NVMEV_INFO("  Huge page faults: %llu\n", atomic64_read(&cxl_mb->huge_faults));
+    NVMEV_INFO("  Prefetch mode:    %u (degree=%u)\n",
+               cxl_mb->prefetch_mode, cxl_mb->prefetch_degree);
+
+    /* Drain and free any remaining NAND retry entries */
+    {
+        struct cxl_nand_retry_entry *re, *tmp;
+        list_for_each_entry_safe(re, tmp, &cxl_mb->nand_retry_list, node) {
+            list_del(&re->node);
+            kfree(re);
+        }
+    }
+
+    /* Chunk hash table lives in DRAM buffer — freed by memunmap below */
+
+    if (cxl_mb->nand_valid)
+        vfree(cxl_mb->nand_valid);
+    if (cxl_mb->slot_to_hpage)
+        vfree(cxl_mb->slot_to_hpage);
+    if (cxl_mb->free_slots)
+        vfree(cxl_mb->free_slots);
+    if (cxl_mb->hpage_table)
+        vfree(cxl_mb->hpage_table);
+    if (cxl_mb->page_table)
+        vfree(cxl_mb->page_table);
+    if (cxl_mb->cached_bm)
+        vfree(cxl_mb->cached_bm);
+    if (cxl_mb->prefetched_bm)
+        vfree(cxl_mb->prefetched_bm);
+    if (cxl_mb->pfused_bm)
+        vfree(cxl_mb->pfused_bm);
+    if (cxl_mb->wralloc_bm)
+        vfree(cxl_mb->wralloc_bm);
+    if (cxl_mb->nand_storage)
+        memunmap(cxl_mb->nand_storage);
+    if (cxl_mb->dram_buffer)
+        memunmap(cxl_mb->dram_buffer);
+
+    kfree(cxl_mb);
+
+    NVMEV_INFO("CXL memory backend cleaned up\n");
+}
+EXPORT_SYMBOL_GPL(cxl_memory_backend_cleanup);
diff --git a/cxl_pci.c b/cxl_pci.c
new file mode 100644
index 0000000..995248f
--- /dev/null
+++ b/cxl_pci.c
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL PCI Configuration Space Management
+ *
+ * Implements CXL DVSEC structures and PCI configuration
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/slab.h>
+
+#include "nvmev.h"
+#include "cxl.h"
+#include "pci.h"
+
+/* PCI Extended Capability ID for DVSEC */
+#define PCI_EXT_CAP_ID_DVSEC 0x23
+
+/* Build DVSEC capability header */
+static u32 cxl_dvsec_make_header(u16 id, u8 rev, u16 len)
+{
+	return (PCI_EXT_CAP_ID_DVSEC) |
+	       ((rev & 0xF) << 16) |
+	       ((len & 0xFFF) << 20);
+}
+
+/* Create CXL Device DVSEC (Type 0) */
+static int cxl_create_device_dvsec(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct cxl_dvsec_device *dvsec;
+	u16 len = sizeof(struct cxl_dvsec_device);
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + len > PCI_CFG_SPACE_EXP_SIZE)
+		return -EINVAL;
+
+	dvsec = (struct cxl_dvsec_device *)(config_base + offset);
+
+	/* DVSEC Header */
+	dvsec->header.cap_hdr = cxl_dvsec_make_header(0, 1, len);
+	dvsec->header.dv_hdr1 = CXL_VENDOR_ID | (1 << 16) | ((len & 0xFFF) << 20);
+	dvsec->header.dvsec_id = CXL_DVSEC_DEVICE;
+
+	/* Device Capabilities
+	 * CXL 2.0 Section 8.1.3 (corrected per Linux kernel cxlpci.h):
+	 *   cap bit 0     = Cache Capable
+	 *   cap bit 1     = I/O Capable
+	 *   cap bit 2     = Mem Capable
+	 *   cap bits 5:4  = HDM Decoder Count (0=1, 1=2, 2=4, 3=8)
+	 *
+	 *   ctrl bit 0    = Cache Enable
+	 *   ctrl bit 1    = I/O Enable
+	 *   ctrl bit 2    = Memory Enable (triggers DVSEC range validation!)
+	 *
+	 * We set Mem Capable but NOT Memory Enable. This tells the kernel
+	 * that firmware hasn't configured DVSEC ranges, so it will use
+	 * HDM decoders for memory address assignment instead.
+	 *
+	 * HDM Count in DVSEC (bits 5:4) must be 1 or 2 per kernel check.
+	 * Value of 0 is rejected as invalid.
+	 */
+	dvsec->cap = 0x0014;  /* Mem Capable (bit 2) + HDM Count=1 (bits 5:4 = 01) */
+	dvsec->ctrl = 0x0000; /* Memory NOT enabled via DVSEC - use HDM decoders */
+	dvsec->status = 0x0000;
+	dvsec->ctrl2 = 0x0000;
+	dvsec->status2 = 0x0000;
+	dvsec->lock = 0x0000;
+	dvsec->cap2 = 0x0000;
+
+	/*
+	 * Memory Range Configuration
+	 *
+	 * cxl_await_media_ready() checks MEM_INFO_VALID and MEM_ACTIVE bits
+	 * for each HDM decoder advertised. We must set these bits even though
+	 * we're not using DVSEC ranges for actual memory mapping (we use HDM
+	 * decoders instead).
+	 *
+	 * Range Size Low register bits:
+	 *   Bit 0  = MEM_INFO_VALID (must be 1)
+	 *   Bit 1  = MEM_ACTIVE (must be 1)
+	 *   Bits 31:28 = Size (256MB granularity, 0 = no range)
+	 */
+	dvsec->range0_size_hi = 0;
+	dvsec->range0_size_lo = 0x3;  /* MEM_INFO_VALID | MEM_ACTIVE, size=0 */
+	dvsec->range0_base_hi = 0;
+	dvsec->range0_base_lo = 0;
+
+	NVMEV_INFO("CXL Device DVSEC: Range0 valid/active (HDM decoders for mapping)\n");
+
+	NVMEV_INFO("Created CXL Device DVSEC at offset 0x%x\n", offset);
+	return len;
+}
+
+/* Create Register Locator DVSEC (Type 8) */
+static int cxl_create_register_locator_dvsec(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct cxl_dvsec_register_locator *dvsec;
+	struct cxl_dvsec_register_locator_entry *entry;
+	u16 base_len = sizeof(struct cxl_dvsec_register_locator);
+	u16 num_entries = 2; /* Component and Device registers */
+	u16 len = base_len + (num_entries * sizeof(struct cxl_dvsec_register_locator_entry));
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + len > PCI_CFG_SPACE_EXP_SIZE)
+		return -EINVAL;
+
+	dvsec = (struct cxl_dvsec_register_locator *)(config_base + offset);
+
+	/* DVSEC Header */
+	dvsec->header.cap_hdr = cxl_dvsec_make_header(8, 1, len);
+	dvsec->header.dv_hdr1 = CXL_VENDOR_ID | (1 << 16) | ((len & 0xFFF) << 20);
+	dvsec->header.dvsec_id = CXL_DVSEC_REGISTER_LOCATOR;
+	dvsec->rsvd = 0;
+
+	/*
+	 * Register Locator Entry format (CXL 2.0 Section 8.1.9):
+	 *   Bits 2:0   - BIR (BAR Indicator: 0=BAR0, 2=BAR2, 4=BAR4)
+	 *   Bits 15:8  - Register Block ID (0x01=Component, 0x03=CXL Device)
+	 *   Bits 31:16 - Block offset low (bits 31:16 of offset within BAR)
+	 *   Second DWORD - Block offset high (bits 63:32 of offset)
+	 */
+
+	/* Entry 1: Component Registers at offset 0 in BAR 0 */
+	entry = (struct cxl_dvsec_register_locator_entry *)((u8 *)dvsec + base_len);
+	entry->reg_base_lo = CXL_REGBLOCK_ENTRY_LO(0, CXL_RBI_COMPONENT_REG, 0);
+	entry->reg_base_hi = CXL_REGBLOCK_ENTRY_HI(0);
+
+	/* Entry 2: Device Registers at offset 0 in BAR 2 */
+	entry++;
+	entry->reg_base_lo = CXL_REGBLOCK_ENTRY_LO(2, CXL_RBI_CXL_DEVICE_REG, 0);
+	entry->reg_base_hi = CXL_REGBLOCK_ENTRY_HI(0);
+
+	NVMEV_INFO("Created Register Locator DVSEC at offset 0x%x\n", offset);
+	return len;
+}
+
+/* Create Flex Bus Port DVSEC (Type 7) */
+static int cxl_create_flexbus_dvsec(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct cxl_dvsec_flexbus *dvsec;
+	u16 len = sizeof(struct cxl_dvsec_flexbus);
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + len > PCI_CFG_SPACE_EXP_SIZE)
+		return -EINVAL;
+
+	dvsec = (struct cxl_dvsec_flexbus *)(config_base + offset);
+
+	/* DVSEC Header */
+	dvsec->header.cap_hdr = cxl_dvsec_make_header(7, 1, len);
+	dvsec->header.dv_hdr1 = CXL_VENDOR_ID | (1 << 16) | ((len & 0xFFF) << 20);
+	dvsec->header.dvsec_id = CXL_DVSEC_FLEXBUS_PORT;
+
+	/* Port Configuration */
+	dvsec->cap = 0x0027;    /* .cache/.mem/.io enabled, 68B Flit */
+	dvsec->ctrl = 0x0027;   /* Enable all protocols */
+	dvsec->status = 0x0026; /* .cache/.mem enabled, 68B Flit, Valid */
+
+	NVMEV_INFO("Created Flex Bus DVSEC at offset 0x%x\n", offset);
+	return len;
+}
+
+/* Create GPF Device DVSEC (Type 5) */
+static int cxl_create_gpf_device_dvsec(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct cxl_dvsec_gpf *dvsec;
+	u16 len = sizeof(struct cxl_dvsec_gpf);
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + len > PCI_CFG_SPACE_EXP_SIZE)
+		return -EINVAL;
+
+	dvsec = (struct cxl_dvsec_gpf *)(config_base + offset);
+
+	/* DVSEC Header */
+	dvsec->header.cap_hdr = cxl_dvsec_make_header(5, 1, len);
+	dvsec->header.dv_hdr1 = CXL_VENDOR_ID | (1 << 16) | ((len & 0xFFF) << 20);
+	dvsec->header.dvsec_id = CXL_DVSEC_GPF_DEVICE;
+
+	/* GPF Parameters */
+	dvsec->phase2_duration = 0x32; /* 50ms */
+	dvsec->phase2_power = 0x00;
+
+	NVMEV_INFO("Created GPF Device DVSEC at offset 0x%x\n", offset);
+	return len;
+}
+
+/* Create Port Extensions DVSEC (Type 3) */
+static int cxl_create_port_extensions_dvsec(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct cxl_dvsec_port_extensions *dvsec;
+	u16 len = sizeof(struct cxl_dvsec_port_extensions);
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + len > PCI_CFG_SPACE_EXP_SIZE)
+		return -EINVAL;
+
+	dvsec = (struct cxl_dvsec_port_extensions *)(config_base + offset);
+
+	/* DVSEC Header */
+	dvsec->header.cap_hdr = cxl_dvsec_make_header(3, 1, len);
+	dvsec->header.dv_hdr1 = CXL_VENDOR_ID | (1 << 16) | ((len & 0xFFF) << 20);
+	dvsec->header.dvsec_id = CXL_DVSEC_PORT_EXTENSIONS;
+
+	/* Port Extensions */
+	dvsec->status = 0x0000;
+	dvsec->control = 0x0000;
+
+	/* Memory windows not configured for Type 3 device */
+	dvsec->alt_memory_base = 0xFFF00000;
+	dvsec->alt_memory_limit = 0x00000000;
+
+	NVMEV_INFO("Created Port Extensions DVSEC at offset 0x%x\n", offset);
+	return len;
+}
+
+/* Update PCI Extended Capability chain */
+static void cxl_update_ext_cap_chain(struct nvmev_dev *nvmev_vdev, u16 current_offset, u16 next_offset)
+{
+	struct pci_ext_cap *cap;
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (current_offset >= PCI_CFG_SPACE_SIZE) {
+		cap = (struct pci_ext_cap *)(config_base + current_offset);
+		if (next_offset)
+			cap->next = next_offset;
+		else
+			cap->next = 0;
+	}
+}
+
+/* Initialize all CXL DVSEC structures */
+int cxl_pci_init_dvsecs(struct nvmev_dev *nvmev_vdev)
+{
+	u16 offset = 0x300; /* Start at 0x300 to avoid overlap with standard caps */
+	u16 prev_offset = 0;
+	int len;
+
+	/* Find last extended capability */
+	struct pci_ext_cap *last_cap = nvmev_vdev->extcap;
+	while (last_cap && last_cap->next) {
+		prev_offset = OFFS_PCI_EXT_CAP + ((u8 *)last_cap - (u8 *)nvmev_vdev->extcap);
+		if (last_cap->next >= PCI_CFG_SPACE_SIZE) {
+			last_cap = (struct pci_ext_cap *)((u8 *)nvmev_vdev->virtDev + last_cap->next);
+		} else {
+			break;
+		}
+	}
+
+	/* Update last standard extended cap to point to CXL DVSECs */
+	if (prev_offset) {
+		last_cap = (struct pci_ext_cap *)((u8 *)nvmev_vdev->virtDev + prev_offset);
+		last_cap->next = offset;
+	}
+
+	/* Create CXL Device DVSEC */
+	len = cxl_create_device_dvsec(nvmev_vdev, offset);
+	if (len < 0)
+		return len;
+	prev_offset = offset;
+	offset += len;
+
+	/* Create Register Locator DVSEC */
+	cxl_update_ext_cap_chain(nvmev_vdev, prev_offset, offset);
+	len = cxl_create_register_locator_dvsec(nvmev_vdev, offset);
+	if (len < 0)
+		return len;
+	prev_offset = offset;
+	offset += len;
+
+	/* Create Flex Bus DVSEC */
+	cxl_update_ext_cap_chain(nvmev_vdev, prev_offset, offset);
+	len = cxl_create_flexbus_dvsec(nvmev_vdev, offset);
+	if (len < 0)
+		return len;
+	prev_offset = offset;
+	offset += len;
+
+	/* Create GPF Device DVSEC */
+	cxl_update_ext_cap_chain(nvmev_vdev, prev_offset, offset);
+	len = cxl_create_gpf_device_dvsec(nvmev_vdev, offset);
+	if (len < 0)
+		return len;
+	prev_offset = offset;
+	offset += len;
+
+	/* Create Port Extensions DVSEC */
+	cxl_update_ext_cap_chain(nvmev_vdev, prev_offset, offset);
+	len = cxl_create_port_extensions_dvsec(nvmev_vdev, offset);
+	if (len < 0)
+		return len;
+
+	/* Terminate chain */
+	cxl_update_ext_cap_chain(nvmev_vdev, offset, 0);
+
+	NVMEV_INFO("CXL DVSECs initialized successfully\n");
+	return 0;
+}
+
+/* Initialize Device Serial Number capability */
+int cxl_pci_init_dsn(struct nvmev_dev *nvmev_vdev, u16 offset)
+{
+	struct pci_ext_cap_dsn *dsn;
+	void *config_base = nvmev_vdev->virtDev;
+
+	if (offset + sizeof(struct pci_ext_cap_dsn) > PCI_CFG_SPACE_SIZE)
+		return -EINVAL;
+
+	dsn = (struct pci_ext_cap_dsn *)(config_base + offset);
+
+	/* Capability header */
+	dsn->id.cid = PCI_EXT_CAP_ID_DSN;
+	dsn->id.cver = 1;
+	dsn->id.next = 0x200; /* Will point to CXL DVSECs */
+
+	/* Generate unique serial number */
+	dsn->serial = 0x0123456789ABCDEFULL; /* Example serial, should be unique */
+
+	NVMEV_INFO("Device Serial Number capability initialized at 0x%x\n", offset);
+	return 0;
+}
+
+/* Read handler for CXL configuration space */
+int cxl_pci_read_config(struct nvmev_dev *nvmev_vdev, int where, int size, u32 *val)
+{
+	/* Standard config space read */
+	memcpy(val, nvmev_vdev->virtDev + where, size);
+
+	NVMEV_DEBUG_VERBOSE("CXL config read: offset=0x%x size=%d val=0x%x\n",
+	                    where, size, *val);
+	return 0;
+}
+
+/* Write handler for CXL configuration space */
+int cxl_pci_write_config(struct nvmev_dev *nvmev_vdev, int where, int size, u32 val)
+{
+	void *addr = nvmev_vdev->virtDev + where;
+
+	/* Check if writing to DVSEC region (0x300-0x400) */
+	if (where >= 0x300 && where < 0x400) {
+		/* DVSEC writes may need special handling */
+		NVMEV_DEBUG("CXL DVSEC write: offset=0x%x size=%d val=0x%x\n",
+		            where, size, val);
+
+		/* For now, allow the write but log it */
+		memcpy(addr, &val, size);
+		return 0;
+	}
+
+	/* Standard write */
+	memcpy(addr, &val, size);
+	return 0;
+}
