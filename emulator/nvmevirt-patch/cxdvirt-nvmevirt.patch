+/* CXL NAND queue back-pressure check */
+static inline bool cxl_nand_queue_pressure_high(struct nvmev_dev *dev)
+{
+	int total_inflight = 0;
+	int total_capacity = 0;
+	unsigned int i;
+	for (i = 0; i < dev->config.nr_io_workers; i++) {
+		total_inflight += atomic_read(&dev->io_workers[i].nr_inflight);
+		total_capacity += NR_MAX_PARALLEL_IO;
+	}
+	return total_inflight > (total_capacity * 3 / 4);  /* 75% threshold */
+}
