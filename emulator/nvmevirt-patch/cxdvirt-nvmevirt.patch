diff --git a/cxl_dax_hook.c b/cxl_dax_hook.c
new file mode 100644
index 0000000..a23b53e
--- /dev/null
+++ b/cxl_dax_hook.c
@@ -0,0 +1,525 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL DAX Device Hook with Bus Notifier
+ *
+ * Uses kernel's bus notification system to automatically install hooks
+ * when the DAX device appears (asynchronously after region commit).
+ */
+
+#include <linux/module.h>
+#include <linux/device.h>
+#include <linux/device/bus.h>
+#include <linux/notifier.h>
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/dax.h>
+#include <linux/cdev.h>
+#include <linux/delay.h>
+#include <linux/platform_device.h>
+
+#include "nvmev.h"
+
+/* DAX bus type - exported from drivers/dax/bus.c */
+extern const struct bus_type dax_bus_type;
+
+/* Saved original operations for chaining */
+static const struct file_operations *original_dax_fops = NULL;
+static struct file_operations *cxl_dax_fops = NULL;
+static struct inode *hooked_inode = NULL;
+
+/* Forward declarations - implemented in cxl_page_fault.c */
+extern vm_fault_t cxl_page_fault_handler(struct vm_fault *vmf);
+extern vm_fault_t cxl_huge_page_fault_handler(struct vm_fault *vmf, unsigned int order);
+
+/**
+ * cxl_dax_vm_close() - Release mm reference when VMA is torn down
+ * @vma: Virtual memory area being closed
+ *
+ * Called when a process unmaps or exits (during exit_mmap).  Drops the
+ * mmgrab() structural reference taken in cxl_dax_mmap().
+ *
+ * We use mmgrab/mmdrop (mm_count) instead of mmget/mmput (mm_users) so
+ * that process exit can decrement mm_users to zero and trigger exit_mmap
+ * normally.  If we held mm_users, exit_mmap would never fire (our ref
+ * blocks it), vm_close would never be called (exit_mmap calls it), and
+ * we'd have a circular deadlock — the mm and all its VMAs/page tables
+ * would leak until rmmod.
+ */
+static void cxl_dax_vm_close(struct vm_area_struct *vma)
+{
+	struct nvmev_dev *dev = vma->vm_private_data;
+	struct cxl_memory_backend *mb;
+	int i;
+
+	if (!dev || !dev->cxl_mb)
+		return;
+
+	mb = dev->cxl_mb;
+
+	spin_lock(&mb->mmap_lock);
+	for (i = 0; i < mb->nr_mmap_entries; i++) {
+		if (mb->mmap_entries[i].mm == vma->vm_mm &&
+		    mb->mmap_entries[i].base == vma->vm_start) {
+			NVMEV_INFO("VMA close: releasing mm=%px base=0x%lx [%d]\n",
+				   vma->vm_mm, vma->vm_start, i);
+			mmdrop(mb->mmap_entries[i].mm);
+			/* Compact: move last entry into this slot */
+			mb->nr_mmap_entries--;
+			if (i < mb->nr_mmap_entries) {
+				mb->mmap_entries[i] = mb->mmap_entries[mb->nr_mmap_entries];
+			}
+			mb->mmap_entries[mb->nr_mmap_entries].mm = NULL;
+			mb->mmap_entries[mb->nr_mmap_entries].base = 0;
+			spin_unlock(&mb->mmap_lock);
+			return;
+		}
+	}
+	spin_unlock(&mb->mmap_lock);
+}
+
+/**
+ * cxl_dax_vm_ops - Custom VM operations for CXL DAX device
+ *
+ * This replaces the default DAX vm_operations_struct to intercept
+ * page faults and call our NAND latency simulation handler.
+ *
+ * The .huge_fault handler is called for 2MB (PMD) page faults when
+ * the kernel requests a huge page mapping. If it returns VM_FAULT_FALLBACK,
+ * the kernel falls back to calling .fault for 4KB pages.
+ *
+ * The .close handler releases the mm reference taken at mmap time so
+ * that NVIDIA UVM cleanup completes before module exit.
+ */
+static const struct vm_operations_struct cxl_dax_vm_ops = {
+	.fault = cxl_page_fault_handler,       /* 4KB page fault handler */
+	.huge_fault = cxl_huge_page_fault_handler,  /* 2MB huge page fault handler */
+	.pfn_mkwrite = cxl_page_pfn_mkwrite,   /* 4KB write-protect (RO->RW dirty) */
+	.close = cxl_dax_vm_close,             /* Release mm ref on unmap/exit */
+};
+
+/**
+ * cxl_dax_mmap() - Custom mmap handler for DAX device
+ * @file: File being mapped (/dev/dax0.0)
+ * @vma: Virtual memory area being created
+ *
+ * Overrides the default DAX mmap to:
+ * 1. Call original DAX mmap to set up the mapping
+ * 2. Replace vm_ops with our custom operations
+ * 3. Set vm_private_data to nvmev_vdev for our fault handler
+ *
+ * Returns: 0 on success, negative error code otherwise
+ */
+static int cxl_dax_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	extern struct nvmev_dev *nvmev_vdev;  /* Global from main.c */
+	int ret;
+
+	NVMEV_DEBUG("CXL DAX mmap: start=0x%lx end=0x%lx size=%lu pages\n",
+		    vma->vm_start, vma->vm_end,
+		    (vma->vm_end - vma->vm_start) >> PAGE_SHIFT);
+
+	/* Call original DAX mmap to set up the mapping */
+	if (original_dax_fops && original_dax_fops->mmap) {
+		ret = original_dax_fops->mmap(file, vma);
+		if (ret) {
+			NVMEV_ERROR("Original DAX mmap failed: %d\n", ret);
+			return ret;
+		}
+	} else {
+		NVMEV_ERROR("No original DAX mmap handler found\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * VMA flag setup is mode-specific:
+	 *
+	 *   2M mode: clear VM_PFNMAP|VM_IO so GUP/cudaHostRegister works on
+	 *            the folio-backed PMDs (they use ZONE_DEVICE struct pages).
+	 *            Set VM_HUGEPAGE so __handle_mm_fault routes to .huge_fault.
+	 *
+	 *   4K mode: keep VM_PFNMAP set (it's required by vmf_insert_pfn
+	 *            and our 4K fault handler installs raw-PFN PTEs).
+	 *            Clearing VM_HUGEPAGE alone is not enough — even then the
+	 *            kernel will speculatively try .huge_fault, which we now
+	 *            handle by returning VM_FAULT_FALLBACK in 4K mode.
+	 *            GUP/cudaHostRegister are not supported in 4K mode by design.
+	 */
+	if (nvmev_vdev->cxl_mb &&
+	    nvmev_vdev->cxl_mb->pg_mode == CXL_PG_4K) {
+		/* Ensure VM_PFNMAP is set; clear VM_HUGEPAGE so PMD heuristics
+		 * don't kick in unnecessarily. */
+		vm_flags_set(vma, VM_PFNMAP);
+		vm_flags_clear(vma, VM_HUGEPAGE);
+	} else {
+		vm_flags_clear(vma, VM_PFNMAP | VM_IO);
+		vm_flags_set(vma, VM_HUGEPAGE);
+	}
+
+	/* Install our custom vm_ops */
+	vma->vm_ops = &cxl_dax_vm_ops;
+
+	/*
+	 * Set vm_private_data to nvmev_vdev so our fault handler
+	 * can access the CXL memory backend and FTL.
+	 */
+	vma->vm_private_data = nvmev_vdev;
+
+	/*
+	 * Record this process's mm_struct and base address so the kernel
+	 * can zap PMDs in ALL processes during eviction/discard.
+	 * Each TP rank is a separate process that mmaps the same DAX device.
+	 */
+	if (nvmev_vdev->cxl_mb) {
+		struct cxl_memory_backend *mb = nvmev_vdev->cxl_mb;
+		int idx;
+
+		spin_lock(&mb->mmap_lock);
+		idx = mb->nr_mmap_entries;
+		if (idx < CXL_MAX_MMAP_ENTRIES) {
+			mb->mmap_entries[idx].mm = current->mm;
+			mmgrab(current->mm);
+			mb->mmap_entries[idx].base = vma->vm_start;
+			mb->nr_mmap_entries = idx + 1;
+			mb->mmap_entries[idx].pgoff  = vma->vm_pgoff;
+			mb->mmap_entries[idx].npages = vma_pages(vma);
+			NVMEV_INFO("Saved mmap state [%d]: mm=%px base=0x%lx "
+				   "pgoff=%lu npages=%lu\n",
+				   idx, current->mm, vma->vm_start,
+				   vma->vm_pgoff, vma_pages(vma));
+		} else {
+			NVMEV_ERROR("Too many mmap callers (%d), max %d\n",
+				    idx + 1, CXL_MAX_MMAP_ENTRIES);
+		}
+		spin_unlock(&mb->mmap_lock);
+	}
+
+	NVMEV_INFO("✓ CXL fault handler installed for VMA [0x%lx - 0x%lx]\n",
+		   vma->vm_start, vma->vm_end);
+	NVMEV_INFO("  Page faults will trigger NAND latency simulation\n");
+
+	if (nvmev_vdev->cxl_mb &&
+	    nvmev_vdev->cxl_mb->pg_mode == CXL_PG_4K) {
+		NVMEV_INFO("  4 KiB normal-page mode: ACTIVE\n");
+		NVMEV_INFO("    PTE faults -> cxl_page_fault_handler()\n");
+	} else {
+		NVMEV_INFO("  2MB huge page support: ACTIVE (exclusive mode)\n");
+		NVMEV_INFO("    PMD faults -> cxl_huge_page_fault_handler()\n");
+	}
+
+	return 0;
+}
+
+/**
+ * __cxl_override_dax_fops() - Internal function to override DAX file operations
+ * @dev: Device to hook (should be a DAX character device)
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * This is the core hook installation logic, called from bus notifier.
+ */
+static int __cxl_override_dax_fops(struct device *dev, struct nvmev_dev *nvmev_vdev)
+{
+	struct file *filp;
+	struct inode *inode;
+	struct cdev *cdev;
+	char path[64];
+	int ret;
+
+	/* Build device path from device name (e.g., "dax0.0" -> "/dev/dax0.0") */
+	snprintf(path, sizeof(path), "/dev/%s", dev_name(dev));
+
+	/* Open device to get inode */
+	filp = filp_open(path, O_RDONLY, 0);
+	if (IS_ERR(filp)) {
+		NVMEV_DEBUG("Cannot open %s: %ld\n", path, PTR_ERR(filp));
+		return PTR_ERR(filp);
+	}
+
+	inode = file_inode(filp);
+	ihold(inode);  /* Increase reference count */
+	filp_close(filp, NULL);
+
+	/* Get cdev from inode */
+	cdev = inode->i_cdev;
+	if (!cdev || !cdev->ops) {
+		NVMEV_ERROR("inode has no cdev or cdev has no ops\n");
+		iput(inode);
+		return -EINVAL;
+	}
+
+	/* Save original fops */
+	original_dax_fops = cdev->ops;
+	NVMEV_DEBUG("Original DAX fops: %px (mmap=%px)\n",
+		    original_dax_fops, original_dax_fops->mmap);
+
+	/* Create a copy of the original fops */
+	cxl_dax_fops = kmemdup(original_dax_fops,
+			       sizeof(*original_dax_fops),
+			       GFP_KERNEL);
+	if (!cxl_dax_fops) {
+		NVMEV_ERROR("Failed to allocate custom fops\n");
+		iput(inode);
+		return -ENOMEM;
+	}
+
+	/* Override mmap with our custom handler */
+	cxl_dax_fops->mmap = cxl_dax_mmap;
+
+	/* Install the new fops */
+	cdev->ops = cxl_dax_fops;
+
+	/* Save inode for cleanup */
+	hooked_inode = inode;
+
+	NVMEV_INFO("✓ Installed custom mmap handler on DAX device\n");
+	NVMEV_INFO("  Device: %s (inode: %px, cdev: %px)\n", path, inode, cdev);
+	NVMEV_INFO("  Original mmap: %px → Custom mmap: %px\n",
+		   original_dax_fops->mmap, cxl_dax_mmap);
+
+	return 0;
+}
+
+/**
+ * cxl_dax_bus_notify() - Bus notifier callback for DAX device events
+ * @nb: Notifier block
+ * @action: Bus notification action
+ * @data: Device that triggered the notification
+ *
+ * This is called by the kernel whenever a device is added/removed from the bus.
+ * We listen for BUS_NOTIFY_BOUND_DRIVER to catch when device_dax driver binds,
+ * which happens after daxctl reconfigure-device --mode=devdax.
+ */
+static int cxl_dax_bus_notify(struct notifier_block *nb,
+			       unsigned long action,
+			       void *data)
+{
+	struct device *dev = data;
+	struct nvmev_dev *nvmev_vdev = container_of(nb, struct nvmev_dev, dax_bus_notifier);
+	int ret;
+
+	/*
+	 * Listen for driver bind events - this fires when:
+	 * 1. device_dax driver binds during initial region creation (if no kmem)
+	 * 2. device_dax driver binds after daxctl reconfigure --mode=devdax
+	 */
+	if (action != BUS_NOTIFY_BOUND_DRIVER)
+		return NOTIFY_DONE;
+
+	/* Check if device_dax driver just bound */
+	if (!dev->driver || strcmp(dev->driver->name, "device_dax") != 0)
+		return NOTIFY_DONE;
+
+	NVMEV_INFO("device_dax driver bound to: %s\n", dev_name(dev));
+
+	/*
+	 * Wait briefly for /dev/dax0.0 to be created by udev.
+	 * The character device is created asynchronously after driver bind.
+	 */
+	msleep(100);
+
+	/* Verify devt exists (character device created) */
+	if (!dev->devt) {
+		NVMEV_DEBUG("Device %s has no devt yet, skipping\n", dev_name(dev));
+		return NOTIFY_DONE;
+	}
+
+	NVMEV_INFO("DAX device ready: %s (devt %d:%d)\n",
+		   dev_name(dev), MAJOR(dev->devt), MINOR(dev->devt));
+
+	/* Prevent concurrent installation */
+	mutex_lock(&nvmev_vdev->dax_hook_lock);
+
+	if (nvmev_vdev->dax_hooks_installed) {
+		NVMEV_DEBUG("Hooks already installed, ignoring device %s\n", dev_name(dev));
+		mutex_unlock(&nvmev_vdev->dax_hook_lock);
+		return NOTIFY_OK;
+	}
+
+	/* Install hooks */
+	ret = __cxl_override_dax_fops(dev, nvmev_vdev);
+	if (ret == 0) {
+		nvmev_vdev->dax_hooks_installed = true;
+
+		NVMEV_INFO("CXL DAX device hooks installed successfully\n");
+		NVMEV_INFO("\n");
+		NVMEV_INFO("Applications can now use CXL memory via:\n");
+		NVMEV_INFO("  fd = open(\"/dev/dax0.0\", O_RDWR);\n");
+		NVMEV_INFO("  ptr = mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0);\n");
+		NVMEV_INFO("\n");
+		NVMEV_INFO("Memory access behavior:\n");
+		NVMEV_INFO("  - First access -> Page fault -> NAND latency -> DRAM cache\n");
+		NVMEV_INFO("  - Subsequent accesses -> Direct DRAM cache (fast)\n");
+
+		NVMEV_INFO("Background eviction runs via dispatcher thread (CLOCK policy, ~100ms interval)\n");
+	} else {
+		NVMEV_ERROR("Failed to install hooks on %s: %d\n", dev_name(dev), ret);
+	}
+
+	mutex_unlock(&nvmev_vdev->dax_hook_lock);
+
+	return NOTIFY_OK;
+}
+
+/**
+ * cxl_register_dax_notifier() - Register bus notifier for DAX devices
+ * @nvmev_vdev: NVMeVirt device context
+ *
+ * This is called from main.c after CXL memdev registration.
+ * The notifier will automatically install hooks when the DAX device appears.
+ */
+int cxl_register_dax_notifier(struct nvmev_dev *nvmev_vdev)
+{
+	int ret;
+
+	/* Initialize state */
+	nvmev_vdev->dax_hooks_installed = false;
+	mutex_init(&nvmev_vdev->dax_hook_lock);
+
+	/* Setup notifier */
+	nvmev_vdev->dax_bus_notifier.notifier_call = cxl_dax_bus_notify;
+	nvmev_vdev->dax_bus_notifier.priority = 0;
+
+	/* Register with DAX bus notification chain */
+	ret = bus_register_notifier(&dax_bus_type, &nvmev_vdev->dax_bus_notifier);
+	if (ret) {
+		NVMEV_ERROR("Failed to register DAX bus notifier: %d\n", ret);
+		return ret;
+	}
+
+	NVMEV_INFO("✓ Registered DAX device notifier\n");
+	NVMEV_INFO("  Hooks will be installed automatically when /dev/dax0.0 appears\n");
+	NVMEV_INFO("  (This happens after CXL region creation and kernel probe)\n");
+
+	return 0;
+}
+
+/**
+ * cxl_unregister_dax_notifier() - Unregister bus notifier
+ * @nvmev_vdev: NVMeVirt device context
+ */
+void cxl_unregister_dax_notifier(struct nvmev_dev *nvmev_vdev)
+{
+	/* Unregister notifier from DAX bus */
+	bus_unregister_notifier(&dax_bus_type, &nvmev_vdev->dax_bus_notifier);
+
+	NVMEV_INFO("Unregistered DAX device notifier\n");
+}
+
+/**
+ * cxl_remove_dax_hooks() - Restore original DAX file operations
+ * @nvmev_vdev: NVMeVirt device context
+ */
+void cxl_remove_dax_hooks(struct nvmev_dev *nvmev_vdev)
+{
+	struct cdev *cdev;
+
+	mutex_lock(&nvmev_vdev->dax_hook_lock);
+
+	if (!hooked_inode) {
+		mutex_unlock(&nvmev_vdev->dax_hook_lock);
+		return;
+	}
+
+	/* Restore original fops */
+	cdev = hooked_inode->i_cdev;
+	if (cdev && cdev->ops == cxl_dax_fops && original_dax_fops) {
+		cdev->ops = original_dax_fops;
+		NVMEV_INFO("Restored original DAX file operations\n");
+	}
+
+	/* Free our custom fops */
+	if (cxl_dax_fops) {
+		kfree(cxl_dax_fops);
+		cxl_dax_fops = NULL;
+	}
+
+	/* Release the inode reference */
+	iput(hooked_inode);
+
+	/*
+	 * Release any remaining mmap mm_struct references.
+	 *
+	 * Normally cxl_dax_vm_close() already released these when
+	 * the process exited (exit_mmap fires because we use mmgrab,
+	 * not mmget, so mm_users drops to 0 on process exit).
+	 *
+	 * This handles the edge case where rmmod runs while a process
+	 * still has the VMA open.  In that case we must:
+	 *   1. Zap our PMDs so exit_mmap won't hit them later
+	 *   2. Clear vm_ops so post-unload exit_mmap won't call freed code
+	 *   3. Drop our mmgrab ref via mmdrop
+	 */
+	if (nvmev_vdev->cxl_mb) {
+		struct cxl_memory_backend *mb = nvmev_vdev->cxl_mb;
+		struct mm_struct *saved_mm[CXL_MAX_MMAP_ENTRIES];
+		int nr_saved = 0;
+		int i;
+		unsigned long j;
+
+		/* Zap all installed CXL PMDs/PTEs across all mm's */
+		if (mb->pg_mode == CXL_PG_2M && mb->hpage_table) {
+			for (j = 0; j < mb->nr_hpages; j++) {
+				if (atomic_read(&mb->hpage_table[j].state) != CXL_HPAGE_NOT_CACHED)
+					cxl_zap_hpage_ptes(mb, j);
+			}
+		} else if (mb->pg_mode == CXL_PG_4K && mb->page_table) {
+			for (j = 0; j < mb->nr_pages; j++) {
+				if (atomic_read(&mb->page_table[j].state) != CXL_HPAGE_NOT_CACHED)
+					cxl_zap_4k_pte(mb, j);
+			}
+		}
+
+		/* Collect mm refs under lock, then release outside */
+		spin_lock(&mb->mmap_lock);
+		for (i = 0; i < mb->nr_mmap_entries; i++) {
+			if (mb->mmap_entries[i].mm) {
+				saved_mm[nr_saved++] = mb->mmap_entries[i].mm;
+				mb->mmap_entries[i].mm = NULL;
+				mb->mmap_entries[i].base = 0;
+			}
+		}
+		mb->nr_mmap_entries = 0;
+		spin_unlock(&mb->mmap_lock);
+
+		/*
+		 * Clear vm_ops on any surviving VMAs that point to our
+		 * module code.  After rmmod, exit_mmap() would call
+		 * vm_ops->close() into freed code — NULL it out first.
+		 *
+		 * Use mmget_not_zero: if mm_users == 0, exit_mmap already
+		 * ran and VMAs are gone — skip the walk.
+		 */
+		for (i = 0; i < nr_saved; i++) {
+			if (mmget_not_zero(saved_mm[i])) {
+				struct vm_area_struct *vma;
+				VMA_ITERATOR(vmi, saved_mm[i], 0);
+
+				mmap_write_lock(saved_mm[i]);
+				for_each_vma(vmi, vma) {
+					if (vma->vm_ops == &cxl_dax_vm_ops) {
+						vma->vm_ops = NULL;
+						vma->vm_private_data = NULL;
+						NVMEV_INFO("Cleared vm_ops on VMA "
+							   "[0x%lx-0x%lx] mm=%px\n",
+							   vma->vm_start,
+							   vma->vm_end,
+							   saved_mm[i]);
+					}
+				}
+				mmap_write_unlock(saved_mm[i]);
+				mmput(saved_mm[i]);
+			}
+		}
+
+		for (i = 0; i < nr_saved; i++)
+			mmdrop(saved_mm[i]);
+	}
+
+	/* Clear saved pointers */
+	original_dax_fops = NULL;
+	hooked_inode = NULL;
+	nvmev_vdev->dax_hooks_installed = false;
+
+	mutex_unlock(&nvmev_vdev->dax_hook_lock);
+
+	NVMEV_INFO("CXL DAX device hooks removed\n");
+}
diff --git a/cxl_device.c b/cxl_device.c
new file mode 100644
index 0000000..312447e
--- /dev/null
+++ b/cxl_device.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL Device Register Implementation
+ *
+ * Implements CXL device registers including mailbox interface
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+
+#include "nvmev.h"
+#include "cxl.h"
+
+#include <cxl.h>      /* Kernel's drivers/cxl/cxl.h - subsystem API */
+#include <cxlmem.h>   /* Kernel's drivers/cxl/cxlmem.h - memory device structures */
+
+/* Device Capability IDs */
+#define CXL_DEV_CAP_CAP_ID_DEVICE_STATUS  0x0001
+#define CXL_DEV_CAP_CAP_ID_PRIMARY_MAILBOX 0x0002
+#define CXL_DEV_CAP_CAP_ID_MEMDEV         0x4000
+
+/* Device Register Field Definitions */
+#define CXL_DEV_EVENT_STATUS_INFO         BIT(0)
+#define CXL_DEV_EVENT_STATUS_WARN         BIT(1)
+#define CXL_DEV_EVENT_STATUS_FAIL         BIT(2)
+#define CXL_DEV_EVENT_STATUS_FATAL        BIT(3)
+#define CXL_DEV_EVENT_STATUS_DYN_CAP      BIT(4)
+
+/* Mailbox Capability Register Fields */
+#define CXL_DEV_MBOX_CAP_PAYLOAD_SIZE_MASK    0x1F
+#define CXL_DEV_MBOX_CAP_INT_CAP              BIT(5)
+#define CXL_DEV_MBOX_CAP_BG_INT_CAP           BIT(6)
+
+/* Mailbox Control Register Fields */
+#define CXL_DEV_MBOX_CTRL_DOORBELL            BIT(0)
+#define CXL_DEV_MBOX_CTRL_INT_EN              BIT(1)
+#define CXL_DEV_MBOX_CTRL_BG_INT_EN           BIT(2)
+
+/* Mailbox Status Register Fields */
+#define CXL_DEV_MBOX_STS_BG_OP                BIT(0)
+#define CXL_DEV_MBOX_STS_ERRNO_SHIFT          32
+#define CXL_DEV_MBOX_STS_ERRNO_MASK           0xFFFF
+
+/* Memory Device Status Fields */
+#define CXL_MEM_DEV_STS_FATAL                 BIT(0)
+#define CXL_MEM_DEV_STS_FW_HALT               BIT(1)
+#define CXL_MEM_DEV_STS_MEDIA_STATUS_SHIFT    2
+#define CXL_MEM_DEV_STS_MEDIA_STATUS_MASK     0x3
+#define CXL_MEM_DEV_STS_MBOX_READY            BIT(4)
+#define CXL_MEM_DEV_STS_RESET_NEEDED_SHIFT    5
+#define CXL_MEM_DEV_STS_RESET_NEEDED_MASK     0x7
+
+/* Initialize device capability array
+ *
+ * CXL 2.0 Section 8.2.8 Device Register Interface:
+ * The kernel's cxl_probe_device_regs() reads capability headers at:
+ *   - Offset 0x00: Cap Array Header (8 bytes)
+ *   - Offset 0x10: Cap 1 header (16 bytes): cap_id[+0], offset[+4], length[+8]
+ *   - Offset 0x20: Cap 2 header (16 bytes)
+ *   - Offset 0x30: Cap 3 header (16 bytes)
+ */
+static void cxl_init_device_caps(struct cxl_device_state *cxl_dev)
+{
+	void __iomem *base = (void __iomem *)cxl_dev->cap_array;
+	int cap_count = 0;
+	u64 hdr_val;
+
+	/* Zero the entire structure first - must use memset_io for __iomem */
+	memset_io(base, 0, sizeof(struct cxl_dev_cap_array));
+
+	/* Capability Array Header at offset 0x00
+	 * Bits 0-15: CAP_ID (must be 0x0000)
+	 * Bits 16-23: CAP_VERSION (0x1)
+	 * Bits 32-47: CAP_COUNT (filled in at end)
+	 *
+	 * IMPORTANT: Must use writeq() for __iomem memory!
+	 */
+	hdr_val = (0x0ULL) |        /* CAP_ID = 0 (required) */
+	          (0x1ULL << 16);   /* Version = 1 */
+
+	/* Reserved field at offset 0x08 - kernel skips to 0x10 */
+	writeq(0, base + 0x08);
+
+	/* Device Status Capability Header at offset 0x10
+	 * Kernel reads: cap_id at +0x00, offset at +0x04, length at +0x08
+	 * Each capability entry is 16 bytes (4x u32)
+	 */
+	writel(CXL_DEV_CAP_CAP_ID_DEVICE_STATUS | (2 << 16),  /* cap_id + version */
+	       base + 0x10 + (cap_count * 16) + 0x00);
+	writel(CXL_DEV_STATUS_REGISTERS_OFFSET,               /* offset */
+	       base + 0x10 + (cap_count * 16) + 0x04);
+	writel(CXL_DEV_STATUS_REGISTERS_LENGTH,               /* length */
+	       base + 0x10 + (cap_count * 16) + 0x08);
+	writel(0,                                             /* reserved */
+	       base + 0x10 + (cap_count * 16) + 0x0C);
+	cap_count++;
+
+	/* Primary Mailbox Capability Header at offset 0x20 */
+	writel(CXL_DEV_CAP_CAP_ID_PRIMARY_MAILBOX | (1 << 16),
+	       base + 0x10 + (cap_count * 16) + 0x00);
+	writel(CXL_MAILBOX_REGISTERS_OFFSET,
+	       base + 0x10 + (cap_count * 16) + 0x04);
+	writel(CXL_MAILBOX_REGISTERS_SIZE,
+	       base + 0x10 + (cap_count * 16) + 0x08);
+	writel(0,
+	       base + 0x10 + (cap_count * 16) + 0x0C);
+	cap_count++;
+
+	/* Memory Device Capability Header at offset 0x30 */
+	writel(CXL_DEV_CAP_CAP_ID_MEMDEV | (1 << 16),
+	       base + 0x10 + (cap_count * 16) + 0x00);
+	writel(CXL_MEMORY_DEVICE_REGISTERS_OFFSET,
+	       base + 0x10 + (cap_count * 16) + 0x04);
+	writel(8,  /* Memory Device Status is 8 bytes */
+	       base + 0x10 + (cap_count * 16) + 0x08);
+	writel(0,
+	       base + 0x10 + (cap_count * 16) + 0x0C);
+	cap_count++;
+
+	/* Update capability count in header and write it */
+	hdr_val |= ((u64)cap_count << 32);
+	writeq(hdr_val, base);
+
+	NVMEV_DEBUG("Device capability array initialized with %d capabilities\n", cap_count);
+	NVMEV_DEBUG("  Cap Array Header: 0x%016llx\n", readq(base));
+	NVMEV_DEBUG("  Cap 0 (Status):  id=0x%08x off=0x%08x len=0x%08x\n",
+	            readl(base + 0x10), readl(base + 0x14), readl(base + 0x18));
+	NVMEV_DEBUG("  Cap 1 (Mailbox): id=0x%08x off=0x%08x len=0x%08x\n",
+	            readl(base + 0x20), readl(base + 0x24), readl(base + 0x28));
+	NVMEV_DEBUG("  Cap 2 (MemDev):  id=0x%08x off=0x%08x len=0x%08x\n",
+	            readl(base + 0x30), readl(base + 0x34), readl(base + 0x38));
+	NVMEV_INFO("Cap array at %p: %016llx\n", base, readq(base));
+}
+
+/* Initialize device status registers */
+static void cxl_init_device_status(struct cxl_device_state *cxl_dev)
+{
+	struct cxl_dev_status *status = cxl_dev->status;
+
+	/* Clear all event status bits */
+	status->status = 0;
+
+	NVMEV_DEBUG("Device status registers initialized\n");
+}
+
+/* Initialize mailbox registers */
+static void cxl_init_mailbox(struct cxl_device_state *cxl_dev)
+{
+	struct cxl_mailbox_registers *mbox = cxl_dev->mailbox;
+
+	/* Mailbox Capability Register
+	 * Bits 0-4: Payload Size (2^n bytes) - 11 = 2048 bytes
+	 * Bit 5: Interrupt Capable
+	 * Bit 6: Background Interrupt Capable
+	 */
+	mbox->mailbox_cap = 11 |                    /* 2048 byte payload */
+	                    CXL_DEV_MBOX_CAP_INT_CAP;
+
+	/* Clear control register */
+	mbox->mailbox_ctrl = 0;
+
+	/* Clear command register */
+	mbox->mailbox_cmd = 0;
+
+	/* Clear status register */
+	mbox->mailbox_sts = 0;
+
+	/* Clear background command status */
+	mbox->bg_cmd_sts = 0;
+
+	/* Allocate payload buffer */
+	cxl_dev->payload_size = CXL_MAILBOX_MAX_PAYLOAD_SIZE;
+	cxl_dev->mbox_payload = (u8 *)(cxl_dev->base + CXL_MAILBOX_PAYLOAD_OFFSET);
+	memset_io(cxl_dev->mbox_payload, 0, cxl_dev->payload_size);
+
+	NVMEV_DEBUG("Mailbox initialized with %zu byte payload\n", cxl_dev->payload_size);
+}
+
+/* Initialize memory device status */
+static void cxl_init_mem_device(struct cxl_device_state *cxl_dev)
+{
+	void __iomem *mem_status_addr = (void __iomem *)cxl_dev->mem_status;
+	u64 status_val;
+
+	/* Set device ready - MBOX_IF_READY bit (bit 4) must be set for cxl_pci
+	 * Media Status: Ready (bits [3:2] = 01 = READY)
+	 *
+	 * IMPORTANT: Must use writeq() for __iomem memory!
+	 */
+	status_val = CXL_MEM_DEV_STS_MBOX_READY |
+	             (1 << CXL_MEM_DEV_STS_MEDIA_STATUS_SHIFT);
+	writeq(status_val, mem_status_addr);
+
+	NVMEV_DEBUG("Memory device status initialized: 0x%016llx\n", status_val);
+}
+
+/* Initialize event logs */
+static void cxl_init_event_logs(struct cxl_device_state *cxl_dev)
+{
+	int i;
+
+	spin_lock_init(&cxl_dev->event_log_lock);
+
+	for (i = 0; i < CXL_EVENT_TYPE_MAX; i++) {
+		INIT_LIST_HEAD(&cxl_dev->event_logs[i]);
+	}
+
+	NVMEV_DEBUG("Event logs initialized\n");
+}
+
+/* Device register read handler */
+static u64 cxl_device_read(struct cxl_device_state *cxl_dev, u32 offset, u32 size)
+{
+	u64 val = 0;
+	void __iomem *addr = cxl_dev->base + offset;
+
+	switch (size) {
+	case 1:
+		val = readb(addr);
+		break;
+	case 2:
+		val = readw(addr);
+		break;
+	case 4:
+		val = readl(addr);
+		break;
+	case 8:
+		val = readq(addr);
+		break;
+	}
+
+	NVMEV_DEBUG_VERBOSE("Device read: offset=0x%x size=%d val=0x%llx\n",
+	                    offset, size, val);
+	return val;
+}
+
+/* Device register write handler */
+static void cxl_device_write(struct cxl_device_state *cxl_dev, u32 offset,
+                             u64 val, u32 size)
+{
+	void __iomem *addr = cxl_dev->base + offset;
+
+	NVMEV_DEBUG_VERBOSE("Device write: offset=0x%x size=%d val=0x%llx\n",
+	                    offset, size, val);
+
+	/* Check for mailbox control register write */
+	if (offset == CXL_MAILBOX_REGISTERS_OFFSET + 4 && size == 4) {
+		struct cxl_mailbox_registers *mbox = cxl_dev->mailbox;
+		u32 ctrl = val;
+
+		if (ctrl & CXL_DEV_MBOX_CTRL_DOORBELL) {
+			/* Doorbell rang - process mailbox command */
+			u64 cmd_reg = mbox->mailbox_cmd;
+			u32 status;
+
+			NVMEV_DEBUG("Mailbox doorbell: cmd=0x%llx\n", cmd_reg);
+
+			/* Process the command */
+			status = cxl_process_mailbox_cmd(cxl_dev, cmd_reg,
+			                                 cxl_dev->mbox_payload);
+
+			/* Update status register */
+			mbox->mailbox_sts = ((u64)status << CXL_DEV_MBOX_STS_ERRNO_SHIFT);
+
+			/* Clear doorbell */
+			ctrl &= ~CXL_DEV_MBOX_CTRL_DOORBELL;
+		}
+
+		mbox->mailbox_ctrl = ctrl;
+		return;
+	}
+
+	/* Standard write */
+	switch (size) {
+	case 1:
+		writeb(val, addr);
+		break;
+	case 2:
+		writew(val, addr);
+		break;
+	case 4:
+		writel(val, addr);
+		break;
+	case 8:
+		writeq(val, addr);
+		break;
+	}
+}
+
+/* Initialize device registers */
+int cxl_device_init(struct cxl_device_state *cxl_dev, void __iomem *base)
+{
+	cxl_dev->base = base;
+
+	/* Clear the device register space */
+	memset_io(base, 0, PAGE_SIZE);
+
+	/* Map register structures */
+	cxl_dev->cap_array = (struct cxl_dev_cap_array *)base;
+	cxl_dev->status = (struct cxl_dev_status *)(base + CXL_DEV_STATUS_REGISTERS_OFFSET);
+	cxl_dev->mailbox = (struct cxl_mailbox_registers *)(base + CXL_MAILBOX_REGISTERS_OFFSET);
+	cxl_dev->mem_status = (struct cxl_mem_device_status *)(base + CXL_MEMORY_DEVICE_REGISTERS_OFFSET);
+
+	/* Initialize capability array */
+	cxl_init_device_caps(cxl_dev);
+
+	/* Initialize device status */
+	cxl_init_device_status(cxl_dev);
+
+	/* Initialize mailbox */
+	cxl_init_mailbox(cxl_dev);
+
+	/* Initialize memory device status */
+	cxl_init_mem_device(cxl_dev);
+
+	/* Initialize event logs */
+	cxl_init_event_logs(cxl_dev);
+
+	/* Set default memory capacities */
+	if (nvmev_vdev->config.memmap_size > 0) {
+		cxl_dev->total_capacity = nvmev_vdev->config.memmap_size;
+		cxl_dev->volatile_capacity = cxl_dev->total_capacity; /* All volatile for now */
+		cxl_dev->persistent_capacity = 0;
+	}
+
+	/* Initialize timestamp */
+	cxl_dev->timestamp = 0;
+	cxl_dev->timestamp_set = false;
+
+	NVMEV_INFO("CXL device registers initialized\n");
+	return 0;
+}
+
+/* Cleanup device registers */
+void cxl_device_exit(struct cxl_device_state *cxl_dev)
+{
+	struct list_head *pos, *tmp;
+	int i;
+
+	/* Free event logs */
+	spin_lock(&cxl_dev->event_log_lock);
+	for (i = 0; i < CXL_EVENT_TYPE_MAX; i++) {
+		list_for_each_safe(pos, tmp, &cxl_dev->event_logs[i]) {
+			list_del(pos);
+			kfree(pos);
+		}
+	}
+	spin_unlock(&cxl_dev->event_log_lock);
+
+	cxl_dev->mbox_payload = NULL;
+
+	/* Clear device registers */
+	if (cxl_dev->base) {
+		memset_io(cxl_dev->base, 0, PAGE_SIZE);
+		cxl_dev->base = NULL;
+	}
+
+	NVMEV_INFO("CXL device registers cleaned up\n");
+}
+
+/* Process device register BAR access */
+void cxl_device_process_bar(struct cxl_device_state *cxl_dev,
+                            u32 offset, u64 *val, bool is_write, u32 size)
+{
+	if (!cxl_dev->base)
+		return;
+
+	if (is_write) {
+		cxl_device_write(cxl_dev, offset, *val, size);
+	} else {
+		*val = cxl_device_read(cxl_dev, offset, size);
+	}
+}
+
+/* Add event to log */
+int cxl_device_add_event(struct cxl_device_state *cxl_dev,
+                         enum cxl_event_log_type type,
+                         struct cxl_event_generic *record)
+{
+	struct list_head *entry;
+
+	if (type >= CXL_EVENT_TYPE_MAX)
+		return -EINVAL;
+
+	entry = kmalloc(sizeof(*entry) + sizeof(*record), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	memcpy(entry + 1, record, sizeof(*record));
+
+	spin_lock(&cxl_dev->event_log_lock);
+	list_add_tail(entry, &cxl_dev->event_logs[type]);
+
+	/* Update event status */
+	cxl_dev->status->status |= BIT(type);
+	spin_unlock(&cxl_dev->event_log_lock);
+
+	NVMEV_DEBUG("Event added to %d log\n", type);
+	return 0;
+}
