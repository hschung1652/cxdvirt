diff --git a/scripts/compile_ssdt.sh b/scripts/compile_ssdt.sh
new file mode 100644
index 0000000..348125d
--- /dev/null
+++ b/scripts/compile_ssdt.sh
@@ -0,0 +1,127 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Compile CXL SSDT tables and extract AML bytecode
+#
+# This script compiles TWO separate SSDT tables:
+# 1. cxl_hostbridge.asl -> CXL0 (ACPI0016) host bridge only
+# 2. cxl_root.asl       -> CXLR (ACPI0017) root device only
+#
+# They are separate to prevent race condition between PCI bus creation
+# and cxl_acpi driver probe. See cxl_acpi_device.c for details.
+
+set -e
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
+
+echo "=== CXL SSDT Compilation ==="
+
+# Check if iasl (ACPI compiler) is installed
+if ! command -v iasl &> /dev/null; then
+    echo "ERROR: iasl (ACPI compiler) not found"
+    echo ""
+    echo "Install iasl:"
+    echo "  Ubuntu/Debian: sudo apt-get install acpica-tools"
+    echo "  Fedora/RHEL:   sudo dnf install acpica-tools"
+    echo "  Arch:          sudo pacman -S acpica"
+    exit 1
+fi
+
+echo "Found iasl: $(iasl -v | head -1)"
+
+cd "$PROJECT_DIR"
+
+# Function to compile one ASL file and generate C header
+compile_asl() {
+    local ASL_NAME="$1"      # e.g., "cxl_hostbridge"
+    local ARRAY_NAME="$2"    # e.g., "cxl_hostbridge_aml"
+    local GUARD_NAME="$3"    # e.g., "_CXL_HOSTBRIDGE_AML_H"
+    local SIZE_NAME="$4"     # e.g., "CXL_HOSTBRIDGE_AML_SIZE"
+    local DESCRIPTION="$5"   # e.g., "CXL host bridge SSDT (CXL0 only)"
+
+    local ASL_FILE="${ASL_NAME}.asl"
+    local AML_FILE="${ASL_NAME}.aml"
+    local HEADER_FILE="${ASL_NAME}_aml.h"
+
+    echo ""
+    echo "--- Compiling $ASL_FILE ---"
+
+    if [ ! -f "$ASL_FILE" ]; then
+        echo "ERROR: ASL file not found: $ASL_FILE"
+        exit 1
+    fi
+
+    # Compile ASL to AML
+    iasl -tc "$ASL_FILE"
+
+    if [ ! -f "$AML_FILE" ]; then
+        echo "ERROR: Compilation failed, AML file not generated"
+        exit 1
+    fi
+
+    local AML_SIZE
+    AML_SIZE=$(stat -c%s "$AML_FILE" 2>/dev/null || stat -f%z "$AML_FILE" 2>/dev/null)
+    echo "  AML size: $AML_SIZE bytes"
+
+    # Generate C header
+    cat > "$HEADER_FILE" <<HEADER_EOF
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * ${DESCRIPTION} - Pre-compiled AML Bytecode
+ *
+ * This file is auto-generated by scripts/compile_ssdt.sh
+ * DO NOT EDIT MANUALLY
+ *
+ * To regenerate:
+ *   cd nvmevirt_fullcxl
+ *   ./scripts/compile_ssdt.sh
+ *
+ * Source: ${ASL_FILE}
+ */
+
+#ifndef ${GUARD_NAME}
+#define ${GUARD_NAME}
+
+/* Size of AML bytecode in bytes */
+#define ${SIZE_NAME} ${AML_SIZE}UL
+
+/* Pre-compiled AML bytecode for ${DESCRIPTION} */
+static const unsigned char ${ARRAY_NAME}[] = {
+HEADER_EOF
+
+    xxd -i < "$AML_FILE" | sed 's/^/\t/' | sed 's/unsigned char stdin//' | sed '/^$/d' >> "$HEADER_FILE"
+
+    echo "};" >> "$HEADER_FILE"
+    echo "" >> "$HEADER_FILE"
+    echo "#endif /* ${GUARD_NAME} */" >> "$HEADER_FILE"
+
+    echo "  Generated: $HEADER_FILE (${ARRAY_NAME}[$AML_SIZE])"
+
+    # Validate SSDT signature
+    local SIGNATURE
+    SIGNATURE=$(dd if="$AML_FILE" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
+    if [ "$SIGNATURE" = "53534454" ]; then
+        echo "  Valid SSDT signature"
+    else
+        echo "  ERROR: Invalid signature: $SIGNATURE"
+        exit 1
+    fi
+
+    # Clean up intermediate files
+    rm -f "${ASL_NAME}.hex"
+}
+
+# Compile both SSDT tables
+compile_asl "cxl_hostbridge" "cxl_hostbridge_aml" "_CXL_HOSTBRIDGE_AML_H" "CXL_HOSTBRIDGE_AML_SIZE" "CXL host bridge SSDT (CXL0/ACPI0016 only)"
+compile_asl "cxl_root" "cxl_root_aml" "_CXL_ROOT_AML_H" "CXL_ROOT_AML_SIZE" "CXL root device SSDT (CXLR/ACPI0017 only)"
+
+echo ""
+echo "=== Compilation Complete ==="
+echo ""
+echo "Generated headers:"
+echo "  cxl_hostbridge_aml.h - ACPI0016 host bridge (loaded first)"
+echo "  cxl_root_aml.h       - ACPI0017 root device (loaded after PCI bus ready)"
+echo ""
+echo "Note: cxl_hostbridge_aml.h contains PLACEHOLDER addresses that"
+echo "      must be patched at runtime. See cxl_acpi_device.c."
