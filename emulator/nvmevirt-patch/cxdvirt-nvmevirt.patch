+#define NAND_READ_LATENCY_MSB (3000) //SLC — same as LSB
+#define NAND_READ_LATENCY_CSB (0) //not used
+#define NAND_PROG_LATENCY (100000)
+#define NAND_ERASE_LATENCY (1000000)
+
+/* FW latencies derived from FIO 4KB QD1 random read = 20us */
+#define FW_4KB_READ_LATENCY (17000) //20us end-to-end - 3us tR
+#define FW_READ_LATENCY (17000)
+#define FW_WBUF_LATENCY0 (4000)
+#define FW_WBUF_LATENCY1 (460)
+#define FW_CH_XFER_LATENCY (0)
+#define OP_AREA_PERCENT (0)
