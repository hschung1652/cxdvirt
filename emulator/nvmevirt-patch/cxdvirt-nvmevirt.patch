+#define LBA_BITS (9)
+#define LBA_SIZE (1 << LBA_BITS)
+
+#elif (BASE_SSD == NOLAT)
+/*
+ * Cylon NAND topology with ALL modeled latency zeroed.
+ *
+ * Geometry matches Cylon's run-cxlssd.sh presets, which are IDENTICAL for the
+ * 8GB and 96GB devices except for blocks/plane:
+ *   nchs=8, luns_per_ch=8, pls_per_lun=1, pgs_per_blk=256 (1MB block),
+ *   secs_per_pg=8 x secsz=512 = 4KB page.
+ * blocks/plane is NOT hard-coded here: BLKS_PER_PLN=0 makes ssd_init_params
+ * derive it from the run-time capacity (memmap_size) and BLK_SIZE --
+ *   8G  -> 128  (Cylon 8GB preset),   96G -> 1536 (Cylon 96GB preset).
+ * So this one profile matches Cylon at whichever capacity the module is loaded.
+ *
+ * Latency: every NAND/channel/FW term is 0, so cxl_ftl_calc_latency returns
+ * within ~tens of ns of nsecs_start.  The 4K fault handler then computes
+ * delay_us = delay_ns/1000 == 0 and SKIPS udelay() -- no emulated NAND cost.
+ * latency_enabled stays true, so cxl_check_4k_eviction still runs and still
+ * zaps evicted PTEs => timed reads keep RE-FAULTING.  What remains is the bare
+ * page-fault machinery (fault entry + state machine + vmf_insert_pfn + zap),
+ * i.e. the page-fault analogue of Cylon's NAND=0 VM-exit overhead.
+ */
+#define NR_NAMESPACES 1
+
+#define NS_SSD_TYPE_0 SSD_TYPE_CONV
+#define NS_CAPACITY_0 (0)
+#define NS_SSD_TYPE_1 NS_SSD_TYPE_0
+#define NS_CAPACITY_1 (0)
+#define MDTS (6)
+#define CELL_MODE (CELL_MODE_SLC)
+
+#define SSD_PARTITIONS (4)
+#define NAND_CHANNELS (8)            /* Cylon nchs=8 */
+#define LUNS_PER_NAND_CH (8)         /* Cylon luns_per_ch=8 */
+#define PLNS_PER_LUN (1)             /* Cylon pls_per_lun=1 */
+#define FLASH_PAGE_SIZE KB(4)        /* Cylon secs_per_pg(8) x secsz(512) = 4KB */
+#define ONESHOT_PAGE_SIZE (FLASH_PAGE_SIZE * 1) /* 1 plane -> 1 page per program */
+#define BLKS_PER_PLN (0)             /* derived from capacity: 8G->128, 96G->1536 */
+#define BLK_SIZE MB(1)               /* pgs_per_blk(256) x 4KB = 1MB */
+static_assert((ONESHOT_PAGE_SIZE % FLASH_PAGE_SIZE) == 0);
+
+#define MAX_CH_XFER_SIZE KB(4)
+#define WRITE_UNIT_SIZE (512)
+
+/* 100 GB/s: a 4KB channel transfer is ~32 ns (negligible), but >0 keeps the
+ * channel model's tx_time/credits valid (tx_time floors to 0 only above ~500GB/s). */
+#define NAND_CHANNEL_BANDWIDTH (100000ull) //MB/s
+#define PCIE_BANDWIDTH (100000ull) //MB/s
+
+/* ALL NAND latencies zeroed */
+#define NAND_4KB_READ_LATENCY_LSB (0) //ns
+#define NAND_4KB_READ_LATENCY_MSB (0) //ns
+#define NAND_4KB_READ_LATENCY_CSB (0) //ns
+#define NAND_READ_LATENCY_LSB (0)
+#define NAND_READ_LATENCY_MSB (0)
+#define NAND_READ_LATENCY_CSB (0)
+#define NAND_PROG_LATENCY (0)
+#define NAND_ERASE_LATENCY (0)
+
+/* FW latencies zeroed */
+#define FW_4KB_READ_LATENCY (0)
+#define FW_READ_LATENCY (0)
+#define FW_WBUF_LATENCY0 (0)
+#define FW_WBUF_LATENCY1 (0)
+#define FW_CH_XFER_LATENCY (0)
+#define OP_AREA_PERCENT (0)
+
+#define GLOBAL_WB_SIZE (NAND_CHANNELS * LUNS_PER_NAND_CH * ONESHOT_PAGE_SIZE * 2)
+#define WRITE_EARLY_COMPLETION 1
+
+#define LBA_BITS (9)
+#define LBA_SIZE (1 << LBA_BITS)
