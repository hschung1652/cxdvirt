+/**
+ * nvmev_cxl_init_registers - Initialize CXL registers using direct address calculation
+ * @nvmev_vdev: NVMeVirt device structure
+ *
+ * This function initializes CXL component, device, and MSI-X registers by
+ * calculating BAR addresses directly from memmap_start, avoiding the need
+ * for pci_resource_start() which requires a pci_dev from our own bus.
+ *
+ * Memory layout (set in PCI_HEADER_SETTINGS):
+ *   memmap_start + 0x000000: ECAM region (1MB reserved by kernel)
+ *   memmap_start + 0x100000: Component registers (64KB) - BAR0
+ *   memmap_start + 0x110000: Device registers (64KB) - BAR2
+ *   memmap_start + 0x120000: MSI-X Table (4KB) - BAR4
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int nvmev_cxl_init_registers(struct nvmev_dev *nvmev_vdev)
+{
+	u64 base = nvmev_vdev->config.memmap_start;
+	u64 bar0_pa = base + BAR0_OFFSET;    /* 0x100000 - after 1MB ECAM region */
+	u64 bar2_pa = base + BAR2_OFFSET;    /* 0x110000 */
+	u64 bar4_pa = base + BAR4_OFFSET;    /* 0x120000 */
+	int rc;
+
+	NVMEV_INFO("CXL register initialization (direct addressing):\n");
+	NVMEV_INFO("  BAR0 (component): 0x%llx\n", bar0_pa);
+	NVMEV_INFO("  BAR2 (device):    0x%llx\n", bar2_pa);
+	NVMEV_INFO("  BAR4 (MSI-X):     0x%llx\n", bar4_pa);
+
+	/* Allocate CXL Type 3 device state */
+	nvmev_vdev->cxl_state = kzalloc(sizeof(struct cxl_type3_state), GFP_KERNEL);
+	if (!nvmev_vdev->cxl_state) {
+		NVMEV_ERROR("Failed to allocate CXL state\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * Use memremap() with MEMREMAP_WT (Write-Through) for CXL register regions
+	 *
+	 * Write-Through caching writes data to BOTH cache and memory simultaneously.
+	 * This eliminates cache coherency issues - no flush needed.
+	 */
+
+	/* Map component registers (BAR0) with write-through caching */
+	nvmev_vdev->cxl_component_base = memremap(bar0_pa, CXL_COMPONENT_BLOCK_SIZE, MEMREMAP_WT);
+	if (!nvmev_vdev->cxl_component_base) {
+		NVMEV_ERROR("Failed to memremap component registers at 0x%llx\n", bar0_pa);
+		goto err_free_state;
+	}
+	NVMEV_INFO("Component registers: phys=0x%llx virt=%p (MEMREMAP_WT)\n",
+		   bar0_pa, nvmev_vdev->cxl_component_base);
+
+	/* Map device registers (BAR2) with write-through caching */
+	nvmev_vdev->cxl_device_base = memremap(bar2_pa, CXL_DEVICE_BLOCK_SIZE, MEMREMAP_WT);
+	if (!nvmev_vdev->cxl_device_base) {
+		NVMEV_ERROR("Failed to memremap device registers at 0x%llx\n", bar2_pa);
+		goto err_unmap_component;
+	}
+	NVMEV_INFO("Device registers: phys=0x%llx virt=%p (MEMREMAP_WT)\n",
+		   bar2_pa, nvmev_vdev->cxl_device_base);
+
+	/* Map MSI-X (BAR4) with write-through caching */
+	nvmev_vdev->msix_base = memremap(bar4_pa, PAGE_SIZE, MEMREMAP_WT);
+	if (!nvmev_vdev->msix_base) {
+		NVMEV_ERROR("Failed to memremap MSI-X registers at 0x%llx\n", bar4_pa);
+		goto err_unmap_device;
+	}
+	NVMEV_INFO("MSI-X registers: phys=0x%llx virt=%p (MEMREMAP_WT)\n",
+		   bar4_pa, nvmev_vdev->msix_base);
+	memset(nvmev_vdev->msix_base, 0x00, PAGE_SIZE);
+
+	/* Initialize component registers */
+	rc = cxl_component_init(&nvmev_vdev->cxl_state->component, nvmev_vdev->cxl_component_base);
+	if (rc < 0) {
+		NVMEV_ERROR("Failed to initialize CXL component registers: %d\n", rc);
+		goto err_unmap_msix;
+	}
+
+	/* Initialize device registers */
+	rc = cxl_device_init(&nvmev_vdev->cxl_state->device, nvmev_vdev->cxl_device_base);
+	if (rc < 0) {
+		NVMEV_ERROR("Failed to initialize CXL device registers: %d\n", rc);
+		goto err_exit_component;
+	}
+
+	/* Set device serial number */
+	nvmev_vdev->cxl_state->device_serial_number = 0xDEADBEEF;
+
+	/*
+	 * VH Mode: Initialize root port component registers
+	 * The root port needs CXL component registers for the kernel's
+	 * dport enumeration (cxl_find_regblock looks for these via DVSEC).
+	 */
+	{
+		u64 rp_comp_pa = nvmev_vdev->config.memmap_start + RP_COMP_OFFSET;
+
+		nvmev_vdev->rp_component_base = memremap(
+			rp_comp_pa, CXL_COMPONENT_BLOCK_SIZE, MEMREMAP_WT);
+		if (!nvmev_vdev->rp_component_base) {
+			NVMEV_ERROR("Failed to map root port component registers\n");
+			goto err_exit_device;
+		}
+
+		rc = cxl_rp_component_init(nvmev_vdev->rp_component_base);
+		if (rc < 0) {
+			NVMEV_ERROR("Failed to init root port component regs: %d\n", rc);
+			goto err_unmap_rp_component;
+		}
+
+		NVMEV_INFO("Root port component registers at PA 0x%llx\n", rp_comp_pa);
+	}
+
+	NVMEV_INFO("CXL Type 3 registers initialized successfully\n");
+	return 0;
+
+err_unmap_rp_component:
+	memunmap(nvmev_vdev->rp_component_base);
+	nvmev_vdev->rp_component_base = NULL;
+err_exit_device:
+	cxl_device_exit(&nvmev_vdev->cxl_state->device);
+err_exit_component:
+	cxl_component_exit(&nvmev_vdev->cxl_state->component);
+err_unmap_msix:
+	memunmap(nvmev_vdev->msix_base);
+	nvmev_vdev->msix_base = NULL;
+err_unmap_device:
+	memunmap(nvmev_vdev->cxl_device_base);
+	nvmev_vdev->cxl_device_base = NULL;
+err_unmap_component:
+	memunmap(nvmev_vdev->cxl_component_base);
+	nvmev_vdev->cxl_component_base = NULL;
+err_free_state:
+	kfree(nvmev_vdev->cxl_state);
+	nvmev_vdev->cxl_state = NULL;
+	return -ENOMEM;
+}
+/**
+ * nvmev_fix_bar_resources - Fix BAR resources after ECAM enumeration
+ * @nvmev_vdev: NVMeVirt device structure
+ *
+ * In ECAM mode, the kernel directly reads config space from physical memory,
+ * bypassing our nvmev_pci_write() handler. This means BAR sizing doesn't work
+ * correctly because we can't intercept the kernel's writes of 0xFFFFFFFF.
+ *
+ * This function manually fixes the pci_dev->resource[] structures after
+ * device enumeration to set the correct BAR sizes and addresses.
+ *
+ * Returns: 0 on success
+ */
+int nvmev_fix_bar_resources(struct nvmev_dev *nvmev_vdev)
+{
+	struct pci_dev *pdev = nvmev_vdev->pdev;
+	u64 base = nvmev_vdev->config.memmap_start;
+	struct resource *res;
+
+	if (!pdev) {
+		NVMEV_ERROR("No pci_dev to fix resources for\n");
+		return -EINVAL;
+	}
+
+	NVMEV_INFO("Fixing BAR resources for ECAM mode:\n");
+
+	/* BAR0: Component registers - 64KB, 64-bit */
+	res = &pdev->resource[0];
+	res->start = base + BAR0_OFFSET;
+	res->end = res->start + 0x10000 - 1;  /* 64KB */
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64;
+	NVMEV_INFO("  BAR0: 0x%llx-0x%llx (64KB)\n",
+		   (u64)res->start, (u64)res->end);
+
+	/* BAR1: Upper 32 bits of BAR0 (part of 64-bit BAR0) */
+	res = &pdev->resource[1];
+	res->start = 0;
+	res->end = 0;
+	res->flags = 0;
+
+	/* BAR2: Device registers - 64KB, 64-bit */
+	res = &pdev->resource[2];
+	res->start = base + BAR2_OFFSET;
+	res->end = res->start + 0x10000 - 1;  /* 64KB */
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64;
+	NVMEV_INFO("  BAR2: 0x%llx-0x%llx (64KB)\n",
+		   (u64)res->start, (u64)res->end);
+
+	/* BAR3: Upper 32 bits of BAR2 (part of 64-bit BAR2) */
+	res = &pdev->resource[3];
+	res->start = 0;
+	res->end = 0;
+	res->flags = 0;
+
+	/* BAR4: MSI-X table - 4KB, 64-bit */
+	res = &pdev->resource[4];
+	res->start = base + BAR4_OFFSET;
+	res->end = res->start + 0x1000 - 1;  /* 4KB */
+	res->flags = IORESOURCE_MEM | IORESOURCE_MEM_64;
+	NVMEV_INFO("  BAR4: 0x%llx-0x%llx (4KB)\n",
+		   (u64)res->start, (u64)res->end);
+
+	/* BAR5: Upper 32 bits of BAR4 (part of 64-bit BAR4) */
+	res = &pdev->resource[5];
+	res->start = 0;
+	res->end = 0;
+	res->flags = 0;
+
+	NVMEV_INFO("BAR resources fixed successfully\n");
+	return 0;
+}
