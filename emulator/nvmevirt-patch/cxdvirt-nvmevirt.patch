+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL Mailbox Command Processing
+ *
+ * Implements CXL mailbox command handlers
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/uuid.h>
+#include <linux/timekeeping.h>
+
+#include "nvmev.h"
+#include "cxl.h"
+
+#include <cxl.h>      /* Kernel's drivers/cxl/cxl.h - subsystem API */
+#include <cxlmem.h>   /* Kernel's drivers/cxl/cxlmem.h - memory device structures */
+
+/* Command Effect Flags */
+#define CXL_CMD_EFFECT_NONE              0
+#define CXL_CMD_EFFECT_CONF_CHANGE       BIT(0)
+#define CXL_CMD_EFFECT_DATA_CHANGE       BIT(1)
+#define CXL_CMD_EFFECT_POLICY_CHANGE     BIT(2)
+#define CXL_CMD_EFFECT_LOG_CHANGE        BIT(3)
+#define CXL_CMD_EFFECT_SECURITY_CHANGE   BIT(4)
+#define CXL_CMD_EFFECT_BACKGROUND        BIT(5)
+
+/* Command structures 
+struct cxl_mbox_identify {
+	u8 fw_revision[16];
+	u64 total_capacity;
+	u64 volatile_capacity;
+	u64 persistent_capacity;
+	u64 partition_alignment;
+	u16 info_event_log_size;
+	u16 warning_event_log_size;
+	u16 failure_event_log_size;
+	u16 fatal_event_log_size;
+	u32 lsa_size;
+	u8 poison_list_max_mer[3];
+	u16 inject_poison_limit;
+	u8 poison_caps;
+	u8 qos_telemetry_caps;
+} __packed;
+
+struct cxl_mbox_get_partition_info {
+	u64 active_volatile_cap;
+	u64 active_persistent_cap;
+	u64 next_volatile_cap;
+	u64 next_persistent_cap;
+} __packed;
+
+struct cxl_mbox_get_lsa {
+	u32 offset;
+	u32 length;
+} __packed;
+
+struct cxl_mbox_set_lsa {
+	u32 offset;
+	u32 rsvd;
+	u8 data[];
+} __packed;
+ */
+
+struct cxl_mbox_get_event_record {
+	u8 event_log;
+	u8 flags;
+	u8 rsvd1;
+	u8 rsvd2;
+	u16 overflow_err_count;
+	u64 first_overflow_timestamp;
+	u64 last_overflow_timestamp;
+	u16 record_count;
+	u8 rsvd3[0xa];
+	struct cxl_event_generic records[];
+} __packed;
+
+struct cxl_mbox_clear_event_record {
+	u8 event_log;
+	u8 clear_flags;
+	u8 nr_handles;
+	u8 rsvd[3];
+	u16 handles[];
+} __packed;
+
+struct cxl_mbox_get_poison_list {
+	u64 address;
+	u64 length;
+} __packed;
+
+/*
+struct cxl_mbox_inject_poison {
+	u64 address;
+} __packed;
+
+struct cxl_mbox_clear_poison {
+	u64 address;
+	u8 write_data[64];
+} __packed;
+
+struct cxl_mbox_get_fw_info {
+	u8 num_slots;
+	u8 slot_info;
+	u8 activation_cap;
+	u8 rsvd[13];
+	u8 slot1_revision[16];
+	u8 slot2_revision[16];
+	u8 slot3_revision[16];
+	u8 slot4_revision[16];
+} __packed;
+
+struct cxl_mbox_get_log {
+	uuid_t uuid;
+	__le32 offset;
+	__le32 length;
+} __packed;
+*/
+
+struct cxl_mbox_health_info {
+	u8 health_status;
+	u8 media_status;
+	u8 additional_status;
+	u8 life_used;
+	__le16 device_temperature;
+	__le32 dirty_shutdown_count;
+	__le32 corrected_volatile_error_count;
+	__le32 corrected_persistent_error_count;
+} __packed;
+
+
+/* Command Effects Log Entry - CXL 3.0 Table 8-36 
+struct cxl_cel_entry {
+	__le16 opcode;
+	__le16 effect;
+	__le16 reserved[2];
+} __packed;
+*/
+
+/* CEL UUID: 0xda9c0b5-bf41-4b78-8f79-96b1623b3f17 */
+static const uuid_t CEL_UUID =
+	UUID_INIT(0x0da9c0b5, 0xbf41, 0x4b78, 0x8f, 0x79,
+	          0x96, 0xb1, 0x62, 0x3b, 0x3f, 0x17);
+
+/* Command table for CEL (Command Effects Log) */
+static const struct {
+	u16 opcode;
+	u16 effect;
+} cxl_cmd_table_tmp[] = {
+	{ CXL_MBOX_OP_GET_EVENT_RECORD, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_CLEAR_EVENT_RECORD, CXL_CMD_EFFECT_LOG_CHANGE},
+	{ CXL_MBOX_OP_GET_EVT_INT_POLICY, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_SET_EVT_INT_POLICY, CXL_CMD_EFFECT_CONF_CHANGE},
+	{ CXL_MBOX_OP_GET_FW_INFO, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_GET_TIMESTAMP, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_SET_TIMESTAMP, CXL_CMD_EFFECT_CONF_CHANGE},
+	{ CXL_MBOX_OP_GET_SUPPORTED_LOGS, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_GET_LOG, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_IDENTIFY, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_GET_PARTITION_INFO, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_GET_LSA, CXL_CMD_EFFECT_NONE},
+	{ CXL_MBOX_OP_SET_LSA, CXL_CMD_EFFECT_DATA_CHANGE},
+	{ CXL_MBOX_OP_GET_HEALTH_INFO, CXL_CMD_EFFECT_NONE},
+};
+
+/* Command handlers */
+static u32 cmd_identify(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_identify *id = (struct cxl_mbox_identify *)cmd->payload;
+
+	memset(id, 0, sizeof(*id));
+
+	/* Firmware revision */
+	snprintf(id->fw_revision, sizeof(id->fw_revision), "NVMEV-CXL-1.0");
+
+	/* Memory capacities - CXL spec requires 256MB units */
+	id->total_capacity = cpu_to_le64(cxl_dev->total_capacity / SZ_256M);
+	id->volatile_capacity = cpu_to_le64(cxl_dev->volatile_capacity / SZ_256M);
+	id->persistent_capacity = cpu_to_le64(cxl_dev->persistent_capacity / SZ_256M);
+
+	/* Alignment (256MB) - also in 256MB units */
+	id->partition_align = cpu_to_le64(1);
+
+	/* Event log sizes */
+	id->info_event_log_size = cpu_to_le16(1024);
+	id->warning_event_log_size = cpu_to_le16(512);
+	id->failure_event_log_size = cpu_to_le16(512);
+	id->fatal_event_log_size = cpu_to_le16(256);
+
+	/* LSA size (128KB) */
+	id->lsa_size = cpu_to_le32(SZ_128K);
+
+	/* No poison support - leave poison fields as zero */
+
+	*len = sizeof(*id);
+	NVMEV_DEBUG("IDENTIFY command processed\n");
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_partition_info(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_get_partition_info *pi = (struct cxl_mbox_get_partition_info *)cmd->payload;
+
+	/* CXL spec requires capacities in 256MB units */
+	pi->active_volatile_cap = cpu_to_le64(cxl_dev->volatile_capacity / SZ_256M);
+	pi->active_persistent_cap = cpu_to_le64(cxl_dev->persistent_capacity / SZ_256M);
+	pi->next_volatile_cap = cpu_to_le64(cxl_dev->volatile_capacity / SZ_256M);
+	pi->next_persistent_cap = cpu_to_le64(cxl_dev->persistent_capacity / SZ_256M);
+
+	*len = sizeof(*pi);
+	NVMEV_DEBUG("GET_PARTITION_INFO command processed\n");
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_lsa(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_get_lsa *get_lsa = (struct cxl_mbox_get_lsa *)cmd->payload;
+	u32 offset = le32_to_cpu(get_lsa->offset);
+	u32 length = le32_to_cpu(get_lsa->length);
+
+	if (offset + length > SZ_128K) {
+		*len = 0;
+		return CXL_MBOX_INVALID_INPUT;
+	}
+
+	/* For now, return zeros for LSA data */
+	memset(cmd->payload, 0, length);
+
+	*len = length;
+	NVMEV_DEBUG("GET_LSA command processed: offset=%u length=%u\n", offset, length);
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_set_lsa(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_set_lsa *set_lsa = (struct cxl_mbox_set_lsa *)cmd->payload;
+	u32 offset = le32_to_cpu(set_lsa->offset);
+
+	if (offset >= SZ_128K) {
+		*len = 0;
+		return CXL_MBOX_INVALID_INPUT;
+	}
+
+	/* Store LSA data (not persisted in this implementation) */
+	NVMEV_DEBUG("SET_LSA command processed: offset=%u\n", offset);
+
+	*len = 0;
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_event_record(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_get_event_record *event_req = (struct cxl_mbox_get_event_record *)cmd->payload;
+	struct cxl_mbox_get_event_record *event_resp = (struct cxl_mbox_get_event_record *)cmd->payload;
+	u8 log_type = event_req->event_log;
+	struct list_head *pos;
+	int count = 0;
+
+	if (log_type >= CXL_EVENT_TYPE_MAX) {
+		*len = 0;
+		return CXL_MBOX_INVALID_INPUT;
+	}
+
+	memset(event_resp, 0, sizeof(*event_resp));
+	event_resp->event_log = log_type;
+
+	spin_lock(&cxl_dev->event_log_lock);
+
+	/* Count events and copy them */
+	list_for_each(pos, &cxl_dev->event_logs[log_type]) {
+		if (count < 16) { /* Max 16 records per request */
+			struct cxl_event_generic *record = (struct cxl_event_generic *)(pos + 1);
+			memcpy(&event_resp->records[count], record, sizeof(*record));
+			count++;
+		}
+	}
+
+	event_resp->record_count = cpu_to_le16(count);
+
+	/* Clear event status if no more events */
+	if (list_empty(&cxl_dev->event_logs[log_type])) {
+		cxl_dev->status->status &= ~BIT(log_type);
+	}
+
+	spin_unlock(&cxl_dev->event_log_lock);
+
+	*len = sizeof(*event_resp) + count * sizeof(struct cxl_event_generic);
+	NVMEV_DEBUG("GET_EVENT_RECORD: log=%d, returned %d records\n", log_type, count);
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_clear_event_record(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_clear_event_record *clear = (struct cxl_mbox_clear_event_record *)cmd->payload;
+	u8 log_type = clear->event_log;
+	struct list_head *pos, *tmp;
+
+	if (log_type >= CXL_EVENT_TYPE_MAX) {
+		*len = 0;
+		return CXL_MBOX_INVALID_INPUT;
+	}
+
+	spin_lock(&cxl_dev->event_log_lock);
+
+	if (clear->clear_flags & 0x1) {
+		/* Clear all events */
+		list_for_each_safe(pos, tmp, &cxl_dev->event_logs[log_type]) {
+			list_del(pos);
+			kfree(pos);
+		}
+	} else {
+		/* Clear specific handles (not implemented) */
+	}
+
+	/* Clear event status */
+	if (list_empty(&cxl_dev->event_logs[log_type])) {
+		cxl_dev->status->status &= ~BIT(log_type);
+	}
+
+	spin_unlock(&cxl_dev->event_log_lock);
+
+	*len = 0;
+	NVMEV_DEBUG("CLEAR_EVENT_RECORD: log=%d\n", log_type);
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_timestamp(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	u64 *timestamp = (u64 *)cmd->payload;
+
+	if (cxl_dev->timestamp_set) {
+		*timestamp = cpu_to_le64(cxl_dev->timestamp + ktime_get_real_ns());
+	} else {
+		*timestamp = cpu_to_le64(ktime_get_real_ns());
+	}
+
+	*len = sizeof(u64);
+	NVMEV_DEBUG("GET_TIMESTAMP: %llu\n", le64_to_cpu(*timestamp));
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_set_timestamp(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	u64 *timestamp = (u64 *)cmd->payload;
+
+	cxl_dev->timestamp = le64_to_cpu(*timestamp) - ktime_get_real_ns();
+	cxl_dev->timestamp_set = true;
+
+	*len = 0;
+	NVMEV_DEBUG("SET_TIMESTAMP: %llu\n", le64_to_cpu(*timestamp));
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_fw_info(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_get_fw_info *fw_info = (struct cxl_mbox_get_fw_info *)cmd->payload;
+
+	memset(fw_info, 0, sizeof(*fw_info));
+
+	fw_info->num_slots = 2;
+	fw_info->slot_info = 0x01; /* Slot 1 active */
+	fw_info->activation_cap = 0x00;
+
+	snprintf(fw_info->slot_1_revision, 16, "NVMEV-1.0");
+	snprintf(fw_info->slot_2_revision, 16, "NVMEV-1.0");
+
+	*len = sizeof(*fw_info);
+	NVMEV_DEBUG("GET_FW_INFO command processed\n");
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_log(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_get_log *get_log = (struct cxl_mbox_get_log *)cmd->payload;
+	uuid_t uuid;
+	u32 offset, length;
+	int i;
+
+	/* Extract UUID and parameters */
+	memcpy(&uuid, &get_log->uuid, sizeof(uuid));
+	offset = le32_to_cpu(get_log->offset);
+	length = le32_to_cpu(get_log->length);
+
+	NVMEV_DEBUG("GET_LOG: offset=%u length=%u\n", offset, length);
+
+	/* Check if requesting Command Effects Log (CEL) */
+	if (uuid_equal(&uuid, &CEL_UUID)) {
+		struct cxl_cel_entry *cel_entries;
+		int num_cmds = ARRAY_SIZE(cxl_cmd_table_tmp);
+		size_t cel_size = num_cmds * sizeof(struct cxl_cel_entry);
+
+		/* Validate offset and length */
+		if (offset >= cel_size) {
+			*len = 0;
+			return CXL_MBOX_INVALID_INPUT;
+		}
+
+		/* Allocate temporary buffer for CEL */
+		cel_entries = kzalloc(cel_size, GFP_KERNEL);
+		if (!cel_entries) {
+			*len = 0;
+			return CXL_MBOX_INTERNAL_ERROR;
+		}
+
+		/* Build CEL from command table */
+		for (i = 0; i < num_cmds; i++) {
+			cel_entries[i].opcode = cpu_to_le16(cxl_cmd_table_tmp[i].opcode);
+			cel_entries[i].effect = cpu_to_le16(cxl_cmd_table_tmp[i].effect);
+		}
+
+		/* Copy requested portion to payload */
+		length = min(length, (u32)(cel_size - offset));
+		memcpy(cmd->payload, ((u8 *)cel_entries) + offset, length);
+
+		kfree(cel_entries);
+
+		*len = length;
+		NVMEV_DEBUG("GET_LOG (CEL): returned %u bytes, %d commands\n", length, num_cmds);
+		return CXL_MBOX_SUCCESS;
+	}
+
+	/* Unsupported log UUID */
+	*len = 0;
+	NVMEV_DEBUG("GET_LOG: unsupported log UUID\n");
+	return CXL_MBOX_UNSUPPORTED;
+}
+
+static u32 cmd_get_supported_logs(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct {
+		__le16 num_logs;
+		u8 reserved[6];
+		struct {
+			uuid_t uuid;
+			__le32 size;
+		} __packed logs[1];
+	} __packed *log_list = (void *)cmd->payload;
+	int num_cmds = ARRAY_SIZE(cxl_cmd_table_tmp);
+
+	/* Report CEL as the only supported log */
+	log_list->num_logs = cpu_to_le16(1);
+	memset(log_list->reserved, 0, sizeof(log_list->reserved));
+
+	/* CEL entry */
+	memcpy(&log_list->logs[0].uuid, &CEL_UUID, sizeof(uuid_t));
+	log_list->logs[0].size = cpu_to_le32(num_cmds * sizeof(struct cxl_cel_entry));
+
+	*len = sizeof(*log_list);
+	NVMEV_DEBUG("GET_SUPPORTED_LOGS: returned CEL (size=%u)\n",
+	            num_cmds * sizeof(struct cxl_cel_entry));
+	return CXL_MBOX_SUCCESS;
+}
+
+/* Event Interrupt Policy - CXL 3.0 Section 8.2.9.2.4 */
+struct cxl_mbox_event_int_policy {
+	u8 info_settings;
+	u8 warn_settings;
+	u8 failure_settings;
+	u8 fatal_settings;
+} __packed;
+
+static u32 cmd_get_event_int_policy(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_event_int_policy *policy = (struct cxl_mbox_event_int_policy *)cmd->payload;
+
+	/* Return the stored policy (set by SET_EVT_INT_POLICY) */
+	policy->info_settings = cxl_dev->evt_int_policy[0];
+	policy->warn_settings = cxl_dev->evt_int_policy[1];
+	policy->failure_settings = cxl_dev->evt_int_policy[2];
+	policy->fatal_settings = cxl_dev->evt_int_policy[3];
+
+	*len = sizeof(*policy);
+	NVMEV_DEBUG("GET_EVT_INT_POLICY: info=0x%02x warn=0x%02x fail=0x%02x fatal=0x%02x\n",
+	            policy->info_settings, policy->warn_settings,
+	            policy->failure_settings, policy->fatal_settings);
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_set_event_int_policy(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_event_int_policy *policy = (struct cxl_mbox_event_int_policy *)cmd->payload;
+
+	/* Store the policy for later retrieval by GET_EVT_INT_POLICY */
+	cxl_dev->evt_int_policy[0] = policy->info_settings;
+	cxl_dev->evt_int_policy[1] = policy->warn_settings;
+	cxl_dev->evt_int_policy[2] = policy->failure_settings;
+	cxl_dev->evt_int_policy[3] = policy->fatal_settings;
+
+	NVMEV_DEBUG("SET_EVT_INT_POLICY: info=0x%02x warn=0x%02x fail=0x%02x fatal=0x%02x\n",
+	            policy->info_settings, policy->warn_settings,
+	            policy->failure_settings, policy->fatal_settings);
+
+	*len = 0;
+	return CXL_MBOX_SUCCESS;
+}
+
+static u32 cmd_get_health_info(struct cxl_cmd *cmd, struct cxl_device_state *cxl_dev, u16 *len)
+{
+	struct cxl_mbox_health_info *health = (struct cxl_mbox_health_info *)cmd->payload;
+
+	memset(health, 0, sizeof(*health));
+
+	/* Device health status: Normal (0x0) */
+	health->health_status = 0x0;
+
+	/* Media status: Normal (0x0) */
+	health->media_status = 0x0;
+
+	/* Additional status: None (0x0) */
+	health->additional_status = 0x0;
+
+	/* Life used: 0% */
+	health->life_used = 0;
+
+	/* Device temperature: 25°C (in Celsius) */
+	health->device_temperature = cpu_to_le16(25);
+
+	/* Error counters */
+	health->dirty_shutdown_count = cpu_to_le32(0);
+	health->corrected_volatile_error_count = cpu_to_le32(0);
+	health->corrected_persistent_error_count = cpu_to_le32(0);
+
+	*len = sizeof(*health);
+	NVMEV_DEBUG("GET_HEALTH_INFO command processed\n");
+	return CXL_MBOX_SUCCESS;
+}
+
+/* Command table */
+static const struct {
+	u16 opcode;
+	u16 effect;
+	cxl_cmd_handler handler;
+} cxl_cmd_table[] = {
+	{ CXL_MBOX_OP_GET_EVENT_RECORD, CXL_CMD_EFFECT_NONE, cmd_get_event_record },
+	{ CXL_MBOX_OP_CLEAR_EVENT_RECORD, CXL_CMD_EFFECT_LOG_CHANGE, cmd_clear_event_record },
+	{ CXL_MBOX_OP_GET_EVT_INT_POLICY, CXL_CMD_EFFECT_NONE, cmd_get_event_int_policy },
+	{ CXL_MBOX_OP_SET_EVT_INT_POLICY, CXL_CMD_EFFECT_CONF_CHANGE, cmd_set_event_int_policy },
+	{ CXL_MBOX_OP_GET_FW_INFO, CXL_CMD_EFFECT_NONE, cmd_get_fw_info },
+	{ CXL_MBOX_OP_GET_TIMESTAMP, CXL_CMD_EFFECT_NONE, cmd_get_timestamp },
+	{ CXL_MBOX_OP_SET_TIMESTAMP, CXL_CMD_EFFECT_CONF_CHANGE, cmd_set_timestamp },
+	{ CXL_MBOX_OP_GET_SUPPORTED_LOGS, CXL_CMD_EFFECT_NONE, cmd_get_supported_logs },
+	{ CXL_MBOX_OP_GET_LOG, CXL_CMD_EFFECT_NONE, cmd_get_log },
+	{ CXL_MBOX_OP_IDENTIFY, CXL_CMD_EFFECT_NONE, cmd_identify },
+	{ CXL_MBOX_OP_GET_PARTITION_INFO, CXL_CMD_EFFECT_NONE, cmd_get_partition_info },
+	{ CXL_MBOX_OP_GET_LSA, CXL_CMD_EFFECT_NONE, cmd_get_lsa },
+	{ CXL_MBOX_OP_SET_LSA, CXL_CMD_EFFECT_DATA_CHANGE, cmd_set_lsa },
+	{ CXL_MBOX_OP_GET_HEALTH_INFO, CXL_CMD_EFFECT_NONE, cmd_get_health_info },
+};
+
+/* Process mailbox command */
+u32 cxl_process_mailbox_cmd(struct cxl_device_state *cxl_dev, u64 cmd_reg, u8 *payload)
+{
+	struct cxl_cmd cmd;
+	u16 opcode = cmd_reg & 0xFFFF;
+	u16 payload_len = (cmd_reg >> 16) & 0xFFFFF;
+	u16 out_len = 0;
+	u32 ret = CXL_MBOX_UNSUPPORTED;
+	int i;
+
+	NVMEV_DEBUG("Processing mailbox command: opcode=0x%04x len=%u\n",
+	            opcode, payload_len);
+
+	/* Find and execute command handler */
+	for (i = 0; i < ARRAY_SIZE(cxl_cmd_table); i++) {
+		if (cxl_cmd_table[i].opcode == opcode) {
+			cmd.opcode = opcode;
+			cmd.effect = cxl_cmd_table[i].effect;
+			cmd.payload = payload;
+
+			ret = cxl_cmd_table[i].handler(&cmd, cxl_dev, &out_len);
+
+			/* Update payload length in command register for response */
+			if (ret == CXL_MBOX_SUCCESS && out_len > 0) {
+				cxl_dev->mailbox->mailbox_cmd &= 0xFFFF;
+				cxl_dev->mailbox->mailbox_cmd |= ((u64)out_len << 16);
+			}
+			break;
+		}
+	}
+
+	if (ret == CXL_MBOX_UNSUPPORTED) {
+		NVMEV_DEBUG("Unsupported mailbox command: 0x%04x\n", opcode);
+	}
+
+	return ret;
+}
