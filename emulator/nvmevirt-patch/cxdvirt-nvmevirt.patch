diff --git a/cxlssd_ftl.c b/cxlssd_ftl.c
new file mode 100644
index 0000000..be69e94
--- /dev/null
+++ b/cxlssd_ftl.c
@@ -0,0 +1,461 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/sched/clock.h>
+
+#include "nvmev.h"
+#include "cxlssd_ftl.h"
+#include "ssd.h"
+#include "channel_model.h"
+
+/* Default NAND timing parameters (in nanoseconds) */
+#define DEFAULT_PAGE_READ_LATENCY	50000   /* 50us for page read */
+
+/* Create CXL-specific SSD structure similar to conv_ftl */
+struct cxl_ssd *cxl_ftl_init(unsigned int nr_channels,
+			      unsigned int dies_per_channel,
+			      struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_ssd *cxl_ssd;
+	struct ssdparams *spp;
+	unsigned int capacity_mb = nvmev_vdev->cxl_mb ?
+		(nvmev_vdev->cxl_mb->nand_size >> 20) : 16384; /* Default 16GB */
+	int i;
+
+	cxl_ssd = kzalloc(sizeof(*cxl_ssd), GFP_KERNEL);
+	if (!cxl_ssd)
+		return NULL;
+
+	cxl_ssd->ssd.cpu_nr_dispatcher = nvmev_vdev->config.cpu_nr_dispatcher;
+
+	/* Initialize SSD parameters similar to conv_ftl */
+	spp = &cxl_ssd->ssd.sp;
+	ssd_init_params(spp, MB_TO_BYTE(capacity_mb), 1);
+
+	/* Override with CXL-specific parameters if provided */
+	if (nr_channels > 0)
+		spp->nchs = nr_channels;
+	if (dies_per_channel > 0)
+		spp->luns_per_ch = dies_per_channel;
+
+	/* Initialize channels - allocate and setup channel structures */
+	cxl_ssd->ssd.ch = kzalloc(sizeof(struct ssd_channel) * spp->nchs, GFP_KERNEL);
+	if (!cxl_ssd->ssd.ch) {
+		kfree(cxl_ssd);
+		return NULL;
+	}
+
+	/* Initialize each channel with LUNs and planes */
+	for (i = 0; i < spp->nchs; i++) {
+		struct ssd_channel *ch = &cxl_ssd->ssd.ch[i];
+		int j, k;
+
+		/* Initialize LUNs for this channel */
+		ch->nluns = spp->luns_per_ch;
+		ch->lun = kzalloc(sizeof(struct nand_lun) * ch->nluns, GFP_KERNEL);
+		if (!ch->lun) {
+			/* Cleanup on error */
+			while (--i >= 0) {
+				kfree(cxl_ssd->ssd.ch[i].lun);
+			}
+			kfree(cxl_ssd->ssd.ch);
+			kfree(cxl_ssd);
+			return NULL;
+		}
+
+		/* Initialize each LUN with planes */
+		for (j = 0; j < ch->nluns; j++) {
+			struct nand_lun *lun = &ch->lun[j];
+			lun->npls = spp->pls_per_lun;
+			lun->pl = kzalloc(sizeof(struct nand_plane) * lun->npls, GFP_KERNEL);
+			if (!lun->pl) {
+				/* Cleanup on error */
+				while (--j >= 0) {
+					kfree(ch->lun[j].pl);
+				}
+				kfree(ch->lun);
+				while (--i >= 0) {
+					for (k = 0; k < cxl_ssd->ssd.ch[i].nluns; k++)
+						kfree(cxl_ssd->ssd.ch[i].lun[k].pl);
+					kfree(cxl_ssd->ssd.ch[i].lun);
+				}
+				kfree(cxl_ssd->ssd.ch);
+				kfree(cxl_ssd);
+				return NULL;
+			}
+
+			/* Initialize plane parameters */
+			for (k = 0; k < lun->npls; k++) {
+				struct nand_plane *pl = &lun->pl[k];
+				pl->next_pln_avail_time = 0;
+			}
+
+			lun->next_lun_avail_time = 0;
+			lun->busy = false;
+		}
+
+		/* Initialize channel performance model */
+		ch->perf_model = kzalloc(sizeof(struct channel_model), GFP_KERNEL);
+		if (ch->perf_model)
+			chmodel_init(ch->perf_model, spp->ch_bandwidth);
+	}
+
+	/* Initialize PCIe performance model (even though CXL uses memory bus) */
+	cxl_ssd->ssd.pcie = kzalloc(sizeof(struct ssd_pcie), GFP_KERNEL);
+	if (cxl_ssd->ssd.pcie) {
+		cxl_ssd->ssd.pcie->perf_model = kzalloc(sizeof(struct channel_model), GFP_KERNEL);
+		if (cxl_ssd->ssd.pcie->perf_model)
+			chmodel_init(cxl_ssd->ssd.pcie->perf_model, spp->pcie_bandwidth);
+	}
+
+	/* Initialize write buffer */
+	cxl_ssd->ssd.write_buffer = kzalloc(sizeof(struct buffer), GFP_KERNEL);
+	if (cxl_ssd->ssd.write_buffer)
+		buffer_init(cxl_ssd->ssd.write_buffer, spp->write_buffer_size);
+
+	/* Initialize per-channel locks */
+	for (i = 0; i < spp->nchs && i < CXL_FTL_MAX_CHANNELS; i++)
+		spin_lock_init(&cxl_ssd->ch_locks[i]);
+
+	/* Compute line-level erase geometry */
+	cxl_ssd->hugepages_per_line = spp->pgs_per_line / CXL_PAGES_PER_HPAGE;
+	cxl_ssd->tt_lines = spp->tt_lines;
+	cxl_ssd->oneshotpgs_per_line =
+		cxl_ssd->hugepages_per_line *
+		(CXL_PAGES_PER_HPAGE / spp->pgs_per_oneshotpg);
+
+	/* Statistics are atomic — kzalloc already zeroed them */
+
+	NVMEV_INFO("CXL FTL initialized: %u channels, %u dies/channel, "
+		   "4KB read=%u ns, write=%u ns, erase=%u ns\n",
+		   spp->nchs, spp->luns_per_ch,
+		   spp->pg_4kb_rd_lat[CELL_TYPE_LSB],
+		   spp->pg_wr_lat, spp->blk_er_lat);
+
+	NVMEV_INFO("CXL FTL: hugepages_per_line=%lu, oneshotpgs_per_line=%lu, "
+		   "tt_lines=%lu, line_size=%lu KB, per-die block_size=%lu KB\n",
+		   cxl_ssd->hugepages_per_line, cxl_ssd->oneshotpgs_per_line,
+		   cxl_ssd->tt_lines,
+		   BYTE_TO_KB((unsigned long)spp->pgs_per_line * spp->pgsz),
+		   BYTE_TO_KB((unsigned long)spp->pgs_per_blk * spp->pgsz));
+
+	return cxl_ssd;
+}
+
+/*
+ * Map a linear NAND page index to a physical page address (PPA).
+ *
+ * Die rotation: die = (die_pos + line_id + stripe_in_line) % num_dies
+ *
+ *   die_pos        = layer index within hugepage  (cycles 0..num_dies-1)
+ *   stripe_in_line = hugepage index within erase line
+ *   line_id        = erase line number
+ *
+ * This gives full write parallelism (each hugepage's layers hit all dies),
+ * full layer-major read parallelism (same layer across hugepages fans out
+ * to different dies), and clean erase-line erasure (hugepages are fully
+ * contained within a single erase line, no (die, blk, pg) collisions).
+ */
+static struct ppa cxl_ftl_page_to_ppa(struct cxl_ssd *cxl_ssd,
+				       unsigned long pg_idx)
+{
+	struct ssdparams *spp = &cxl_ssd->ssd.sp;
+	struct ppa ppa;
+	unsigned long oneshotpg_idx, pg_in_oneshotpg;
+	unsigned long num_dies, line_id, intra_line, die_pos, die;
+	unsigned long stripe_in_line;
+
+	ppa.ppa = 0;
+
+	oneshotpg_idx   = pg_idx / spp->pgs_per_oneshotpg;
+	pg_in_oneshotpg = pg_idx % spp->pgs_per_oneshotpg;
+
+	num_dies   = (unsigned long)spp->nchs * spp->luns_per_ch;
+	line_id    = oneshotpg_idx / cxl_ssd->oneshotpgs_per_line;
+	intra_line = oneshotpg_idx % cxl_ssd->oneshotpgs_per_line;
+
+	die_pos        = intra_line % num_dies;
+	stripe_in_line = intra_line / num_dies;
+	die            = (die_pos + line_id + stripe_in_line) % num_dies;
+
+	ppa.g.ch  = die % spp->nchs;
+	ppa.g.lun = die / spp->nchs;
+	ppa.g.pl  = 0;
+
+	/* Block = line_id (one block per die per erase line) */
+	ppa.g.blk = line_id % spp->blks_per_pl;
+
+	/* Page within block */
+	ppa.g.pg = stripe_in_line * spp->pgs_per_oneshotpg + pg_in_oneshotpg;
+
+	return ppa;
+}
+
+static inline bool cxl_is_same_flash_page(struct ssdparams *spp,
+					   struct ppa ppa1, struct ppa ppa2)
+{
+	return (ppa1.h.blk_in_ssd == ppa2.h.blk_in_ssd) &&
+	       ((ppa1.g.pg / spp->pgs_per_flashpg) == (ppa2.g.pg / spp->pgs_per_flashpg));
+}
+
+unsigned long long cxl_ftl_calc_latency(struct cxl_ssd *cxl_ssd,
+					 unsigned long page_idx,
+					 bool is_write,
+					 size_t size,
+					 unsigned long long nsecs_start)
+{
+	struct ssdparams *spp;
+	unsigned long nr_pages;
+	unsigned long long nsecs_completed, nsecs_latest;
+	unsigned long flags;
+	unsigned long i;
+
+	if (!cxl_ssd) {
+		NVMEV_ERROR("CXL FTL not initialized\n");
+		return nsecs_start + DEFAULT_PAGE_READ_LATENCY;
+	}
+
+	spp = &cxl_ssd->ssd.sp;
+	nr_pages = DIV_ROUND_UP(size, spp->pgsz);
+	nsecs_latest = nsecs_start;
+
+	if (is_write) {
+		/*
+		 * Write path: group pages by oneshot page and issue one
+		 * NAND_WRITE per group.  PPA computation is lock-free;
+		 * only ssd_advance_nand() runs under the per-channel lock.
+		 */
+		struct ppa last_ppa;
+		unsigned long cur_oneshotpg = ULONG_MAX;
+		unsigned long pages_in_cur = 0;
+		struct nand_cmd swr = {
+			.type = USER_IO,
+			.cmd = NAND_WRITE,
+			.stime = nsecs_start,
+			.interleave_pci_dma = false,
+		};
+
+		for (i = 0; i < nr_pages; i++) {
+			struct ppa ppa = cxl_ftl_page_to_ppa(cxl_ssd,
+							     page_idx + i);
+			unsigned long oneshotpg_idx =
+				(page_idx + i) / spp->pgs_per_oneshotpg;
+
+			if (oneshotpg_idx != cur_oneshotpg) {
+				/* Flush previous oneshot page group */
+				if (pages_in_cur > 0) {
+					swr.xfer_size = pages_in_cur *
+							spp->pgsz;
+					swr.ppa = &last_ppa;
+					spin_lock_irqsave(
+						&cxl_ssd->ch_locks[last_ppa.g.ch],
+						flags);
+					nsecs_completed = ssd_advance_nand(
+						&cxl_ssd->ssd, &swr);
+					spin_unlock_irqrestore(
+						&cxl_ssd->ch_locks[last_ppa.g.ch],
+						flags);
+					nsecs_latest = max(nsecs_completed,
+							   nsecs_latest);
+				}
+				cur_oneshotpg = oneshotpg_idx;
+				pages_in_cur = 0;
+			}
+
+			pages_in_cur++;
+			last_ppa = ppa;
+		}
+
+		/* Flush remaining oneshot page group */
+		if (pages_in_cur > 0) {
+			swr.xfer_size = pages_in_cur * spp->pgsz;
+			swr.ppa = &last_ppa;
+			spin_lock_irqsave(
+				&cxl_ssd->ch_locks[last_ppa.g.ch], flags);
+			nsecs_completed = ssd_advance_nand(
+				&cxl_ssd->ssd, &swr);
+			spin_unlock_irqrestore(
+				&cxl_ssd->ch_locks[last_ppa.g.ch], flags);
+			nsecs_latest = max(nsecs_completed, nsecs_latest);
+		}
+
+		atomic64_inc(&cxl_ssd->total_writes);
+	} else {
+		/*
+		 * Read path: aggregate 4KB pages within the same flash page,
+		 * then issue one NAND_READ per flash page.  PPA computation
+		 * and coalescing are lock-free; only ssd_advance_nand() runs
+		 * under the per-channel lock.
+		 */
+		struct ppa prev_ppa;
+		uint64_t xfer_size = 0;
+		struct nand_cmd srd = {
+			.type = USER_IO,
+			.cmd = NAND_READ,
+			.stime = nsecs_start,
+			.interleave_pci_dma = false,
+		};
+
+		prev_ppa.ppa = UNMAPPED_PPA;
+
+		for (i = 0; i < nr_pages; i++) {
+			struct ppa cur_ppa = cxl_ftl_page_to_ppa(
+				cxl_ssd, page_idx + i);
+
+			/* Aggregate reads within the same flash page */
+			if (prev_ppa.ppa != UNMAPPED_PPA &&
+			    cxl_is_same_flash_page(spp, cur_ppa, prev_ppa)) {
+				xfer_size += spp->pgsz;
+				continue;
+			}
+
+			/* Issue previously accumulated flash page read */
+			if (xfer_size > 0) {
+				srd.xfer_size = xfer_size;
+				srd.ppa = &prev_ppa;
+				spin_lock_irqsave(
+					&cxl_ssd->ch_locks[prev_ppa.g.ch],
+					flags);
+				nsecs_completed = ssd_advance_nand(
+					&cxl_ssd->ssd, &srd);
+				spin_unlock_irqrestore(
+					&cxl_ssd->ch_locks[prev_ppa.g.ch],
+					flags);
+				nsecs_latest = max(nsecs_completed,
+						   nsecs_latest);
+			}
+
+			xfer_size = spp->pgsz;
+			prev_ppa = cur_ppa;
+		}
+
+		/* Issue remaining flash page read */
+		if (xfer_size > 0) {
+			srd.xfer_size = xfer_size;
+			srd.ppa = &prev_ppa;
+			spin_lock_irqsave(
+				&cxl_ssd->ch_locks[prev_ppa.g.ch], flags);
+			nsecs_completed = ssd_advance_nand(
+				&cxl_ssd->ssd, &srd);
+			spin_unlock_irqrestore(
+				&cxl_ssd->ch_locks[prev_ppa.g.ch], flags);
+			nsecs_latest = max(nsecs_completed, nsecs_latest);
+		}
+
+		atomic64_inc(&cxl_ssd->total_reads);
+	}
+
+	NVMEV_DEBUG("CXL FTL: %s page_idx=%lu nr_pages=%lu size=%zu "
+		    "latency=%llu ns (%llu us)\n",
+		    is_write ? "WRITE" : "READ", page_idx, nr_pages, size,
+		    nsecs_latest - nsecs_start,
+		    (nsecs_latest - nsecs_start) / 1000);
+
+	return nsecs_latest;
+}
+
+unsigned long long cxl_ftl_erase_line(struct cxl_ssd *cxl_ssd,
+				      unsigned long line_id,
+				      unsigned long long nsecs_start)
+{
+	struct ssdparams *spp = &cxl_ssd->ssd.sp;
+	struct ppa ppa = {0};
+	unsigned long long nsecs_latest = nsecs_start;
+	unsigned long flags;
+	int ch, lun;
+
+	ppa.g.blk = line_id;
+	ppa.g.pl = 0;
+
+	/* Issue one NAND_ERASE per die — per-channel lock */
+	for (ch = 0; ch < spp->nchs; ch++) {
+		spin_lock_irqsave(&cxl_ssd->ch_locks[ch], flags);
+		for (lun = 0; lun < spp->luns_per_ch; lun++) {
+			struct nand_cmd gce = {
+				.type = USER_IO,
+				.cmd = NAND_ERASE,
+				.stime = nsecs_start,
+				.interleave_pci_dma = false,
+				.ppa = &ppa,
+			};
+			unsigned long long t;
+
+			ppa.g.ch = ch;
+			ppa.g.lun = lun;
+
+			t = ssd_advance_nand(&cxl_ssd->ssd, &gce);
+			nsecs_latest = max(nsecs_latest, t);
+		}
+		spin_unlock_irqrestore(&cxl_ssd->ch_locks[ch], flags);
+	}
+
+	atomic64_inc(&cxl_ssd->total_erases);
+
+	NVMEV_INFO("CXL FTL: ERASE line=%lu dies=%d latency=%llu ns (%llu us)\n",
+		   line_id, spp->nchs * spp->luns_per_ch,
+		   nsecs_latest - nsecs_start,
+		   (nsecs_latest - nsecs_start) / 1000);
+
+	return nsecs_latest;
+}
+
+void cxl_ftl_cleanup(struct cxl_ssd *cxl_ssd)
+{
+	struct ssdparams *spp;
+	int i;
+
+	if (!cxl_ssd)
+		return;
+
+	spp = &cxl_ssd->ssd.sp;
+
+	NVMEV_INFO("CXL FTL stats: reads=%lld, writes=%lld, erases=%lld, "
+		   "channel_conflicts=%lld, die_conflicts=%lld\n",
+		   atomic64_read(&cxl_ssd->total_reads),
+		   atomic64_read(&cxl_ssd->total_writes),
+		   atomic64_read(&cxl_ssd->total_erases),
+		   atomic64_read(&cxl_ssd->total_channel_conflicts),
+		   atomic64_read(&cxl_ssd->total_die_conflicts));
+
+	ssd_remove(&cxl_ssd->ssd);
+	kfree(cxl_ssd);
+}
+
+void cxl_ftl_reset_busy_times(struct cxl_ssd *cxl_ssd)
+{
+	struct ssdparams *spp;
+	unsigned int i, j, k;
+	unsigned long flags;
+
+	if (!cxl_ssd)
+		return;
+
+	spp = &cxl_ssd->ssd.sp;
+
+	/* Reset per-channel state under each channel's lock */
+	for (i = 0; i < spp->nchs; i++) {
+		struct ssd_channel *ch = &cxl_ssd->ssd.ch[i];
+
+		spin_lock_irqsave(&cxl_ssd->ch_locks[i], flags);
+
+		for (j = 0; j < spp->luns_per_ch; j++) {
+			struct nand_lun *lun = &ch->lun[j];
+			lun->next_lun_avail_time = 0;
+			lun->busy = false;
+			lun->gc_endtime = 0;
+
+			for (k = 0; k < spp->pls_per_lun; k++)
+				lun->pl[k].next_pln_avail_time = 0;
+		}
+
+		ch->gc_endtime = 0;
+		if (ch->perf_model)
+			ch->perf_model->cur_time = 0;
+
+		spin_unlock_irqrestore(&cxl_ssd->ch_locks[i], flags);
+	}
+}
+
+MODULE_LICENSE("GPL v2");
