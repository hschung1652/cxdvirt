+	atomic64_t rmw_read_ns;
+	atomic64_t write_protect_faults;      /* .pfn_mkwrite upgrades (RO->RW dirty) */
+	atomic64_t victim_probes_4k;          /* candidates examined by the active 4K policy */
+	atomic64_t clock_victims_4k;          /* victims selected by CLOCK */
+	atomic64_t vskip_second_chance_4k;    /* CLOCK: referenced since last sweep, spared */
+	atomic64_t vforced_4k;                /* CLOCK: claimed in tier 2 (A-bit veto ignored) */
+	atomic64_t fifo_victims_4k;           /* victims selected by FIFO */
+	atomic64_t lifo_victims_4k;           /* victims selected by LIFO */
+	atomic64_t zap_failures_4k;            /* evictions deferred by mmap_lock contention */
+	atomic64_t evict_sync_fallback_4k;    /* async evicts forced sync on queue-full (Fix 2) */
+
+	/* Miss-triggered next-N prefetch accounting (4K mode).  Separates the
+	 * trigger stage (push) from the admission stage (dispatcher), so a
+	 * silent prefetch failure is visible as pushed >> admissions. */
+	atomic64_t pf4k_pushed;         /* triggers enqueued by fault handlers */
+	atomic64_t pf4k_dropped_full;   /* triggers lost to a full ring */
+	atomic64_t pf4k_paired_evicts;  /* victims evicted to admit a prefetch */
+	atomic64_t pf4k_no_victim;      /* admission stopped: no evictable victim */
+	atomic64_t pf4k_admit_fail;     /* load refused after room was made (lost race) */
+
+	/* Prefetcher quality, measured rather than inferred.  End-to-end timing
+	 * cannot separate prediction from this prefetcher's side effects
+	 * (async paired eviction, clean-page injection), so accuracy has to be
+	 * counted directly at the page level.
+	 *   accuracy    = useful / (useful + wasted)
+	 *   timeliness  = 1 - late / useful
+	 * NOTE: `useful` is observed via the hardware A-bit sampled by the CLOCK
+	 * victim finder, because a prefetched page gets its PTE pre-installed
+	 * and therefore never faults on use.  FIFO/LIFO never sample the A-bit,
+	 * so useful/wasted are CLOCK-only; late is policy-independent. */
+	atomic64_t pf4k_useful;         /* prefetched page was touched before eviction */
+	atomic64_t pf4k_wasted;         /* prefetched page evicted untouched */
+	atomic64_t pf4k_late;           /* demand fault had to wait on an in-flight prefetch */
+};
+
+/*
+ * FIFO/LIFO residency ordering for 4K mode.
+ *
+ * The list contains pages from the moment they enter the logical cache until
+ * eviction completes.  A selected page remains linked while EVICTING, so a
+ * failed PTE zap can simply return it to CACHED without losing its original
+ * FIFO/LIFO position.  CLOCK does not use this list.
+ */
+static inline bool __cxl_policy_linked_4k(struct cxl_memory_backend *cxl_mb,
+					  u32 page_idx,
+					  struct cxl_page_entry *entry)
+{
+	return cxl_mb->policy_head_4k == page_idx ||
+	       cxl_mb->policy_tail_4k == page_idx ||
+	       entry->policy_prev != CXL_POLICY_IDX_NONE ||
+	       entry->policy_next != CXL_POLICY_IDX_NONE;
+}
+
+static inline void cxl_policy_insert_4k(struct cxl_memory_backend *cxl_mb,
+					 unsigned long page_idx_ul)
+{
+	struct cxl_page_entry *entry;
+	unsigned long flags;
+	u32 page_idx = (u32)page_idx_ul;
+	u32 tail;
+
+	if (cxl_mb->cache_policy == CXL_CACHE_POLICY_CLOCK)
+		return;
+
+	entry = &cxl_mb->page_table[page_idx];
+	spin_lock_irqsave(&cxl_mb->policy_lock_4k, flags);
+	if (__cxl_policy_linked_4k(cxl_mb, page_idx, entry))
+		goto out;
+
+	tail = cxl_mb->policy_tail_4k;
+	entry->policy_prev = tail;
+	entry->policy_next = CXL_POLICY_IDX_NONE;
+	if (tail == CXL_POLICY_IDX_NONE)
+		cxl_mb->policy_head_4k = page_idx;
+	else
+		cxl_mb->page_table[tail].policy_next = page_idx;
+	cxl_mb->policy_tail_4k = page_idx;
+out:
+	spin_unlock_irqrestore(&cxl_mb->policy_lock_4k, flags);
+}
+
+static inline void cxl_policy_remove_4k(struct cxl_memory_backend *cxl_mb,
+					 unsigned long page_idx_ul)
+{
+	struct cxl_page_entry *entry;
+	unsigned long flags;
+	u32 page_idx = (u32)page_idx_ul;
+	u32 prev, next;
+
+	if (cxl_mb->cache_policy == CXL_CACHE_POLICY_CLOCK)
+		return;
+
+	entry = &cxl_mb->page_table[page_idx];
+	spin_lock_irqsave(&cxl_mb->policy_lock_4k, flags);
+	if (!__cxl_policy_linked_4k(cxl_mb, page_idx, entry))
+		goto out;
+
+	prev = entry->policy_prev;
+	next = entry->policy_next;
+	if (prev == CXL_POLICY_IDX_NONE)
+		cxl_mb->policy_head_4k = next;
+	else
+		cxl_mb->page_table[prev].policy_next = next;
+	if (next == CXL_POLICY_IDX_NONE)
+		cxl_mb->policy_tail_4k = prev;
+	else
+		cxl_mb->page_table[next].policy_prev = prev;
+	entry->policy_prev = CXL_POLICY_IDX_NONE;
+	entry->policy_next = CXL_POLICY_IDX_NONE;
+out:
+	spin_unlock_irqrestore(&cxl_mb->policy_lock_4k, flags);
+}
+
+/*
+ * Move a temporarily non-evictable ordered-policy candidate away from the
+ * victim end.  Leaving FIFO's head or LIFO's tail in place after a failed zap
+ * makes the next sweep immediately select the same page and can starve every
+ * other resident while mmap_lock is contended.
+ */
+static inline void cxl_policy_defer_4k(struct cxl_memory_backend *cxl_mb,
+					unsigned long page_idx_ul)
+{
+	struct cxl_page_entry *entry;
+	unsigned long flags;
+	u32 page_idx = (u32)page_idx_ul;
+	u32 prev, next;
+
+	if (cxl_mb->cache_policy == CXL_CACHE_POLICY_CLOCK)
+		return;
+
+	entry = &cxl_mb->page_table[page_idx];
+	spin_lock_irqsave(&cxl_mb->policy_lock_4k, flags);
+	if (!__cxl_policy_linked_4k(cxl_mb, page_idx, entry))
+		goto out;
+
+	/* Unlink from the current position. */
+	prev = entry->policy_prev;
+	next = entry->policy_next;
+	if (prev == CXL_POLICY_IDX_NONE)
+		cxl_mb->policy_head_4k = next;
+	else
+		cxl_mb->page_table[prev].policy_next = next;
+	if (next == CXL_POLICY_IDX_NONE)
+		cxl_mb->policy_tail_4k = prev;
+	else
+		cxl_mb->page_table[next].policy_prev = prev;
+
+	if (cxl_mb->cache_policy == CXL_CACHE_POLICY_FIFO) {
+		u32 tail = cxl_mb->policy_tail_4k;
+
+		/* Failed oldest candidate becomes the newest retry candidate. */
+		entry->policy_prev = tail;
+		entry->policy_next = CXL_POLICY_IDX_NONE;
+		if (tail == CXL_POLICY_IDX_NONE)
+			cxl_mb->policy_head_4k = page_idx;
+		else
+			cxl_mb->page_table[tail].policy_next = page_idx;
+		cxl_mb->policy_tail_4k = page_idx;
+	} else {
+		u32 head = cxl_mb->policy_head_4k;
+
+		/* Failed newest candidate becomes the oldest retry candidate. */
+		entry->policy_prev = CXL_POLICY_IDX_NONE;
+		entry->policy_next = head;
+		if (head == CXL_POLICY_IDX_NONE)
+			cxl_mb->policy_tail_4k = page_idx;
+		else
+			cxl_mb->page_table[head].policy_prev = page_idx;
+		cxl_mb->policy_head_4k = page_idx;
+	}
+out:
+	spin_unlock_irqrestore(&cxl_mb->policy_lock_4k, flags);
+}
+
+/* Inline helpers for DRAM slot access (shared by cxl_page_fault.c and cxl_async_io.c) */
+
+static inline void *cxl_dram_slot_addr(struct cxl_memory_backend *cxl_mb,
+				       unsigned long dram_slot)
+{
