@@ -626,6 +1737,39 @@ bool NVMEV_PCI_INIT(struct nvmev_dev *nvmev_vdev)
 #endif
 	nvmev_vdev->intx_disabled = false;
 
+#ifdef CONFIG_NVMEV_CXL_SUPPORT
+	if (nvmev_vdev->config.enable_cxl) {
+		/*
+		 * ECAM mode: Don't create our own PCI bus.
+		 *
+		 * With ECAM, the kernel's ACPI PCI root driver will create the bus
+		 * when it binds to the ACPI0016 device. The kernel reads config space
+		 * via ECAM (memory-mapped), which hits our virtDev copy at memmap_start.
+		 *
+		 * Flow:
+		 * 1. NVMEV_PCI_INIT() - just init virtDev (this function)
+		 * 2. nvmev_copy_config_to_ecam() - copy virtDev to physical memory
+		 * 3. nvmev_create_acpi_device() - inject SSDT
+		 * 4. Kernel enumerates bus via ECAM, creates pci_dev
+		 * 5. nvmev_wait_for_kernel_pdev() - find kernel's pdev
+		 * 6. nvmev_cxl_init_registers() - init CXL registers
+		 */
+		nvmev_vdev->virt_bus = NULL;
+		nvmev_vdev->pdev = NULL;
+
+		/* Initialize CXL DVSECs in virtDev */
+		if (cxl_pci_init_dvsecs(nvmev_vdev) < 0) {
+			NVMEV_ERROR("Failed to initialize CXL DVSECs\n");
+			return false;
+		}
+		nvmev_vdev->cxl_enabled = true;
+
+		NVMEV_INFO("CXL ECAM mode: PCI bus will be created by kernel via ACPI\n");
+		return true;
+	}
+#endif
+
+	/* Non-CXL mode: Create our own PCI bus with custom config space ops */
 	nvmev_vdev->virt_bus = __create_pci_bus();
 	if (!nvmev_vdev->virt_bus)
 		return false;
