+    0x02,0xF0,0x4E,0x56,0x4D,0x45,0x56,0x00,  /* 00000008    "..NVMEV." */
+    0x43,0x58,0x4C,0x52,0x54,0x00,0x00,0x00,  /* 00000010    "CXLRT..." */
+    0x01,0x00,0x00,0x00,0x49,0x4E,0x54,0x4C,  /* 00000018    "....INTL" */
+    0x28,0x06,0x23,0x20,0x10,0x2C,0x5C,0x5F,  /* 00000020    "(.# .,\_" */
+    0x53,0x42,0x5F,0x5B,0x82,0x24,0x43,0x58,  /* 00000028    "SB_[.$CX" */
+    0x4C,0x52,0x08,0x5F,0x48,0x49,0x44,0x0D,  /* 00000030    "LR._HID." */
+    0x41,0x43,0x50,0x49,0x30,0x30,0x31,0x37,  /* 00000038    "ACPI0017" */
