+
+/**
+ * cxl_get_async_stats() - Get async I/O statistics
+ */
+void cxl_get_async_stats(unsigned long long *async_loads_out,
+			 unsigned long long *async_evictions_out,
+			 unsigned long long *async_prefetches_out)
+{
+	*async_loads_out = atomic64_read(&async_loads);
+	*async_evictions_out = atomic64_read(&async_evictions);
+	*async_prefetches_out = atomic64_read(&async_prefetches);
+}
+
+/**
+ * cxl_reset_async_stats() - Reset async I/O statistics to zero
+ */
+void cxl_reset_async_stats(void)
+{
+	atomic64_set(&async_loads, 0);
+	atomic64_set(&async_evictions, 0);
+	atomic64_set(&async_prefetches, 0);
+}
+
+/*
+ * ============================================================================
+ * 4 KiB Mode Helpers (page_granularity=4k)
+ * ============================================================================
+ *
+ * Direct-PFN at 4 KiB: PTE points at NAND PFN; "CACHED" = PTE installed +
+ * latency paid; "NOT_CACHED" = next access faults and re-pays latency.
+ * No DRAM-backed copy, no slot pool, no chunk table.
+ */
+
+/* 4K async load completion: I/O worker fires this once the simulated NAND
+ * read latency has elapsed.  Transitions state to CACHED, increments the
+ * cached-set counter, optionally pre-installs the PTE across all mmap_entries
+ * so the next access avoids a fault.
+ */
+static void cxl_async_load_4k_completion(void *completion_data)
+{
+	struct cxl_async_completion *comp = completion_data;
+	struct nvmev_dev *nvmev_vdev = comp->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	struct cxl_page_entry *entry;
+	unsigned long page_idx = comp->hpage_idx; /* reuse field for page_idx */
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		goto out;
+
+	cxl_mb = nvmev_vdev->cxl_mb;
+
+	if (cxl_mb->pg_mode != CXL_PG_4K || page_idx >= cxl_mb->nr_pages)
+		goto out;
+
+	entry = &cxl_mb->page_table[page_idx];
+
+	/* Publish CACHED FIRST, then install the PTE.
+	 *
+	 * Ordering matters: cxl_install_4k_pte() guards on state==CACHED
+	 * (it pins, then re-checks state).  If we called it while state is
+	 * still LOADING, that guard would reject the install and the PTE
+	 * pre-warm would be a no-op.  So flip to CACHED before installing.
+	 * cxl_install_4k_pte's own pin_count protects the page from
+	 * eviction during the install window.  The budget credit was taken
+	 * at claim time in cxl_async_load_4k_page — no increment here.
+	 *
+	 * accessed=0, not 1: nobody has touched this page — it was
+	 * speculated on.  Seeding 1 hands a prefetched page a full CLOCK
+	 * second chance, so a wrong guess occupies the cache for two sweeps
+	 * instead of one.  A demand fill still earns its 1 in the fault
+	 * handler; a prefetched page that gets hit is spared by the
+	 * hardware A-bit check (cxl_pte_young_4k) the CLOCK finder runs. */
+	atomic_set(&entry->accessed, 0);
+	cxl_policy_insert_4k(cxl_mb, page_idx);
+	set_bit(page_idx, cxl_mb->cached_bm);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+
+	/* Install the PTE proactively in every mmap_entry so the next
+	 * access avoids a fault.  Best-effort — if a process doesn't have
+	 * the page-table levels populated yet, skip it (the next fault
+	 * will install). */
+	cxl_install_4k_pte(cxl_mb, page_idx);
+
+	wake_up(&entry->wait);
+
+	atomic64_inc(&async_loads);
+	atomic_dec_if_positive(&cxl_mb->prefetch_inflight);
+
+out:
+	if (comp->done)
+		complete(comp->done);
+	kfree(comp);
+}
+
+/* Install a single 4 KiB PTE for @page_idx across every mmap_entry.
+ *
+ * Bug 4 fix: actually installs the PTE via vmf_insert_pfn from worker
+ * context (NOT a fault handler).  vmf_insert_pfn is callable outside a
+ * fault context — it just needs a valid VMA and grabs its own pte_lock
+ * internally.  The kernel mm subsystem allows two concurrent inserts
+ * for the same (mm, addr, pfn) — the second sees PTE present with the
+ * matching PFN and returns success.
+ *
+ * Bug 3 protocol: pin_count protects against eviction during install.
+ * Bug 1 protocol: snapshot mmap_entries to prevent UAF.
+ * Bug 2 protocol: mmap_read_trylock to avoid stalling under writer.
+ *
+ * Caller: cxl_async_load_4k_completion (I/O worker thread context).
+ * Best-effort — silently skips processes whose mmap_lock is contended,
+ * whose VMA was unmapped, or where vmf_insert_pfn returns an error.
+ */
+void cxl_install_4k_pte(struct cxl_memory_backend *cxl_mb, unsigned long page_idx)
+{
+	struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+	struct cxl_page_entry *entry;
+	unsigned long pfn;
+	int n, i;
+
+	if (!cxl_mb || cxl_mb->pg_mode != CXL_PG_4K ||
+	    page_idx >= cxl_mb->nr_pages)
+		return;
+
+	entry = &cxl_mb->page_table[page_idx];
+	pfn = cxl_mb->nand_pfn_base + page_idx;
+
+	/* Bug 3: pin to block eviction during install. */
+	atomic_inc(&entry->pin_count);
+	smp_mb();
+
+	/* Re-check state — caller transitioned to CACHED but eviction may
+	 * have raced in between.  If not CACHED, skip the install. */
+	if (atomic_read(&entry->state) != CXL_HPAGE_CACHED) {
+		atomic_dec(&entry->pin_count);
+		wake_up(&entry->wait);
+		return;
+	}
+
+	n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+
+	for (i = 0; i < n; i++) {
+		struct vm_area_struct *vma;
+		unsigned long vaddr;
+
+		/* Only a mapping that covers this device page can take the PTE.
+		 * With a windowed mmap, base + page_idx would land inside a
+		 * DIFFERENT window and install this page's PFN at an address
+		 * belonging to another device page. */
+		if (!snap[i].mm || !cxl_snap_vaddr(&snap[i], page_idx, &vaddr))
+			continue;
+		if (!mmget_not_zero(snap[i].mm))
+			continue;
+
+		/* Bug 2: trylock — don't stall behind a queued writer. */
+		if (!mmap_read_trylock(snap[i].mm)) {
+			mmput(snap[i].mm);
+			continue;
+		}
+
+		vma = vma_lookup(snap[i].mm, vaddr);
+		if (vma && vaddr + PAGE_SIZE <= vma->vm_end) {
+			/* Install read-only so the first write traps via
+			 * .pfn_mkwrite (dirty tracking).  Best-effort: ignore
+			 * return — the next demand-fault will install correctly.
+			 *
+			 * Also clear _PAGE_ACCESSED.  x86's page-prot macros
+			 * carry ___A (see PAGE_READONLY/PAGE_SHARED), so a PTE
+			 * created here is born already-young even though nothing
+			 * has read the page.  Two things break if we leave it:
+			 *   - accuracy accounting: the CLOCK hand samples the
+			 *     A-bit as the ONLY evidence a prefetched page was
+			 *     used (it never faults, the PTE is pre-installed),
+			 *     so every prefetch scored "useful" -- a measured
+			 *     100.00% accuracy on a workload whose real accuracy
+			 *     is ~0.2%;
+			 *   - policy: it silently undid the accessed=0 set in
+			 *     the completion, handing every speculated page a
+			 *     CLOCK second chance it had not earned.
+			 * Born with A=0, the first genuine access sets it. */
+			pgprot_t ro = __pgprot(pgprot_val(vma->vm_page_prot) &
+					       ~(_PAGE_RW | _PAGE_ACCESSED));
+			(void)vmf_insert_pfn_prot(vma, vaddr, pfn, ro);
+		}
+
+		mmap_read_unlock(snap[i].mm);
+		mmput(snap[i].mm);
+	}
+
+	cxl_mmap_snap_release(snap, n);
+
+	atomic_dec(&entry->pin_count);
+	wake_up(&entry->wait);
+}
+EXPORT_SYMBOL_GPL(cxl_install_4k_pte);
+
+/* Zap the 4 KiB PTE at @page_idx across all mmap_entries.
+ * Used by 4K eviction to force a re-fault on next access.
+ *
+ * Returns true iff every mm we attempted was successfully locked and
+ * processed.  Returns false if any mmap_read_trylock failed (writer queued).
+ * Bug 1: snapshot under spinlock + mmgrab to prevent UAF on mm.
+ * Bug 2: trylock to avoid deadlock under mmap_write_lock contention.
+ */
+bool cxl_zap_4k_pte(struct cxl_memory_backend *cxl_mb, unsigned long page_idx)
+{
+	struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+	int n, i;
+	bool all_ok = true;
+
+	n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+
+	for (i = 0; i < n; i++) {
+		struct vm_area_struct *vma;
+		unsigned long vaddr;
+
+		if (!snap[i].mm)
+			continue;
+
+		/* A window that does not cover this device page has no PTE for
+		 * it: nothing to zap there.  base + page_idx would instead zap an
+		 * address belonging to a different device page. */
+		if (!cxl_snap_vaddr(&snap[i], page_idx, &vaddr))
+			continue;
+
+		/* Process exiting: its PTEs go away with exit_mmap anyway.
+		 * Treat as success (no zap work owed). */
+		if (!mmget_not_zero(snap[i].mm))
+			continue;
+
+		/* Bug 2: trylock instead of blocking lock.
+		 * If a writer is queued (mprotect/munmap/anon-mmap from another
+		 * thread in the same mm), we MUST NOT block here — otherwise
+		 * the dispatcher stalls and faults waiting on EVICTING never
+		 * make progress.  Report failure so caller can revert state
+		 * and retry next sweep. */
+		if (!mmap_read_trylock(snap[i].mm)) {
+			mmput(snap[i].mm);
+			all_ok = false;
+			continue;
+		}
+
+		vma = vma_lookup(snap[i].mm, vaddr);
+		if (vma)
+			zap_page_range_single(vma, vaddr, PAGE_SIZE, NULL);
+
+		mmap_read_unlock(snap[i].mm);
+		mmput(snap[i].mm);
+	}
+
+	cxl_mmap_snap_release(snap, n);
+	return all_ok;
+}
+EXPORT_SYMBOL_GPL(cxl_zap_4k_pte);
+
+/* Asynchronously schedule a NAND read for @page_idx.  Used by prefetch.
+ * Atomically transitions NOT_CACHED -> LOADING and reserves the DRAM-cache
+ * credit at claim time, mirroring the demand path (cxl_page_fault.c:499),
+ * so paired-replacement admission is exact: the paired eviction's release
+ * and this claim cancel out and occupancy never leaves the budget.
+ *
+ * Returns 1 if a NAND read was actually scheduled, 0 for a no-op (already
+ * resident/loading, or no budget headroom), negative on error.  Callers
+ * MUST count a prefetch only on 1: the old contract returned 0 for both
+ * the budget-refused skip and a real submit, which made async_prefetches
+ * read ~degree/miss while zero prefetch I/O was occurring — the miscount
+ * that hid the full-cache admission bug. */
+static int __cxl_async_load_4k(struct nvmev_dev *nvmev_vdev,
+			       unsigned long page_idx, bool inherit_credit)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_page_entry *entry;
+	struct cxl_async_completion *comp;
+	unsigned long long nsecs_start, nsecs_target;
+	int old;
+
+	if (!cxl_mb || cxl_mb->pg_mode != CXL_PG_4K ||
+	    page_idx >= cxl_mb->nr_pages)
+		return -EINVAL;
+
+	entry = &cxl_mb->page_table[page_idx];
+
+	/* Hard bound: never admit without headroom.  Skipped when the caller
+	 * transferred a victim's credit to this load (paired replacement):
+	 * the counter already accounts for this admission, so a gate read
+	 * here would see "full" and wrongly refuse. */
+	if (!inherit_credit &&
+	    atomic_long_read(&cxl_mb->nr_cached_4k) >= (long)cxl_mb->nr_dram_pages)
+		return 0;
+
+	/* Atomically transition NOT_CACHED -> LOADING; bail otherwise.
+	 * On failure in inherit mode, the caller still owns the withheld
+	 * credit and must release it. */
+	old = atomic_cmpxchg(&entry->state, CXL_HPAGE_NOT_CACHED,
+			     CXL_HPAGE_LOADING);
+	if (old != CXL_HPAGE_NOT_CACHED)
+		return 0;
+
+	/* Claim-time credit, exactly like the demand path — unless it was
+	 * inherited from a paired eviction, in which case the counter never
+	 * moved and must not move now.  The completion handler no longer
+	 * increments.  (cache_misses is deliberately NOT bumped here any
+	 * more: it counts demand misses, so hit-rate and victims/miss stay
+	 * comparable across prefetch degrees.) */
+	if (!inherit_credit)
+		atomic_long_inc(&cxl_mb->nr_cached_4k);
+
+	/* Mark provenance at SUBMISSION, not completion: a demand fault that
+	 * collides with this load while it is still in flight needs to see the
+	 * bit in order to count itself as a late prefetch hit. */
+	if (cxl_mb->prefetched_bm) {
+		set_bit(page_idx, cxl_mb->prefetched_bm);
+		clear_bit(page_idx, cxl_mb->pfused_bm);
+	}
+
+	comp = kzalloc(sizeof(*comp), GFP_ATOMIC);
+	if (!comp) {
+		if (!inherit_credit)
+			atomic_long_dec(&cxl_mb->nr_cached_4k);
+		if (cxl_mb->prefetched_bm)
+			clear_bit(page_idx, cxl_mb->prefetched_bm);
+		atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+		wake_up(&entry->wait);
+		return -ENOMEM;
+	}
+
+	comp->nvmev_vdev = nvmev_vdev;
+	comp->hpage_idx = page_idx;  /* reused field */
+	comp->is_write = false;
+	comp->done = NULL;
+
+	/* Compute simulated NAND read latency for this 4 KiB op.  Gate on
+	 * nand_valid exactly like the demand read path (cxl_page_fault.c:518):
+	 * a page NAND has never held data for is a zero-fill — no physical
+	 * read occurs, so none is modeled.  Charging tR here unconditionally
+	 * made prefetch pay for reads the demand path gets free, inflating
+	 * the apparent prefetch cost wherever cold pages are speculated. */
+	nsecs_start = local_clock();
+	if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled) &&
+	    test_bit(page_idx, cxl_mb->nand_valid)) {
+		nsecs_target = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+						     page_idx,
+						     false /* read */,
+						     PAGE_SIZE,
+						     nsecs_start);
+	} else {
+		nsecs_target = nsecs_start;
+	}
+
+	atomic_inc(&cxl_mb->prefetch_inflight);
+	WRITE_ONCE(cxl_mb->last_prefetch_latency_ns,
+		   nsecs_target - nsecs_start);
+
+	schedule_cxl_nand_operation(page_idx, false, nsecs_target,
+				     cxl_async_load_4k_completion, comp);
+	return 1;
+}
+
+int cxl_async_load_4k_page(struct nvmev_dev *nvmev_vdev, unsigned long page_idx)
+{
+	return __cxl_async_load_4k(nvmev_vdev, page_idx, false);
+}
+EXPORT_SYMBOL_GPL(cxl_async_load_4k_page);
+
+/* Fault-context trigger for miss-driven next-N prefetch (4K mode).
+ * O(1): records the missed page_idx in the trigger ring and returns.  All
+ * real work — victim selection, PTE zap, NAND scheduling — happens on the
+ * dispatcher (cxl_process_4k_queues -> cxl_prefetch_sequential_4k), so the
+ * demand miss is charged nothing but this push (~100 ns).  MPSC: fault
+ * handlers on any CPU produce under prefetch_push_lock; the dispatcher is
+ * the only consumer. */
+void cxl_prefetch_push_4k(struct cxl_memory_backend *cxl_mb,
+			  unsigned long page_idx)
+{
+	unsigned long flags;
+
+	if (!cxl_mb || cxl_mb->pg_mode != CXL_PG_4K)
+		return;
+	if (cxl_mb->prefetch_mode != CXL_PREFETCH_MODE_MISS_NEXTN ||
+	    cxl_mb->prefetch_degree == 0)
+		return;
+	/* Disarmed: take neither the lock nor a ring slot, so a setup phase
+	 * costs exactly what degree 0 costs. */
+	if (!READ_ONCE(cxl_mb->prefetch_gate))
+		return;
+
+	spin_lock_irqsave(&cxl_mb->prefetch_push_lock, flags);
+	if (cxl_mb->pf4k_tail - READ_ONCE(cxl_mb->pf4k_head) >=
+	    CXL_PF4K_RING_CAP) {
+		spin_unlock_irqrestore(&cxl_mb->prefetch_push_lock, flags);
+		atomic64_inc(&cxl_mb->pf4k_dropped_full);
+		return;
+	}
+	cxl_mb->pf4k_ring[cxl_mb->pf4k_tail & (CXL_PF4K_RING_CAP - 1)] =
+		page_idx;
+	/* Publish the entry before the index so the lock-free consumer
+	 * never reads an unwritten slot. */
+	smp_store_release(&cxl_mb->pf4k_tail, cxl_mb->pf4k_tail + 1);
+	spin_unlock_irqrestore(&cxl_mb->prefetch_push_lock, flags);
+	atomic64_inc(&cxl_mb->pf4k_pushed);
+}
+EXPORT_SYMBOL_GPL(cxl_prefetch_push_4k);
+
+/* CLOCK-style victim search over the 4K page_table.  Walks at most
+ * @max_scan entries from clock_hand_4k looking for CACHED entries with
+ * accessed=0 (giving accessed=1 entries a second chance by clearing the
+ * bit).  Claims the victim by cmpxchg CACHED->EVICTING.
+ *
+ * Bug 3: pin_count check.  Fault handler increments pin_count before
+ * installing a PTE; eviction must skip pinned pages to avoid racing
+ * with vmf_insert_pfn.  Pre-check is a fast filter; the re-check after
+ * the CAS handles the race where a fault increments pin between our
+ * pre-check and our CAS.
+ *
+ * Returns: page_idx of victim, or -1 if none found.
+ */
+/* Test-and-clear the HARDWARE accessed (young) bit of a 4 KiB page's PTE across
+ * every mapping process.  Returns true if ANY process's PTE had the A-bit set,
+ * i.e. the page was touched natively since the last CLOCK sweep -- the signal
+ * the software `accessed` flag cannot observe, because in 4K mode a hit leaves
+ * the PTE present and therefore never faults into this module.
+ *
+ * No kernel export needed: test_and_clear_bit(_PAGE_BIT_ACCESSED) is exactly
+ * what x86's ptep_test_and_clear_young does internally.  We do NOT flush the
+ * TLB, so the re-set on the next access can lag until the stale TLB entry is
+ * evicted -- acceptable for an aging heuristic.
+ *
+ * Uses mmap_read_TRYLOCK, mirroring cxl_zap_4k_pte: the CLOCK finder is reached
+ * in-context from a fault handler that may already hold the faulting mm's
+ * mmap_read_lock, so a blocking re-acquire could deadlock behind a queued
+ * writer.  On trylock failure we skip that mm and fall back to the software
+ * bit for it.  Ported from nvmevirt_fullcxl_latest. */
+static bool cxl_pte_young_4k(struct cxl_memory_backend *cxl_mb,
+			     unsigned long page_idx, bool clear)
+{
+	struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+	int n, i;
+	bool young = false;
+
+	n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+
+	for (i = 0; i < n; i++) {
+		struct mm_struct *mm = snap[i].mm;
+		unsigned long vaddr;
+		pgd_t *pgd;
+		p4d_t *p4d;
+		pud_t *pud;
+		pmd_t *pmd;
+		pte_t *pte;
+
+		if (!mm)
+			continue;
+		if (!cxl_snap_vaddr(&snap[i], page_idx, &vaddr))
+			continue;
+		if (!mmget_not_zero(mm))
+			continue;
+		if (!mmap_read_trylock(mm)) {
+			mmput(mm);
+			continue;
+		}
+
+		pgd = pgd_offset(mm, vaddr);
+		if (pgd_none(*pgd) || pgd_bad(*pgd))
+			goto unlock;
+		p4d = p4d_offset(pgd, vaddr);
+		if (p4d_none(*p4d) || p4d_bad(*p4d))
+			goto unlock;
+		pud = pud_offset(p4d, vaddr);
+		if (pud_none(*pud) || pud_bad(*pud))
+			goto unlock;
+		pmd = pmd_offset(pud, vaddr);
+		if (pmd_none(*pmd) || pmd_bad(*pmd))
+			goto unlock;
+
+		/* pte_offset_kernel, not pte_offset_map_lock: the latter pulls in
+		 * __pte_offset_map_lock, which is NOT exported to modules.  On
+		 * x86-64 page tables live in the direct map, so this yields a
+		 * valid pointer.  mmap_read_lock keeps the pte table from being
+		 * freed (our VM_PFNMAP device VMA is never THP-collapsed), and
+		 * test_and_clear_bit is atomic -- no pte lock required. */
+		pte = pte_offset_kernel(pmd, vaddr);
+		if (pte_present(*pte)) {
+			if (clear) {
+				if (test_and_clear_bit(_PAGE_BIT_ACCESSED,
+						       (unsigned long *)pte))
+					young = true;
+			} else if (test_bit(_PAGE_BIT_ACCESSED,
+					    (unsigned long *)pte)) {
+				young = true;
+			}
+		}
+unlock:
+		mmap_read_unlock(mm);
+		mmput(mm);
+	}
+
+	cxl_mmap_snap_release(snap, n);
+
+	/* Single chokepoint where a native (non-faulting) access is observable.
+	 * A prefetched page has its PTE pre-installed, so using it produces no
+	 * fault -- the only evidence it was ever read is the hardware A-bit the
+	 * CLOCK hand samples here.  Latch it into pfused_bm before the caller's
+	 * `clear` wipes it, otherwise the use is lost and the prefetch would be
+	 * misclassified as wasted at eviction. */
+	if (young && cxl_mb->prefetched_bm &&
+	    test_bit(page_idx, cxl_mb->prefetched_bm))
+		set_bit(page_idx, cxl_mb->pfused_bm);
+
+	return young;
+}
+
+static long cxl_clock_find_victim_4k(struct cxl_memory_backend *cxl_mb,
+				     unsigned long max_scan)
+{
+	unsigned long total = cxl_mb->nr_pages;
+	unsigned long hand, probes = 0;
+	unsigned long resident;
+
+	if (total == 0 || !cxl_mb->cached_bm)
+		return -1;
+
+	resident = (unsigned long)atomic_long_read(&cxl_mb->nr_cached_4k);
+
+	/* Fix 1: the CLOCK hand walks the cached_bm resident-set index rather than
+	 * the raw page_table.  find_next_bit jumps directly to the next CANDIDATE
+	 * (possibly-CACHED) page, skipping the huge NOT_CACHED desert word-at-a-
+	 * time, so a scan is O(resident set) instead of O(device size).  max_scan
+	 * now bounds CANDIDATE probes (a handful of resident-set passes), not raw
+	 * slots — the same "give up rather than spin" contract, far cheaper. */
+	hand = (unsigned long)atomic_long_read(&cxl_mb->clock_hand_4k) % total;
+
+	while (probes < max_scan) {
+		unsigned long page_idx = find_next_bit(cxl_mb->cached_bm, total, hand);
+		struct cxl_page_entry *entry;
+		int state;
+
+		if (page_idx >= total) {		/* ran off the end — wrap once */
+			page_idx = find_next_bit(cxl_mb->cached_bm, total, 0);
+			if (page_idx >= total)
+				break;			/* no candidates at all */
+		}
+		hand = page_idx + 1;
+		probes++;
+
+		entry = &cxl_mb->page_table[page_idx];
+		state = atomic_read(&entry->state);
+		if (state != CXL_HPAGE_CACHED)
+			/* Spuriously-set bit: page left CACHED via a path that has
+			 * not cleared it (benign — the bit is only a hint).  Skip;
+			 * it is re-validated on every scan and cleared at claim. */
+			continue;
+
+		/* Bug 3: fast pre-filter — skip pinned pages */
+		if (atomic_read(&entry->pin_count) > 0)
+			continue;
+
+		/* Second chance if the page was referenced since the last sweep.
+		 *
+		 * TIERED SWEEP (ported from nvmevirt_fullcxl_latest).  The
+		 * hardware A-bit is advisory only, for two reasons.  (a) When the
+		 * working set far exceeds the dTLB, every access misses the TLB,
+		 * so the CPU re-walks and re-sets A on essentially every resident
+		 * page -- the bit stops discriminating and becomes a blanket veto
+		 * on eviction.  (b) Clearing A without a TLB shootdown ages it
+		 * inconsistently, and a per-probe shootdown is far too expensive
+		 * in fault context.
+		 *
+		 * So honour it only while the hand is still within its first pass
+		 * over the resident set.  Past that, every candidate has already
+		 * been declined once and the capacity bound must outrank policy
+		 * fidelity -- otherwise the resident set is not bounded at all and
+		 * the emulated DRAM cache grows without limit, silently
+		 * invalidating every latency number the model produces.
+		 *
+		 * The software bit is always honoured: it is set on a real fault,
+		 * cleared here, and never re-set behind our back, so it ages
+		 * correctly and can never deadlock the sweep. */
+		{
+			bool tier1 = (resident == 0 || probes <= resident);
+			bool sw = (atomic_cmpxchg(&entry->accessed, 1, 0) == 1);
+			bool hw = READ_ONCE(cxl_clock_hw_young) && tier1 &&
+				  cxl_pte_young_4k(cxl_mb, page_idx, true);
+
+			if (sw || hw) {
+				atomic64_inc(&cxl_mb->vskip_second_chance_4k);
+				continue;  /* stays CACHED */
+			}
+			if (!tier1)
+				atomic64_inc(&cxl_mb->vforced_4k);
+		}
+
+		if (atomic_cmpxchg(&entry->state, CXL_HPAGE_CACHED,
+				   CXL_HPAGE_EVICTING) != CXL_HPAGE_CACHED)
+			continue;  /* lost the race; the winner clears the bit */
+
+		/* Bug 3: re-check pin AFTER CAS.  A faulter could have
+		 * incremented pin between our pre-check and our CAS;
+		 * smp_mb pairs with the faulter's smp_mb after pin++. */
+		smp_mb();
+		if (atomic_read(&entry->pin_count) > 0) {
+			/* Revert and let the faulter finish install (bit stays set:
+			 * the page is back to CACHED and never left our ownership). */
+			atomic_set(&entry->state, CXL_HPAGE_CACHED);
+			wake_up(&entry->wait);
+			continue;
+		}
+
+		/* Won CACHED->EVICTING and the page is unpinned.  This cmpxchg is
+		 * the SOLE exit from CACHED, so clear the index bit here; the evict
+		 * paths re-set it only if they must revert EVICTING->CACHED. */
+		clear_bit(page_idx, cxl_mb->cached_bm);
+		atomic_long_set(&cxl_mb->clock_hand_4k, hand);
+		atomic64_add(probes, &cxl_mb->victim_probes_4k);
+		atomic64_inc(&cxl_mb->clock_victims_4k);
+		return (long)page_idx;
+	}
+
+	atomic_long_set(&cxl_mb->clock_hand_4k, hand);
+	atomic64_add(probes, &cxl_mb->victim_probes_4k);
+	return -1;
+}
+
+/* FIFO/LIFO victim selection over the insertion-ordered residency list.
+ * FIFO starts at the oldest page (head); LIFO starts at the newest (tail).
+ * LOADING, EVICTING, and pinned pages are skipped without changing order.
+ *
+ * The selected entry deliberately remains linked while EVICTING.  Successful
+ * eviction removes it in the common completion path; a failed zap restores
+ * CACHED in place, preserving strict insertion order without requeue races.
+ */
+static long cxl_order_find_victim_4k(struct cxl_memory_backend *cxl_mb,
+				     unsigned long max_scan)
+{
+	unsigned long flags;
+	unsigned long probes = 0;
+	unsigned long skip = 0;
+	u32 cursor;
+	bool fifo = cxl_mb->cache_policy == CXL_CACHE_POLICY_FIFO;
+
+	/* LIFO staging window.  FIFO scans from the head (oldest resident) and
+	 * CLOCK sweeps a rotating hand with second chances, so both are already
+	 * structurally far from the pages in flight.  LIFO's victim end is
+	 * exactly where new pages arrive: without a hold-back the victim is the
+	 * page the faulting thread installed microseconds ago, so a multi-page
+	 * request evicts its own working set and re-faults it indefinitely.
+	 * Only applied when the resident set exceeds the window, so a victim
+	 * always exists beyond it. */
+	if (!fifo && cxl_mb->lifo_stage &&
+	    atomic_long_read(&cxl_mb->nr_cached_4k) > (long)cxl_mb->lifo_stage)
+		skip = cxl_mb->lifo_stage;
+
+	spin_lock_irqsave(&cxl_mb->policy_lock_4k, flags);
+	cursor = fifo ? cxl_mb->policy_head_4k : cxl_mb->policy_tail_4k;
+
+	while (cursor != CXL_POLICY_IDX_NONE && probes < max_scan) {
+		struct cxl_page_entry *entry = &cxl_mb->page_table[cursor];
+		u32 next = fifo ? entry->policy_next : entry->policy_prev;
+
+		/* Staged entries are not candidates and do not consume the
+		 * probe budget, so victim_probes_4k stays a clean diagnostic. */
+		if (skip) {
+			skip--;
+			cursor = next;
+			continue;
+		}
+
+		probes++;
+		if (atomic_read(&entry->state) != CXL_HPAGE_CACHED)
+			goto advance;
+		if (atomic_read(&entry->pin_count) > 0)
+			goto advance;
+
+		if (atomic_cmpxchg(&entry->state, CXL_HPAGE_CACHED,
+				   CXL_HPAGE_EVICTING) != CXL_HPAGE_CACHED)
+			goto advance;
+
+		/* Pair with the fault/install path's barrier after pin_count++. */
+		smp_mb();
+		if (atomic_read(&entry->pin_count) > 0) {
+			atomic_set(&entry->state, CXL_HPAGE_CACHED);
+			wake_up(&entry->wait);
+			goto advance;
+		}
+
+		clear_bit(cursor, cxl_mb->cached_bm);
+		atomic64_add(probes, &cxl_mb->victim_probes_4k);
+		if (fifo)
+			atomic64_inc(&cxl_mb->fifo_victims_4k);
+		else
+			atomic64_inc(&cxl_mb->lifo_victims_4k);
+		spin_unlock_irqrestore(&cxl_mb->policy_lock_4k, flags);
+		return (long)cursor;
+
+advance:
+		cursor = next;
+	}
+
+	atomic64_add(probes, &cxl_mb->victim_probes_4k);
+	spin_unlock_irqrestore(&cxl_mb->policy_lock_4k, flags);
+	return -1;
+}
+
+static long cxl_find_victim_4k(struct cxl_memory_backend *cxl_mb,
+				unsigned long max_scan)
+{
+	switch (cxl_mb->cache_policy) {
+	case CXL_CACHE_POLICY_FIFO:
+	case CXL_CACHE_POLICY_LIFO:
+		return cxl_order_find_victim_4k(cxl_mb, max_scan);
+	case CXL_CACHE_POLICY_CLOCK:
+	default:
+		return cxl_clock_find_victim_4k(cxl_mb, max_scan);
+	}
+}
+
+/* Restore a claimed victim when its PTE could not be zapped.  Ordered
+ * policies move the failed candidate away from their victim end so the next
+ * sweep can make progress on another resident instead of retrying the same
+ * dirty page forever. */
+static void cxl_restore_4k_after_zap_failure(struct cxl_memory_backend *cxl_mb,
+					     unsigned long page_idx)
+{
+	struct cxl_page_entry *entry = &cxl_mb->page_table[page_idx];
+
+	set_bit(page_idx, cxl_mb->cached_bm);
+	cxl_policy_defer_4k(cxl_mb, page_idx);
+	atomic64_inc(&cxl_mb->zap_failures_4k);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_CACHED);
+	wake_up(&entry->wait);
+}
+
+/* Complete an eviction after its PTE has already been removed.
+ * @release_credit: decrement nr_cached_4k here (the default).  False only
+ * when the credit was already released at zap time by paired-replacement
+ * prefetch admission (__dispatch_async_4k_eviction with release_early). */
+static void cxl_finish_4k_eviction(struct cxl_memory_backend *cxl_mb,
+				   unsigned long page_idx, bool synchronous,
+				   bool release_credit)
+{
+	struct cxl_page_entry *entry = &cxl_mb->page_table[page_idx];
+
+	/* Eviction is the page's end of life, so it is the only point at which
+	 * a prefetch's verdict is final.  Classify and clear here. */
+	if (cxl_mb->prefetched_bm &&
+	    test_and_clear_bit(page_idx, cxl_mb->prefetched_bm)) {
+		if (test_and_clear_bit(page_idx, cxl_mb->pfused_bm))
+			atomic64_inc(&cxl_mb->pf4k_useful);
+		else
+			atomic64_inc(&cxl_mb->pf4k_wasted);
+	}
+
+	atomic_set(&entry->dirty, 0);
+	cxl_policy_remove_4k(cxl_mb, page_idx);
+	smp_wmb();
+	atomic_set(&entry->state, CXL_HPAGE_NOT_CACHED);
+	if (release_credit)
+		atomic_long_dec(&cxl_mb->nr_cached_4k);
+	wake_up(&entry->wait);
+
+	if (synchronous)
+		atomic64_inc(&cxl_mb->sync_evicts_4k);
+	else
+		atomic64_inc(&async_evictions);
+}
+
+/* Synchronously evict a 4 KiB page.  Caller has already transitioned
+ * state to EVICTING.  Direct-PFN: no NAND write-back work, just zap PTEs
+ * and reset state so the next access faults again.
+ *
+ * Bug 2: if the zap can't complete because a writer is queued on
+ * mmap_lock, revert state EVICTING -> CACHED so the dispatcher will retry
+ * on the next sweep (after the writer drains).  This avoids:
+ *   (a) blocking the dispatcher on a chronic writer (would stall all
+ *       fault handlers waiting on EVICTING via wait_event)
+ *   (b) accounting drift (decrementing nr_cached_4k while PTE is still
+ *       installed in some processes).
+ */
+static bool __evict_4k_page(struct nvmev_dev *nvmev_vdev,
+			    unsigned long page_idx, bool release_credit)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+
+	if (!cxl_zap_4k_pte(cxl_mb, page_idx)) {
+		cxl_restore_4k_after_zap_failure(cxl_mb, page_idx);
+		return false;
+	}
+
+	cxl_finish_4k_eviction(cxl_mb, page_idx, false, release_credit);
+	return true;
+}
+
+/* Synchronously evict a 4 KiB page, paying NAND program (write-back) latency
+ * in-context for dirty pages.  Mirror of cxl_evict_hpage_to_nand (2M).  Caller
+ * has already transitioned state to EVICTING (via cxl_find_victim_4k).
+ * The in-context udelay both stalls the faulting thread (backpressure) and
+ * advances the per-die busy time so subsequent reads on the same die see
+ * contention.  On zap failure, revert EVICTING->CACHED and keep the credit. */
+void cxl_evict_4k_page_sync(struct nvmev_dev *nvmev_vdev, unsigned long page_idx)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_page_entry *entry = &cxl_mb->page_table[page_idx];
+
+	/* Zap first.  Charging NAND program latency before a trylock failure
+	 * caused the same dirty LIFO tail to pay tPROG on every retry.  Once the
+	 * zap succeeds, TLB shootdown has quiesced writers and EVICTING blocks
+	 * refaults, so the simulated write-back can be charged exactly once. */
+	if (!cxl_zap_4k_pte(cxl_mb, page_idx)) {
+		cxl_restore_4k_after_zap_failure(cxl_mb, page_idx);
+		return;
+	}
+
+	if (atomic_read(&entry->dirty) && nvmev_vdev->cxl_ftl &&
+	    READ_ONCE(cxl_mb->latency_enabled)) {
+		unsigned long long nsecs_start = local_clock();
+		unsigned long long nsecs_rmw = nsecs_start;
+		unsigned long long nsecs_target;
+
+		/* CXL_WR_ALLOC_DEFER: this page was admitted by a write fault over
+		 * live NAND content, so only the written cachelines are valid here
+		 * and a page-granular program needs the rest.  Chain the program's
+		 * stime off the read's completion: same page, so the same die, and
+		 * the hardware could not overlap them either.
+		 *
+		 * test_and_clear runs whenever the bitmap exists, even in another
+		 * policy, so a runtime policy change cannot strand set bits; the
+		 * charge itself is gated last. */
+		if (cxl_mb->wralloc_bm &&
+		    test_and_clear_bit(page_idx, cxl_mb->wralloc_bm) &&
+		    READ_ONCE(cxl_wr_alloc) == CXL_WR_ALLOC_DEFER) {
+			nsecs_rmw = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+							 page_idx, false /* read */,
+							 PAGE_SIZE, nsecs_start);
+			if (nsecs_rmw > nsecs_start) {
+				atomic64_inc(&cxl_mb->rmw_reads);
+				atomic64_add(nsecs_rmw - nsecs_start,
+					     &cxl_mb->rmw_read_ns);
+			} else {
+				nsecs_rmw = nsecs_start;
+			}
+		}
+		nsecs_target =
+			cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl, page_idx,
+					     true /* write */, PAGE_SIZE,
+					     nsecs_rmw);
+		if (nsecs_target > nsecs_start) {
+			unsigned long long delay_ns = nsecs_target - nsecs_start;
+			unsigned long delay_us = delay_ns / 1000;
+			if (delay_us > 0) {
+				if (delay_us < 10000)
+					udelay(delay_us);
+				else
+					msleep(delay_us / 1000);
+			}
+			atomic64_inc(&cxl_mb->nand_write_lat_applied);
+			atomic64_add(delay_ns, &cxl_mb->nand_write_lat_applied_ns);
+			/* Same event, recorded again as the in-fault subset: this
+			 * one just spun a Redis thread for delay_ns. */
+			atomic64_inc(&cxl_mb->sync_wb_applied);
+			atomic64_add(delay_ns, &cxl_mb->sync_wb_applied_ns);
+		}
+	}
+
+	cxl_finish_4k_eviction(cxl_mb, page_idx, true, true);
+}
+EXPORT_SYMBOL_GPL(cxl_evict_4k_page_sync);
+
+/* Enforce the 4K DRAM-cache hard bound: evict cached pages (paying write-back
+ * latency in-context) until occupancy is back within budget.  Mirror of the
+ * 2M slot-acquire slow path (cxl_load_hpage_from_nand) — the faulting thread
+ * pays the victim's write-back cost.  Capped per call to bound fault latency;
+ * if no victim is currently evictable, allow transient overshoot rather than
+ * deadlock (a memory fault must not fail). */
+void cxl_enforce_4k_budget(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	unsigned long max_scan;
+	int guard;
+
+	if (!cxl_mb || cxl_mb->pg_mode != CXL_PG_4K)
+		return;
+
+	max_scan = cxl_mb->nr_dram_pages * 4;
+	if (max_scan < 1024)
+		max_scan = 1024;
+
+	for (guard = 0; guard < 64; guard++) {
+		long victim;
+		if (atomic_long_read(&cxl_mb->nr_cached_4k) <=
+		    (long)cxl_mb->nr_dram_pages)
+			break;
+		victim = cxl_find_victim_4k(cxl_mb, max_scan);
+		if (victim < 0)
+			break;
+		cxl_evict_4k_page_sync(nvmev_vdev, victim);
+	}
+}
+EXPORT_SYMBOL_GPL(cxl_enforce_4k_budget);
+
+/* 4K async eviction completion: I/O worker fires this once the simulated NAND
+ * program (write-back) latency has elapsed.  The dispatcher zapped the PTE
+ * before scheduling the write, so completion only publishes NOT_CACHED and
+ * releases the cache credit. */
+static void cxl_async_4k_evict_completion(void *completion_data)
+{
+	struct cxl_async_completion *comp = completion_data;
+	struct nvmev_dev *nvmev_vdev = comp->nvmev_vdev;
+	struct cxl_memory_backend *cxl_mb;
+	unsigned long page_idx = comp->hpage_idx;  /* reused field */
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		goto out;
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->pg_mode != CXL_PG_4K || page_idx >= cxl_mb->nr_pages)
+		goto out;
+
+	cxl_finish_4k_eviction(cxl_mb, page_idx, false, !comp->credit_released);
+
+out:
+	if (comp->done)
+		complete(comp->done);
+	kfree(comp);
+}
+
+/* Dispatch one 4K eviction from the dispatcher (background) path.  Victim is
+ * already EVICTING.  Dirty pages schedule an async NAND write on the I/O worker
+ * (program latency lands on the die timeline; finalized in the completion).
+ * Clean pages (or alloc failure) are evicted immediately.  Mirror of
+ * __dispatch_async_eviction (2M).
+ *
+ * @transfer_credit: paired-replacement prefetch admission.  The victim's
+ * nr_cached_4k credit is NOT released — neither here nor at completion
+ * (comp->credit_released suppresses the completion's decrement) — it is
+ * handed intact to the paired prefetch load, which claims it without
+ * incrementing.  The global counter therefore never moves during a pair:
+ * there is no dip for a concurrent demand fill to steal (the measured
+ * release-then-reclaim window let ~2.4%% of demand misses skip their sync
+ * eviction) and no overshoot for one to double-pay.  On failure the caller
+ * owns the withheld credit and must release it with one decrement.
+ *
+ * Returns true if the eviction was dispatched (or finished inline) and,
+ * in transfer mode, the credit is now withheld for the caller; false if
+ * the PTE zap was deferred by mmap_lock contention and the victim was
+ * restored (nothing withheld). */
+static bool __dispatch_async_4k_eviction(struct nvmev_dev *nvmev_vdev,
+					 unsigned long page_idx,
+					 bool transfer_credit)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	struct cxl_page_entry *entry = &cxl_mb->page_table[page_idx];
+
+	if (atomic_read(&entry->dirty)) {
+		struct cxl_async_completion *comp;
+		unsigned long long nsecs_start, nsecs_target;
+
+		comp = kzalloc(sizeof(*comp), GFP_ATOMIC);
+		if (!comp)
+			goto sync_fallback;
+
+		comp->nvmev_vdev = nvmev_vdev;
+		comp->hpage_idx = page_idx;  /* reused field */
+		comp->is_write = true;
+		comp->done = NULL;
+
+		/* Claim the mapping before charging or scheduling the NAND program.
+		 * A trylock failure is only a deferral, not a physical write. */
+		if (!cxl_zap_4k_pte(cxl_mb, page_idx)) {
+			kfree(comp);
+			cxl_restore_4k_after_zap_failure(cxl_mb, page_idx);
+			return false;
+		}
+
+		/* Transfer: completion must not release the credit — the
+		 * caller hands it to the paired load. */
+		comp->credit_released = transfer_credit;
+
+		nsecs_start = local_clock();
+		if (nvmev_vdev->cxl_ftl && READ_ONCE(cxl_mb->latency_enabled)) {
+			unsigned long long nsecs_rmw = nsecs_start;
+
+			/* CXL_WR_ALLOC_DEFER merge read -- see the sync path.  The
+			 * completion deadline below is taken from nsecs_target, so
+			 * chaining here is what makes the worker hold the slot for
+			 * read+program rather than program alone. */
+			if (cxl_mb->wralloc_bm &&
+			    test_and_clear_bit(page_idx, cxl_mb->wralloc_bm) &&
+			    READ_ONCE(cxl_wr_alloc) == CXL_WR_ALLOC_DEFER) {
+				nsecs_rmw = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+								 page_idx, false,
+								 PAGE_SIZE, nsecs_start);
+				if (nsecs_rmw > nsecs_start) {
+					atomic64_inc(&cxl_mb->rmw_reads);
+					atomic64_add(nsecs_rmw - nsecs_start,
+						     &cxl_mb->rmw_read_ns);
+				} else {
+					nsecs_rmw = nsecs_start;
+				}
+			}
+			nsecs_target = cxl_ftl_calc_latency(nvmev_vdev->cxl_ftl,
+							     page_idx, true,
+							     PAGE_SIZE, nsecs_rmw);
+			if (nsecs_target > nsecs_start) {
+				atomic64_inc(&cxl_mb->nand_write_lat_applied);
+				atomic64_add(nsecs_target - nsecs_start,
+					     &cxl_mb->nand_write_lat_applied_ns);
+			}
+		} else {
+			nsecs_target = nsecs_start;
+		}
+
+		/* Fix 2: enqueue on an I/O worker directly.  If every worker queue
+		 * is full, do NOT defer to the dispatcher-drained nand_retry_list:
+		 * that leaves the page stuck EVICTING (and any faulter colliding
+		 * with it blocked in wait_event) until the dispatcher gets back to
+		 * it — the ms-scale tail.  Instead fall back to an immediate zap so
+		 * the EVICTING window is bounded by one zap regardless of dispatcher
+		 * liveness.  The die timeline was already advanced above (read
+		 * contention preserved); only the deferred write-back completion
+		 * timing is dropped, and only under worker-queue saturation. */
+		if (__try_schedule_cxl_nand(page_idx, true, nsecs_target,
+					     cxl_async_4k_evict_completion, comp))
+			return true;
+		/* not enqueued — completion won't fire; release comp and finish
+		 * inline.  In transfer mode the credit stays withheld for the
+		 * caller's paired load, exactly as if the completion had fired. */
+		kfree(comp);
+		atomic64_inc(&cxl_mb->evict_sync_fallback_4k);
+		/* PTE was already zapped above and the die timeline was charged. */
+		cxl_finish_4k_eviction(cxl_mb, page_idx, false, !transfer_credit);
+		return true;
+	}
+
+sync_fallback:
+	return __evict_4k_page(nvmev_vdev, page_idx, !transfer_credit);
+}
+
+/* Dispatcher-side next-N admission for one prefetch trigger (4K mode).
+ *
+ * For each of the next nr_ahead pages: skip non-NOT_CACHED pages, honour
+ * the inflight cap, and — the part the old fault-context version lacked —
+ * make room at a full cache by PAIRED REPLACEMENT: claim a victim through
+ * the active policy, dispatch its write-back asynchronously with the
+ * budget credit released at zap time, then admit the prefetch read into
+ * the freed credit.  One in, one out; occupancy never exceeds
+ * nr_dram_pages.
+ *
+ * Without pairing, prefetch was structurally dead at a full cache:
+ * cxl_enforce_4k_budget() exits with occupancy at exactly nr_dram_pages
+ * and the admission gate refuses at >=, so at WSS > cache every prefetch
+ * was silently skipped for the entire run.
+ *
+ * Demand-path semantics are deliberately untouched: cxl_enforce_4k_budget
+ * still charges one synchronous victim per demand admission, at the same
+ * line as always, at every degree including 0.  What prefetch adds lands
+ * where a device's would: pollution (its victims), die/channel occupancy
+ * (its reads and write-backs, in the shared timing model), and partial
+ * hits (demand faults that wait on a LOADING prefetch).
+ *
+ * MUST be called from the dispatcher only (single consumer): the
+ * make-room-then-admit sequence is not safe against a concurrent instance
+ * of itself. */
+void cxl_prefetch_sequential_4k(struct nvmev_dev *nvmev_vdev,
+				unsigned long page_idx, int nr_ahead)
+{
+	struct cxl_memory_backend *cxl_mb;
+	unsigned long max_scan;
+	int i;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb || nr_ahead <= 0)
+		return;
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->pg_mode != CXL_PG_4K)
+		return;
+
+	max_scan = cxl_mb->nr_dram_pages * 4;
+	if (max_scan < 1024)
+		max_scan = 1024;
+
+	for (i = 1; i <= nr_ahead; i++) {
+		unsigned long idx;
+
+		if (cxl_mb->prefetch_random) {
+			/* Control arm: same admission count, same paired
+			 * evictions, same clean-page injection -- but the
+			 * target carries no locality, so prediction value is
+			 * zero by construction.  (next-N minus random) is
+			 * therefore what prediction is actually worth, and
+			 * (random minus off) is the mechanism.  splitmix64
+			 * finalizer: no RNG state, and deterministic in
+			 * (page_idx, i) so a run is reproducible. */
+			u64 h = (u64)(page_idx + 1) * 0x9E3779B97F4A7C15ULL
+			      + (u64)i * 0xBF58476D1CE4E5B9ULL;
+			h ^= h >> 30; h *= 0xBF58476D1CE4E5B9ULL;
+			h ^= h >> 27; h *= 0x94D049BB133111EBULL;
+			h ^= h >> 31;
+			idx = (unsigned long)(h % cxl_mb->nr_pages);
+		} else {
+			idx = page_idx + i;
+		}
+
+		if (idx >= cxl_mb->nr_pages)
+			break;
+		if (atomic_read(&cxl_mb->page_table[idx].state) !=
+		    CXL_HPAGE_NOT_CACHED)
+			continue;
+		if (atomic_read(&cxl_mb->prefetch_inflight) >=
+		    MAX_PREFETCH_INFLIGHT)
+			break;
+
+		if (atomic_long_read(&cxl_mb->nr_cached_4k) >=
+		    (long)cxl_mb->nr_dram_pages) {
+			long victim = cxl_find_victim_4k(cxl_mb, max_scan);
+
+			if (victim < 0) {
+				atomic64_inc(&cxl_mb->pf4k_no_victim);
+				break;
+			}
+			/* Transfer the victim's credit to this admission.
+			 * The counter never moves, so there is no dip for a
+			 * concurrent demand fill to steal (release-then-
+			 * reclaim measurably let ~2.4%% of demand misses skip
+			 * their sync eviction) and no overshoot to double-
+			 * charge one. */
+			if (!__dispatch_async_4k_eviction(nvmev_vdev, victim,
+							  true)) {
+				/* Zap deferred by mmap_lock contention; the
+				 * victim was restored.  Retry next pass. */
+				atomic64_inc(&cxl_mb->pf4k_admit_fail);
+				break;
+			}
+			atomic64_inc(&cxl_mb->pf4k_paired_evicts);
+
+			if (__cxl_async_load_4k(nvmev_vdev, idx, true) == 1) {
+				atomic64_inc(&async_prefetches);
+			} else {
+				/* The page became resident/loading under us —
+				 * release the withheld credit; the eviction
+				 * stands as one early background eviction. */
+				atomic_long_dec(&cxl_mb->nr_cached_4k);
+				atomic64_inc(&cxl_mb->pf4k_admit_fail);
+			}
+			continue;
+		}
+
+		if (cxl_async_load_4k_page(nvmev_vdev, idx) == 1)
+			atomic64_inc(&async_prefetches);
+		else
+			/* Lost the slot to a concurrent demand fill, or the
+			 * page changed state under us. */
+			atomic64_inc(&cxl_mb->pf4k_admit_fail);
+	}
+}
+EXPORT_SYMBOL_GPL(cxl_prefetch_sequential_4k);
+
+/* Drain the 4K prefetch trigger ring (dispatcher only).  Budgeted per pass
+ * so BAR polling and the NAND retry list stay responsive; at degree d a
+ * pass performs at most CXL_PF4K_TRIGGERS_PER_PASS * d admissions. */
+#define CXL_PF4K_TRIGGERS_PER_PASS 4
+static void cxl_process_4k_prefetch(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb = nvmev_vdev->cxl_mb;
+	int n;
+
+	if (cxl_mb->prefetch_mode != CXL_PREFETCH_MODE_MISS_NEXTN ||
+	    cxl_mb->prefetch_degree == 0)
+		return;
+
+	/* Disarmed, or a GUP warm-up phase (latency disabled, reset later by
+	 * clear_gup): speculating through either would seed the cache that the
+	 * measured phase is supposed to start from.  Drop the backlog rather
+	 * than act on it, so re-arming starts from a clean ring. */
+	if (!READ_ONCE(cxl_mb->prefetch_gate) ||
+	    !READ_ONCE(cxl_mb->latency_enabled)) {
+		WRITE_ONCE(cxl_mb->pf4k_head,
+			   smp_load_acquire(&cxl_mb->pf4k_tail));
+		return;
+	}
+
+	for (n = 0; n < CXL_PF4K_TRIGGERS_PER_PASS; n++) {
+		unsigned long tail = smp_load_acquire(&cxl_mb->pf4k_tail);
+		unsigned long head = cxl_mb->pf4k_head;
+		unsigned long trigger;
+
+		if (head == tail)
+			return;
+		trigger = cxl_mb->pf4k_ring[head & (CXL_PF4K_RING_CAP - 1)];
+		/* Copy out before publishing head: producers may reuse the
+		 * slot as soon as head advances. */
+		WRITE_ONCE(cxl_mb->pf4k_head, head + 1);
+		cxl_prefetch_sequential_4k(nvmev_vdev, trigger,
+					   cxl_mb->prefetch_degree);
+	}
+}
+
+/* Watermark-based eviction in 4K mode.  When the cached-set count exceeds
+ * high_wm, evict victims down toward low_wm.  Capped per-call to keep
+ * dispatcher latency bounded. */
+void cxl_check_4k_eviction(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb;
+	long cached;
+	int max_evict, i;
+	unsigned long max_scan;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->pg_mode != CXL_PG_4K)
+		return;
+	if (!READ_ONCE(cxl_mb->latency_enabled))
+		return;
+
+	/* Every 4K policy evicts exactly at the hard budget, one victim per
+	 * admission, matching Cylon's one-victim-per-fill.  Two reasons the
+	 * background drain is off by default:
+	 *   - correctness for LIFO: draining (high_wm - low_wm) = 10% of the
+	 *     cache off the tail removes the entire recent working set;
+	 *   - fairness across policies: the drain moves NAND write-back off the
+	 *     request path and is worth ~20% throughput (measured, FIFO @2.67x
+	 *     WSS), so enabling it for one policy only biases every latency
+	 *     comparison by far more than the ~5% run-to-run noise floor.
+	 * bg_drain_4k=1 restores the legacy behaviour for reproducing older runs. */
+	if (!cxl_mb->bg_drain_4k)
+		return;
+
+	cached = atomic_long_read(&cxl_mb->nr_cached_4k);
+	if (cached <= (long)cxl_mb->high_wm)
+		return;
+
+	/* Burst more aggressively when way over the budget.  Batch is tunable:
+	 * with the stock 64 the drain tops out near 5.8K evictions/s, which a
+	 * 2.67x-WSS Redis run (~12.7K/s) outruns permanently, pinning occupancy
+	 * at high_wm and pushing the surplus onto the fault path. */
+	max_evict = READ_ONCE(bg_drain_batch);
+	if (max_evict < 1)
+		max_evict = 1;
+	if (cached <= (long)cxl_mb->nr_dram_pages)
+		max_evict = max(1, max_evict / 2);
+
+	/* Bound victim search work. CLOCK may consume second chances;
+	 * FIFO/LIFO may skip pinned or already-EVICTING ordered entries. */
+	max_scan = (unsigned long)cached * 4;
+	if (max_scan < 1024)
+		max_scan = 1024;
+
+	for (i = 0; i < max_evict; i++) {
+		long victim = cxl_find_victim_4k(cxl_mb, max_scan);
+		if (victim < 0)
+			break;
+		__dispatch_async_4k_eviction(nvmev_vdev, victim, false);
+		if (atomic_long_read(&cxl_mb->nr_cached_4k) <= (long)cxl_mb->low_wm)
+			break;
+	}
+
+	if (i > 0)
+		NVMEV_DEBUG("4K background eviction: %d pages "
+			    "(cached=%ld, low_wm=%lu, high_wm=%lu)\n",
+			    i, atomic_long_read(&cxl_mb->nr_cached_4k),
+			    cxl_mb->low_wm, cxl_mb->high_wm);
+}
+EXPORT_SYMBOL_GPL(cxl_check_4k_eviction);
+
+/* 4K-mode dispatcher hook.  No userspace queues to drain in 4K mode
+ * (no chunk table, no free queue): drain the NAND retry list, then run
+ * miss-triggered next-N prefetch admission off the trigger ring. */
+void cxl_process_4k_queues(struct nvmev_dev *nvmev_vdev)
+{
+	struct cxl_memory_backend *cxl_mb;
+
+	if (!nvmev_vdev || !nvmev_vdev->cxl_mb)
+		return;
+	cxl_mb = nvmev_vdev->cxl_mb;
+	if (cxl_mb->pg_mode != CXL_PG_4K)
+		return;
+
+	cxl_drain_nand_retry_list(cxl_mb);
+	cxl_process_4k_prefetch(nvmev_vdev);
+}
+EXPORT_SYMBOL_GPL(cxl_process_4k_queues);
