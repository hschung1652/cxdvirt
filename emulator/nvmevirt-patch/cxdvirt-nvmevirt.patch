+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CXL Component Register Implementation
+ *
+ * Implements CXL.io and CXL.cache/mem component registers
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/io.h>
+
+#include "nvmev.h"
+#include "cxl.h"
+
+/* Capability Header Registers */
+#define CXL_CM_CAP_HDR_ID_MASK           0xFFFF
+#define CXL_CM_CAP_HDR_VERSION_MASK      0xFF0000
+#define CXL_CM_CAP_HDR_CACHE_MEM_VERSION  0x1000000
+
+/* RAS Capability Offsets */
+#define CXL_RAS_UNCORRECTABLE_STATUS     0x00
+#define CXL_RAS_UNCORRECTABLE_MASK       0x04
+#define CXL_RAS_UNCORRECTABLE_SEVERITY   0x08
+#define CXL_RAS_CORRECTABLE_STATUS       0x0C
+#define CXL_RAS_CORRECTABLE_MASK         0x10
+#define CXL_RAS_ERR_CAP_CTRL             0x14
+#define CXL_RAS_ERR_HEADER_LOG           0x18
+
+/* HDM Decoder Capability */
+#define CXL_HDM_DECODER_CAPABILITY       0x00
+#define CXL_HDM_DECODER_GLOBAL_CONTROL   0x04
+#define CXL_HDM_DECODER0_BASE_LOW        0x10
+#define CXL_HDM_DECODER0_BASE_HIGH       0x14
+#define CXL_HDM_DECODER0_SIZE_LOW        0x18
+#define CXL_HDM_DECODER0_SIZE_HIGH       0x1C
+#define CXL_HDM_DECODER0_CTRL            0x20
+
+/* Capability IDs */
+#define CXL_CM_CAP_CAP_ID_RAS    0x2
+#define CXL_CM_CAP_CAP_ID_HDM    0x5
+#define CXL_CM_CAP_CAP_ID_LINK   0x4
+
+/* Error Status Bits */
+#define CXL_RAS_UC_CACHE_DATA_PARITY     BIT(0)
+#define CXL_RAS_UC_CACHE_ADDRESS_PARITY  BIT(1)
+#define CXL_RAS_UC_CACHE_BE_PARITY       BIT(2)
+#define CXL_RAS_UC_CACHE_DATA_ECC        BIT(3)
+#define CXL_RAS_UC_MEM_DATA_PARITY       BIT(4)
+#define CXL_RAS_UC_MEM_ADDRESS_PARITY    BIT(5)
+#define CXL_RAS_UC_MEM_BE_PARITY         BIT(6)
+#define CXL_RAS_UC_MEM_DATA_ECC          BIT(7)
+#define CXL_RAS_UC_POISON_RECEIVED        BIT(10)
+#define CXL_RAS_UC_INTERNAL_ERROR        BIT(14)
+#define CXL_RAS_UC_IDE_TX_ERROR          BIT(15)
+#define CXL_RAS_UC_IDE_RX_ERROR          BIT(16)
+
+/* Initialize RAS Capability */
+static void cxl_init_ras_capability(void __iomem *base, u32 offset)
+{
+	void __iomem *ras_base = base + offset;
+
+	/* Initialize RAS registers */
+	writel(0, ras_base + CXL_RAS_UNCORRECTABLE_STATUS);
+	writel(0, ras_base + CXL_RAS_UNCORRECTABLE_MASK);
+	writel(CXL_RAS_UC_INTERNAL_ERROR | CXL_RAS_UC_POISON_RECEIVED,
+	       ras_base + CXL_RAS_UNCORRECTABLE_SEVERITY);
+	writel(0, ras_base + CXL_RAS_CORRECTABLE_STATUS);
+	writel(0, ras_base + CXL_RAS_CORRECTABLE_MASK);
+	writel(0, ras_base + CXL_RAS_ERR_CAP_CTRL);
+
+	/* Clear error header log */
+	memset_io(ras_base + CXL_RAS_ERR_HEADER_LOG, 0, 128);
+
+	NVMEV_DEBUG("RAS capability initialized at offset 0x%x\n", offset);
+}
+
+/* Initialize HDM Decoder Capability */
+static void cxl_init_hdm_capability(void __iomem *base, u32 offset,
+                                    struct cxl_component_state *comp)
+{
+	void __iomem *hdm_base = base + offset;
+	u32 hdm_cap;
+
+	/*
+	 * HDM Decoder Capability Register (CXL 2.0 Section 8.2.4.19.1)
+	 * Bits 3:0   - Decoder Count (0=1, 1=2, 2=4, 3=6, 4=8, 5=10 decoders)
+	 * Bits 7:4   - Target Count (max interleave targets: 0=1, 1=2, 2=4, etc.)
+	 * Bit 8      - A11to8 interleave capable
+	 * Bit 9      - A14to12 interleave capable
+	 * Bit 10     - 3/6/12 way interleave capable
+	 * Bit 11     - 16-way interleave capable
+	 * Bits 13:12 - Poison on decode error capability
+	 *
+	 * For Type 3 endpoint device:
+	 * - 1 decoder (decoder count = 0) - sufficient for single memory region
+	 * - 1 target (target count = 0, no interleave at endpoint)
+	 */
+	hdm_cap = 0x0;               /* Decoder count = 0 (means 1 decoder) */
+	hdm_cap |= (0x0 << 4);       /* Target count = 0 (1 target, no interleave) */
+	/* No interleave capability needed for single-device endpoint */
+
+	writel(hdm_cap, hdm_base + CXL_HDM_DECODER_CAPABILITY);
+
+	/*
+	 * HDM Decoder Global Control Register (CXL 2.0 Section 8.2.4.19.2)
+	 * Bit 0 - Poison on Decode Error Enable
+	 * Bit 1 - HDM Decoder Enable (must be set for decoders to work)
+	 */
+	writel(0, hdm_base + CXL_HDM_DECODER_GLOBAL_CONTROL);
+
+	/*
+	 * Don't pre-program decoder registers - the kernel will configure them
+	 * during region creation. Leave them at 0 (unconfigured state).
+	 */
+
+	comp->hdm_enabled = true;
+	comp->hdm_count = 1;
+
+	NVMEV_DEBUG("HDM capability initialized at offset 0x%x\n", offset);
+}
+
+/* Initialize Link Capability */
+static void cxl_init_link_capability(void __iomem *base, u32 offset)
+{
+	/* Link capability registers would go here */
+	/* For Type 3 device, link capability is minimal */
+	NVMEV_DEBUG("Link capability initialized at offset 0x%x\n", offset);
+}
+
+/* Component register read handler */
+static u32 cxl_component_read(void __iomem *base, u32 offset)
+{
+	u32 val = readl(base + offset);
+	NVMEV_DEBUG_VERBOSE("Component read: offset=0x%x val=0x%x\n", offset, val);
+	return val;
+}
+
+/* Component register write handler */
+static void cxl_component_write(void __iomem *base, u32 offset, u32 val)
+{
+	NVMEV_DEBUG_VERBOSE("Component write: offset=0x%x val=0x%x\n", offset, val);
+
+	/* Special handling for certain registers */
+	if (offset >= CXL_CM_OFFSET && offset < CXL_CM_OFFSET + 0x1000) {
+		/* CXL.cache/mem registers */
+		u32 cm_offset = offset - CXL_CM_OFFSET;
+
+		/*
+		 * HDM Decoder region layout (from CXL 2.0 spec):
+		 *   HDM base + 0x00: Capability
+		 *   HDM base + 0x04: Global Control
+		 *   HDM base + 0x10: Decoder 0 starts (target list/DPA base)
+		 *   HDM base + 0x20: Decoder 0 Control
+		 *   HDM base + 0x30: Decoder 1 starts
+		 *   HDM base + 0x40: Decoder 1 Control
+		 *
+		 * HDM base is at CM_OFFSET + 0x110, so:
+		 *   Decoder 0 Control at CM_OFFSET + 0x110 + 0x20 = CM_OFFSET + 0x130
+		 *   Decoder 1 Control at CM_OFFSET + 0x110 + 0x40 = CM_OFFSET + 0x150
+		 *
+		 * Each decoder block is 0x20 bytes, starting at HDM_base + 0x10
+		 */
+		u32 hdm_base_offset = 0x110;  /* HDM capability at CM + 0x110 */
+		u32 decoder_start = hdm_base_offset + 0x10;  /* Decoders start at HDM + 0x10 */
+
+		if (cm_offset >= decoder_start && cm_offset < 0x250) {
+			u32 rel_offset = cm_offset - decoder_start;
+			u32 decoder_idx = rel_offset / 0x20;
+			u32 decoder_reg = rel_offset % 0x20;
+
+			/* Control register is at offset 0x10 within each decoder block */
+			if (decoder_reg == 0x10) {
+				u32 old_val = readl(base + offset);
+				NVMEV_DEBUG("HDM Decoder %d ctrl write: old=0x%x new=0x%x\n",
+					    decoder_idx, old_val, val);
+
+				if ((val & BIT(9)) && !(old_val & BIT(9))) {
+					/* COMMIT bit (bit 9) being set */
+					NVMEV_INFO("HDM Decoder %d: COMMIT requested\n", decoder_idx);
+					val |= BIT(10); /* Set COMMITTED (bit 10) */
+					NVMEV_INFO("HDM Decoder %d: COMMITTED set\n", decoder_idx);
+				}
+			}
+		}
+	}
+
+	writel(val, base + offset);
+}
+
+/* Initialize component registers */
+int cxl_component_init(struct cxl_component_state *cxl_comp, void __iomem *base)
+{
+	void __iomem *cap_hdr;
+	void __iomem *cap_array;
+	u32 cap_count = 0;
+	u32 offset;
+	u32 hdr_val;
+
+	cxl_comp->base = base;
+
+	/* Clear the entire component register space */
+	memset_io(base, 0, CXL_COMPONENT_BLOCK_SIZE);
+
+	/* Setup CXL.cache/mem capability header array at offset 0x1000 */
+	offset = CXL_CM_OFFSET;
+	cap_hdr = base + offset;
+
+	/*
+	 * CXL Capability Header Register (CXL 2.0 Section 8.2.4.1)
+	 * Bits 15:0  - CXL Capability ID = 1 (for CXL.cache/mem)
+	 * Bits 19:16 - Capability Version = 1
+	 * Bits 23:20 - CXL.cache/mem Version = 1 (for CXL 2.0)
+	 * Bits 31:24 - Array Size = number of capability array entries (set later)
+	 */
+	hdr_val = (1 << 0) |       /* CXL Capability ID = 1 */
+	          (1 << 16) |      /* Capability Version = 1 */
+	          (1 << 20);       /* CXL.cache/mem Version = 1 */
+
+	/*
+	 * Capability Array starts at offset 0x4 from CM header
+	 * Kernel reads entries at: base + cap * 0x4 (where cap starts at 1)
+	 * Each entry is 4 bytes (from kernel's regs.c):
+	 *   Bits 15:0  - Capability ID (CXL_CM_CAP_HDR_ID_MASK)
+	 *   Bits 31:20 - Capability Offset (CXL_CM_CAP_PTR_MASK)
+	 */
+	cap_array = base + offset + CXL_CM_CAP_PTR_OFFSET;
+
+	/* RAS Capability Entry (ID=2) at offset 0x80 from CM base */
+	writel((CXL_CM_CAP_CAP_ID_RAS << 0) |       /* ID in bits 15:0 */
+	       (0x80 << 20),                        /* Offset in bits 31:20 */
+	       cap_array + (cap_count++ * 4));
+	cxl_init_ras_capability(base + offset, 0x80);
+
+	/* HDM Decoder Capability Entry (ID=5) at offset 0x110 from CM base */
+	writel((CXL_CM_CAP_CAP_ID_HDM << 0) |       /* ID in bits 15:0 */
+	       (0x110 << 20),                       /* Offset in bits 31:20 */
+	       cap_array + (cap_count++ * 4));
+	cxl_init_hdm_capability(base + offset, 0x110, cxl_comp);
+
+	/* Link Capability Entry (ID=4) at offset 0x1C0 from CM base */
+	writel((CXL_CM_CAP_CAP_ID_LINK << 0) |      /* ID in bits 15:0 */
+	       (0x1C0 << 20),                       /* Offset in bits 31:20 */
+	       cap_array + (cap_count++ * 4));
+	cxl_init_link_capability(base + offset, 0x1C0);
+
+	/* Update Array Size in header (bits 31:24) and write it */
+	hdr_val |= (cap_count << 24);
+	writel(hdr_val, cap_hdr);
+
+	cxl_comp->ras_enabled = true;
+
+	/* Debug: verify writes by reading back */
+	{
+		u32 verify_hdr, verify_ras, verify_hdm, verify_link;
+		verify_hdr = readl(cap_hdr);
+		verify_ras = readl(cap_array + 0);
+		verify_hdm = readl(cap_array + 4);
+		verify_link = readl(cap_array + 8);
+		NVMEV_INFO("CXL CM verification:\n");
+		NVMEV_INFO("  Header at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)(cap_hdr - base), hdr_val, verify_hdr,
+			   (hdr_val == verify_hdr) ? "OK" : "MISMATCH!");
+		NVMEV_INFO("  RAS entry at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)(cap_array - base), 0x08000002, verify_ras,
+			   (0x08000002 == verify_ras) ? "OK" : "MISMATCH!");
+		NVMEV_INFO("  HDM entry at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)(cap_array + 4 - base), 0x11000005, verify_hdm,
+			   (0x11000005 == verify_hdm) ? "OK" : "MISMATCH!");
+		NVMEV_INFO("  Link entry at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)(cap_array + 8 - base), 0x1C000004, verify_link,
+			   (0x1C000004 == verify_link) ? "OK" : "MISMATCH!");
+	}
+
+	NVMEV_INFO("CXL component registers initialized\n");
+	return 0;
+}
+
+/* Cleanup component registers */
+void cxl_component_exit(struct cxl_component_state *cxl_comp)
+{
+	if (cxl_comp->base) {
+		/* Clear component registers */
+		memset_io(cxl_comp->base, 0, CXL_COMPONENT_BLOCK_SIZE);
+		cxl_comp->base = NULL;
+	}
+
+	cxl_comp->ras_enabled = false;
+	cxl_comp->hdm_enabled = false;
+	cxl_comp->hdm_count = 0;
+
+	NVMEV_INFO("CXL component registers cleaned up\n");
+}
+
+/* Process component register access */
+void cxl_component_process_bar(struct cxl_component_state *cxl_comp,
+                               u32 offset, u32 *val, bool is_write)
+{
+	if (!cxl_comp->base)
+		return;
+
+	if (is_write) {
+		cxl_component_write(cxl_comp->base, offset, *val);
+	} else {
+		*val = cxl_component_read(cxl_comp->base, offset);
+	}
+}
+
+/*
+ * Initialize Root Port Component Registers
+ *
+ * Root ports (dports/USPs) need CXL component registers for VH mode.
+ * The kernel's cxl_find_regblock() looks for these when probing dports.
+ * Unlike endpoints, root port HDM decoders route addresses to downstream devices.
+ */
+int cxl_rp_component_init(void __iomem *base)
+{
+	void __iomem *cap_hdr;
+	void __iomem *cap_array;
+	void __iomem *hdm_base;
+	u32 cap_count = 0;
+	u32 hdr_val;
+	u32 hdm_cap;
+
+	if (!base) {
+		NVMEV_ERROR("Root port component base is NULL\n");
+		return -EINVAL;
+	}
+
+	/* Clear the entire component register space */
+	memset_io(base, 0, CXL_COMPONENT_BLOCK_SIZE);
+
+	/* Setup CXL.cache/mem capability header array at offset 0x1000 */
+	cap_hdr = base + CXL_CM_OFFSET;
+
+	/*
+	 * CXL Capability Header Register (CXL 3.0 Section 8.2.4.1)
+	 * Bits 15:0  - CXL Capability ID = 1 (for CXL.cache/mem)
+	 * Bits 19:16 - Capability Version = 1
+	 * Bits 23:20 - CXL.cache/mem Version = 1 (for CXL 2.0)
+	 * Bits 31:24 - Array Size = number of capability array entries
+	 */
+	hdr_val = (1 << 0) |       /* CXL Capability ID = 1 */
+	          (1 << 16) |      /* Capability Version = 1 */
+	          (1 << 20);       /* CXL.cache/mem Version = 1 */
+
+	/*
+	 * Capability Array starts at offset 0x4 from CM header
+	 * Each entry: Bits 15:0 = Capability ID, Bits 31:20 = Offset
+	 */
+	cap_array = base + CXL_CM_OFFSET + CXL_CM_CAP_PTR_OFFSET;
+
+	/*
+	 * HDM Decoder Capability Entry (ID=5) at offset 0x10 from CM base
+	 * For root port, we only need the HDM decoder capability.
+	 * RAS capability is optional for ports.
+	 */
+	writel((CXL_CM_CAP_CAP_ID_HDM << 0) |       /* ID in bits 15:0 */
+	       (0x10 << 20),                        /* Offset in bits 31:20 */
+	       cap_array + (cap_count++ * 4));
+
+	/* Initialize HDM Decoder at CM + 0x10 */
+	hdm_base = base + CXL_CM_OFFSET + 0x10;
+
+	/*
+	 * HDM Decoder Capability Register for Root Port (CXL 3.0 Section 8.2.4.19.1)
+	 *
+	 * Root ports need different capabilities than endpoints:
+	 * - More decoders possible (for multi-device topologies)
+	 * - Target list for routing to downstream devices
+	 * - Interleave capability for multi-device configurations
+	 *
+	 * Bits 3:0   - Decoder Count: encoded (0=1, 1=2, 2=4, 3=6, 4=8, 5=10)
+	 * Bits 7:4   - Target Count: RAW value used by kernel (not encoded!)
+	 *              Kernel reads this directly as interleave_targets count.
+	 *              Must be >= 1 for region creation to work.
+	 * Bit 8      - A11to8 interleave capable
+	 * Bit 9      - A14to12 interleave capable
+	 * Bit 10     - 3/6/12 way interleave capable
+	 * Bit 11     - 16-way interleave capable
+	 * Bit 12     - UIO capable (Uncategorized IO - PCIe MMIO)
+	 * Bit 14     - Commit Timeout Programmable
+	 */
+	hdm_cap = 0x0;              /* 1 decoder (encoded: 0 = 1 decoder) */
+	hdm_cap |= (0x1 << 4);      /* 1 target (raw value - kernel uses directly) */
+	/* No interleave capability - simple single-device topology */
+
+	writel(hdm_cap, hdm_base + CXL_HDM_DECODER_CAPABILITY);
+
+	/*
+	 * HDM Decoder Global Control Register
+	 * Bit 0 - Poison on Decode Error Enable
+	 * Bit 1 - HDM Decoder Enable (kernel will set this)
+	 */
+	writel(0, hdm_base + CXL_HDM_DECODER_GLOBAL_CONTROL);
+
+	/*
+	 * Decoder 0 registers (at HDM base + 0x10)
+	 * Leave unconfigured - kernel will program during region creation
+	 */
+
+	/* Update Array Size in header (bits 31:24) and write it */
+	hdr_val |= (cap_count << 24);
+	writel(hdr_val, cap_hdr);
+
+	/* Debug: verify writes */
+	{
+		u32 verify_hdr, verify_hdm_entry, verify_hdm_cap;
+		verify_hdr = readl(cap_hdr);
+		verify_hdm_entry = readl(cap_array + 0);
+		verify_hdm_cap = readl(hdm_base + CXL_HDM_DECODER_CAPABILITY);
+
+		NVMEV_INFO("Root port CXL CM verification:\n");
+		NVMEV_INFO("  Header at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)CXL_CM_OFFSET, hdr_val, verify_hdr,
+			   (hdr_val == verify_hdr) ? "OK" : "MISMATCH!");
+		NVMEV_INFO("  HDM entry at 0x%lx: wrote 0x%08x, read 0x%08x %s\n",
+			   (unsigned long)(CXL_CM_OFFSET + CXL_CM_CAP_PTR_OFFSET),
+			   0x01000005, verify_hdm_entry,
+			   (0x01000005 == verify_hdm_entry) ? "OK" : "MISMATCH!");
+		NVMEV_INFO("  HDM cap at 0x%lx: wrote 0x%08x, read 0x%08x %s (targets=%d)\n",
+			   (unsigned long)(CXL_CM_OFFSET + 0x10), hdm_cap, verify_hdm_cap,
+			   (hdm_cap == verify_hdm_cap) ? "OK" : "MISMATCH!",
+			   (verify_hdm_cap >> 4) & 0xF);
+	}
+
+	NVMEV_INFO("Root port component registers initialized\n");
+	return 0;
+}
