+/* Check if a huge page entry is in a transient (busy) state */
+static inline bool cxl_hpage_is_busy(struct cxl_hpage_entry *entry)
+{
+	int s = atomic_read(&entry->state);
+	return s == CXL_HPAGE_LOADING || s == CXL_HPAGE_EVICTING;
+}
+
+/**
+ * cxl_clock_find_victim - CLOCK (second-chance) algorithm for victim selection
+ * @cxl_mb: CXL memory backend
+ * @slot_base: First DRAM slot index in the pool (0 for unified pool)
+ * @pool_size: Number of slots in the pool (nr_dram_hpages for unified pool)
+ * @clock_hand: Pointer to the pool's atomic clock hand
+ * @max_scan: Maximum entries to scan before giving up
+ *
+ * Sweeps DRAM slots via the slot_to_hpage reverse mapping so that every
+ * cached page is reachable regardless of its hpage_idx.
+ *
+ * Lockless victim selection:
+ *   1. Advance clock_hand atomically (each caller gets unique slot position)
+ *   2. Look up hpage_idx via slot_to_hpage[slot]
+ *   3. If entry is CACHED with accessed=0 and unpinned, claim via cmpxchg → EVICTING
+ *   4. If accessed=1, clear to 0 (second chance) and move on
+ *
+ * Returns: hpage_idx of victim (state already EVICTING), or -1 if none found
+ */
+static inline long cxl_clock_find_victim(struct cxl_memory_backend *cxl_mb,
+					 unsigned long slot_base,
+					 unsigned long pool_size,
+					 atomic_long_t *clock_hand,
+					 unsigned long max_scan)
+{
+	unsigned long scanned = 0;
+	unsigned long nr_empty = 0, nr_not_cached = 0, nr_loading = 0;
+	unsigned long nr_evicting = 0, nr_pinned = 0, nr_accessed = 0;
+	unsigned long nr_cas_fail = 0;
+
+	while (scanned < max_scan) {
+		unsigned long slot = slot_base +
+			(atomic_long_inc_return(clock_hand) % pool_size);
+		unsigned long hpage_idx = READ_ONCE(cxl_mb->slot_to_hpage[slot]);
+		struct cxl_hpage_entry *entry;
+		int state;
+
+		scanned++;
+
+		/* Skip empty slots (freed but not yet reused) */
+		if (hpage_idx == INVALID_PAGE_IDX) {
+			nr_empty++;
+			continue;
+		}
+
+		entry = &cxl_mb->hpage_table[hpage_idx];
+		state = atomic_read(&entry->state);
+
+		/* Only consider CACHED entries */
+		if (state != CXL_HPAGE_CACHED) {
+			if (state == CXL_HPAGE_LOADING)
+				nr_loading++;
+			else if (state == CXL_HPAGE_EVICTING)
+				nr_evicting++;
+			else
+				nr_not_cached++;
+			continue;
+		}
+
+		/* Skip pinned pages */
+		if (READ_ONCE(cxl_mb->pin_flags[hpage_idx])) {
+			nr_pinned++;
+			continue;
+		}
+
+		/* Check / clear accessed bit (second chance) */
+		if (atomic_cmpxchg(&entry->accessed, 1, 0) == 1) {
+			nr_accessed++;
+			continue;  /* Was accessed — give second chance */
+		}
+
+		/* accessed == 0, try to claim as victim */
+		if (atomic_cmpxchg(&entry->state, CXL_HPAGE_CACHED,
+				   CXL_HPAGE_EVICTING) == CXL_HPAGE_CACHED)
+			return (long)hpage_idx;
+
+		/* Someone else changed state — skip */
+		nr_cas_fail++;
+	}
+
+	printk(KERN_ERR "NVMeVirt: CLOCK failed: scanned=%lu pool=%lu "
+	       "empty=%lu not_cached=%lu loading=%lu evicting=%lu "
+	       "pinned=%lu accessed=%lu cas_fail=%lu\n",
+	       scanned, pool_size, nr_empty, nr_not_cached,
+	       nr_loading, nr_evicting, nr_pinned, nr_accessed,
+	       nr_cas_fail);
+
+	return -1;
+}
+
+/* Unified CLOCK victim selection over entire DRAM pool */
+static inline long cxl_clock_victim(struct cxl_memory_backend *cxl_mb,
+				    unsigned long max_scan)
+{
+	return cxl_clock_find_victim(cxl_mb, 0, cxl_mb->nr_dram_hpages,
+				    &cxl_mb->clock_hand, max_scan);
+}
+
+/*
+ * mmap_entries snapshot helpers (Bug 1 fix).
+ *
+ * cxl_dax_vm_close holds cxl_mb->mmap_lock while it mmdrops and compacts
+ * entries.  Callers that need to iterate mmap_entries WITHOUT holding the
+ * spinlock for the whole walk (because they need to take sleeping locks
+ * like mmap_read_lock) must first take a snapshot under the spinlock and
+ * mmgrab each mm so it cannot disappear during iteration.
+ *
+ * Usage:
+ *     struct cxl_mmap_snap_entry snap[CXL_MAX_MMAP_ENTRIES];
+ *     int n = cxl_mmap_snap(cxl_mb, snap, CXL_MAX_MMAP_ENTRIES);
+ *     for (i = 0; i < n; i++) {
+ *         if (!mmget_not_zero(snap[i].mm)) continue;
+ *         ... mmap_read_lock + work + mmap_read_unlock ...
+ *         mmput(snap[i].mm);
+ *     }
+ *     cxl_mmap_snap_release(snap, n);
+ */
+struct cxl_mmap_snap_entry {
+	struct mm_struct *mm;
+	unsigned long base;
+	unsigned long pgoff;
+	unsigned long npages;
+};
+
+/* Device page index -> virtual address within one mapping window.  Returns
+ * false when the page is outside this mapping.  daxmalloc maps the whole
+ * device at offset 0, so this reduces to base + (page_idx << PAGE_SHIFT);
+ * the pgoff/npages terms make it correct for a partial window too. */
+static inline bool cxl_snap_vaddr(const struct cxl_mmap_snap_entry *e,
+				  unsigned long page_idx, unsigned long *vaddr)
+{
+	if (page_idx < e->pgoff || page_idx >= e->pgoff + e->npages)
+		return false;
+	*vaddr = e->base + ((page_idx - e->pgoff) << PAGE_SHIFT);
+	return true;
+}
+
+static inline int cxl_mmap_snap(struct cxl_memory_backend *mb,
+				struct cxl_mmap_snap_entry *snap, int max)
+{
+	int i, n;
+
+	spin_lock(&mb->mmap_lock);
+	n = mb->nr_mmap_entries < max ? mb->nr_mmap_entries : max;
+	for (i = 0; i < n; i++) {
+		snap[i].mm     = mb->mmap_entries[i].mm;
+		snap[i].base   = mb->mmap_entries[i].base;
+		snap[i].pgoff  = mb->mmap_entries[i].pgoff;
+		snap[i].npages = mb->mmap_entries[i].npages;
+		if (snap[i].mm)
+			mmgrab(snap[i].mm);   /* +mm_count under lock */
+	}
+	spin_unlock(&mb->mmap_lock);
+	return n;
+}
+
+static inline void cxl_mmap_snap_release(struct cxl_mmap_snap_entry *snap, int n)
+{
+	int i;
+	for (i = 0; i < n; i++)
+		if (snap[i].mm)
+			mmdrop(snap[i].mm);
+}
