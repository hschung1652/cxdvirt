+  #pragma omp parallel for num_threads(8)
+  for (uint64_t i=0;i<sz/8;i+=4096/8) {
+    cxl[i] = 0;
+  }
+
+  munmap(cxl, sz);
+
+  close(fd);
+  printf("Done\n");
+  return 0;
