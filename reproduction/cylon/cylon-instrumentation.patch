+    "xor %%r10, %%r10 \n"
+    TIMING_BEGIN
+    "1: \n"
+    "mov (%%r11), %%r11 \n"
+    "inc %%r10 \n"
+    "cmp %[num_chase_block], %%r10 \n"
+    "jl 1b \n"
+    TIMING_END
+    "mov %%r11, %[addr] \n"
