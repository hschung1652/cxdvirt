+/* ============================================================================
+ * Cylon KVM Option-B: ns-resolution per-miss host-window stamps.
+ *
+ * Replaces the lossy ftrace kvm_exit/kvm_entry capture.  On a CXL MMIO miss
+ * (handle_ept_misconfig -> userspace), kvm_optb_mark_exit() stamps the exit time
+ * (CLOCK_MONOTONIC ns, matching QEMU's qemu_clock_get_ns(REALTIME) used by the
+ * optb device stamps).  At the next VMRESUME, kvm_optb_maybe_emit() records
+ * {vcpu, t_exit, t_entry}; host_window = t_entry - t_exit.  Records go to a
+ * preallocated array (no ring, no overflow -> ALL misses) dumped via
+ * /proc/kvm_optb (CSV; any write resets).  Mirrors nvmevirt's optb4k.
+ * ========================================================================== */
+struct kvm_optb_rec { u16 vcpu; u64 t_exit; u64 t_entry; u64 gtsc_exit; u64 gtsc_entry;
+		      u32 cpu_ns; u32 rundelay_ns; };  /* on-CPU work vs runqueue-wait (preemption) */
+#define KVM_OPTB_MAX   (16u << 20)        /* 16M misses */
+#define KVM_OPTB_VCPUS 64
+static struct kvm_optb_rec *g_kvm_optb;
+static atomic64_t g_kvm_optb_idx = ATOMIC64_INIT(0);
+static u64 g_kvm_optb_exit[KVM_OPTB_VCPUS];
+static u64 g_kvm_optb_gtsc_exit[KVM_OPTB_VCPUS];
+static u64 g_kvm_optb_cpu_exit[KVM_OPTB_VCPUS];       /* current->se.sum_exec_runtime at exit */
+static u64 g_kvm_optb_rundelay_exit[KVM_OPTB_VCPUS];  /* current->sched_info.run_delay at exit */
+static u8  g_kvm_optb_pending[KVM_OPTB_VCPUS];
+static int g_kvm_optb_on = 1;
+
+/* called from vmx.c (kvm-intel.ko) on a CXL MMIO miss exit */
+void kvm_optb_mark_exit(struct kvm_vcpu *vcpu)
+{
+	int idx = vcpu->vcpu_idx;
+	if (!g_kvm_optb_on || idx < 0 || idx >= KVM_OPTB_VCPUS)
+		return;
+	g_kvm_optb_exit[idx] = ktime_get_mono_fast_ns();
+	g_kvm_optb_gtsc_exit[idx] = kvm_read_l1_tsc(vcpu, rdtsc());
+	g_kvm_optb_cpu_exit[idx] = current->se.sum_exec_runtime;
+	g_kvm_optb_rundelay_exit[idx] = current->sched_info.run_delay;
+	g_kvm_optb_pending[idx] = 1;
+}
+EXPORT_SYMBOL_GPL(kvm_optb_mark_exit);
+
+/* called in vcpu_enter_guest just before VMRESUME: closes the pending miss */
+static void kvm_optb_maybe_emit(struct kvm_vcpu *vcpu)
+{
+	int idx = vcpu->vcpu_idx;
+	u64 i;
+	if (!g_kvm_optb_on || idx < 0 || idx >= KVM_OPTB_VCPUS || !g_kvm_optb_pending[idx])
+		return;
+	g_kvm_optb_pending[idx] = 0;
+	if (!READ_ONCE(g_kvm_optb)) {
+		struct kvm_optb_rec *p = vzalloc((size_t)KVM_OPTB_MAX * sizeof(*p));
+		if (!p) { g_kvm_optb_on = 0; return; }
+		if (cmpxchg(&g_kvm_optb, NULL, p) != NULL)
+			vfree(p);
+	}
+	i = atomic64_fetch_add(1, &g_kvm_optb_idx);
+	if (i >= KVM_OPTB_MAX)
+		return;
+	g_kvm_optb[i].vcpu = (u16)idx;
+	g_kvm_optb[i].t_exit = g_kvm_optb_exit[idx];
+	g_kvm_optb[i].t_entry = ktime_get_mono_fast_ns();
+	g_kvm_optb[i].gtsc_exit = g_kvm_optb_gtsc_exit[idx];
+	g_kvm_optb[i].gtsc_entry = kvm_read_l1_tsc(vcpu, rdtsc());
+	{
+		u64 dcpu = current->se.sum_exec_runtime - g_kvm_optb_cpu_exit[idx];
+		u64 drd  = current->sched_info.run_delay - g_kvm_optb_rundelay_exit[idx];
+		g_kvm_optb[i].cpu_ns      = dcpu > 0xffffffffUL ? 0xffffffffU : (u32)dcpu;
+		g_kvm_optb[i].rundelay_ns = drd  > 0xffffffffUL ? 0xffffffffU : (u32)drd;
+	}
+}
+
+static void *kvm_optb_seq_start(struct seq_file *s, loff_t *pos)
+{
+	u64 cnt = atomic64_read(&g_kvm_optb_idx);
+	if (cnt > KVM_OPTB_MAX) cnt = KVM_OPTB_MAX;
+	if (!g_kvm_optb || *pos >= cnt) return NULL;
+	return &g_kvm_optb[*pos];
+}
+static void *kvm_optb_seq_next(struct seq_file *s, void *v, loff_t *pos)
+{
+	u64 cnt = atomic64_read(&g_kvm_optb_idx);
+	if (cnt > KVM_OPTB_MAX) cnt = KVM_OPTB_MAX;
+	(*pos)++;
+	if (*pos >= cnt) return NULL;
+	return &g_kvm_optb[*pos];
+}
+static void kvm_optb_seq_stop(struct seq_file *s, void *v) {}
+static int kvm_optb_seq_show(struct seq_file *s, void *v)
+{
+	struct kvm_optb_rec *r = v;
+	/* columns: vcpu,t_exit_ns,t_entry_ns,gtsc_exit,gtsc_entry,cpu_ns,rundelay_ns */
+	seq_printf(s, "%u,%llu,%llu,%llu,%llu,%u,%u\n", r->vcpu, r->t_exit, r->t_entry,
+		   r->gtsc_exit, r->gtsc_entry, r->cpu_ns, r->rundelay_ns);
+	return 0;
+}
+static const struct seq_operations kvm_optb_seq_ops = {
+	.start = kvm_optb_seq_start, .next = kvm_optb_seq_next,
+	.stop = kvm_optb_seq_stop, .show = kvm_optb_seq_show,
+};
+static int kvm_optb_proc_open(struct inode *ino, struct file *f)
+{
+	return seq_open(f, &kvm_optb_seq_ops);
+}
+static ssize_t kvm_optb_proc_write(struct file *f, const char __user *b, size_t n, loff_t *o)
+{
+	atomic64_set(&g_kvm_optb_idx, 0);   /* any write resets for the next run */
+	return n;
